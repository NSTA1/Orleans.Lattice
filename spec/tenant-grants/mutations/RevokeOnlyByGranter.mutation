# Pairs with NoUnilateralTrap. Without the grantee-side fallback the grantee
# cannot walk away from an active grant.
MODULE: RevokeOnlyByGranter
TARGET: NoUnilateralTrap
CLASS: Invariant
SUMMARY: revoke authorizes only the granting tenant's side
PERTURBS: Revoke

--- FIND
    LET a == IF TryAuthorizeAdmin(c, "A") THEN "ok" ELSE AuthorizeAdmin(c, "B")
--- REPLACE
    LET a == AuthorizeAdmin(c, "A")
--- END