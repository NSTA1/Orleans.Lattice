# #5837, the claimless advance and the split hint.
MODULE: SiblingHintHonestSplitHintBoundsReadBeforeHeads
TARGET: SiblingHintHonest
CLASS: Invariant
SUMMARY: the split reads the donor's view and bounds before it captures the heads
PERTURBS: SplitHeads
BOUNDS: WithFreeAdvance = TRUE, WithSplitHint = TRUE, WithDuplicate = FALSE, WithMixedVersion = FALSE

--- FIND
    /\ \A b \in Acts : sh[b] = -1
    /\ sh' = [sh EXCEPT ![a] = next]
--- REPLACE
    /\ \A b \in Acts : sh[b] = -1
\* MUTATION: the marker view is read here, before the heads are captured.
    /\ mInit
    /\ ~hoOpen
    /\ rp[a] >= hoClosedAt - 1
    /\ sh' = [sh EXCEPT ![a] = next]
--- END

--- FIND
    /\ sh[a] # -1
    /\ SplitViewClear(a)
    /\ rp[a] >= seenP[a]
    /\ rp[a] >= seenU[a]
    /\ CloseCarried => rp[a] >= seenS[a]
    /\ \A o \in Offs : o < sh[a] /\ author[o] = a => o \in cache[a]
    /\ sibHint' = sh[a] - 1
    /\ sibRows' = {o \in cache[a] : o < sh[a]}
--- REPLACE
    /\ sh[a] # -1
\* MUTATION: the heads, and the bounds their capture returns, are taken now, after the view.
    /\ rp[a] >= ForeignHigh(a)
    /\ rp[a] >= lastU
    /\ pend => rp[a] >= sHi
    /\ \A o \in Offs : o < next /\ author[o] = a => o \in cache[a]
    /\ sibHint' = next - 1
    /\ sibRows' = {o \in cache[a] : o < next}
--- END
