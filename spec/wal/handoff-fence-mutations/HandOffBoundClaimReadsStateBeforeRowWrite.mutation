# #5841, option A (Dekker): the claim must write the row before it reads the leaf state.
MODULE: HandOffBoundClaimReadsStateBeforeRowWrite
TARGET: HandOffBound
CLASS: Invariant
SUMMARY: the duplicate's claim reads the leaf state before it writes the row, so both reads can miss the other's write
PERTURBS: DupClaimWrite, DupClaimCheck
BOUNDS: WithStaleDonor = TRUE, WithPreArm = TRUE, MaxWindows = 1, WithDekker = TRUE

--- FIND
    /\ dst' = "wrote"
    /\ dEpoch' = eRow + 1
    /\ eRow' = eRow + 1
    /\ UNCHANGED <<rowSeq, liveArmed, dpend, dstamp, bst, bRead, sNarrowed, dSaw>>
--- REPLACE
    /\ dst' = "wrote"
\* MUTATION: the state is read first; the row is written by the check.
    /\ dSaw' = sNarrowed
    /\ UNCHANGED <<eRow, dEpoch, rowSeq, liveArmed, dpend, dstamp, bst, bRead, sNarrowed>>
--- END

--- FIND
    /\ dst = "wrote"
    /\ dSaw' = sNarrowed
    /\ dst' = IF dSaw' THEN "stale" ELSE "claimed"
    /\ UNCHANGED <<eRow, rowSeq, liveArmed, dEpoch, dpend, dstamp, bst, bRead, sNarrowed>>
--- REPLACE
    /\ dst = "wrote"
\* MUTATION: the row is written after the state read, deciding on the earlier read.
    /\ eRow < MaxEpoch
    /\ dEpoch' = eRow + 1
    /\ eRow' = eRow + 1
    /\ dst' = IF dSaw THEN "stale" ELSE "claimed"
    /\ UNCHANGED <<rowSeq, liveArmed, dpend, dstamp, bst, bRead, sNarrowed, dSaw>>
--- END
