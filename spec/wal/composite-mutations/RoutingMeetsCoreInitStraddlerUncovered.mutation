# Pairs with RoutingMeetsCoreInit (R -> C). StraddlerBelowInit is dropped, so the first
# initialisation records a head at or below a straddler.
MODULE: RoutingMeetsCoreInitStraddlerUncovered
TARGET: RoutingMeetsCoreInit
CLASS: Invariant
SUMMARY: StraddlerBelowInit is dropped

--- FIND
Guarantees ==
    /\ ClaimHeadCoversPriorAppends
    /\ RaisedEpochUnique
    /\ StaleEpochNeverAppends
    /\ HandOffBound
    /\ StraddlerBelowInit
    /\ BulkHintBound
--- REPLACE
Guarantees ==
    /\ ClaimHeadCoversPriorAppends
    /\ RaisedEpochUnique
    /\ StaleEpochNeverAppends
    /\ HandOffBound
    /\ BulkHintBound
--- END
