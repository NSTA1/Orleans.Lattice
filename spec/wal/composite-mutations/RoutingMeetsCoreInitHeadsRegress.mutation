# Pairs with RoutingMeetsCoreInit (H -> C). CloseHeadMonotone is dropped, so after a 10.2.0
# purge, which keeps L's marker, the first initialisation lowers the heads an earlier
# close recorded.
MODULE: RoutingMeetsCoreInitHeadsRegress
TARGET: RoutingMeetsCoreInit
CLASS: Invariant
SUMMARY: CloseHeadMonotone is dropped

--- FIND
    /\ (~recreated /\ recreated' /\ ~legacy') \/ CloseHeadMonotone
--- REPLACE
    /\ TRUE
--- END
