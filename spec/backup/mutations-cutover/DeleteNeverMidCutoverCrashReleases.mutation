# Pairs with DeleteNeverMidCutover. A restore that fails part-way releases
# its reservation, so the tree can be deleted while its copies are half
# moved and the retry has nothing left to resume.
MODULE: DeleteNeverMidCutoverCrashReleases
TARGET: DeleteNeverMidCutover
CLASS: Invariant
SUMMARY: a failed restore releases the alias reservation
PERTURBS: Crash

--- FIND
    /\ rp' = "failed"
    /\ UNCHANGED <<alias, map, route, redir, reserved, deleted>>
--- REPLACE
    /\ rp' = "failed"
    \* MUTATION: the reservation is released on failure.
    /\ reserved' = FALSE
    /\ UNCHANGED <<alias, map, route, redir, deleted>>
--- END
