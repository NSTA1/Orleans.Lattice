# Pairs with FailClosed. The gate admits every tool when no authorizer is
# registered, so a host that removed the default reaches every facade tool.
MODULE: AbsentAuthorizerAdmits
TARGET: FailClosed
CLASS: Invariant
SUMMARY: McpToolAuthorizationGate admits when no authorizer is registered

--- FIND
    CASE authz = "absent" -> FALSE
--- REPLACE
    CASE authz = "absent" -> TRUE
--- END
