DETECTORS: TreeShardSplitGrainTests.RetroactiveSweep_replays_prepare_when_saga_in_flight
SUMMARY: the split's retroactive sweep skips replaying the source's prepared mutations onto the destination

--- FIND
                    await PreparedBucketSweep.RunAsync(
                        grainFactory, TreeId, attemptLeafId.Value, target, sortedSlots, virtualShardCount,
                        progress, carryOriginalStamps: true);
                    break;
--- REPLACE
                    break;
