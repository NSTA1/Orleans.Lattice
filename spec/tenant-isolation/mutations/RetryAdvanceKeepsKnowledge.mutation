# Pairs with NoStaleAuthority. The re-publish completes without publishing an
# epoch any silo has not seen, so it reports the debt repaired while a peer
# still trusts its old snapshot.
MODULE: RetryAdvanceKeepsKnowledge
TARGET: NoStaleAuthority
CLASS: Invariant
SUMMARY: the background re-publish does not bump the epoch
PERTURBS: RetryAdvance
BOUNDS: MaxFailures = 1

--- FIND
    /\ wstate' = "retrying"
    /\ epoch' = <<epoch[1], epoch[2] + 1>>
    /\ knows' = [t \in Silos |-> FALSE]
--- REPLACE
\* MUTATION: silos still hold the current epoch.
    /\ wstate' = "retrying"
    /\ epoch' = <<epoch[1], epoch[2] + 1>>
    /\ knows' = knows
--- END
