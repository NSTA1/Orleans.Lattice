# CacheCurrentOrPending: a cached setting is current or its eviction is on its way.
MODULE: SchemaPolicyConfig
ROW: CacheCurrentOrPending
FILE: src/lattice.schema/LatticeSchemaPolicyProvider.cs
DETECTORS: LatticeSchemaPolicyProviderTests.OnMutationAsync_policy_tree_write_evicts_affected_tree
SUMMARY: a delivered change leaves the stale policy cached

--- FIND
        _cache.InvalidateForMutation(mutation, SchemaConstants.PolicyTree);
--- REPLACE
        _ = mutation;
--- END
