# ShadowAtOwnTarget: each migrated value is stamped at the migration's target.
MODULE: SchemaVersionFamily
ROW: ShadowAtOwnTarget
FILE: src/lattice.schema/LatticeSchemaVersionMigration.cs
DETECTORS: LatticeSchemaVersionMigrationTests.Migrate_below_target_value_is_upcast_and_reenveloped_at_target, LatticeSchemaRemediationGrainTests.StartVersionMigrationAsync_restamps_mixed_versions_to_target_and_cuts_over
SUMMARY: an upcast value is re-enveloped one version past the target

--- FIND
        return LatticeSchemaEnvelope.Encode(stampedSchemaId, targetVersion, upcast);
--- REPLACE
        return LatticeSchemaEnvelope.Encode(stampedSchemaId, targetVersion + 1, upcast);
--- END