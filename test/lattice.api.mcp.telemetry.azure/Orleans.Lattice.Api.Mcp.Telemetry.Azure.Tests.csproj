<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <!-- Test-only: lets the docs-snippet harness compile the companion's
         DefaultAzureCredential example against the real Azure.Identity surface. -->
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\lattice.api.mcp.telemetry.azure\Orleans.Lattice.Api.Mcp.Telemetry.Azure.csproj" />
    <!--
      Test-only. The product package deliberately references only the neutral
      Orleans.Lattice.Api.Telemetry facade (issue #1767), so a client head does not
      drag in the MCP server surface. The test project still needs the MCP binding
      to (a) compile this package's docs snippet, which shows the MCP composition,
      and (b) prove end to end that an MCP host composing AddTelemetryTools with
      AddAzureTelemetryBackendToken keeps the minted token confined to the backend.
      Keeping the reference here rather than in src is what makes that provable
      without re-coupling the shipped package.
    -->
    <ProjectReference Include="..\..\src\lattice.api.mcp.telemetry\Orleans.Lattice.Api.Mcp.Telemetry.csproj" />
    <ProjectReference Include="..\shared\Orleans.Lattice.Testing\Orleans.Lattice.Testing.csproj" />
  </ItemGroup>

</Project>
