<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<IsPackable>false</IsPackable>
	<RootNamespace>VehicleFleetSimulator.AzureThroughput.Silo.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
	<FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
	<PackageReference Include="NSubstitute" Version="6.2.0" />
	<PackageReference Include="NUnit" Version="4.6.1" />
	<PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
	<Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
	<!--
	  Reference the silo's Exe project so the test fixture can call into
	  BenchWorkloadDispatcher.DispatchAsync directly. The silo's csproj
	  sets OutputType=Exe; .NET's project-to-project graph handles that
	  fine for a test referencing the Exe's assembly.
	-->
	<ProjectReference Include="..\..\benchmark\azure-throughput\Silo\VehicleFleetSimulator.AzureThroughput.Silo.csproj" />
	<!--
	  ILattice / ICollections types are pulled in transitively through
	  the silo's reference graph; declaring the direct reference here
	  keeps the IDE's intellisense aware of the public surface the tests
	  assert against.
	-->
	<ProjectReference Include="..\..\src\lattice\Orleans.Lattice.csproj" />
  </ItemGroup>

</Project>
