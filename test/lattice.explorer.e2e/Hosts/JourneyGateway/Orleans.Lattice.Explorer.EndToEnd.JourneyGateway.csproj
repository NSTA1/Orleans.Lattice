<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Orleans.Lattice.Explorer.EndToEnd.Hosts.Gateway</RootNamespace>
    <AssemblyName>Orleans.Lattice.Explorer.EndToEnd.JourneyGateway</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\JourneyHostEnvironment.cs" Link="Shared\JourneyHostEnvironment.cs" />
  </ItemGroup>

</Project>
