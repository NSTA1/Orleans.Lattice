<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Orleans.Lattice.Explorer.EndToEnd.Hosts.LineFeed</RootNamespace>
    <AssemblyName>Orleans.Lattice.Explorer.EndToEnd.LineFeed</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    The factory's upstream ingestion service: a Data API client and nothing more,
    authenticated as the service identity line-feed.
  -->
  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\lattice.api.data.grpc\Orleans.Lattice.Api.Data.Grpc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\JourneyHostEnvironment.cs" Link="Shared\JourneyHostEnvironment.cs" />
  </ItemGroup>

</Project>
