<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Orleans.Lattice.Explorer.EndToEnd.Hosts.Explorer</RootNamespace>
    <AssemblyName>Orleans.Lattice.Explorer.EndToEnd.JourneyExplorer</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    The reference-architecture Explorer head built from source: the Explorer web
    hosting library over project references, with the built-in Basic sign-in.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\lattice.explorer\WebHosting\Orleans.Lattice.Explorer.Web.csproj" />
    <ProjectReference Include="..\..\..\..\reference-architecture\hosts\Common\Orleans.Lattice.ReferenceArchitecture.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\JourneyHostEnvironment.cs" Link="Shared\JourneyHostEnvironment.cs" />
    <Compile Include="..\Shared\JourneyMemoryProbe.cs" Link="Shared\JourneyMemoryProbe.cs" />
  </ItemGroup>

</Project>
