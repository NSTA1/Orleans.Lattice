<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Opt-in diagnostic instrumentation, mirrored from the core library.
    When LatticeDiag=true is supplied (e.g. `dotnet build /p:LatticeDiag=true`),
    every `#if LATTICE_DIAG` block in this project compiles in. Off by
    default. The mirror is required because test-side trace emissions
    (e.g. from chaos repros that decorate failures with extra context)
    live in this assembly and need the same compile guard as the library
    emissions to stay symmetrically gated.
  -->
  <PropertyGroup Condition="'$(LatticeDiag)' == 'true'">
    <DefineConstants>$(DefineConstants);LATTICE_DIAG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="8.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    <PackageReference Include="Microsoft.Orleans.TestingHost" Version="10.1.0" />
    <PackageReference Include="Microsoft.Orleans.Streaming" Version="10.1.0" />
    <!--
      Pulled in solely so docs/lattice/api.md can show the canonical
      Azure Table grain-storage wiring as a `csharp verify` snippet. The
      DocsSnippetCompilationTests harness compiles every `csharp verify`
      fence under docs/ against this test project's reference graph; the
      example uses `AddAzureTableGrainStorage`, which lives here.
    -->
    <PackageReference Include="Microsoft.Orleans.Persistence.AzureStorage" Version="10.1.0" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="NUnit" Version="4.5.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\lattice\Orleans.Lattice.csproj" />
    <ProjectReference Include="..\..\src\lattice.storage.azuretable\Orleans.Lattice.Storage.AzureTable.csproj" />
    <ProjectReference Include="..\..\src\lattice.replication\Orleans.Lattice.Replication.csproj" />
    <ProjectReference Include="..\..\src\lattice.replication.grpc\Orleans.Lattice.Replication.Grpc.csproj" />
  </ItemGroup>

</Project>
