<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Opt-in diagnostic instrumentation, mirrored from the core library.
    When LatticeDiag=true is supplied (e.g. `dotnet build /p:LatticeDiag=true`),
    every `#if LATTICE_DIAG` block in this project compiles in. Off by
    default. The mirror is required because test-side trace emissions
    (e.g. from chaos repros that decorate failures with extra context)
    live in this assembly and need the same compile guard as the library
    emissions to stay symmetrically gated.
  -->
  <PropertyGroup Condition="'$(LatticeDiag)' == 'true'">
    <DefineConstants>$(DefineConstants);LATTICE_DIAG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="Microsoft.Orleans.TestingHost" Version="10.2.2" />
    <PackageReference Include="Microsoft.Orleans.Streaming" Version="10.2.2" />
    <!--
      Pulled in solely so docs/lattice/api.md can show the canonical
      Azure Table grain-storage wiring as a `csharp verify` snippet. The
      DocsSnippetCompilationTests harness compiles every `csharp verify`
      fence under docs/ against this test project's reference graph; the
      example uses `AddAzureTableGrainStorage`, which lives here.
    -->
    <PackageReference Include="Microsoft.Orleans.Persistence.AzureStorage" Version="10.2.2" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <!--
    Byte-for-byte legacy leaf-snapshot blob, serialised by the same Newtonsoft
    path the grain-storage serializer uses, committed so the codec's dual-read
    guarantee is proved against a real pre-codec persisted shape rather than a
    reconstruction. Embedded (not copied) so the bytes the test reads are
    exactly the bytes in source control.
  -->
  <ItemGroup>
    <EmbeddedResource Include="BPlusTree\State\Fixtures\leaf-snapshot-legacy.json">
      <LogicalName>Orleans.Lattice.Tests.BPlusTree.State.Fixtures.leaf-snapshot-legacy.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\lattice\Orleans.Lattice.csproj" />
    <ProjectReference Include="..\shared\Orleans.Lattice.Testing\Orleans.Lattice.Testing.csproj" />
    <ProjectReference Include="..\..\src\lattice.storage.azuretable\Orleans.Lattice.Storage.AzureTable.csproj" />
    <ProjectReference Include="..\..\src\lattice.replication\Orleans.Lattice.Replication.csproj" />
    <ProjectReference Include="..\..\src\lattice.replication.grpc\Orleans.Lattice.Replication.Grpc.csproj" />
    <!--
      Pulled in solely so docs/lattice.api.state/*.md can show the state-API
      registration and client wiring as `csharp verify` snippets. The
      DocsSnippetCompilationTests harness compiles every `csharp verify` fence
      under docs/ against this test project's reference graph.
    -->
    <ProjectReference Include="..\..\src\lattice.api.state\Orleans.Lattice.Api.State.csproj" />
    <ProjectReference Include="..\..\src\lattice.api.state.grpc\Orleans.Lattice.Api.State.Grpc.csproj" />
    <!--
      Pulled in solely so docs/lattice.api.data/*.md can show the data-API
      registration and client wiring as `csharp verify` snippets, on the same
      DocsSnippetCompilationTests reference-graph mechanism as the state API above.
    -->
    <ProjectReference Include="..\..\src\lattice.api.data\Orleans.Lattice.Api.Data.csproj" />
    <ProjectReference Include="..\..\src\lattice.api.data.grpc\Orleans.Lattice.Api.Data.Grpc.csproj" />
    <!--
      Pulled in solely so docs/lattice.backup*, docs/lattice.api.backup,
      and docs/lattice.api.backup.grpc can show backup capture, restore,
      storage, and control-API wiring as `csharp verify` snippets, on the same
      DocsSnippetCompilationTests reference-graph mechanism as the other API
      packages above.
    -->
    <ProjectReference Include="..\..\src\lattice.backup\Orleans.Lattice.Backup.csproj" />
    <ProjectReference Include="..\..\src\lattice.backup.azureblob\Orleans.Lattice.Backup.AzureBlob.csproj" />
    <ProjectReference Include="..\..\src\lattice.api.backup\Orleans.Lattice.Api.Backup.csproj" />
    <ProjectReference Include="..\..\src\lattice.api.backup.grpc\Orleans.Lattice.Api.Backup.Grpc.csproj" />
    <ProjectReference Include="..\..\src\lattice.api.mcp\Orleans.Lattice.Api.Mcp.csproj" />
    <!--
      Pulled in solely so docs/lattice.api.mcp.telemetry/*.md can show the
      telemetry tool-module registration and options as `csharp verify` snippets
      on the same DocsSnippetCompilationTests reference-graph mechanism.
    -->
    <ProjectReference Include="..\..\src\lattice.api.mcp.telemetry\Orleans.Lattice.Api.Mcp.Telemetry.csproj" />
    <!--
      Pulled in solely so docs/lattice.membership/*.md and docs/lattice.auth/*.md
      can show membership + authorization registration, rule authoring, and
      options as `csharp verify` snippets, on the same DocsSnippetCompilationTests
      reference-graph mechanism as the API packages above.
    -->
    <ProjectReference Include="..\..\src\lattice.membership\Orleans.Lattice.Membership.csproj" />
    <ProjectReference Include="..\..\src\lattice.auth\Orleans.Lattice.Auth.csproj" />
    <ProjectReference Include="..\..\src\lattice.schema\Orleans.Lattice.Schema.csproj" />
    <ProjectReference Include="..\..\src\lattice.scaling\Orleans.Lattice.Scaling.csproj" />
  </ItemGroup>

</Project>
