@inherits LayoutComponentBase
@implements IDisposable
@inject MultiSiteManufacturing.Host.SiloIdentity Silo
@inject IGrainFactory Grains
@using MultiSiteManufacturing.Host.Replication
@using MultiSiteManufacturing.Host.Replication.Grains

<header class="container">
    <nav>
        <ul>
            <li><strong>Multi-Site Manufacturing</strong></li>
        </ul>
        <ul class="topbar-status">
            <li><small>operator: <kbd>demo</kbd></small></li>
            <li>
                <small>silo: <kbd>@($"{Silo.ClusterName}/{Silo.Id.ToUpperInvariant()}")</kbd></small>
            </li>
            @foreach (var peer in _snapshot.Peers)
            {
                <li title="Outbound batches shipped to @peer.Peer (process lifetime: @peer.RowsSent rows in @peer.BatchesSent batches, @peer.SendErrors errors)">
                    <small>
                        ship&rarr;<kbd>@peer.Peer</kbd>
                        <span class="@SentClass(peer)">@FormatRelative(peer.LastSentUtc)</span>
                    </small>
                </li>
                <li title="Inbound batches applied from @peer.Peer (process lifetime: @peer.BatchesReceived batches, @peer.ApplyErrors errors)">
                    <small>
                        recv&larr;<kbd>@peer.Peer</kbd>
                        <span class="@RecvClass(peer)">@FormatRelative(peer.LastReceivedUtc)</span>
                    </small>
                </li>
            }
            <li>
                <button class="secondary"
                        aria-expanded="@_chaosOpen.ToString().ToLowerInvariant()"
                        aria-controls="chaos-flyout"
                        @onclick="ToggleChaos">
                    &#9776; Chaos
                </button>
            </li>
        </ul>
    </nav>
</header>

<main class="container">
    @Body
</main>

<ChaosFlyout IsOpen="_chaosOpen" OnClose="CloseChaos" />


@code {
    private bool _chaosOpen;
    private MultiSiteManufacturing.Host.Replication.ReplicationActivitySnapshot _snapshot =
        new(System.Array.Empty<MultiSiteManufacturing.Host.Replication.ReplicationPeerActivity>());
    private System.Threading.Timer? _timer;

    // Stale thresholds for the per-peer indicators. Anything fresher than
    // `FreshThreshold` reads green; older than `StaleThreshold` reads
    // amber/red. Values picked to match the package's default ship cadence
    // (sub-second) plus a small buffer for the meter callback path.
    private static readonly System.TimeSpan FreshThreshold = System.TimeSpan.FromSeconds(5);
    private static readonly System.TimeSpan StaleThreshold = System.TimeSpan.FromSeconds(30);

    protected override async Task OnInitializedAsync()
    {
        // Eager first refresh so the strip populates immediately on
        // navigation, instead of waiting a full poll interval before the
        // peers list appears for the first time.
        await RefreshAsync();
        _timer = new System.Threading.Timer(_ => InvokeAsync(RefreshAsync),
            null, System.TimeSpan.FromMilliseconds(500), System.TimeSpan.FromMilliseconds(500));
    }

    private async Task RefreshAsync()
    {
        // Source the strip from the cluster-singleton aggregator rather
        // than the local-silo tracker. The package's ReplicationShipperGrain
        // activates on a single silo per (tree, peer) pair, so the local
        // MeterListener only sees ship events when this silo happens to
        // host that activation. Polling the aggregator means a sticky-
        // cookied tab on any silo sees the merged cluster-wide view.
        try
        {
            var grain = Grains.GetGrain<IClusterReplicationActivityGrain>(
                IClusterReplicationActivityGrain.SingletonKey);
            _snapshot = await grain.SnapshotAsync();
            StateHasChanged();
        }
        catch
        {
            // Swallow transient grain-call failures so a momentary
            // routing blip doesn't crash the layout render. Persistent
            // failures naturally surface as repl-stale colouring on the
            // per-peer ship/recv chips.
            StateHasChanged();
        }
    }

    private void ToggleChaos() => _chaosOpen = !_chaosOpen;
    private void CloseChaos() => _chaosOpen = false;

    private static string FormatRelative(System.DateTime? whenUtc)
    {
        if (whenUtc is null) return "—";
        var elapsed = System.DateTime.UtcNow - whenUtc.Value;
        if (elapsed < System.TimeSpan.Zero) elapsed = System.TimeSpan.Zero;
        if (elapsed.TotalSeconds < 1) return "just now";
        if (elapsed.TotalSeconds < 60) return $"{(int)elapsed.TotalSeconds}s ago";
        if (elapsed.TotalMinutes < 60) return $"{(int)elapsed.TotalMinutes}m ago";
        return $"{(int)elapsed.TotalHours}h ago";
    }

    private static string SentClass(MultiSiteManufacturing.Host.Replication.ReplicationPeerActivity p)
    {
        if (p.LastSentUtc is null) return "repl-stale";
        var elapsed = System.DateTime.UtcNow - p.LastSentUtc.Value;
        if (p.LastSendErrorUtc is { } err && err > p.LastSentUtc.Value && System.DateTime.UtcNow - err < FreshThreshold)
            return "repl-error";
        if (elapsed < FreshThreshold) return "repl-fresh";
        if (elapsed < StaleThreshold) return "repl-warming";
        return "repl-stale";
    }

    private static string RecvClass(MultiSiteManufacturing.Host.Replication.ReplicationPeerActivity p)
    {
        if (p.LastReceivedUtc is null) return "repl-stale";
        var elapsed = System.DateTime.UtcNow - p.LastReceivedUtc.Value;
        if (elapsed < FreshThreshold) return "repl-fresh";
        if (elapsed < StaleThreshold) return "repl-warming";
        return "repl-stale";
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _timer = null;
    }
}

<style>
    /* Top-bar status strip: silo identity + chaos toggle + per-peer
       ship / recv indicators. The ship & recv timestamps are sourced
       from the canonical orleans.lattice.replication meter via a
       host-side MeterListener (ReplicationActivityTracker); the same
       meter feeds the bind-mounted Grafana dashboards through
       Prometheus, so the in-page strip and the operator dashboards
       stay aligned by construction. */
    .topbar-status {
        gap: 0.75rem;
    }
    .topbar-status li {
        display: inline-flex;
        align-items: center;
    }

    /* Per-peer ship/recv freshness colouring. Green when the most
       recent observation is within FreshThreshold, amber on warming,
       muted-grey on stale or never-observed, and red on a recent
       outbound failure. */
    .repl-fresh   { color: #2d8a3e; font-weight: 600; margin-left: 0.25rem; }
    .repl-warming { color: #b45309; font-weight: 600; margin-left: 0.25rem; } /* amber-700 */
    .repl-stale   { color: var(--pico-muted-color); margin-left: 0.25rem; }
    .repl-error   { color: #b83a3a; font-weight: 600; margin-left: 0.25rem; }

    /* Widen the default Pico container — at standard widths Pico caps at
       ~1130px which wraps the Serial / Family columns hard on a 1080p
       display. Give the dashboard real estate up to 1800px while keeping
       a small gutter on ultra-wide monitors. */
    body > header.container,
    body > main.container,
    body > footer.container {
        max-width: min(1800px, calc(100vw - 2rem));
    }

    .state-badge {
        display: inline-block;
        padding: 0.15rem 0.5rem;
        border-radius: 0.25rem;
        font-size: 0.8rem;
        font-weight: 600;
        color: #fff;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .state-nominal          { background: #2d8a3e; }
    .state-underinspection  { background: #3b7ab8; }
    .state-flaggedforreview { background: #d18f2a; }
    .state-rework           { background: #d46b2a; }
    .state-scrap            { background: #b83a3a; }

    .chaos-banner {
        margin-bottom: 1rem;
    }
    .divergent-row td {
        background-color: rgba(184, 58, 58, 0.08);
    }
    /* Serial numbers (`HPT-BLD-S1-2028-00001`) and family codes are
       identifiers — never wrap them mid-token. */
    .inventory-nowrap {
        white-space: nowrap;
    }

    /* Chaos fly-out. Slides in from the right; the scrim sits
       underneath to dim the dashboard and close on outside-click. */
    .chaos-flyout {
        position: fixed;
        top: 0;
        right: 0;
        height: 100vh;
        width: min(1100px, 100vw);
        background: var(--pico-background-color);
        border-left: 1px solid var(--pico-muted-border-color);
        box-shadow: -4px 0 16px rgba(0, 0, 0, 0.15);
        transform: translateX(100%);
        transition: transform 0.25s ease-in-out;
        overflow-y: auto;
        padding: 1rem 1.5rem;
        z-index: 1000;
    }
    .chaos-flyout.open {
        transform: translateX(0);
    }
    .chaos-flyout-scrim {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.35);
        z-index: 999;
    }
    .chaos-flyout section {
        margin-top: 1.5rem;
    }
    .chaos-flyout-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }
    .chaos-flyout-close {
        width: auto;
        padding: 0.25rem 0.6rem;
        margin: 0;
        line-height: 1;
    }
    .chaos-flyout .backend-row {
        padding: 0.75rem 1rem;
    }
    /* Per-site table: give numeric inputs enough room for 4-5 digit
       values (e.g. "8000" ms) without clipping. Pico's default narrow
       table input style was crushing them. */
    .chaos-flyout table input[type="number"] {
        min-width: 6rem;
        width: 100%;
    }
    .chaos-flyout table td,
    .chaos-flyout table th {
        white-space: nowrap;
    }
    .preset-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    .preset-buttons button {
        flex: 1 1 auto;
    }
    /* Race button in the inventory grid: fixed width + compact padding
       so the aria-busy spinner state (Pico-provided) can't reflow the
       "Actions" column. Without this, toggling between ⚠ and spinner
       visibly shifts the row. */
    .race-button {
        min-width: 7.5rem;
        padding: 0.25rem 0.5rem;
        margin: 0;
        font-size: 0.85rem;
        white-space: nowrap;
        /* Reserve room for Pico's aria-busy spinner so toggling it on/off
           doesn't reflow the column. Pico injects a ::before pseudo-element
           sized roughly 1em — we hard-allocate the width via a fixed
           box model below. */
        box-sizing: border-box;
        width: 7.5rem;
    }
    /* Hide the spinner Pico adds via aria-busy="true"; the button's
       disabled state is already a clear visual signal and a moving
       spinner inside a fixed-width button was the source of the
       horizontal flicker. */
    .race-button[aria-busy="true"]::before {
        display: none;
    }

    /* Inline "last race" status line inside the inventory header.
       Muted by default; amber when every fact was held so the operator
       notices their chaos config is suppressing downstream effects. */
    .race-status {
        margin-left: 0.5rem;
        color: var(--pico-muted-color);
    }
    .race-status-held {
        color: #b45309; /* amber-700 */
        font-weight: 600;
    }

    /* Tab bar for switching between top-level dashboard views
       (Inventory vs. Inventory By Activity). Styled to sit flush
       above the tab panels with a single bottom border; the
       active tab lifts that border into the primary accent
       colour. The same class is reused inside the activity
       panel for its per-site filter strip. */
    .tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 0;
        list-style: none;
        padding-left: 0;
        margin: 0 0 1rem 0;
        border-bottom: 1px solid var(--pico-muted-border-color);
    }
    .tabs li {
        list-style: none;
        margin: 0;
        padding: 0;
    }
    .tabs li::marker {
        content: "";
    }
    .tabs button,
    .tabs a {
        background: transparent;
        color: var(--pico-muted-color);
        border: none;
        border-bottom: 2px solid transparent;
        border-radius: 0;
        padding: 0.5rem 1rem;
        margin: 0;
        cursor: pointer;
        font-weight: normal;
        box-shadow: none;
        text-decoration: none;
        display: inline-block;
    }
    .tabs button:hover,
    .tabs a:hover {
        color: var(--pico-color);
        background: transparent;
        text-decoration: none;
    }
    .tabs button[aria-selected="true"],
    .tabs a[aria-selected="true"] {
        color: var(--pico-primary);
        border-bottom-color: var(--pico-primary);
        font-weight: 600;
    }
</style>
