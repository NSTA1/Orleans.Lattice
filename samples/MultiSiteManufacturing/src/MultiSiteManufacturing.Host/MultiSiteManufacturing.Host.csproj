<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MultiSiteManufacturing.Host</RootNamespace>
    <AssemblyName>MultiSiteManufacturing.Host</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Docker image trim: the container entrypoint is `dotnet <dll>`,
         so the native apphost launcher is dead weight (~78 KB). And
         we only ship English error messages, so suppress the 13
         locale satellite DLL folders (~1 MB). Both are harmless for
         local `dotnet run` on Windows/Mac/Linux as well - apphost is
         generated for `dotnet run` separately. -->
    <UseAppHost>false</UseAppHost>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Data.Tables" Version="12.11.0" />
    <PackageReference Include="Microsoft.Orleans.Server" Version="10.2.0" />
    <PackageReference Include="Microsoft.Orleans.Persistence.AzureStorage" Version="10.2.0" />
    <PackageReference Include="Microsoft.Orleans.Clustering.AzureStorage" Version="10.2.0" />
    <PackageReference Include="Microsoft.Orleans.Reminders.AzureStorage" Version="10.2.0" />
    <PackageReference Include="Microsoft.Orleans.Streaming.AzureStorage" Version="10.2.0" />
    <!-- Observability: expose orleans.lattice + orleans.lattice.replication
         meters via Prometheus on /metrics so the docker-compose Grafana
         container can render the dashboards shipped by Orleans.Lattice.Dashboards. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.15.3-beta.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MultiSiteManufacturing.Contracts\MultiSiteManufacturing.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\src\lattice\Orleans.Lattice.csproj" />
    <!-- Migration step 1: package-shipped replication wired in alongside the
         host-rolled pipeline (see ../../migration.md). The package observes
         only trees declared in LatticeReplicationOptions.ReplicatedTrees -
         currently `mfg-facts-v2` only - so it is disjoint from the existing
         host-rolled ReplicationTopology. -->
    <ProjectReference Include="..\..\..\..\src\lattice.replication\Orleans.Lattice.Replication.csproj" />
    <ProjectReference Include="..\..\..\..\src\lattice.replication.grpc\Orleans.Lattice.Replication.Grpc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy per-cluster overlay files next to the built DLL so the
         host can find them when launched via `dotnet <dll>` from any
         working directory (run.ps1 also pins WorkingDirectory, but
         this makes it robust to manual invocations too). The Web SDK
         already includes these as Content items by default - we only
         need to flip CopyToOutputDirectory via Update. -->
    <Content Update="appsettings.cluster.*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MultiSiteManufacturing.Tests" />
  </ItemGroup>

</Project>
