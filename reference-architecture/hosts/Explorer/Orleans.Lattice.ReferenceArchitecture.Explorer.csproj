<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Orleans.Lattice.ReferenceArchitecture.Explorer</RootNamespace>
    <AssemblyName>Orleans.Lattice.ReferenceArchitecture.Explorer</AssemblyName>
    <IsPackable>false</IsPackable>
    <!--
      InvariantGlobalization is enabled after the ordinal-only audit recorded in
      reference-architecture/hosts/README.md. For this Blazor Server head the
      only culture-sensitive residue is display-side formatting (numbers, dates)
      and UI-list ordering; tree keys and access decisions are compared
      ordinally by the underlying explorer. Dropping ICU is therefore
      correctness-safe here and only alters cosmetic display formatting to the
      invariant culture, which is acceptable for an operator console.
    -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Published Orleans.Lattice NuGet packages (nuget.org), NOT project references
    into src/. Orleans.Lattice.Explorer.Web brings the Explorer UI (every native
    area compiled in) and Core transitively; Core and UI are also pinned
    explicitly so the whole Explorer family resolves to one released version. The
    Entra.Web package adds the hosted-web (OpenID Connect, auth-code + PKCE) Entra
    sign-in provider that replaces the desktop/device-code flow - the console is a
    multi-replica Blazor Server web head, so the browser signs in via a
    server-side confidential client rather than an interactive desktop broker.

    Orleans.Lattice.Caching.AzureBlob backs the Microsoft.Identity.Web distributed
    token cache with the per-region storage account, so a signed-in operator's
    token survives replica scale/restart and is shared across warm replicas.
  -->
  <ItemGroup>
    <PackageReference Include="Orleans.Lattice.Explorer.Web" Version="10.0.0" />
    <PackageReference Include="Orleans.Lattice.Explorer.Core" Version="10.0.0" />
    <PackageReference Include="Orleans.Lattice.Explorer.UI" Version="10.0.0" />
    <PackageReference Include="Orleans.Lattice.Explorer.Entra.Web" Version="10.0.0" />
    <PackageReference Include="Orleans.Lattice.Caching.AzureBlob" Version="10.0.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <!-- Shared reference-architecture hosting helpers (Front Door origin lock). -->
  <ItemGroup>
    <ProjectReference Include="..\Common\Orleans.Lattice.ReferenceArchitecture.Hosting.csproj" />
  </ItemGroup>

</Project>
