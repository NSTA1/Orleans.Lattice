<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Orleans.Lattice.ReferenceArchitecture.Mcp</RootNamespace>
    <AssemblyName>Orleans.Lattice.ReferenceArchitecture.Mcp</AssemblyName>
    <IsPackable>false</IsPackable>
    <!--
      InvariantGlobalization is enabled after the ordinal-only audit recorded in
      reference-architecture/hosts/README.md. This head is a stateless gRPC
      client + MCP transport; it performs no culture-sensitive comparison on any
      correctness-relevant path, so dropping ICU is safe and shrinks the image.
    -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Published Orleans.Lattice NuGet packages (nuget.org, the current released
    family-lockstep wave), NOT project references into src/.
    Orleans.Lattice.Api.Mcp brings the ModelContextProtocol server transport and
    the facade gRPC client packages (State / Auth / Data / Backup / Replication)
    transitively.
  -->
  <ItemGroup>
    <PackageReference Include="Orleans.Lattice.Api.Mcp" Version="9.8.0" />
    <PackageReference Include="Orleans.Lattice.Api.Mcp.Telemetry" Version="9.8.0" />
    <PackageReference Include="Orleans.Lattice.Api.Mcp.Telemetry.Azure" Version="9.8.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
  </ItemGroup>

  <!--
    Transitive security floors.

    A package's dependency floors are fixed when it is packed, and NuGet resolves
    a floor to the LOWEST version that satisfies it. So when a patch wave
    republishes the core or a facade client but not Api.Mcp, the floors Api.Mcp
    emits still name the unpatched versions, and without the pins below this head
    would restore the unpatched graph (issue #2413; the first case was the
    api.state.grpc lockout bypass fixed in the 9.6.2 wave). At 9.8.0 every pin
    equals the floor Api.Mcp 9.8.0 emits.

    These are deliberate version overrides, not new direct dependencies: the
    packages still arrive transitively via Api.Mcp exactly as documented above,
    and each pin only raises the resolved version to the patched release. Keep
    them and advance them with every wave: the 9.7.1 patch reached this head only
    through the Orleans.Lattice pin, because Api.Mcp 9.7.0 still floored it at
    9.7.0.
  -->
  <ItemGroup>
    <PackageReference Include="Orleans.Lattice" Version="9.8.0" />
    <PackageReference Include="Orleans.Lattice.Api.State.Grpc" Version="9.8.0" />
    <PackageReference Include="Orleans.Lattice.Api.Data.Grpc" Version="9.8.0" />
    <PackageReference Include="Orleans.Lattice.Api.Auth.Grpc" Version="9.8.0" />
    <PackageReference Include="Orleans.Lattice.Api.Backup.Grpc" Version="9.8.0" />
    <PackageReference Include="Orleans.Lattice.Api.Replication.Grpc" Version="9.8.0" />
    <PackageReference Include="Orleans.Lattice.Api.TreeAdmin.Grpc" Version="9.8.0" />
    <PackageReference Include="Orleans.Lattice.Api.Schema.Grpc" Version="9.8.0" />
    <PackageReference Include="Orleans.Lattice.Api.TenantAdmin.Grpc" Version="9.8.0" />
  </ItemGroup>

  <!-- Shared reference-architecture hosting helpers (Front Door origin lock). -->
  <ItemGroup>
    <ProjectReference Include="..\Common\Orleans.Lattice.ReferenceArchitecture.Hosting.csproj" />
  </ItemGroup>

</Project>
