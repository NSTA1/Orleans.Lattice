<?xml version="1.0" encoding="utf-8"?>
<!--
  Portable default NuGet configuration for the local-dev image builds.

  The local-dev heads reference the Orleans.Lattice.* libraries directly from
  src/** (project references), so those are NOT restored from a feed. The src
  projects do, however, depend on ordinary THIRD-PARTY packages (Microsoft.Orleans.*,
  Grpc.*, Azure.*, OpenTelemetry, etc.), and those must still be restored from a
  NuGet feed during the Docker build. This file points that restore at the public
  nuget.org feed, which is all a typical developer or CI needs.

  Behind a private/corporate feed (where public nuget.org is unreachable), do NOT
  edit this file. Instead point the build at your own NuGet.Config without changing
  anything tracked, by exporting NUGET_CONFIG_FILE before `docker compose build`:

      # PowerShell
      $env:NUGET_CONFIG_FILE = "$env:APPDATA\NuGet\NuGet.Config"
      docker compose build

  docker-compose.yml wires that path in as the BuildKit `nugetcfg` build secret,
  which the Dockerfiles copy over this default for the restore step only. The secret
  is never baked into an image layer.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
