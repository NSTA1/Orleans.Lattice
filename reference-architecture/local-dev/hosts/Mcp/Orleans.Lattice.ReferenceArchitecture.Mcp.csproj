<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Orleans.Lattice.ReferenceArchitecture.Mcp</RootNamespace>
    <AssemblyName>Orleans.Lattice.ReferenceArchitecture.Mcp</AssemblyName>
    <IsPackable>false</IsPackable>
    <!--
      InvariantGlobalization is enabled after the ordinal-only audit recorded in
      reference-architecture/hosts/README.md. This head is a stateless gRPC
      client + MCP transport; it performs no culture-sensitive comparison on any
      correctness-relevant path, so dropping ICU is safe and shrinks the image.
    -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    LOCAL-DEV VARIANT: PROJECT references into src/**, NOT the published
    Orleans.Lattice NuGet packages. Orleans.Lattice.Api.Mcp brings the
    ModelContextProtocol server transport and the facade gRPC client projects
    transitively; the two telemetry projects are referenced explicitly to mirror
    reference-architecture/hosts/Mcp.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\lattice.api.mcp\Orleans.Lattice.Api.Mcp.csproj" />
    <ProjectReference Include="..\..\..\..\src\lattice.api.mcp.telemetry\Orleans.Lattice.Api.Mcp.Telemetry.csproj" />
    <ProjectReference Include="..\..\..\..\src\lattice.api.mcp.telemetry.azure\Orleans.Lattice.Api.Mcp.Telemetry.Azure.csproj" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
  </ItemGroup>

  <!-- Shared reference-architecture hosting helpers (Front Door origin lock). -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\hosts\Common\Orleans.Lattice.ReferenceArchitecture.Hosting.csproj" />
  </ItemGroup>

</Project>
