# ---------------------------------------------------------------------------
# Local smoke-test harness environment - OPTIONAL OVERRIDES.
#
# Every value here already has a baked-in default in docker-compose.yml, so the
# harness runs with `docker compose up --build` and NO .env file. Copy this file
# to `.env` only to override a default:
#
#     cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# Every value here is a LOCAL DEV DEFAULT for the Azurite-backed single-region
# harness. NONE of these is a real secret and NONE of them is suitable for a
# deployed environment - in Azure the storage identity is a managed identity and
# the replication key comes from Key Vault.
# ---------------------------------------------------------------------------

# Azurite well-known emulator connection string. The account name and key below
# are the fixed, publicly-documented Azurite development credentials - they are
# NOT a secret and only ever address the local emulator container. Endpoints are
# addressed by the `azurite` compose service name.
STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;QueueEndpoint=http://azurite:10001/devstoreaccount1;TableEndpoint=http://azurite:10002/devstoreaccount1;

# Per-cluster replication key. DEV PLACEHOLDER ONLY. In Azure this is injected
# from Key Vault as LATTICE_REPLICATION_SECRET and is never stored in source,
# an image, or a compose file. A single-region local cluster has no peers, so
# the value is unused here beyond satisfying the shipper's configuration.
LATTICE_REPLICATION_SECRET=local-dev-only-not-a-real-secret
