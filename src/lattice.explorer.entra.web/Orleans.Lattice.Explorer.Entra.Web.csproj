<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Orleans.Lattice.Explorer.Entra.Web</RootNamespace>
    <PackageId>Orleans.Lattice.Explorer.Entra.Web</PackageId>
    <Version>10.2.0</Version>
    <Description>Microsoft Entra ID hosted-web (OpenID Connect) sign-in provider for the Orleans.Lattice Explorer web console. Wires ASP.NET Core OIDC (auth-code + PKCE) and a cookie session via Microsoft.Identity.Web, then acquires and silently refreshes a bearer token for an auth-enabled State API on behalf of the signed-in browser user - the flow the interactive MSAL provider (Orleans.Lattice.Explorer.Entra) cannot serve because a remote Blazor Server circuit has no local browser. Keeps the Microsoft.Identity.Web dependency out of the core explorer.</Description>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Explorer.Entra.Web.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\lattice.explorer\Core\Orleans.Lattice.Explorer.Core.csproj" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
    <!-- Floor the transitive dependency for GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
