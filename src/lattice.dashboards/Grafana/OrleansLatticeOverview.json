{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source scraping the orleans.lattice (and optionally orleans.lattice.replication) meter.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.3.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": {
    "list": [
      {
        "name": "Tree lifecycle",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "rgba(255, 96, 96, 1)",
        "expr": "sum by (kind) (increase(orleans_lattice_tree_lifecycle_total[5m]))",
        "titleFormat": "tree.lifecycle {{kind}}"
      }
    ]
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "orleans",
    "lattice",
    "overview"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "tree",
        "label": "Tree",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(orleans_lattice_shard_reads_total, tree)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "regex": "",
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(orleans_lattice_shard_reads_total, cluster)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "silo",
        "label": "Silo",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(orleans_lattice_shard_reads_total, instance)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Orleans.Lattice - Overview",
  "uid": "orleans-lattice-overview",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Cluster throughput (ops/s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "refId": "R",
          "expr": "sum(rate(orleans_lattice_shard_reads_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[1m]))",
          "legendFormat": "reads"
        },
        {
          "refId": "W",
          "expr": "sum(rate(orleans_lattice_shard_writes_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[1m]))",
          "legendFormat": "writes"
        }
      ]
    },
    {
      "id": 2,
      "title": "Per-tree write throughput",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tree) (rate(orleans_lattice_shard_writes_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[1m]))",
          "legendFormat": "{{tree}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Leaf write duration (p50/p95/p99 ms)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "P50",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(orleans_lattice_leaf_write_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "P95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(orleans_lattice_leaf_write_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "P99",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(orleans_lattice_leaf_write_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "title": "Leaf scan duration p95 by operation",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(orleans_lattice_leaf_scan_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Cache hit ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(orleans_lattice_cache_hits_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])) / clamp_min(sum(rate(orleans_lattice_cache_hits_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])) + sum(rate(orleans_lattice_cache_misses_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])), 1)",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "id": 6,
      "title": "Tombstone churn (ops/s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "C",
          "expr": "sum(rate(orleans_lattice_leaf_tombstones_created_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])) or vector(0)",
          "legendFormat": "created"
        },
        {
          "refId": "R",
          "expr": "sum(rate(orleans_lattice_leaf_tombstones_reaped_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])) or vector(0)",
          "legendFormat": "reaped"
        },
        {
          "refId": "X",
          "expr": "sum(rate(orleans_lattice_leaf_tombstones_expired_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])) or vector(0)",
          "legendFormat": "expired (ttl)"
        }
      ]
    },
    {
      "id": 7,
      "title": "Compaction duration p95 (ms)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(orleans_lattice_leaf_compaction_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 8,
      "title": "Splits committed (rate)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "splits/min"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "S",
          "expr": "sum by (tree) (rate(orleans_lattice_shard_splits_committed_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[10m])) * 60 or vector(0)",
          "legendFormat": "shard {{tree}}"
        },
        {
          "refId": "L",
          "expr": "sum by (tree) (rate(orleans_lattice_leaf_splits_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[10m])) * 60 or vector(0)",
          "legendFormat": "leaf {{tree}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Atomic write outcomes (rate)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(orleans_lattice_atomic_write_completed_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])) or vector(0)",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Coordinator completions (rate)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(orleans_lattice_coordinator_completed_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[10m])) or vector(0)",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "Events published (by kind)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(orleans_lattice_events_published_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])) or vector(0)",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "Events dropped (by reason)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(orleans_lattice_events_dropped_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])) or vector(0)",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 13,
      "title": "Tree lifecycle events (count over range)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 42
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (increase(orleans_lattice_tree_lifecycle_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[$__range])) or vector(0)",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 14,
      "title": "Runtime config changes (by config / tree)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 42
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tree, config) (increase(orleans_lattice_config_changed_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[$__range])) or vector(0)",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 15,
      "title": "Active shards (per tree)",
      "description": "Distinct shard count per tree over time, derived from observed orleans_lattice_shard_reads_total series. Respects the Tree / Cluster / Silo filters.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (tree) (count by (tree, shard) (orleans_lattice_shard_reads_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}))",
          "legendFormat": "{{tree}}"
        }
      ]
    },
    {
      "id": 16,
      "title": "Atomic write saga duration (p50/p95/p99 ms)",
      "description": "End-to-end SetManyAtomicAsync saga duration captured from Prepare to Completed. Reflects true wall-clock cost including any reminder-driven recovery time. Tag dimensions: tree, outcome.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 47
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "P50",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(orleans_lattice_atomic_write_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "P95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(orleans_lattice_atomic_write_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "P99",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(orleans_lattice_atomic_write_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 17,
      "title": "Atomic write batch size (p50/p95/p99 entries)",
      "description": "Entry count of each SetManyAtomicAsync saga at terminal transition. Pair with saga duration to detect distribution shifts in caller batch sizing.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 47
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "P50",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(orleans_lattice_atomic_write_batch_size_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "P95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(orleans_lattice_atomic_write_batch_size_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "P99",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(orleans_lattice_atomic_write_batch_size_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 18,
      "title": "Atomic write saga failure rate (%)",
      "description": "Fraction of terminal SetManyAtomicAsync sagas that did not reach the committed outcome. Sums failed + compensated rates and divides by the total terminal-transition rate. A non-zero floor here indicates either contention surfacing as compensation (possibly healthy) or surrogate failures (always investigate).",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 47
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "thresholdsStyle": { "mode": "line" }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "FAIL",
          "expr": "sum by (tree) (rate(orleans_lattice_atomic_write_completed_total{outcome=\"failed\",tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])) / clamp_min(sum by (tree) (rate(orleans_lattice_atomic_write_completed_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])), 1e-12)",
          "legendFormat": "{{tree}} failed"
        },
        {
          "refId": "COMP",
          "expr": "sum by (tree) (rate(orleans_lattice_atomic_write_completed_total{outcome=\"compensated\",tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])) / clamp_min(sum by (tree) (rate(orleans_lattice_atomic_write_completed_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])), 1e-12)",
          "legendFormat": "{{tree}} compensated"
        },
        {
          "refId": "TOTAL_FAIL",
          "expr": "sum by (tree) (rate(orleans_lattice_atomic_write_completed_total{outcome=~\"failed|compensated\",tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])) / clamp_min(sum by (tree) (rate(orleans_lattice_atomic_write_completed_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])), 1e-12)",
          "legendFormat": "{{tree}} non-committed"
        }
      ]
    },
    {
      "id": 19,
      "title": "Compaction pass duration p95 (ms, by trigger)",
      "description": "End-to-end RunCompactionPassAsync wall-clock duration split by trigger source: reminder-driven baseline passes, ratio/size policy-trigger passes, and operator-initiated passes. A divergence between trigger labels means policy passes are markedly cheaper or more expensive than baseline passes - investigate the policy thresholds.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 54 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, trigger) (rate(orleans_lattice_compaction_pass_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "{{trigger}} p95"
        }
      ]
    },
    {
      "id": 20,
      "title": "Compaction leaves visited (rate, by outcome)",
      "description": "Per-leaf compaction outcome rate: 'reaped' means at least one tombstone was physically removed, 'noop' means the leaf had pending tombstones that were still inside the grace window. A high noop:reaped ratio suggests TombstoneGracePeriod is too long for the workload's tombstone-to-write ratio.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 54 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tree, outcome) (rate(orleans_lattice_compaction_leaves_visited_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))",
          "legendFormat": "{{tree}} {{outcome}}"
        }
      ]
    },
    {
      "id": 21,
      "title": "Compaction shard retries / skips (rate)",
      "description": "Coordinator-level resilience signal. Retries indicate transient leaf-walk failures that the coordinator absorbed. Skips indicate shards the coordinator gave up on after exhausting retries - a non-zero skip rate is an alert-worthy condition.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 61 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "RETRIES",
          "expr": "sum by (tree) (rate(orleans_lattice_compaction_shard_retries_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))",
          "legendFormat": "{{tree}} retries"
        },
        {
          "refId": "SKIPS",
          "expr": "sum by (tree) (rate(orleans_lattice_compaction_shard_skipped_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))",
          "legendFormat": "{{tree}} skipped"
        }
      ]
    },
    {
      "id": 22,
      "title": "Leaf tombstone ratio p95",
      "description": "Distribution of tombstone-to-live-entry ratio sampled per mutation. The p95 is the headroom signal for MinTombstoneRatioForCompaction: when p95 trends above the configured threshold, the ratio policy will start firing out-of-cycle compaction passes.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 61 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "P95",
          "expr": "histogram_quantile(0.95, sum by (le, tree) (rate(orleans_lattice_leaf_tombstone_ratio_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "{{tree}} p95"
        }
      ]
    },
    {
      "id": 23,
      "title": "Storage footprint by tree",
      "description": "Byte-accurate retained footprint per tree, broken down by surface: WAL bytes, snapshot blob bytes, and summed leaf/shard-root state bytes. Sourced from the observable storage-usage gauges; a tree on an unsupported provider reports no data rather than a misleading zero.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 68 },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "WAL",
          "expr": "sum by (tree) (orleans_lattice_storage_wal_bytes{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"})",
          "legendFormat": "{{tree}} wal"
        },
        {
          "refId": "SNAP",
          "expr": "sum by (tree) (orleans_lattice_storage_snapshot_bytes{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"})",
          "legendFormat": "{{tree}} snapshot"
        },
        {
          "refId": "LEAF",
          "expr": "sum by (tree) (orleans_lattice_storage_leaf_state_bytes{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"})",
          "legendFormat": "{{tree}} leaf-state"
        }
      ]
    },
    {
      "id": 24,
      "title": "Cluster total retained bytes",
      "description": "Single stat summing orleans_lattice_storage_total_bytes across every tree and silo: the cluster-wide byte-accurate footprint of all Lattice storage surfaces.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 68 },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "TOTAL",
          "expr": "sum(orleans_lattice_storage_total_bytes{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"})",
          "legendFormat": "cluster total"
        }
      ]
    },
    {
      "id": 25,
      "title": "Trees over advisory threshold",
      "description": "Trees whose retained WAL bytes currently breach the advisory ceiling (LatticeOptions.WalMaxRetainedBytes). The 0/1 over_threshold gauge stays at 1 while a lagging consumer pins bytes the byte-pressure policy cannot safely reclaim - the breach is advisory and the durability invariant wins.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 68 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "OVER",
          "expr": "max by (tree) (orleans_lattice_storage_policy_over_threshold{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}) == 1",
          "legendFormat": "{{tree}}",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 26,
      "title": "Byte-pressure trim activity",
      "description": "Rate of advisory byte-pressure trim passes (policy.trim_triggered, reason=byte_pressure) and the WAL bytes those passes reclaimed (policy.bytes_reclaimed). A non-zero trigger rate with a flat reclaim rate means consumers are lagging and the bytes could not be safely freed.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 75 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "TRIG",
          "expr": "sum by (tree) (rate(orleans_lattice_storage_policy_trim_triggered_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))",
          "legendFormat": "{{tree}} triggered/s"
        },
        {
          "refId": "RECLAIM",
          "expr": "sum by (tree) (rate(orleans_lattice_storage_policy_bytes_reclaimed_bytes_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))",
          "legendFormat": "{{tree}} reclaimed bytes/s"
        }
      ]
    },
    {
      "id": 36,
      "title": "WAL compression savings ratio by tree",
      "description": "Fraction of encoded WAL payload bytes saved by the Azure Table provider's per-row compression, per tree: 1 - rate(stored_bytes) / rate(uncompressed_bytes). 0 means no saving (every row stored verbatim); higher is better. Reads as no data for a tree with no WAL append traffic in the window, since the ratio is undefined with no bytes. Pair with the skips-by-reason panel to the right to explain a low ratio.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 75 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "RATIO",
          "expr": "1 - sum by (tree) (rate(orleans_lattice_storage_wal_stored_bytes_bytes_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])) / sum by (tree) (rate(orleans_lattice_storage_wal_uncompressed_bytes_bytes_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))",
          "legendFormat": "{{tree}} savings"
        }
      ]
    },
    {
      "id": 37,
      "title": "WAL compression skips by reason",
      "description": "Rate of WAL rows the Azure Table provider stored verbatim instead of compressed, by reason: below_threshold (payload shorter than CompressionMinPayloadBytes), inflation_guard (compressing did not shrink it), or disabled (compression off). A low savings ratio dominated by below_threshold is the cue to lower CompressionMinPayloadBytes; one dominated by inflation_guard means the payloads are incompressible and lowering it would only burn CPU.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 75 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "SKIP",
          "expr": "sum by (tree, reason) (rate(orleans_lattice_storage_wal_compression_skipped_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))",
          "legendFormat": "{{tree}} {{reason}}"
        }
      ]
    },
    {
      "id": 27,
      "title": "GetAsync / GetManyAsync envelope p50 (ms)",
      "description": "Top-of-stack public-API read-call duration: get.duration is single-key GetAsync, get_many.duration is batched GetManyAsync. Pair with the cache hit-ratio panel above (cache.hits / cache.misses) to interpret in context - on a hot keyspace the LeafCacheGrain serves most reads in the tens-of-microseconds range; on a cache-miss-heavy workload the envelope grows by one cross-grain RPC into the primary leaf.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 82 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        { "refId": "G", "expr": "histogram_quantile(0.50, sum by (le) (rate(orleans_lattice_get_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "p50 GetAsync" },
        { "refId": "M", "expr": "histogram_quantile(0.50, sum by (le) (rate(orleans_lattice_get_many_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "p50 GetManyAsync" }
      ]
    },
    {
      "id": 28,
      "title": "GetAsync / GetManyAsync envelope p95 / p99 (ms)",
      "description": "p95 and p99 of the public-API read-call envelopes. The gap between p50 and p99 is the tail introduced by stale-routing retries, registry-snapshot retries, topology-version drift mid-fan-out, or LeafCacheGrain TTL-driven delta refreshes.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 82 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        { "refId": "G95", "expr": "histogram_quantile(0.95, sum by (le) (rate(orleans_lattice_get_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "p95 GetAsync" },
        { "refId": "G99", "expr": "histogram_quantile(0.99, sum by (le) (rate(orleans_lattice_get_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "p99 GetAsync" },
        { "refId": "M95", "expr": "histogram_quantile(0.95, sum by (le) (rate(orleans_lattice_get_many_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "p95 GetManyAsync" },
        { "refId": "M99", "expr": "histogram_quantile(0.99, sum by (le) (rate(orleans_lattice_get_many_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "p99 GetManyAsync" }
      ]
    },
    {
      "id": 29,
      "title": "GetAsync stage breakdown p95 (ms)",
      "description": "Per-stage sub-attribution inside LatticeGrain.GetAsync. get.stage.duration is tagged stage = route (per-attempt GetShardGrainAsync resolution) and stage = shard (per-attempt shard.GetAsync RPC including the cache-or-leaf read). Under a stale-routing storm both stages record multiple observations per envelope so the histograms attribute the retry cost.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 89 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(orleans_lattice_get_stage_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "p95 {{stage}}" }
      ]
    },
    {
      "id": 30,
      "title": "GetManyAsync stage breakdown p95 (ms)",
      "description": "Per-stage sub-attribution inside LatticeGrain.GetManyAsync. get_many.stage.duration is tagged stage in {route, bucket, fanout, merge}, isolating routing fetch, per-key shard bucketing, the cross-shard parallel fan-out (registry snapshot + Task.WhenAll), and the trailing topology / snap2 stability checks plus dictionary materialise.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 89 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(orleans_lattice_get_many_stage_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "p95 {{stage}}" }
      ]
    },
    {
      "id": 31,
      "title": "ExistsAsync / GetWithVersionAsync envelope p95 (ms)",
      "description": "Lower-traffic read surfaces: exists.duration (key-existence probe) and get_with_version.duration (versioned point read). GetWithVersionAsync bypasses the LeafCacheGrain by design - the returned HybridLogicalClock must reflect the primary leaf's authoritative ordering - so this envelope runs systematically higher than the cached GetAsync envelope above on the same key distribution. If that ordering inverts on a dashboard, treat it as a regression signal.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 96 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        { "refId": "E", "expr": "histogram_quantile(0.95, sum by (le) (rate(orleans_lattice_exists_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "p95 ExistsAsync" },
        { "refId": "V", "expr": "histogram_quantile(0.95, sum by (le) (rate(orleans_lattice_get_with_version_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "p95 GetWithVersionAsync" }
      ]
    },
    {
      "id": 32,
      "title": "WAL saturation regime - current state per tree",
      "description": "Step-plot of the per-tree WAL saturation state observable gauge (orleans.lattice.wal.saturation.state). Values: 0 = Healthy (normal traffic), 1 = Throttled (per-partition admission depth at-or-above WalSaturationThrottledRatio, default 0.75 - callers should slow down but appends still land), 2 = Saturated (admission cap reached with parked callers, OR recent dispatch-timeout trips OR provider-failure rate crossed the configured thresholds - callers should pause new appends). A sustained non-zero series is the leading-edge surface for the WAL back-pressure regime the silo cannot otherwise expose to operators without a live SSH session. Pair with the transition counters below for direction attribution.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 103 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 2,
          "custom": { "lineInterpolation": "stepAfter", "fillOpacity": 20 },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Healthy", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "Throttled", "color": "yellow" } } },
            { "type": "value", "options": { "2": { "text": "Saturated", "color": "red" } } }
          ]
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "max by (tree) (orleans_lattice_wal_saturation_state{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"})", "legendFormat": "{{tree}}" }
      ]
    },
    {
      "id": 33,
      "title": "WAL saturation regime - transition rate by direction (ops/s)",
      "description": "Per-direction transition rate on the orleans.lattice.wal.saturation.transitions counter, broken out by the new state tag. Each series shows how often the classifier flips into the named state per second. A rising rate of state=throttled is the leading edge of the saturation regime; state=saturated is the regime itself; state=healthy is the recovery edge. Flapping between Throttled and Saturated at a high frequency is a different operational signal from a sustained Saturated regime - the latter is the genuine cap, the former is the bursty per-partition WAL drain pattern (defended against by WalSaturationRecoveryWindow).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 103 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (tree, state) (rate(orleans_lattice_wal_saturation_transitions_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[$__rate_interval]))", "legendFormat": "{{tree}} -> {{state}}" }
      ]
    },
    {
      "id": 34,
      "title": "WAL saturation regime - per-partition attribution (heat-map)",
      "description": "Per-partition transition-rate heat-map on the orleans.lattice.wal.saturation.transitions counter, grouped by the partition tag. Identifies which underlying WAL partition is driving the regime when one partition's drain pattern dominates the tree's worst-case rollup. A solitary hot partition is the canonical pattern under the single-account 409-Conflict regime (the 409s back up against the partition the SDK chose; the others stay clear). A spread across every partition indicates a true cluster-wide cap saturation. Transitions without a partition tag (provider-failure-rate triggered, attributed by shard rather than partition) appear as the empty label series.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 110 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "targets": [
        { "refId": "A", "expr": "sum by (tree, partition) (rate(orleans_lattice_wal_saturation_transitions_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\",state=\"saturated\"}[$__rate_interval]))", "legendFormat": "{{tree}} partition={{partition}}" }
      ]
    },
    {
      "id": 35,
      "title": "WAL saturation regime - % time non-Healthy (1h)",
      "description": "Per-tree fraction of the last hour the tree spent in a non-Healthy regime (Throttled or Saturated), as a percentage. A one-tile KPI suitable for at-a-glance dashboards: 0% = the tree never left Healthy; 100% = the tree has been continuously back-pressured for the full hour. Intermediate values quantify how much of the operational hour the silo was telling callers to slow down. Uses avg_over_time on the state observable gauge (values 0/1/2 ordered as Healthy<Throttled<Saturated) divided by 2 to normalise to [0, 1] then multiplied by 100. Operationally: <5% is the steady-state target for a non-saturating workload; sustained values above ~20% are the cue to raise WalMaxPendingBatches, the storage account count (F-084), or the offered load.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 110 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "horizontal", "colorMode": "background" },
      "targets": [
        { "refId": "A", "expr": "max by (tree) (avg_over_time(orleans_lattice_wal_saturation_state{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[1h])) / 2 * 100", "legendFormat": "{{tree}}" }
      ]
    }
  ]
}