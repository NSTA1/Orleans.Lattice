{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source scraping the orleans.lattice.auth and orleans.lattice.membership meters.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.3.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": {
    "list": []
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "orleans",
    "lattice",
    "auth",
    "membership"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "tree",
        "label": "Tree",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(orleans_lattice_auth_decisions_total, tree)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "allValue": ".+",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "title": "Orleans.Lattice - Identity & Authorization",
  "uid": "orleans-lattice-authorization",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Authorization decisions (rate by effect)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "ALLOW",
          "expr": "sum by (effect) (rate(orleans_lattice_auth_decisions_total{tree=~\"$tree\"}[5m]))",
          "legendFormat": "{{effect}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Decisions by operation (rate)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "OP",
          "expr": "sum by (operation) (rate(orleans_lattice_auth_decisions_total{tree=~\"$tree\"}[5m]))",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Decision latency p50/p95/p99 (ms)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 7 },
      "fieldConfig": {
        "defaults": { "unit": "ms" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "P50",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(orleans_lattice_auth_decision_duration_milliseconds_bucket{tree=~\"$tree\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "P95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(orleans_lattice_auth_decision_duration_milliseconds_bucket{tree=~\"$tree\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "P99",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(orleans_lattice_auth_decision_duration_milliseconds_bucket{tree=~\"$tree\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "title": "Compiled snapshot rebuilds (rate)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 7 },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "REBUILD",
          "expr": "sum (rate(orleans_lattice_auth_snapshot_rebuilds_total[5m]))",
          "legendFormat": "rebuilds/s"
        }
      ]
    },
    {
      "id": 5,
      "title": "Compiled snapshot epoch",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": { "unit": "none" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "EPOCH",
          "expr": "max by (instance) (orleans_lattice_auth_snapshot_epoch)",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Compiled snapshot age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "AGE",
          "expr": "max by (instance) (orleans_lattice_auth_snapshot_age)",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Subject-resolution cache hit ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 21 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "RATIO",
          "expr": "sum(rate(orleans_lattice_membership_resolution_cache_hits_total[5m])) / clamp_min(sum(rate(orleans_lattice_membership_resolution_cache_hits_total[5m])) + sum(rate(orleans_lattice_membership_resolution_cache_misses_total[5m])), 1)",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "id": 8,
      "title": "Subject-resolution cache hits vs misses (rate)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 21 },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "HITS",
          "expr": "sum(rate(orleans_lattice_membership_resolution_cache_hits_total[5m]))",
          "legendFormat": "hits/s"
        },
        {
          "refId": "MISSES",
          "expr": "sum(rate(orleans_lattice_membership_resolution_cache_misses_total[5m]))",
          "legendFormat": "misses/s"
        }
      ]
    },
    {
      "id": 9,
      "title": "Members with policies configured (distinct subjects)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 28 },
      "fieldConfig": {
        "defaults": { "unit": "none" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "SUBJECTS",
          "expr": "max by (instance) (orleans_lattice_auth_snapshot_subjects)",
          "legendFormat": "{{instance}}"
        }
      ]
    }
  ]
}
