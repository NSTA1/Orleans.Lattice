{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source scraping the orleans.lattice meter.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.3.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": {
    "list": [
      {
        "name": "Atomic write outcomes",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "rgba(255, 96, 96, 1)",
        "expr": "sum by (outcome) (increase(orleans_lattice_atomic_write_completed_total{outcome=~\"failed|compensated\"}[5m]))",
        "titleFormat": "atomic_write {{outcome}}"
      }
    ]
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "orleans",
    "lattice",
    "atomic-writes"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "tree",
        "label": "Tree",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(orleans_lattice_atomic_write_completed_total, tree)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "regex": "",
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(orleans_lattice_atomic_write_completed_total, cluster)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "silo",
        "label": "Silo",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(orleans_lattice_atomic_write_completed_total, instance)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Orleans.Lattice - Atomic Writes",
  "uid": "orleans-lattice-atomic-writes",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Atomic write outcomes (rate)",
      "description": "Terminal SetManyAtomicAsync saga transitions per second by outcome. 'committed' = all writes applied; 'compensated' = rolled back via LWW; 'failed' = post-compensation surrogate failure.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "stacking": { "mode": "normal", "group": "A" },
            "spanNulls": true
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "committed" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "compensated" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }]
          },
          {
            "matcher": { "id": "byName", "options": "failed" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(orleans_lattice_atomic_write_completed_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])) or vector(0)",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Saga failure rate (%)",
      "description": "Fraction of terminal sagas that did not commit. Sums failed + compensated rates and divides by the total terminal-transition rate. Threshold lines at 1% (yellow) and 5% (red). A non-zero floor here indicates either contention surfacing as compensation (possibly healthy in a high-conflict workload) or surrogate failures (always investigate).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "thresholdsStyle": { "mode": "line+area" }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "FAIL",
          "expr": "sum (rate(orleans_lattice_atomic_write_completed_total{outcome=\"failed\",tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])) / clamp_min(sum (rate(orleans_lattice_atomic_write_completed_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])), 1e-12)",
          "legendFormat": "failed"
        },
        {
          "refId": "COMP",
          "expr": "sum (rate(orleans_lattice_atomic_write_completed_total{outcome=\"compensated\",tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])) / clamp_min(sum (rate(orleans_lattice_atomic_write_completed_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])), 1e-12)",
          "legendFormat": "compensated"
        },
        {
          "refId": "TOTAL",
          "expr": "sum (rate(orleans_lattice_atomic_write_completed_total{outcome=~\"failed|compensated\",tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])) / clamp_min(sum (rate(orleans_lattice_atomic_write_completed_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])), 1e-12)",
          "legendFormat": "non-committed"
        }
      ]
    },
    {
      "id": 3,
      "title": "Saga duration (p50/p95/p99 ms)",
      "description": "End-to-end SetManyAtomicAsync saga duration captured from Prepare to Completed. Persisted across reminder-driven recovery so the recorded ms reflects true wall-clock cost (including any time the saga was suspended across silo restarts).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "P50",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(orleans_lattice_atomic_write_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "P95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(orleans_lattice_atomic_write_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "P99",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(orleans_lattice_atomic_write_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "title": "Saga duration p95 by outcome (ms)",
      "description": "Saga duration p95 broken out by terminal outcome. Compensated/failed sagas should generally be slower than committed (extra work on the rollback path); a flip in this relationship can indicate fast-failing sagas masking real saturation.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(orleans_lattice_atomic_write_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Batch size (p50/p95/p99 entries)",
      "description": "Entry count of each saga at terminal transition. Lets operators correlate p99 saga duration with batch size and detect distribution shifts in caller batch sizing.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "P50",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(orleans_lattice_atomic_write_batch_size_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "P95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(orleans_lattice_atomic_write_batch_size_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "P99",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(orleans_lattice_atomic_write_batch_size_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 6,
      "title": "Batch size p95 by outcome (entries)",
      "description": "Saga batch-size p95 broken out by terminal outcome. A sustained gap (e.g. compensated sagas systematically larger than committed sagas) suggests size-correlated contention that may benefit from caller-side batch splitting.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(orleans_lattice_atomic_write_batch_size_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Per-tree saga throughput (committed)",
      "description": "Committed sagas per second per tree. Use as the denominator when correlating per-tree latency tails with per-tree load.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tree) (rate(orleans_lattice_atomic_write_completed_total{outcome=\"committed\",tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])) or vector(0)",
          "legendFormat": "{{tree}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Non-committed saga count (range)",
      "description": "Total number of sagas that did NOT reach the committed terminal outcome over the dashboard time range. A standalone counter - distinct from the rate panel - for at-a-glance visibility into the absolute scale of failure / compensation activity.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 100 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(orleans_lattice_atomic_write_completed_total{outcome=~\"failed|compensated\",tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[$__range])) or vector(0)",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 100,
      "title": "Saga phase durations p95 (ms) - prepare / decision / broadcast / checkpoint / reminder",
      "description": "Per-phase saga latency breakdown. Sum of phase p95s approximates the total saga p95; outliers identify which phase is binding under load.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "targets": [
        { "refId": "P", "expr": "histogram_quantile(0.95, sum by (le) (rate(orleans_lattice_saga_prepare_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "prepare" },
        { "refId": "D", "expr": "histogram_quantile(0.95, sum by (le) (rate(orleans_lattice_saga_terminal_decision_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "decision" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(orleans_lattice_saga_broadcast_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "broadcast" },
        { "refId": "C", "expr": "histogram_quantile(0.95, sum by (le) (rate(orleans_lattice_saga_checkpoint_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "checkpoint" },
        { "refId": "R", "expr": "histogram_quantile(0.95, sum by (le, phase) (rate(orleans_lattice_saga_reminder_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "reminder {{phase}}" }
      ]
    },
    {
      "id": 101,
      "title": "Saga broadcast sub-attribution p95 (ms) - per-shard / per-leaf / per-shard-stage",
      "description": "Inside the broadcast phase: per-shard fan-out cost (saga.broadcast.shard.duration), per-leaf within a shard (saga.broadcast.leaf.duration), and per-shard-stage breakdown (saga.broadcast.shard.stage.duration tagged stage). Identifies whether broadcast latency is shard-fanout-bound, per-leaf-RPC-bound, or stage-of-shard bound.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 40 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "targets": [
        { "refId": "S", "expr": "histogram_quantile(0.95, sum by (le) (rate(orleans_lattice_saga_broadcast_shard_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "per-shard" },
        { "refId": "L", "expr": "histogram_quantile(0.95, sum by (le) (rate(orleans_lattice_saga_broadcast_leaf_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "per-leaf" },
        { "refId": "T", "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(orleans_lattice_saga_broadcast_shard_stage_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "stage {{stage}}" }
      ]
    },
    {
      "id": 102,
      "title": "Per-key saga work - p95 per-key duration vs serial-gap wait (ms)",
      "description": "saga.perkey.duration: per-key work inside the saga loop. saga.wait.serial_gap: time the saga sat idle between per-key operations. A growing serial_gap relative to perkey.duration indicates the saga is queue-bound rather than work-bound.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        { "refId": "K", "expr": "histogram_quantile(0.95, sum by (le) (rate(orleans_lattice_saga_perkey_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "p95 perkey.duration" },
        { "refId": "W", "expr": "histogram_quantile(0.95, sum by (le) (rate(orleans_lattice_saga_wait_serial_gap_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "p95 wait.serial_gap" }
      ]
    },
    {
      "id": 103,
      "title": "Saga fan-out size (entries per saga)",
      "description": "Distribution of how many entries each saga touches. Pairs with saga.broadcast.shard.duration to identify whether broadcast cost scales linearly with fan-out.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "P50", "expr": "histogram_quantile(0.50, sum by (le) (rate(orleans_lattice_saga_fanout_size_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "p50" },
        { "refId": "P95", "expr": "histogram_quantile(0.95, sum by (le) (rate(orleans_lattice_saga_fanout_size_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "p95" },
        { "refId": "P99", "expr": "histogram_quantile(0.99, sum by (le) (rate(orleans_lattice_saga_fanout_size_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "p99" }
      ]
    }
  ]
}
