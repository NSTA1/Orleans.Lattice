{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source scraping the orleans.lattice (and optionally orleans.lattice.replication) meter.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.3.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": {
    "list": []
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "orleans",
    "lattice",
    "replication"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "tree",
        "label": "Tree",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(orleans_lattice_replication_wal_entries_appended_total, tree)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "allValue": ".+",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      },
      {
        "name": "peer",
        "label": "Peer",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(orleans_lattice_replication_peer_entries_behind, peer)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "allValue": ".+",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(orleans_lattice_replication_wal_entries_appended_total, cluster)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "allValue": ".*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      },
      {
        "name": "silo",
        "label": "Silo",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(orleans_lattice_replication_wal_entries_appended_total, instance)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "allValue": ".+",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "title": "Orleans.Lattice - Replication",
  "uid": "orleans-lattice-replication",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Ship duration p50/p95/p99 (ms)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "P50",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(orleans_lattice_replication_ship_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "P95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(orleans_lattice_replication_ship_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "P99",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(orleans_lattice_replication_ship_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 2,
      "title": "Apply duration p50/p95/p99 (ms)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "P50",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(orleans_lattice_replication_apply_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "P95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(orleans_lattice_replication_apply_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "P99",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(orleans_lattice_replication_apply_duration_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "title": "Apply lag p50/p95/p99 (ms)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "P50",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(orleans_lattice_replication_apply_lag_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "P95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(orleans_lattice_replication_apply_lag_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "P99",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(orleans_lattice_replication_apply_lag_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "title": "Dependency wait p95 (ms) - causal-consistency staging",
      "description": "Wait time for entries parked in the causal-apply buffer awaiting dependency satisfaction. Only emits samples when causal staging is enabled AND at least one entry parks. Flat-zero (no series) is the healthy steady state - the 'or vector(0)' guard renders zero rather than 'No data'.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(orleans_lattice_replication_apply_dependency_wait_ms_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 5,
      "title": "WAL throughput (ops/s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(orleans_lattice_replication_wal_entries_appended_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))",
          "legendFormat": "appended"
        },
        {
          "refId": "S",
          "expr": "sum(rate(orleans_lattice_replication_wal_entries_shipped_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))",
          "legendFormat": "shipped"
        },
        {
          "refId": "T",
          "expr": "sum(rate(orleans_lattice_wal_entries_trimmed_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))",
          "legendFormat": "trimmed"
        }
      ]
    },
    {
      "id": 6,
      "title": "Dead-letter queue churn (ops/s)",
      "description": "Dead-letter enqueue/removal rate. Only emits when permanent transport or apply failures occur. Flat-zero is the healthy steady state.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "E",
          "expr": "sum(rate(orleans_lattice_replication_dead_letter_enqueued_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])) or vector(0)",
          "legendFormat": "enqueued"
        },
        {
          "refId": "R",
          "expr": "sum by (reason) (rate(orleans_lattice_replication_dead_letter_removed_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])) or vector(0)",
          "legendFormat": "removed {{reason}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Apply correctness violations (rate)",
      "description": "FIFO and causal-violation counters. A sustained nonzero rate indicates a real correctness regression. Flat-zero is required for a healthy cluster.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "F",
          "expr": "sum(rate(orleans_lattice_replication_apply_fifo_violations_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])) or vector(0)",
          "legendFormat": "fifo violations"
        },
        {
          "refId": "C",
          "expr": "sum(rate(orleans_lattice_replication_apply_causal_violations_blocked_total{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])) or vector(0)",
          "legendFormat": "causal violations blocked"
        }
      ]
    },
    {
      "id": 8,
      "title": "Peer fell-off-log events (count over range)",
      "description": "Receiver fell-off-log detections per peer. Nonzero means the receiver's high-water-mark is older than the sender's oldest WAL entry - i.e. the receiver missed the catch-up window. Flat-zero is the healthy steady state.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (peer) (increase(orleans_lattice_replication_peer_fell_off_log_total{peer=~\"$peer\",cluster=~\"$cluster\",instance=~\"$silo\"}[$__range]))",
          "legendFormat": "{{peer}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Apply buffer (entries)",
      "description": "Causal-apply buffer occupancy in entries. Only emits when causal staging parks an entry. Flat-zero (or absent) means no causal staging is engaged. When non-zero, see the apply-lag overlay panel for the bistability signal. The matching bytes panel is rendered to the right of this one.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tree) (orleans_lattice_replication_apply_buffered_entries{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}) or vector(0)",
          "legendFormat": "{{tree}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Per-peer entries behind",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (peer) (orleans_lattice_replication_peer_entries_behind{peer=~\"$peer\",cluster=~\"$cluster\",instance=~\"$silo\"})",
          "legendFormat": "{{peer}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "Per-peer last outbound ship (seconds ago)",
      "description": "Wall-clock seconds since the local sender last successfully shipped a batch (or an empty liveness probe) to the named peer. Filters on direction=outbound; the inbound twin panel renders the receiver-side timeline.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 42
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (peer) (orleans_lattice_replication_peer_last_contact_seconds{peer=~\"$peer\",cluster=~\"$cluster\",instance=~\"$silo\",direction=\"outbound\"})",
          "legendFormat": "{{peer}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "Per-peer consecutive errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 42
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (peer, direction) (orleans_lattice_replication_peer_consecutive_errors{peer=~\"$peer\",cluster=~\"$cluster\",instance=~\"$silo\"})",
          "legendFormat": "{{peer}} ({{direction}})"
        }
      ]
    },
    {
      "id": 13,
      "title": "Apply lag p99 vs apply-buffer depth (causal-staging bistability overlay)",
      "description": "Overlays apply-lag p99 (left axis, ms) against the causal-apply buffer occupancy (right axis, entries). The bistability hypothesis: once the buffer crosses ~N entries, apply-lag p99 stays pegged at a high level for the rest of the window even as the buffer eventually drains. If only the lag panel renders (buffer flat-zero), causal staging is not engaged and the bistability is in a different layer (e.g. shipper backpressure, sender-side WAL). Use this panel as the first stop when the lag-p99 sweep shows wide run-to-run variance.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 49
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "BUF" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.axisLabel", "value": "buffered entries" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "LAG99" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } },
              { "id": "custom.axisLabel", "value": "apply-lag p99 (ms)" }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "LAG99",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(orleans_lattice_replication_apply_lag_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)",
          "legendFormat": "apply-lag p99"
        },
        {
          "refId": "BUF",
          "expr": "sum (orleans_lattice_replication_apply_buffered_entries{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}) or vector(0)",
          "legendFormat": "buffered entries"
        }
      ]
    },
    {
      "id": 18,
      "title": "Apply buffer (bytes)",
      "description": "Causal-apply buffer occupancy in bytes. Tracks the same lifecycle as the entries panel to its left at byte granularity. Together they bound the buffer against CausalBufferMaxEntries and CausalBufferMaxBytes. Flat-zero (or absent) means no causal staging is engaged.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tree) (orleans_lattice_replication_apply_buffer_bytes{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}) or vector(0)",
          "legendFormat": "{{tree}}"
        }
      ]
    },
    {
      "id": 19,
      "title": "Per-peer bytes behind",
      "description": "Cumulative WAL payload bytes the local sender has yet to ship to each peer. Companion to the per-peer entries-behind panel to the left.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (peer) (orleans_lattice_replication_peer_bytes_behind_bytes{peer=~\"$peer\",cluster=~\"$cluster\",instance=~\"$silo\"})",
          "legendFormat": "{{peer}}"
        }
      ]
    },
    {
      "id": 20,
      "title": "Per-peer last inbound apply (seconds ago)",
      "description": "Wall-clock seconds since the local receiver last successfully applied a batch authored by the named peer. Filters on direction=inbound; symmetric twin of the outbound ship panel.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 49
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (peer) (orleans_lattice_replication_peer_last_contact_seconds{peer=~\"$peer\",cluster=~\"$cluster\",instance=~\"$silo\",direction=\"inbound\"})",
          "legendFormat": "{{peer}}"
        }
      ]
    },
    {
      "id": 21,
      "title": "Per-peer negotiated wire version",
      "description": "Framing wire version the local sender has negotiated as the target for the named peer (min(localCurrent, peerAdvertised), or the unknown-peer floor until the peer advertises). Capability/telemetry only - the sender does not yet re-encode at this version (see follow-up issue).",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 57
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (tree, peer) (orleans_lattice_replication_wire_version_negotiated{tree=~\"$tree\",peer=~\"$peer\",cluster=~\"$cluster\",instance=~\"$silo\"})",
          "legendFormat": "{{tree}} / {{peer}}"
        }
      ]
    },
    {
      "id": 22,
      "title": "Per-peer wire-version downgrade active (1 = mixed-version fleet)",
      "description": "1 when the negotiated target version is strictly below the sender's current wire version (a mixed-version fleet during a rolling upgrade), else 0. Telemetry only - reflects the negotiated target, not an actual re-encode.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 57
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (tree, peer) (orleans_lattice_replication_wire_version_downgrade_active{tree=~\"$tree\",peer=~\"$peer\",cluster=~\"$cluster\",instance=~\"$silo\"})",
          "legendFormat": "{{tree}} / {{peer}}"
        }
      ]
    },
    {
      "id": 23,
      "title": "Anti-entropy digest-probe comparisons (rate, by outcome)",
      "description": "Per-shard digest comparisons performed by the anti-entropy probe scheduler, by outcome (match / mismatch / version_skew / remote_unavailable). Dark/opt-in: zero unless DigestProbeEnabled is set.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 64
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(orleans_lattice_replication_digest_probe_compared_total{tree=~\"$tree\",peer=~\"$peer\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 24,
      "title": "Anti-entropy digest divergence (mismatch rate)",
      "description": "Per-shard digest comparisons whose versions matched but hashes differed - the local cluster and the named peer have diverged for that shard. Pair with the comparisons panel to compute the divergence ratio. Dark/opt-in.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 64
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (peer) (rate(orleans_lattice_replication_digest_probe_mismatch_total{tree=~\"$tree\",peer=~\"$peer\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))",
          "legendFormat": "{{peer}}"
        }
      ]
    },
    {
      "id": 25,
      "title": "Redundant payload re-send rate",
      "description": "Rate of byte-identical content re-sets the shipper observed while content-hash dedup measurement is enabled (ContentHashDedupEnabled). 'entries/s' counts redundant Set entries; 'bytes/s' is the value bytes they carried. Flat-zero unless the workload re-sets identical values for a key. Observability-only - the shipper never elides or reorders bytes on the wire.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 71
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "BYTES" },
            "properties": [
              { "id": "unit", "value": "binBps" },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.axisLabel", "value": "redundant bytes/s" }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "ENTRIES",
          "expr": "sum by (tree, peer) (rate(orleans_lattice_replication_ship_redundant_payloads_total{tree=~\"$tree\",peer=~\"$peer\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])) or vector(0)",
          "legendFormat": "entries/s {{tree}}/{{peer}}"
        },
        {
          "refId": "BYTES",
          "expr": "sum by (tree, peer) (rate(orleans_lattice_replication_ship_redundant_payload_bytes_total{tree=~\"$tree\",peer=~\"$peer\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m])) or vector(0)",
          "legendFormat": "bytes/s {{tree}}/{{peer}}"
        }
      ]
    },
    {
      "id": 26,
      "title": "Effective ship batch size (adaptive)",
      "description": "Per-tick outbound batch cap the shipper actually used, distribution p50/p95/p99. With adaptive sizing off (AdaptiveBatchSizingEnabled=false, the default) this sits flat at the configured ShipBatchSize; with it on, the AIMD controller raises it toward ShipBatchSize on a healthy link and backs it off on rising ack latency or send errors. The receiver flow-control hint is always the hard ceiling.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 56 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(orleans_lattice_replication_ship_effective_batch_size_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(orleans_lattice_replication_ship_effective_batch_size_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(orleans_lattice_replication_ship_effective_batch_size_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "p99" }
      ]
    },
    {
      "id": 27,
      "title": "Ship ack latency p50/p95/p99 (ms)",
      "description": "Round-trip latency from sending a batch to receiving its ack, per (tree, peer). This is the primary signal the adaptive batch-size controller reacts to: a sustained rise above AdaptiveBatchLatencyThreshold shrinks the effective batch size. Emitted on every acknowledged batch regardless of whether adaptive sizing is enabled.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 56 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(orleans_lattice_replication_ship_ack_latency_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(orleans_lattice_replication_ship_ack_latency_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(orleans_lattice_replication_ship_ack_latency_milliseconds_bucket{tree=~\"$tree\",cluster=~\"$cluster\",instance=~\"$silo\"}[5m]))) or vector(0)", "legendFormat": "p99" }
      ]
    },
    {
      "id": 28,
      "title": "Merkle-walk leaves localised (rate)",
      "description": "Rate of diverging leaves the read-only anti-entropy Merkle walk narrowed a shard mismatch down to. Opt-in via MerkleWalkEnabled; stays zero unless a range-answering probe transport is wired up.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 78
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tree) (rate(orleans_lattice_replication_merkle_walk_localised_total{cluster=~\"$cluster\",instance=~\"$silo\"}[$__rate_interval]))",
          "legendFormat": "{{tree}}"
        }
      ]
    },
    {
      "id": 29,
      "title": "Merkle-walk aborted (rate by reason)",
      "description": "Rate of read-only Merkle-walk passes that stopped before localising, split by reason (depth_cap, byte_budget, remote_unavailable, version_skew). With the default transport every triggered walk reports remote_unavailable.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 78
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(orleans_lattice_replication_merkle_walk_aborted_total{cluster=~\"$cluster\",instance=~\"$silo\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ]
    }
  ]
}
