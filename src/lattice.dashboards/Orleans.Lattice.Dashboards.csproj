<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Orleans.Lattice.Dashboards</PackageId>
    <Version>9.8.0</Version>
    <Description>Pre-built Grafana dashboards and provisioning templates for Orleans.Lattice telemetry. Bundles ready-to-import JSON dashboards covering the orleans.lattice, orleans.lattice.replication, orleans.lattice.replication.grpc, orleans.lattice.auth, orleans.lattice.membership, orleans.lattice.backup, orleans.lattice.scaling, and orleans.lattice.tenancy meters.</Description>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
    <PackageTags>orleans;lattice;observability;grafana;opentelemetry;prometheus;dashboards</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Grafana\*.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Provisioning\*.yaml" Pack="true" PackagePath="contentFiles\any\any\Provisioning\;content\Provisioning\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Dashboards.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\lattice\Orleans.Lattice.csproj" />
  </ItemGroup>

</Project>
