<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Orleans.Lattice.Api.Mcp.Telemetry.Azure</PackageId>
    <Version>9.5.0</Version>
    <Description>Azure managed-identity backend-token provider for the transport-neutral Orleans.Lattice.Api.Telemetry facade. Supplies a rotating Entra (Azure AD) access token to the telemetry proxy's DynamicBearer auth mode so any telemetry binding - the MCP cluster-telemetry tools, or a client head hosting the facade directly - can query an Azure Monitor managed-Prometheus endpoint, acquiring and caching the token from a caller-supplied Azure.Core TokenCredential and refreshing it before expiry with a single shared in-flight acquisition. Keeps the Azure identity dependency out of the core telemetry package and takes no dependency on the MCP server surface.</Description>
    <PackageProjectUrl>https://github.com/NSTA1/Orleans.Lattice</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NSTA1/Orleans.Lattice</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Api.Mcp.Telemetry.Azure.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The ITelemetryBackendTokenProvider seam this package implements lives in the
      transport-neutral Orleans.Lattice.Api.Telemetry facade (issue #1756), so this
      package references that facade directly rather than inheriting it transitively
      through the MCP binding. A client head that wants the Azure backend token must
      not have to drag in the MCP server surface (and its ModelContextProtocol
      dependency) to get it - which is the whole reason the hoist happened.
      AzureTelemetryPackageGraphTests pins this.
    -->
    <ProjectReference Include="..\lattice.api.telemetry\Orleans.Lattice.Api.Telemetry.csproj" />
    <PackageReference Include="Azure.Core" Version="1.62.0" />
  </ItemGroup>

</Project>
