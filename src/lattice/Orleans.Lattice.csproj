<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Orleans.Lattice</PackageId>
    <Version>5.1.0</Version>
    <Description>Distributed B+ tree implementation (with CRDT primitives) for Microsoft Orleans.</Description>
    <PackageProjectUrl>https://github.com/NSTA1/Orleans.Lattice</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NSTA1/Orleans.Lattice</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <!--
    Opt-in diagnostic instrumentation. When LatticeDiag=true is supplied
    (e.g. `dotnet build /p:LatticeDiag=true`), the LATTICE_DIAG compile
    symbol is defined and every `#if LATTICE_DIAG` block in this project
    is compiled in. Off by default: production / CI builds compile every
    DIAG site out, with no runtime cost. The instrumentation is kept in
    source so future investigations can re-enable it without re-deriving
    the trace shape.
  -->
  <PropertyGroup Condition="'$(LatticeDiag)' == 'true'">
    <DefineConstants>$(DefineConstants);LATTICE_DIAG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Tests" />
    <InternalsVisibleTo Include="Orleans.Lattice.Replication" />
    <InternalsVisibleTo Include="Orleans.Lattice.Replication.Tests" />
    <InternalsVisibleTo Include="Orleans.Lattice.Benchmark.Microbench" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Reminders" Version="10.1.0" />
    <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.1.0" />
    <PackageReference Include="Microsoft.Orleans.Streaming" Version="10.1.0" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.8" />
  </ItemGroup>

</Project>
