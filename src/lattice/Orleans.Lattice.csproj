<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Orleans.Lattice</PackageId>
    <Version>7.8.0</Version>
    <Description>Distributed B+ tree implementation (with CRDT primitives) for Microsoft Orleans.</Description>
    <PackageProjectUrl>https://github.com/NSTA1/Orleans.Lattice</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NSTA1/Orleans.Lattice</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <!--
    Opt-in diagnostic instrumentation. When LatticeDiag=true is supplied
    (e.g. `dotnet build /p:LatticeDiag=true`), the LATTICE_DIAG compile
    symbol is defined and every `#if LATTICE_DIAG` block in this project
    is compiled in. Off by default: production / CI builds compile every
    DIAG site out, with no runtime cost. The instrumentation is kept in
    source so future investigations can re-enable it without re-deriving
    the trace shape.
  -->
  <PropertyGroup Condition="'$(LatticeDiag)' == 'true'">
    <DefineConstants>$(DefineConstants);LATTICE_DIAG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    LATTICE0001 is the custom diagnostic id raised by the [Obsolete] forwarder
    on IWalShardGrain.GetEntryCountAsync. Orleans' source-generated grain
    proxy mechanically implements every interface method, including the
    obsolete one, and the generated file is outside our control. We suppress
    LATTICE0001 project-wide because our own callers raise the diagnostic too
    (via the forwarder body); the matching test sites use #pragma to keep the
    suppression scoped where it matters. CS0618 from any *other* obsolete API
    remains active.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);LATTICE0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Tests" />
    <InternalsVisibleTo Include="Orleans.Lattice.Replication" />
    <InternalsVisibleTo Include="Orleans.Lattice.Replication.Tests" />
    <InternalsVisibleTo Include="Orleans.Lattice.Auth" />
    <InternalsVisibleTo Include="Orleans.Lattice.Api.State" />
    <InternalsVisibleTo Include="Orleans.Lattice.Api.State.Tests" />
    <InternalsVisibleTo Include="Orleans.Lattice.Api.State.Grpc.Tests" />
    <InternalsVisibleTo Include="Orleans.Lattice.Api.Data.Tests" />
    <InternalsVisibleTo Include="Orleans.Lattice.Api.Data.Grpc.Tests" />
    <InternalsVisibleTo Include="Orleans.Lattice.Api.Auth" />
    <InternalsVisibleTo Include="Orleans.Lattice.Api.Auth.Tests" />
    <InternalsVisibleTo Include="Orleans.Lattice.Storage.AzureTable" />
    <InternalsVisibleTo Include="Orleans.Lattice.Storage.AzureTable.Tests" />
    <InternalsVisibleTo Include="Orleans.Lattice.Benchmark.Microbench" />
    <InternalsVisibleTo Include="Orleans.Lattice.Benchmark.LeafCacheGrowth" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Reminders" Version="10.2.0" />
    <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.2.0" />
    <PackageReference Include="Microsoft.Orleans.Streaming" Version="10.2.0" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.9" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

</Project>
