<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Orleans.Lattice.Api.Mcp.RepoContext</PackageId>
    <Version>8.0.0</Version>
    <Description>Optional, opt-in repository-context add-on for Orleans.Lattice.Api.Mcp. Gives an AI agent a durable, conflict-free place to capture and maintain detailed context about a codebase - structural facts, notes, and short-lived working memory - served as MCP tools over dedicated Lattice trees. Reuses the Api.Mcp fail-closed credential bridge, authorization gate, and permission-scoped tool discovery. Registered with AddRepoContextTools() alongside AddLatticeMcp(...)/MapLatticeMcp().</Description>
    <PackageProjectUrl>https://github.com/NSTA1/Orleans.Lattice</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NSTA1/Orleans.Lattice</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <!-- Pin the patched Microsoft.Bcl.Memory to override the vulnerable 9.0.4 that
         Microsoft.ML.Tokenizers 2.0.0 pulls transitively (NU1903, GHSA-73j8-2gch-69rq). -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.11" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.0" />
    <PackageReference Include="Microsoft.Orleans.Reminders" Version="10.2.2" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Api.Mcp.RepoContext.Tests" />
    <!-- The multi-cluster companion package enrols the internal RepoContextTrees
         names/layout into replication; sharing internals keeps repo-context's
         public surface minimal rather than promoting the tree-name map to public. -->
    <InternalsVisibleTo Include="Orleans.Lattice.Api.Mcp.RepoContext.Replication" />
    <InternalsVisibleTo Include="Orleans.Lattice.Api.Mcp.RepoContext.Replication.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\lattice\Orleans.Lattice.csproj" />
    <ProjectReference Include="..\lattice.api.mcp\Orleans.Lattice.Api.Mcp.csproj" />
    <ProjectReference Include="..\lattice.vector\Orleans.Lattice.Vector.csproj" />
  </ItemGroup>

</Project>
