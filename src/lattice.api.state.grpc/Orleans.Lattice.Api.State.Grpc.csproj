<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Orleans.Lattice.Api.State.Grpc</PackageId>
    <Version>9.5.0</Version>
    <Description>gRPC transport binding for Orleans.Lattice.Api.State. Exposes the read-only cluster state API (discovery, tree structure, entry inspection) as unary gRPC RPCs over a code-first, Orleans-serialized contract, with a pluggable authorization seam and a default-deny posture. Registered with AddLatticeStateApiGrpc(...) and mapped with MapLatticeStateApiGrpc().</Description>
    <PackageProjectUrl>https://github.com/NSTA1/Orleans.Lattice</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NSTA1/Orleans.Lattice</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Api.State.Grpc.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\lattice.api.abstractions\Orleans.Lattice.Api.Abstractions.csproj" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.83.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.83.0" />
  </ItemGroup>

</Project>
