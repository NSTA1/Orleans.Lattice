<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Orleans.Lattice.Backup</PackageId>
    <Version>9.8.0</Version>
    <Description>Backup and restore add-on for Orleans.Lattice. Provides the backup catalog, manifest and set model, full and incremental capture, restore and revert orchestration, retention pruning, scheduling, health tracking, metrics, and the pluggable ILatticeBackupSink seam for in-cluster or durable external storage.</Description>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Backup.Tests" />
    <InternalsVisibleTo Include="Orleans.Lattice.Api.Backup" />
    <InternalsVisibleTo Include="Orleans.Lattice.Api.Backup.Grpc" />
    <InternalsVisibleTo Include="Orleans.Lattice.Api.Backup.Tests" />
    <InternalsVisibleTo Include="Orleans.Lattice.Api.Backup.Grpc.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\lattice\Orleans.Lattice.csproj" />
    <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.2.2" />
  </ItemGroup>

</Project>
