<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Orleans.Lattice.Schema</PackageId>
    <Version>9.7.0</Version>
    <Description>Schema add-on for Orleans.Lattice. Ships schema enforcement, envelope versioning, remediation dry-run and shadow-build support, dead-letter models, and the LatticeValueTransform value-to-value transform IR with client-side translation, server-side JSON evaluation, and an ILatticeValueTransform DI escape hatch.</Description>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Schema.Tests" />
    <InternalsVisibleTo Include="Orleans.Lattice.Api.Schema" />
    <InternalsVisibleTo Include="Orleans.Lattice.Api.Schema.Tests" />
    <InternalsVisibleTo Include="Orleans.Lattice.Api.Schema.Grpc" />
    <InternalsVisibleTo Include="Orleans.Lattice.Api.Schema.Grpc.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\lattice\Orleans.Lattice.csproj" />
    <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.2.2" />
  </ItemGroup>

</Project>
