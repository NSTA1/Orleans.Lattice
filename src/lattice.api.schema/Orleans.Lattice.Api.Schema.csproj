<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Orleans.Lattice.Api.Schema</PackageId>
    <Version>8.0.0</Version>
    <Description>Optional transport-agnostic control facade add-on for Orleans.Lattice schema management. Wraps the in-process schema admin surface (policy, versioning, remediation, and a read-only per-tree compliance audit) behind a single fail-closed control interface every transport binding (for example the gRPC surface) adapts over. Registered separately; adds no transport behaviour of its own.</Description>
    <PackageProjectUrl>https://github.com/NSTA1/Orleans.Lattice</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NSTA1/Orleans.Lattice</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Api.Schema.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\lattice\Orleans.Lattice.csproj" />
    <ProjectReference Include="..\lattice.api.abstractions\Orleans.Lattice.Api.Abstractions.csproj" />
    <ProjectReference Include="..\lattice.schema\Orleans.Lattice.Schema.csproj" />
    <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.2.0" />
  </ItemGroup>

</Project>
