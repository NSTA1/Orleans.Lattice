<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Orleans.Lattice.Api.Mcp</PackageId>
    <Version>8.0.8</Version>
    <Description>Model Context Protocol (MCP) server binding for Orleans.Lattice. Exposes the cluster's transport-agnostic API facades (state, data, backup, auth, replication) as MCP tools over the official ModelContextProtocol SDK, with permission-aware tool discovery, an authenticated fail-closed credential bridge, and a default-deny authorization posture. Registered with AddLatticeMcp(...) and mapped with MapLatticeMcp(); per-facade tool modules are opt-in via AddStateTools/AddDataTools/AddBackupTools/AddAuthTools/AddReplicationTools, and out-of-silo hosting is available via AddLatticeMcpRemote(...).</Description>
    <PackageProjectUrl>https://github.com/NSTA1/Orleans.Lattice</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NSTA1/Orleans.Lattice</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Api.Mcp.Tests" />
    <InternalsVisibleTo Include="Orleans.Lattice.Api.Mcp.Telemetry" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\lattice\Orleans.Lattice.csproj" />
    <ProjectReference Include="..\lattice.api.abstractions\Orleans.Lattice.Api.Abstractions.csproj" />
    <ProjectReference Include="..\lattice.api.state.grpc\Orleans.Lattice.Api.State.Grpc.csproj" />
    <ProjectReference Include="..\lattice.api.data.grpc\Orleans.Lattice.Api.Data.Grpc.csproj" />
    <ProjectReference Include="..\lattice.api.auth.grpc\Orleans.Lattice.Api.Auth.Grpc.csproj" />
    <ProjectReference Include="..\lattice.api.backup.grpc\Orleans.Lattice.Api.Backup.Grpc.csproj" />
    <ProjectReference Include="..\lattice.api.replication.grpc\Orleans.Lattice.Api.Replication.Grpc.csproj" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.1" />
    <PackageReference Include="Azure.Core" Version="1.44.1" />
  </ItemGroup>

</Project>
