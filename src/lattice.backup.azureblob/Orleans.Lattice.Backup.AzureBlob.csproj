<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Orleans.Lattice.Backup.AzureBlob</PackageId>
    <Version>9.8.0</Version>
    <Description>Azure Blob Storage ILatticeBackupSink for Orleans.Lattice.Backup. Persists backup manifests as block blobs and backup artifacts as append blobs of length-framed chunks (one blob per capture's artifact) in an Azure Storage container, so backups are durable off-cluster. Registered through DI in place of the in-cluster default sink; the capture and restore engines stay unaware of Azure specifics.</Description>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Backup.AzureBlob.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\lattice\Orleans.Lattice.csproj" />
    <ProjectReference Include="..\lattice.backup\Orleans.Lattice.Backup.csproj" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
  </ItemGroup>

</Project>
