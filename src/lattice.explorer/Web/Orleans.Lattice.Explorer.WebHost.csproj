<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Orleans.Lattice.Explorer.WebHost</RootNamespace>
    <AssemblyName>Orleans.Lattice.Explorer.WebHost</AssemblyName>
    <IsPackable>false</IsPackable>
    <!--
      The Explorer's Razor components (the App root and its interactive server
      render mode) live in the referenced Orleans.Lattice.Explorer.Web hosting
      library, not this host project, so the SDK does not auto-detect that this
      app hosts Blazor and omits the framework's _framework/blazor.web.js script,
      leaving the console rendered but non-interactive. Opting in explicitly pulls
      the Blazor Web script into this app's static web assets so the interactive
      circuit starts. Consumers of the hosting package get this automatically via
      the package's build/Orleans.Lattice.Explorer.Web.props.
    -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebHosting\Orleans.Lattice.Explorer.Web.csproj" />
  </ItemGroup>

</Project>
