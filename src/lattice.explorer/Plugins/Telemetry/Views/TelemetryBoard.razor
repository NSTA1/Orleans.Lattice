@*
    The whole telemetry body: the panel a caller selected, the bounded controls
    that shape it, the scope the facade actually served it under, and the chart.

    This component is the reason the area plugin and the My Tenant metrics
    section are not two implementations. Both mount this; they differ only in the
    workspace handed to them, and the tenant-pinned one is pinned in the
    workspace rather than by a different view. So there is exactly one place
    where a panel is composed, one place a scope caption is rendered, and no
    chance of the two surfaces disagreeing about what the effective scope was.

    It renders nothing about quota or usage: that is the My Tenant Quota
    surface's job and duplicating it here would put two answers to the same
    question in one area.
*@

<div class="lxt-board">
    @if (State.Unavailable)
    {
        @*
            No telemetry backend on this cluster, so there is nothing to chart.
            The shell hides an unavailable area's rail entry and collects its
            label into the "why can I not see everything?" affordance, so this is
            the second half of the same answer: it explains what a backend is and
            what its absence means, for anyone who reached the body anyway
            (a direct address, or an embedded mount with no rail above it).
        *@
        <TelemetryStateBlock Message="UnavailableMessage" Class="lxt-muted" />
        <LatticeHelp Id="@TelemetryVocabulary.BackendId"
                     Term="@TelemetryVocabulary.Backend.Label"
                     Explanation="@TelemetryVocabulary.Backend.Explanation" />
    }
    else if (!State.Allowed)
    {
        @*
            A refusal, and the kind is picked rather than defaulted: an
            unauthenticated connection is recoverable by signing in and is
            announced assertively because it is actionable now, where a refusal
            of a signed-in caller is a polite status naming the grant they lack.
        *@
        <div role="@(State.AuthenticationRequired ? "alert" : "status")">
            <TelemetryStateBlock Message="RefusedMessage" Class="lxt-status is-denied" />
        </div>
    }
    else if (State.Catalog.IsEmpty)
    {
        <div role="status">
            <TelemetryStateBlock Message="EmptyMessage" Class="lxt-muted" />
        </div>
        <LatticeHelp Id="@TelemetryVocabulary.MetricCatalogId"
                     Term="@TelemetryVocabulary.MetricCatalog.Label"
                     Explanation="@TelemetryVocabulary.MetricCatalog.Explanation" />
    }
    else
    {
        <TelemetryControls State="State" />

        @if (State.Notice is { } notice)
        {
            <div class="lxt-status @notice.Severity" role="status">
                <p class="lxt-status-message">@notice.Message</p>
                @if (notice.Guidance is { } guidance)
                {
                    <p class="lxt-status-guidance">@guidance</p>
                }
                @if (notice.IsRetryable)
                {
                    <button type="button"
                            class="lx-btn lxt-retry"
                            disabled="@State.Busy"
                            @onclick="State.ReevaluateAsync">Try again</button>
                }
            </div>
        }

        @if (State.Selected is { } query)
        {
            <section class="lxt-panel-body" aria-label="@query.Title">
                <header class="lxt-panel-head">
                    <h3 class="lxt-panel-title">@query.Title</h3>
                    @*
                        The caption used to sit in a title attribute, which a
                        keyboard or touch caller can never reach. The badge is
                        the short form, the caption its accessible expansion, and
                        the term itself is explained by the disclosure beside it.
                    *@
                    <span class="lxt-badge @ScopeBadgeClass">
                        <span aria-hidden="true">@ScopeBadge</span>
                        <span class="lx-visually-hidden">@State.Caption.Text</span>
                    </span>
                    <LatticeHelp Id="@TelemetryVocabulary.ScopeId"
                                 Term="@TelemetryVocabulary.Scope.Label"
                                 Explanation="@TelemetryVocabulary.Scope.Explanation" />
                </header>

                <p class="lxt-panel-description">@query.Description</p>

                <TelemetryScopeBanner Caption="State.Caption" />

                <TelemetryChartView Chart="State.Chart"
                                    Label="@query.Title"
                                    EmptyText="@EmptyText" />

                @if (State.SelectedInstruments is { } instruments)
                {
                    <p class="lxt-muted lxt-instruments">Reads @instruments.</p>
                }
            </section>
        }
    }
</div>

@code {
    private const string DegradedBadgeClass = "is-warn";
    private const string ScopedBadgeClass = "is-ok";
    private const string NotEvaluatedText = "Nothing has been read yet.";
    private const string NoSeriesText = "This query matched no series over the window requested.";

    /// <summary>
    /// The grant a refused caller is missing, named as the cluster names it, so
    /// a refusal points at the permission rather than at the area label the
    /// caller can already see.
    /// </summary>
    private const string MissingTelemetryGrant = "Telemetry";

    // Frozen singletons from the shared copy, so a board that renders one of
    // these on every gate change composes nothing.
    private static readonly ExplorerStateMessage Unavailable =
        ExplorerStateCopy.Unavailable(ExplorerSubjects.TelemetrySignals);

    private static readonly ExplorerStateMessage Empty =
        ExplorerStateCopy.Empty(ExplorerSubjects.TelemetrySignals);

    private static readonly ExplorerStateMessage SignInRequired =
        ExplorerStateCopy.SignInRequired(ExplorerSubjects.TelemetrySignals);

    private static readonly ExplorerStateMessage NotPermitted =
        ExplorerStateCopy.NotPermitted(ExplorerSubjects.TelemetrySignals, MissingTelemetryGrant);

    /// <summary>The workspace this board reads and drives.</summary>
    [Parameter, EditorRequired] public TelemetryWorkspace State { get; set; } = default!;

    private static ExplorerStateMessage UnavailableMessage => Unavailable;

    private static ExplorerStateMessage EmptyMessage => Empty;

    private ExplorerStateMessage RefusedMessage =>
        State.AuthenticationRequired ? SignInRequired : NotPermitted;

    // A degraded scope is styled as a qualification rather than sharing the
    // confident styling of a scope that was served exactly as asked.
    private string ScopeBadgeClass => State.WasDowngraded ? DegradedBadgeClass : ScopedBadgeClass;

    private string ScopeBadge => TelemetryScopeCaptions.BadgeFor(State.Scope, State.IsTenancyEnabled);

    // "Nothing matched" and "nothing has been read" are different facts, and a
    // panel that said the first before it had asked would be lying.
    private string EmptyText => State.HasEvaluated ? NoSeriesText : NotEvaluatedText;
}
