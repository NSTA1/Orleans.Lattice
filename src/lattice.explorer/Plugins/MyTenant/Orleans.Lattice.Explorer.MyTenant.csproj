<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      Assembly, root namespace, and package id are the same string, matching the
      Access and Backups plugin packages: a concrete plugin package is
      Orleans.Lattice.Explorer.<Area>, and only the shared tenancy seam beneath
      it carries the Tenancy name.
    -->
    <RootNamespace>Orleans.Lattice.Explorer.MyTenant</RootNamespace>
    <AssemblyName>Orleans.Lattice.Explorer.MyTenant</AssemblyName>
    <PackageId>Orleans.Lattice.Explorer.MyTenant</PackageId>
    <Version>9.4.0</Version>
    <Description>The My Tenant plugin for the Orleans.Lattice Explorer: the tenant admin's self-service area. Renders the tenant's own descriptor and status, its admin-subject membership, its consumption against each quota ceiling (unbounded, unmeasured, and measured kept distinct, and captioned with the scope the figures were enforced under), its region residency against the operator-authorized allowed set, and its own side of the two-step cross-tenant grant agreement. Scoped to the caller's active tenant throughout, so a tenant admin can never read or mutate another tenant through it. Registered with AddExplorerMyTenant() and AddExplorerMyTenantPlugin(); served by a referencing app at _content/Orleans.Lattice.Explorer.MyTenant.</Description>
    <PackageProjectUrl>https://github.com/NSTA1/Orleans.Lattice</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NSTA1/Orleans.Lattice</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Explorer.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <!--
    Deliberately narrower than the Backups and Access plugin projects: this one
    references no gRPC binding and no control-API contract at all. Everything it
    reaches the cluster with arrives through the shared tenancy seam's controlled
    domain model (ITenancyDomain), which is the whole of the epic's D3 for a
    tenancy surface. TenancyDomainSurfaceTests guards that the seam names no wire
    type, so this project cannot acquire one by accident.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Core\Orleans.Lattice.Explorer.Core.csproj" />
    <ProjectReference Include="..\..\DesignSystem\Orleans.Lattice.Explorer.DesignSystem.csproj" />
    <ProjectReference Include="..\Abstractions\Orleans.Lattice.Explorer.Plugins.Abstractions.csproj" />
    <ProjectReference Include="..\Tenancy\Orleans.Lattice.Explorer.Tenancy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
  </ItemGroup>

</Project>
