@implements IDisposable
@inject IExplorerPluginHostContextFactory HostContexts
@inject IExplorerPluginAccessStore AccessStore
@inject IServiceProvider Services

@*
    The My tenant plugin's panel: the surface the shell renders through
    DynamicComponent for this plugin.

    It reaches the cluster only through its declared domain contract
    (IMyTenantDomain), resolved for it by the host from its own plugin id, so it
    holds no connection, no channel, and no container (epic decision D3).

    Its six sub-surfaces are internal to the plugin and render through the design
    system's single tab primitive in its SUBORDINATE variant, so the fourth
    navigation tier reads as sitting below the rail that selected the area rather
    than competing with it. At compact the strip moves what will not fit into its
    overflow menu, which is what keeps a six-tab area usable on a phone without a
    single media query in this package (epic decision D7).

    The plugin's own gate decides whether any of it is reachable. A refusal is
    rendered from the four-state contract, never from a guess: an anonymous
    caller is told to sign in - the defect here was telling a signed-out visitor
    they held no authority over a tenant they never had - and an authenticated
    one is told which permission they are missing and who issues it. A deployment
    without the tenancy add-on renders nothing at all (D9).
*@

@if (AdaptiveContext is null)
{
    @*
        No shell above us has cascaded a breakpoint, so the plugin supplies its
        own adaptive root and stays usable at compact on its own. It yields the
        moment a shell provides one - the other branch renders no second root -
        so this is a fallback, never a competing owner of the viewport.
    *@
    <LatticeAdaptiveRoot Class="lxm-root">
        @_panel
    </LatticeAdaptiveRoot>
}
else
{
    @_panel
}

@code {
    /// <summary>
    /// The element-id prefix for the sub-surface strip and the panel it controls.
    /// A tab that names no panel leaves a screen-reader caller with nothing to
    /// move into, so the strip is always given one.
    /// </summary>
    private const string SurfaceStripId = "lxm-surfaces";

    // Composed once as a constant rather than per render: the strip re-renders on
    // every sub-surface activation.
    private const string SurfaceStripLabel = ExplorerVocabulary.MyTenantArea + " surfaces";

    private readonly Action _render;

    private MyTenantWorkspace _state = null!;
    private RenderFragment? _panel;

    /// <summary>Creates the panel, caching the delegate its state subscription marshals.</summary>
    public MyTenantPanel() =>
        // Bound once rather than per notification, so a load that raises several
        // changes does not allocate a delegate for each of them.
        _render = StateHasChanged;

    /// <summary>
    /// The breakpoint cascaded by a shell-provided adaptive root, when there is
    /// one. The plugin supplies its own root when this is absent.
    /// </summary>
    [CascadingParameter] public LatticeAdaptiveContext? AdaptiveContext { get; set; }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        // Materialised once at mount rather than per render: the panel
        // re-renders on every load, every gate change, and every breakpoint
        // change, and a fresh template on each would allocate on all of them.
        _panel = Panel;

        // Declared by the area itself rather than by a head, so a deployment
        // gains the key by rendering the area and the reset-view affordance
        // discloses and clears it with no further wiring. Registration is
        // idempotent by reference, and the catalog is resolved optionally so the
        // panel still renders in a host with no preference contract.
        (Services.GetService(typeof(IExplorerPreferenceCatalog)) as IExplorerPreferenceCatalog)
            ?.Register(MyTenantPluginKeys.SurfacePreference);

        // The host context is bound to this plugin's id, so GetDomain can only
        // ever hand back this plugin's declared contract: there is no parameter
        // through which the panel could name another plugin's domain.
        var context = HostContexts.Create(MyTenantPluginKeys.PluginId);
        _state = new MyTenantWorkspace(
            context.GetDomain<IMyTenantDomain>(),
            AccessStore,
            Services.GetService(typeof(IExplorerShellPreferences)) as IExplorerShellPreferences,
            Services.GetService(typeof(IExplorerShellRouter)) as IExplorerShellRouter);
        _state.Changed += OnStateChanged;
        await _state.InitializeAsync();
    }

    private void OnStateChanged() => InvokeAsync(_render);

    /// <inheritdoc />
    public void Dispose()
    {
        if (_state is null)
        {
            return;
        }

        _state.Changed -= OnStateChanged;
        _state.Dispose();
    }

    private RenderFragment Panel => @<section class="lxm-panel" aria-label="@ExplorerVocabulary.MyTenantArea">
        @if (_state.Unavailable)
        {
            @*
                D9: no tenancy add-on here, so there is nothing to administer and
                nothing to explain away. The shell already hides an unavailable
                plugin's entry; this keeps the body empty if it is rendered
                anyway.
            *@
        }
        else
        {
            @if (_state.AccessMessage is { } refusal)
            {
                @*
                    One refusal shape for both unhappy states, driven by the
                    contract rather than by the surface's own guess. A sign-in
                    requirement is something to act on now, so it is assertive; a
                    denial is not.
                *@
                <div class="lxm-status is-denied"
                     role="@(_state.AuthenticationRequired ? "alert" : "status")">
                    <p class="lxm-status-message">@refusal.Headline</p>
                    <p class="lxm-status-guidance">@refusal.Explanation</p>
                    @if (_state.AccessRemedyText is { Length: > 0 } remedy)
                    {
                        <p class="lxm-status-guidance">
                            <strong>@refusal.RemedyLabel</strong> @remedy
                        </p>
                    }
                    @if (_state.AccessReason is { Length: > 0 } reason)
                    {
                        <p class="lxm-status-guidance">@reason</p>
                    }
                </div>
            }

            @if (_state.SurfaceRestoreNotice is { Length: > 0 } restoreNotice)
            {
                <p class="lxm-status" role="status">@restoreNotice</p>
            }

            @if (_state.LastNotice is { } notice)
            {
                <div class="lxm-status @notice.Severity" role="status">
                    <p class="lxm-status-message">@notice.Message</p>
                    @if (notice.Guidance is { } guidance)
                    {
                        <p class="lxm-status-guidance">@guidance</p>
                    }
                </div>
            }

            <LatticeAdaptiveTabs Tabs="MyTenantSurfaces.Tabs"
                                 ActiveId="@_state.ActiveSurfaceId"
                                 OnSelect="_state.SelectSurfaceAsync"
                                 Label="@SurfaceStripLabel"
                                 Variant="LatticeTabsVariant.Subordinate"
                                 Id="@SurfaceStripId"
                                 Class="lxm-tabs">
                <TrailingContent>
                    @*
                        The scope statement is a disclosure, not a hover hint: a
                        title attribute is unreachable by keyboard and by touch,
                        which is precisely the caller who most needs to be told
                        that every surface here is one tenant's.
                    *@
                    <span class="lxm-tenant-chip"
                          aria-describedby="@ActiveTenantHelpTarget">@(_state.TenantId ?? "no active tenant")</span>
                    <LatticeHelp Id="@ActiveTenantHelpId"
                                 Term="@ActiveTenantTerm.Label"
                                 Explanation="@ActiveTenantTerm.Explanation" />
                    @if (MyTenantSurfaces.TermFor(_state.ActiveSurfaceId) is { } term)
                    {
                        <LatticeHelp Id="@MyTenantSurfaces.HelpIdFor(_state.ActiveSurfaceId)"
                                     Term="@term.Label"
                                     Explanation="@term.Explanation" />
                    }
                    <button type="button" class="lx-btn lxm-refresh-action"
                            disabled="@(_state.Busy || !_state.Allowed)"
                            @onclick="_state.ReloadAsync">Refresh</button>
                </TrailingContent>
                <ChildContent>
                    @switch (_state.ActiveSurfaceId)
                    {
                        case MyTenantSurfaces.Members:
                            <MyTenantMembers State="_state" />
                            break;
                        case MyTenantSurfaces.Quota:
                            <MyTenantQuota State="_state" />
                            break;
                        case MyTenantSurfaces.Regions:
                            <MyTenantRegions State="_state" />
                            break;
                        case MyTenantSurfaces.Sharing:
                            <MyTenantSharing State="_state" />
                            break;
                        case MyTenantSurfaces.Metrics:
                            <MyTenantMetrics State="_state" />
                            break;
                        default:
                            <MyTenantOverview State="_state" />
                            break;
                    }
                </ChildContent>
            </LatticeAdaptiveTabs>
        }
    </section>;

    // Resolved once: the glossary probe is allocation-free but the composed
    // element id is not, and both are the same on every render.
    private const string ActiveTenantHelpId = "lxm-active-tenant";

    private static readonly string ActiveTenantHelpTarget =
        LatticeHelp.ExplanationElementId(ActiveTenantHelpId);

    private static readonly ExplorerTerm ActiveTenantTerm =
        ExplorerGlossary.Get(ExplorerTermIds.ActiveTenant);
}
