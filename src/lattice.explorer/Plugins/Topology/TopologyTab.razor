@inherits SelectionPluginViewBase
@inject ITopologySurface Surface
@inject IJSRuntime JS

@*
    The tree-topology surface: a load-coloured radial graph of the selected
    tree's shard roots and internal nodes. It reaches the cluster only through
    ITopologySurface - the single domain contract this plugin declares.

    The graph is an SVG with a viewBox, so it scales to whatever width it is
    given, down to a phone, with no width media query of its own. The toolbar
    wraps for the same reason (epic decision D7).
*@

<div class="lx-topology">
    <div class="lx-topology-toolbar">
        <button type="button"
                class="lx-btn"
                disabled="@_loading"
                @onclick="LoadAsync">
            @(_loading ? "Loading..." : "Refresh")
        </button>
        <label class="lx-topology-toggle">
            <input type="checkbox" checked="@_showLeaves" @onchange="OnToggleLeaves" />
            Show leaf nodes
        </label>
        @if (_canvasReady)
        {
            <button type="button" class="lx-btn lx-topology-reset" @onclick="ResetViewAsync">
                Reset view
            </button>
            <span class="lx-topology-hint">scroll to zoom, drag to pan</span>
        }
        @if (_truncated)
        {
            <span class="lx-topology-trunc">truncated</span>
            <LatticeHelp Term="Truncated graph"
                         Explanation="@TruncatedExplanation"
                         Class="lx-topology-trunc-help" />
        }
        <div class="lx-topology-legend" aria-hidden="true">
            <span class="lx-topology-legend-label">load</span>
            @for (var b = 0; b < TopologyLayout.LoadBuckets; b++)
            {
                <span class="lx-topo-swatch lx-topo-load-@b"></span>
            }
        </div>
    </div>

    @if (State is not null)
    {
        <SelectionStateView Message="State" OnAction="_reload" />
    }
    else
    {
        var graph = _graph!;
        <div class="lx-topology-canvas">
            @*
                role="group" rather than role="img": an image has no exposed
                descendants, and the expandable nodes below are real controls, so
                declaring the graph an image would hide every one of them from a
                screen reader while leaving them clickable with a mouse.
            *@
            <svg @ref="_svg"
                 class="lx-topo-svg"
                 viewBox="@_homeViewBox"
                 preserveAspectRatio="xMidYMid meet"
                 role="group" aria-label="Tree topology graph">
                @foreach (var edge in graph.Edges)
                {
                    var from = _points[edge.FromId];
                    var to = _points[edge.ToId];
                    <line class="lx-topo-edge"
                          x1="@F(from.X)" y1="@F(from.Y)"
                          x2="@F(to.X)" y2="@F(to.Y)" />
                }
                @foreach (var node in graph.Nodes)
                {
                    var expandable = node.Node.HasMoreChildren;
                    var visual = _visuals[node.Node.NodeId];
                    @*
                        An expandable node is a control, so it is a button that
                        the keyboard can reach and activate. It used to respond
                        to a click alone, which made the whole expansion path
                        mouse-only (WCAG SC 2.1.1). Its name, its transform and
                        its glyphs are all composed on the layout pass, never
                        here: this loop runs for every node on every render.
                    *@
                    <g class="lx-topo-node @(expandable ? "is-expandable" : null) @(node.Node.SplitInProgress ? "is-splitting" : null)"
                       transform="@visual.Transform"
                       role="@(expandable ? "button" : null)"
                       tabindex="@(expandable ? "0" : null)"
                       aria-label="@visual.Label"
                       @onclick="@(() => OnNodeClickAsync(node.Node))"
                       @onkeydown="@(args => OnNodeKeyDownAsync(args, node.Node))">
                        <title>@visual.Label</title>
                        <circle class="lx-topo-dot lx-topo-load-@node.LoadBucket" r="@F(RadialLayout.NodeRadius)" />
                        @visual.Glyphs
                    </g>
                }
            </svg>
        </div>
    }
</div>
