<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Orleans.Lattice.Explorer.Plugins.Topology</RootNamespace>
    <PackageId>Orleans.Lattice.Explorer.Plugins.Topology</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>9.4.0</Version>
    <Description>The tree-topology per-selection surface for the Orleans.Lattice Explorer, as a self-contained plugin: the load-coloured radial graph of a tree's shard roots and internal nodes, with lazy subtree expansion and pan / zoom. It reaches the cluster only through the ITopologySurface domain contract it declares, and ships its own scoped stylesheet and pan-zoom script.</Description>
    <PackageProjectUrl>https://github.com/NSTA1/Orleans.Lattice</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NSTA1/Orleans.Lattice</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Explorer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Selection\Orleans.Lattice.Explorer.Plugins.Selection.csproj" />
    <ProjectReference Include="..\..\DesignSystem\Orleans.Lattice.Explorer.DesignSystem.csproj" />
  </ItemGroup>

</Project>
