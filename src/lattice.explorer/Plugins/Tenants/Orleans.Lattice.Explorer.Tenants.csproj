<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      Package id, assembly name, and root namespace agree, matching the Access
      and Backups plugin packages: a concrete plugin package is
      Orleans.Lattice.Explorer.<Area>.
    -->
    <RootNamespace>Orleans.Lattice.Explorer.Tenants</RootNamespace>
    <PackageId>Orleans.Lattice.Explorer.Tenants</PackageId>
    <Version>9.4.0</Version>
    <Description>The Tenants plugin for the Orleans.Lattice Explorer: the platform-operator tenant-management area. Lists every tenant with its lifecycle state, default flag, and headline usage; drives create / suspend / resume / delete with explicit confirmation and the cascaded tree count; authors quota ceilings across every dimension, rendering unbounded and unmeasured as themselves rather than as zero; authorizes allowed regions and surfaces a still-resident revocation refusal specifically; and administers admin subjects and cross-tenant grants with each grant's lifecycle state made explicit. Gated to platform operators and reports unavailable on a cluster without the tenancy add-on. Registered with AddExplorerTenantsPlugin(); served by a referencing app at _content/Orleans.Lattice.Explorer.Tenants.</Description>
    <PackageProjectUrl>https://github.com/NSTA1/Orleans.Lattice</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NSTA1/Orleans.Lattice</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Explorer.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <!--
    The plugin reaches the cluster only through the shared tenancy seam's
    controlled domain model (ITenancyDomain), so it references that package and
    never a control-API wire type, a gRPC channel, or the cluster connection
    (epic decision D3). It takes the design system for the tokens, the
    breakpoint set, and the adaptive primitives, the plugin abstractions for the
    contract it registers through, and Explorer.Core for the platform-operator
    gate seam its registration guard inspects.

    It must never reference Orleans.Lattice.Explorer.UI: the dependency runs the
    other way round, from a head to a plugin.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Core\Orleans.Lattice.Explorer.Core.csproj" />
    <ProjectReference Include="..\..\DesignSystem\Orleans.Lattice.Explorer.DesignSystem.csproj" />
    <ProjectReference Include="..\Abstractions\Orleans.Lattice.Explorer.Plugins.Abstractions.csproj" />
    <ProjectReference Include="..\Tenancy\Orleans.Lattice.Explorer.Tenancy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
  </ItemGroup>

</Project>
