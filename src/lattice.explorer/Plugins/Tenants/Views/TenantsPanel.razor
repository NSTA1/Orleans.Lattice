@implements IDisposable
@inject IExplorerPluginHostContextFactory HostContexts
@inject IExplorerPluginAccessStore AccessStore
@inject IServiceProvider Services

@*
    The tenant administration plugin's panel: the surface the shell renders
    through DynamicComponent for this plugin.

    It reaches the cluster only through its declared domain contract
    (ITenancyDomain), resolved for it by the host from its own plugin id, so it
    holds no connection and no container (epic decision D3).

    Its four sub-surfaces - Overview, Quotas, Regions and Tenant access - are
    internal to the plugin and render through the design system's single tab
    primitive in its SUBORDINATE variant: the fourth navigation tier is
    deliberately the quietest control in the shell, so it reads as sitting below
    the rail that selected the area rather than competing with it. None of them
    repeats the area's own name; "Tenants" appeared in two adjacent tiers at once
    before this issue and is retired as a label.

    The plugin's own gate decides whether any of it is reachable. A refusal is
    rendered from the four-state contract, never from a guess: an anonymous
    caller is told to sign in, an authenticated one is told which permission they
    are missing and who issues it, and a cluster without the tenancy add-on says
    the surface does not exist here (epic decision D9).
*@

@if (AdaptiveContext is null)
{
    @*
        No shell above us has cascaded a breakpoint, so the plugin supplies its
        own adaptive root and stays usable at compact on its own. It yields the
        moment a shell provides one - the other branch renders no second root -
        so this is a fallback, never a competing owner of the viewport.
    *@
    <LatticeAdaptiveRoot Class="lxt-root">
        @_panel
    </LatticeAdaptiveRoot>
}
else
{
    @_panel
}

@code {
    /// <summary>
    /// The element-id prefix for the sub-surface strip and the panel it controls.
    /// A tab that names no panel leaves a screen-reader caller with nothing to
    /// move into, so the strip is always given one.
    /// </summary>
    private const string SurfaceStripId = "lxt-surfaces";

    private readonly Action _render;

    private TenantsWorkspace _state = null!;
    private RenderFragment? _panel;

    /// <summary>Creates the panel, caching the delegate its state subscription marshals.</summary>
    public TenantsPanel() =>
        // Bound once rather than per notification, so a load that raises several
        // changes does not allocate a delegate for each of them.
        _render = StateHasChanged;

    /// <summary>
    /// The breakpoint cascaded by a shell-provided adaptive root, when there is
    /// one. The plugin supplies its own root when this is absent.
    /// </summary>
    [CascadingParameter] public LatticeAdaptiveContext? AdaptiveContext { get; set; }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        // Materialised once at mount rather than per render: the panel
        // re-renders on every load, every gate change, and every breakpoint
        // change, and a fresh template on each would allocate on all of them.
        _panel = Panel;

        // Declared by the area itself rather than by a head, so a deployment
        // gains the key by rendering the area and the reset-view affordance
        // discloses and clears it with no further wiring. Registration is
        // idempotent by reference, and the catalog is resolved optionally so the
        // panel still renders in a host with no preference contract.
        (Services.GetService(typeof(IExplorerPreferenceCatalog)) as IExplorerPreferenceCatalog)
            ?.Register(TenantsPluginKeys.SurfacePreference);

        // The host context is bound to this plugin's id, so GetDomain can only
        // ever hand back this plugin's declared contract: there is no parameter
        // through which the panel could name another plugin's domain.
        var context = HostContexts.Create(TenantsPluginKeys.PluginId);
        _state = new TenantsWorkspace(
            context.GetDomain<ITenancyDomain>(),
            AccessStore,
            Services.GetService(typeof(IExplorerShellPreferences)) as IExplorerShellPreferences,
            Services.GetService(typeof(IExplorerShellRouter)) as IExplorerShellRouter);
        _state.Changed += OnStateChanged;
        await _state.InitializeAsync();
    }

    private void OnStateChanged() => InvokeAsync(_render);

    /// <inheritdoc />
    public void Dispose()
    {
        if (_state is null)
        {
            return;
        }

        _state.Changed -= OnStateChanged;
        _state.Dispose();
    }

    private RenderFragment Panel =>
        @<section class="lxt-panel" aria-label="@ExplorerVocabulary.TenantAdministrationArea">
        @if (_state.AccessMessage is { } refusal)
        {
            @*
                One refusal shape for all three unhappy states, driven by the
                contract rather than by the surface's own guess. A sign-in
                requirement is something to act on now, so it is assertive; a
                denial or an absent capability is not.
            *@
            <div class="lxt-status @_state.AccessStatusClass"
                 role="@(_state.AuthenticationRequired ? "alert" : "status")">
                <p class="lxt-status-headline">@refusal.Headline</p>
                <p class="lxt-status-detail">@refusal.Explanation</p>
                @if (_state.AccessRemedyText is { Length: > 0 } remedy)
                {
                    <p class="lxt-status-remedy">
                        <strong>@refusal.RemedyLabel</strong> @remedy
                    </p>
                }
                @if (_state.AccessReason is { Length: > 0 } reason)
                {
                    <p class="lxt-status-detail">@reason</p>
                }
            </div>
        }

        @if (!_state.Unavailable)
        {
            @if (_state.SurfaceRestoreNotice is { Length: > 0 } restoreNotice)
            {
                <p class="lxt-status" role="status">@restoreNotice</p>
            }

            @if (_state.LastMessage is { Length: > 0 } message)
            {
                <p class="lxt-status @_state.LastResultClass" role="status">@message</p>
            }

            <LatticeAdaptiveTabs Tabs="TenantsSurfaces.Tabs"
                                 ActiveId="@_state.ActiveSurfaceId"
                                 OnSelect="_state.SelectSurfaceAsync"
                                 Label="@SurfaceStripLabel"
                                 Variant="LatticeTabsVariant.Subordinate"
                                 Id="@SurfaceStripId"
                                 Class="lxt-surfaces">
                <TrailingContent>
                    @if (TenantsSurfaces.TermFor(_state.ActiveSurfaceId) is { } term)
                    {
                        <LatticeHelp Id="@TenantsSurfaces.HelpIdFor(_state.ActiveSurfaceId)"
                                     Term="@term.Label"
                                     Explanation="@term.Explanation" />
                    }
                    <button type="button" class="lx-btn lxt-refresh-action"
                            disabled="@(_state.Busy || !_state.Allowed)"
                            @onclick="_state.ReloadAsync">Refresh</button>
                </TrailingContent>
                <ChildContent>
                    @if (TenantsSurfaces.RequiresTenant(_state.ActiveSurfaceId) && _state.SelectedTenantId is null)
                    {
                        <p class="lxt-empty" role="status">
                            Select a tenant on the Overview surface to administer it.
                        </p>
                    }
                    else if (_state.ActiveSurfaceId == TenantsSurfaces.Quotas)
                    {
                        <TenantQuotaView State="_state" />
                    }
                    else if (_state.ActiveSurfaceId == TenantsSurfaces.Regions)
                    {
                        <TenantRegionView State="_state" />
                    }
                    else if (_state.ActiveSurfaceId == TenantsSurfaces.Access)
                    {
                        <TenantAccessView State="_state" />
                    }
                    else
                    {
                        <TenantListView State="_state" />
                    }
                </ChildContent>
            </LatticeAdaptiveTabs>

            <TenantConfirmDialog State="_state" />
        }
    </section>;

    // Composed once as a constant rather than per render: the strip re-renders on
    // every sub-surface activation.
    private const string SurfaceStripLabel =
        ExplorerVocabulary.TenantAdministrationArea + " surfaces";
}
