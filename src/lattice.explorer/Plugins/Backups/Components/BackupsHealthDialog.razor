@using System.Globalization

@*
    The backup-health diagnostics dialog: why a backup is not healthy, which
    artifacts are missing or mismatched, and a re-check that verifies the sink
    payload on demand.
*@

@if (Owner.HealthDialog is { } report)
{
    <div class="explorer-modal-backdrop" role="presentation">
        <div class="explorer-modal" role="dialog" aria-modal="true" aria-labelledby="explorer-health-title">
            <h3 id="explorer-health-title">Backup health</h3>
            <p>
                Backup <strong>@report.BackupId</strong> is
                <strong>@report.Status</strong>.
            </p>
            <p class="lx-backups-hint">@report.Explanation</p>
            @if (report.MissingArtifactIds.Count > 0)
            {
                <p><strong>Missing or uncommitted artifacts:</strong></p>
                <ul class="lx-backups-health-list">
                    @foreach (var id in report.MissingArtifactIds)
                    {
                        <li @key="id">@id</li>
                    }
                </ul>
            }
            @if (report.HashMismatchArtifactIds.Count > 0)
            {
                <p><strong>Content-hash mismatches:</strong></p>
                <ul class="lx-backups-health-list">
                    @foreach (var id in report.HashMismatchArtifactIds)
                    {
                        <li @key="id">@id</li>
                    }
                </ul>
            }
            <p class="lx-backups-hint">Last checked @report.CheckedAtUtc.UtcDateTime.ToString("u", CultureInfo.InvariantCulture).</p>
            <div class="explorer-modal-actions">
                <button type="button" class="explorer-btn explorer-btn-primary" disabled="@Owner.Busy"
                        @onclick="@(() => Owner.RecheckHealthAsync(report.BackupId))">Re-check now</button>
                <button type="button" class="explorer-btn" disabled="@Owner.Busy" @onclick="Owner.CloseHealthDialog">Close</button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>The Backups panel this dialog reads and drives.</summary>
    [Parameter, EditorRequired] public BackupsPanel Owner { get; set; } = default!;
}
