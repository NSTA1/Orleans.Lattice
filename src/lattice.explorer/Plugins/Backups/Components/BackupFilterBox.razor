@implements IDisposable

@*
    A debounced starts-with filter box for the Existing Backups filter row. Mirrors
    the Data tab's key-search box - a 600ms debounce, an Enter / blur commit, and a
    clear button - but fires for any prefix length and takes its placeholder from the
    caller so the same control can drive the Name and Created filters.
*@
<div class="lx-data-search-field">
    <input type="text" class="lx-data-search-input" placeholder="@Placeholder"
           disabled="@Disabled"
           value="@_value" @oninput="OnInput" @onkeyup="OnKeyUp" @onblur="OnBlurAsync" />
    @if (!string.IsNullOrEmpty(_value))
    {
        <button type="button" class="lx-data-search-clear" aria-label="Clear filter"
                disabled="@Disabled" @onclick="ClearAsync">&times;</button>
    }
</div>

@code {
    /// <summary>Placeholder text shown when the box is empty.</summary>
    [Parameter] public string Placeholder { get; set; } = string.Empty;

    /// <summary>Disables the box (and its clear button).</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>The prefix to seed the box with on first render, restoring a retained filter.</summary>
    [Parameter] public string InitialValue { get; set; } = string.Empty;

    /// <summary>Raised with the committed prefix whenever the filter should run.</summary>
    [Parameter] public EventCallback<string> OnFilter { get; set; }

    private string _value = string.Empty;
    private string _lastFiltered = string.Empty;
    private CancellationTokenSource? _debounceCts;

    private static readonly TimeSpan Debounce = TimeSpan.FromMilliseconds(600);

    protected override void OnInitialized()
    {
        _value = InitialValue ?? string.Empty;
        _lastFiltered = _value;
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        _value = e.Value?.ToString() ?? string.Empty;
        CancelDebounce();

        var cts = new CancellationTokenSource();
        _debounceCts = cts;
        try
        {
            await Task.Delay(Debounce, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await CommitAsync();
    }

    private async Task OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            CancelDebounce();
            await CommitAsync();
        }
    }

    private async Task OnBlurAsync()
    {
        CancelDebounce();
        await CommitAsync();
    }

    private async Task ClearAsync()
    {
        CancelDebounce();
        _value = string.Empty;
        await CommitAsync();
    }

    private async Task CommitAsync()
    {
        if (string.Equals(_value, _lastFiltered, StringComparison.Ordinal))
        {
            return;
        }

        _lastFiltered = _value;
        await OnFilter.InvokeAsync(_value);
    }

    private void CancelDebounce()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = null;
    }

    public void Dispose() => CancelDebounce();
}
