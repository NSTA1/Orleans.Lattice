<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Orleans.Lattice.Explorer.Plugins.DeadLetter</RootNamespace>
    <PackageId>Orleans.Lattice.Explorer.Plugins.DeadLetter</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>9.4.0</Version>
    <Description>The strict-mode dead-letter per-selection surface for the Orleans.Lattice Explorer, as a self-contained plugin: a read-only, cursor-paged inspection view of the entries a tree rejected, with a per-entry detail pane. It reaches the cluster only through the IDeadLetterSurface domain contract it declares, and ships its own scoped stylesheet.</Description>
    <PackageProjectUrl>https://github.com/NSTA1/Orleans.Lattice</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NSTA1/Orleans.Lattice</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Explorer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Selection\Orleans.Lattice.Explorer.Plugins.Selection.csproj" />
    <ProjectReference Include="..\..\DesignSystem\Orleans.Lattice.Explorer.DesignSystem.csproj" />
  </ItemGroup>

</Project>
