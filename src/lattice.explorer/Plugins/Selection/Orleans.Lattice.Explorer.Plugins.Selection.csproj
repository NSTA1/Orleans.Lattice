<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Orleans.Lattice.Explorer.Plugins.Selection</RootNamespace>
    <PackageId>Orleans.Lattice.Explorer.Plugins.Selection</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>9.4.0</Version>
    <Description>The shared kernel every Orleans.Lattice Explorer per-selection plugin builds on: the view base that carries the selected catalog entry and the cancellation token tied to a view's lifetime, the stable plugin ids the shipped surfaces are keyed under, the switcher a surface uses to hand off to a sibling surface, and the change-history guidance card. It carries no reader and no cluster client, so a plugin takes it without taking a data dependency.</Description>
    <PackageProjectUrl>https://github.com/NSTA1/Orleans.Lattice</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NSTA1/Orleans.Lattice</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Explorer.Tests" />
  </ItemGroup>

  <!--
    The kernel sees the catalog record a selection is and the plugin contract,
    and nothing else. It deliberately does NOT reference a feature package or a
    reader: a per-selection plugin reaches its data only through the domain
    contract it declares itself (epic decision D3), so nothing shared may hand
    one a way around that.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Core\Orleans.Lattice.Explorer.Core.csproj" />
    <ProjectReference Include="..\Abstractions\Orleans.Lattice.Explorer.Plugins.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
  </ItemGroup>

</Project>
