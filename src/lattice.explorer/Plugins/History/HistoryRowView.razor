@*
    One revision on the timeline: its kind, time and origin, then whichever body
    the row's render mode calls for - a value diff, retained metadata only, the
    CRDT members that changed, or a not-yet-durable live marker.
*@
<li class="explorer-history-row @HistoryFormat.RowClass(Row)">
    <div class="explorer-history-rowhead">
        <span class="explorer-history-kind explorer-history-kind-@HistoryFormat.KindClass(Row.Kind)">@HistoryFormat.KindLabel(Row.Kind)</span>
        @if (Row.IsLiveTail)
        {
            <span class="explorer-history-live-tag" title="Appended live from the change feed; metadata only, pending durable backfill.">live</span>
        }
        <span class="explorer-history-time" title="@HistoryFormat.FormatAbsolute(Row.Hlc)">@HistoryFormat.FormatRelative(Row.Hlc)</span>
        <span class="explorer-history-origin">@HistoryFormat.OriginLabel(Row.OriginClusterId)</span>
    </div>
    <div class="explorer-history-rowbody">
        @switch (Row.RenderMode)
        {
            case HistoryRowRenderMode.ValueDiff:
                if (Row.Value is { } rendered)
                {
                    @if (Row.Diff.Count > 0)
                    {
                        <pre class="explorer-history-diff">@foreach (var line in Row.Diff)
{<span class="explorer-history-diff-@HistoryFormat.DiffClass(line.Kind)">@HistoryFormat.DiffPrefix(line.Kind)@line.Text
</span>}</pre>
                    }
                    else
                    {
                        <pre class="explorer-history-value">@rendered.Content</pre>
                    }
                    @if (rendered.Note is not null)
                    {
                        <p class="explorer-history-note">@rendered.Note</p>
                    }
                }
                break;
            case HistoryRowRenderMode.MetadataOnly:
                <p class="explorer-history-metaonly">Values not retained - metadata only.</p>
                <dl class="explorer-history-meta">
                    <div><dt>Value hash</dt><dd>@HistoryFormat.FormatHash(Row.ValueHash)</dd></div>
                    <div><dt>Value length</dt><dd>@Row.ValueLength.ToString("N0") bytes</dd></div>
                </dl>
                break;
            case HistoryRowRenderMode.CrdtMembers:
                @if (Row.MemberChanges.Count > 0)
                {
                    <ul class="explorer-history-members">
                        @foreach (var member in Row.MemberChanges)
                        {
                            <li class="explorer-history-member explorer-history-member-@HistoryFormat.MemberClass(member.Kind)">
                                <span class="explorer-history-member-kind">@HistoryFormat.MemberLabel(member.Kind)</span>
                                <code class="explorer-history-member-element">@HistoryFormat.ElementText(member)</code>
                                <span class="explorer-history-member-replica">@member.ReplicaId (dot @member.Ordinal)</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="explorer-history-metaonly">CRDT delta not retained in full - member changes unavailable for this revision.</p>
                }
                break;
            case HistoryRowRenderMode.Delete:
                <p class="explorer-history-metaonly">Key deleted.</p>
                break;
            case HistoryRowRenderMode.RangeTombstone:
                <p class="explorer-history-metaonly">Swept by a range delete@(Row.EndKey is not null ? $" up to {Row.EndKey}" : string.Empty).</p>
                break;
            case HistoryRowRenderMode.LiveTail:
                <p class="explorer-history-metaonly explorer-history-livetail">
                    Live @HistoryFormat.KindLabel(Row.Kind)@(Row.EndKey is not null ? $" up to {Row.EndKey}" : string.Empty) - metadata only, pending durable backfill.
                </p>
                break;
        }
    </div>
</li>

@code {
    /// <summary>The revision this row renders.</summary>
    [Parameter]
    [EditorRequired]
    public HistoryRevisionRow Row { get; set; } = default!;
}
