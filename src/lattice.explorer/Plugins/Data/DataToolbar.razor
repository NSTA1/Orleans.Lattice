@*
    The scan controls: refresh, page size, cursor isolation, and the pager. All
    state lives on the parent; this component only renders and raises.
*@
<div class="explorer-data-toolbar">
    <button type="button" class="explorer-btn" disabled="@Loading" @onclick="OnRefresh">
        @(Loading ? "Loading..." : "Refresh")
    </button>

    <label class="explorer-data-pagesize">
        Page size
        <select disabled="@Loading" @onchange="OnPageSizeSelected">
            @foreach (var size in DataPaging.PageSizes)
            {
                <option value="@size" selected="@(size == PageSize)">@size</option>
            }
        </select>
    </label>

    <label class="explorer-data-scanmode">
        <input type="checkbox" disabled="@Loading"
               checked="@(ScanMode == EntryScanMode.Snapshot)" @onchange="OnScanModeToggled" />
        Consistent snapshot
        <span class="explorer-data-infoicon" tabindex="0" role="img"
              aria-label="Consistent snapshot scan mode explanation"
              title="Off (default): a live scan reads current data cheaply, so entries written after you start paging can appear on later pages. On: a consistent snapshot freezes the table at the moment you open the scan, so every page reflects one instant - at the cost of a heavier per-shard capture that can be shed while the table is very busy.">i</span>
    </label>

    <div class="explorer-data-pager">
        <button type="button" class="explorer-btn" disabled="@(Loading || !CanGoPrevious)" @onclick="OnPrevious">Prev</button>
        <span class="explorer-data-pagenum">Page @(PageIndex + 1)</span>
        <button type="button" class="explorer-btn" disabled="@(Loading || !CanGoNext)" @onclick="OnNext">Next</button>
    </div>
</div>

@code {
    /// <summary>Whether a scan is in flight; disables every control.</summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>The page size currently in effect.</summary>
    [Parameter] public int PageSize { get; set; } = DataPaging.DefaultPageSize;

    /// <summary>The cursor isolation currently in effect.</summary>
    [Parameter] public EntryScanMode ScanMode { get; set; } = EntryScanMode.Live;

    /// <summary>The zero-based index of the page in view.</summary>
    [Parameter] public int PageIndex { get; set; }

    /// <summary>Whether a previous (already-visited) page exists.</summary>
    [Parameter] public bool CanGoPrevious { get; set; }

    /// <summary>Whether a next page exists.</summary>
    [Parameter] public bool CanGoNext { get; set; }

    /// <summary>Invoked to reopen the scan from the first page.</summary>
    [Parameter] public EventCallback OnRefresh { get; set; }

    /// <summary>Invoked with the newly chosen page size.</summary>
    [Parameter] public EventCallback<int> OnPageSizeChanged { get; set; }

    /// <summary>Invoked with the newly chosen cursor isolation.</summary>
    [Parameter] public EventCallback<EntryScanMode> OnScanModeChanged { get; set; }

    /// <summary>Invoked to step back one page.</summary>
    [Parameter] public EventCallback OnPrevious { get; set; }

    /// <summary>Invoked to step forward one page.</summary>
    [Parameter] public EventCallback OnNext { get; set; }

    private Task OnPageSizeSelected(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out var size)
            ? OnPageSizeChanged.InvokeAsync(size)
            : Task.CompletedTask;

    private Task OnScanModeToggled(ChangeEventArgs e) =>
        OnScanModeChanged.InvokeAsync(e.Value is true ? EntryScanMode.Snapshot : EntryScanMode.Live);
}
