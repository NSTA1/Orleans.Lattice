<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Orleans.Lattice.Explorer.Plugins.Data</RootNamespace>
    <PackageId>Orleans.Lattice.Explorer.Plugins.Data</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>9.4.0</Version>
    <Description>The key and value drill-down per-selection surface for the Orleans.Lattice Explorer, as a self-contained plugin: a cursor-paged key browser with a starts-with key search, a tag-index filter, live-following value inspection, and decoded CRDT current state. It reaches the cluster only through the IDataSurface domain contract it declares, and hands off to the revision-timeline surface by plugin id rather than by referencing it.</Description>
    <PackageProjectUrl>https://github.com/NSTA1/Orleans.Lattice</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NSTA1/Orleans.Lattice</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Explorer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Selection\Orleans.Lattice.Explorer.Plugins.Selection.csproj" />
    <ProjectReference Include="..\..\DesignSystem\Orleans.Lattice.Explorer.DesignSystem.csproj" />
  </ItemGroup>

</Project>
