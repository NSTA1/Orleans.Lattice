@implements IDisposable

@*
    Key starts-with search box. Typing auto-runs a search (debounced) only once
    the prefix is longer than AutoScanMinLength; shorter prefixes hold the
    current result until an explicit commit (Enter, blur, or the clear button).
    A starts-with prefix maps to a cheap ranged seek over the sorted keys, so it
    is the only efficient server-side key filter offered.
*@
<div class="explorer-data-toolbar explorer-data-search">
    <div class="explorer-data-search-field">
        <input type="text" class="explorer-data-search-input" placeholder="Key starts with..."
               disabled="@Disabled"
               value="@_value" @oninput="OnInput" @onkeyup="OnKeyUp" @onblur="OnBlurAsync" />
        @if (!string.IsNullOrEmpty(_value))
        {
            <button type="button" class="explorer-data-search-clear" title="Clear search"
                    disabled="@(Loading || Disabled)" @onclick="ClearAsync">&times;</button>
        }
    </div>
    @if (Disabled)
    {
        <span class="explorer-data-search-hint">Key search is unavailable while a tag filter is active.</span>
    }
</div>

@code {
    /// <summary>Whether a scan is in flight; disables input and the clear button.</summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>
    /// Disables the box (and surfaces a hint) while a tag filter is active, since
    /// the state-API key range is ignored on a tag-filtered scan.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Raised with the committed prefix whenever a scan should run: a debounced
    /// auto-search past the length threshold, Enter, blur, or clear (empty).
    /// </summary>
    [Parameter] public EventCallback<string> OnSearch { get; set; }

    /// <summary>
    /// The prefix to seed the box with on first render, used to restore a
    /// retained search when the surface is mounted for a selection.
    /// </summary>
    [Parameter] public string InitialValue { get; set; } = string.Empty;

    private string _value = string.Empty;
    private string _lastSearched = string.Empty;
    private CancellationTokenSource? _debounceCts;

    // Auto-search only fires for prefixes strictly longer than this; shorter
    // prefixes keep the current page until the operator commits explicitly.
    private const int AutoScanMinLength = 4;
    private static readonly TimeSpan Debounce = TimeSpan.FromMilliseconds(600);

    protected override void OnInitialized()
    {
        // The component is re-created when the surface re-mounts on a selection
        // change, so seeding here restores that selection's retained search
        // without re-triggering it (the parent already scans with this prefix).
        _value = InitialValue ?? string.Empty;
        _lastSearched = _value;
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        _value = e.Value?.ToString() ?? string.Empty;
        CancelDebounce();

        if (_value.Length <= AutoScanMinLength)
        {
            return;
        }

        var cts = new CancellationTokenSource();
        _debounceCts = cts;
        try
        {
            await Task.Delay(Debounce, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await CommitAsync();
    }

    private async Task OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            CancelDebounce();
            await CommitAsync();
        }
    }

    private async Task OnBlurAsync()
    {
        CancelDebounce();
        await CommitAsync();
    }

    private async Task ClearAsync()
    {
        CancelDebounce();
        _value = string.Empty;
        await CommitAsync();
    }

    // Runs a search only when the prefix actually changed since the last one, so
    // a blur or Enter right after a debounced search does not re-scan needlessly.
    private async Task CommitAsync()
    {
        if (string.Equals(_value, _lastSearched, StringComparison.Ordinal))
        {
            return;
        }

        _lastSearched = _value;
        await OnSearch.InvokeAsync(_value);
    }

    private void CancelDebounce()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = null;
    }

    /// <inheritdoc />
    public void Dispose() => CancelDebounce();
}
