@inherits SelectionPluginViewBase
@inject ITagIndexSurface Surface

@*
    The tag-index browsing surface. It is composed of three sections, each its
    own component so this file stays a shell: the trees the index covers, the
    tags it carries, and the members of the selected tag.

    The sections sit in a three-column grid at medium and expanded, and stack
    into one column at compact - chosen from the cascaded breakpoint by name,
    never from a media query (epic decision D7).

    Every state the surface can be in - a selection it cannot render, a read in
    flight, a read that failed, an index the caller may not read - is one
    SelectionStateView in one slot, so the copy names which situation the reader
    is in rather than saying "nothing here", and the transition between two
    states updates one live region instead of swapping three elements.
*@

<div class="lx-tagindex">
    @if (State is not null)
    {
        <SelectionStateView Message="State" OnAction="_retryLoad" />
    }
    else
    {
        <div class="lx-tagindex-summary">
            <SelectionBadgeList Badges="_badges" Count="_badgeCount" />
            <span class="lx-tagindex-name">@IndexName</span>
            <span class="lx-tagindex-stat">@_coveredTrees.Count covered tree@(_coveredTrees.Count == 1 ? "" : "s")</span>
            <span class="lx-tagindex-stat">@_tags.Count tag@(_tags.Count == 1 ? "" : "s")</span>
            <button type="button" class="lx-btn" disabled="@_loading" @onclick="LoadAsync">
                @(_loading ? "Loading..." : "Refresh")
            </button>
        </div>

        <div class="lx-tagindex-body @(IsCompact ? "is-stacked" : null)">
            <TagIndexTrees Trees="_coveredTrees" OnOpenTree="_openTree" />

            <TagIndexTags Tags="_tags" SelectedTag="_selectedTag" OnSelectTag="_selectTag" />

            <TagIndexMembers Tag="_selectedTag"
                             Members="CurrentMembers"
                             Loading="_membersLoading"
                             HasLoadedPage="@(_memberPages.Count > 0)"
                             Error="_memberError"
                             PageIndex="_memberPageIndex"
                             CanGoPrevious="@(_memberPageIndex > 0)"
                             CanGoNext="CanGoNextMembers"
                             OnPrevious="_previousMembers"
                             OnNext="_nextMembers"
                             OnRetry="_retryMembers"
                             OnOpenMember="_openMember" />
        </div>
    }
</div>
