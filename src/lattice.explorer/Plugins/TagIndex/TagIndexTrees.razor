@*
    The trees a tag index covers. Each is a link back into the tree's own value
    drill-down surface; the parent owns what "open there" means.
*@
<section class="explorer-tagindex-section explorer-tagindex-trees">
    <h4 class="explorer-tagindex-heading">Covered trees</h4>
    @if (Trees.Count == 0)
    {
        <p class="explorer-tagindex-empty">This index covers no trees yet.</p>
    }
    else
    {
        <ul class="explorer-tagindex-treelist">
            @foreach (var tree in Trees)
            {
                <li>
                    <button type="button"
                            class="explorer-tagindex-treelink"
                            title="@($"Open {tree}")"
                            @onclick="@(() => OnOpenTree.InvokeAsync(tree))">
                        @tree
                    </button>
                </li>
            }
        </ul>
    }
</section>

@code {
    private static readonly IReadOnlyList<string> NoTrees = Array.Empty<string>();

    /// <summary>The subject trees this index covers, in display order.</summary>
    [Parameter] public IReadOnlyList<string> Trees { get; set; } = NoTrees;

    /// <summary>Invoked with the tree id the operator asked to open.</summary>
    [Parameter] public EventCallback<string> OnOpenTree { get; set; }
}
