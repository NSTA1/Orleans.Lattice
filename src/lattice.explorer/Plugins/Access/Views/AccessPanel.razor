@implements IDisposable
@inject IExplorerPluginHostContextFactory HostContexts
@inject IExplorerPluginAccessStore AccessStore
@inject IExplorerShellPreferences Preferences
@inject IExplorerPreferenceCatalog PreferenceCatalog
@inject IExplorerShellRouter Router

@*
    The Access (membership & access-control) plugin's panel: the surface the
    shell renders through DynamicComponent for this plugin.

    It reaches the cluster only through its declared domain contract
    (IAccessDomain), resolved for it by the host from its own plugin id, so it
    holds no connection and no container (epic decision D3).

    Its three sub-surfaces - Groups, Policies, Explain - are internal to the
    plugin and are rendered through the design system's single tab primitive
    over the shared LatticeTabItem vocabulary, so the retired AccessTab enum and
    its bespoke SetTab switch leave no third tab registry behind. The strip
    carries the WAI-ARIA tabs keyboard pattern and overflows rather than
    scrolling off a narrow window.

    The plugin's own gate decides whether any of it is reachable. A denial greys
    the surface out and says so; an unauthenticated connection instead prompts a
    sign-in, because that is recoverable. Both states are read from the keyed
    access store rather than from a shared capability record.
*@

@if (AdaptiveContext is null)
{
    @*
        RETAINED DELIBERATELY, not dead code.

        The Explorer's own MainLayout now hosts LatticeAdaptiveRoot, so in the
        shipped shell this branch never runs and the plugin owns no viewport -
        AccessPanelRenderTests pins that: with a cascade present the rendered
        markup contains no root of ours at all.

        It is kept because this plugin ships as its own package and a head may
        compose it WITHOUT the shared MainLayout, which is the whole point of a
        self-contained plugin. Without this, such a head would silently pin every
        adaptive primitive to the Expanded default and the compact card reflow
        would never fire - the exact failure that went unnoticed shell-wide until
        MainLayout adopted the root, because the CSS half of the design system
        keeps working (media queries need no cascade) while the C#-driven half
        goes quiet without ever failing.

        It can never become a competing owner: the null check means a shell's
        root always wins, so adopting one upstream retires this automatically
        with no edit here. With no viewport service and no JS runtime the root
        simply holds the default breakpoint, which is the layout the Explorer
        already shipped.
    *@
    <LatticeAdaptiveRoot Class="lxa-root">
        @_panel
    </LatticeAdaptiveRoot>
}
else
{
    @_panel
}

@code {
    // Composed once rather than interpolated per render: the posture line
    // re-renders on every access change and every load.
    private const string OnBadgeClass = "lxa-badge is-on";
    private const string OffBadgeClass = "lxa-badge is-off";

    /// <summary>
    /// The grant a refused caller is missing, named as the cluster names it, so
    /// the refusal points at the permission rather than at the area label the
    /// caller can already see.
    /// </summary>
    private const string MissingAdminGrant = "Admin";

    private const string AllTreesHelpId = "lxa-all-trees-grants";
    private const string DelegationHelpId = "lxa-admin-delegation";

    // Hoisted to statics: each call concatenates, and the posture line
    // re-renders on every access change.
    private static readonly string AllTreesExplanationId =
        LatticeHelp.ExplanationElementId(AllTreesHelpId);

    private static readonly string DelegationExplanationId =
        LatticeHelp.ExplanationElementId(DelegationHelpId);

    // Frozen singletons from the shared copy, so a panel that renders one of
    // these on every gate change composes nothing.
    private static readonly ExplorerStateMessage SignInRequired =
        ExplorerStateCopy.SignInRequired(ExplorerSubjects.Grants);

    private static readonly ExplorerStateMessage NotPermitted =
        ExplorerStateCopy.NotPermitted(ExplorerSubjects.Grants, MissingAdminGrant);

    private readonly Action _render;

    private AccessWorkspace _state = null!;
    private RenderFragment? _panel;
    private EventCallback<string> _selectSurface;

    /// <summary>
    /// The strip's selection callback, bound once at mount rather than written
    /// as a method group at the call site: the panel re-renders on every load,
    /// every gate change and every breakpoint change, and a callback composed on
    /// the render path would be rebuilt on each of them.
    /// </summary>
    private EventCallback<string> SelectSurface => _selectSurface;

    private ExplorerStateMessage RefusedMessage =>
        _state.AuthenticationRequired ? SignInRequired : NotPermitted;

    /// <summary>Creates the panel, caching the delegate its state subscription marshals.</summary>
    public AccessPanel() =>
        // Bound once rather than per notification, so a load that raises several
        // changes does not allocate a delegate for each of them.
        _render = StateHasChanged;

    /// <summary>
    /// The breakpoint cascaded by a shell-provided adaptive root - the Explorer's
    /// own <c>MainLayout</c> hosts one, so in the shipped shell this is always
    /// supplied. The plugin falls back to its own root only when it is absent,
    /// which is the case for a head that composes this package without that
    /// layout.
    /// </summary>
    [CascadingParameter] public LatticeAdaptiveContext? AdaptiveContext { get; set; }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        // Materialised once at mount rather than per render: the panel
        // re-renders on every load, every gate change, and every breakpoint
        // change, and a fresh template on each would allocate on all of them.
        _panel = Panel;

        // Declared before the first read, and idempotent by reference: the
        // contract rejects an unregistered key, so this is what makes the
        // area's retained surface enumerable at /reset-view and cleared by it.
        PreferenceCatalog.Register(AccessPluginKeys.SurfacePreference);

        // Bound once here rather than per render, for the reason given on
        // SelectSurface.
        _selectSurface = EventCallback.Factory.Create<string>(this, SelectSurfaceAsync);

        // The host context is bound to this plugin's id, so GetDomain can only
        // ever hand back this plugin's declared contract: there is no parameter
        // through which the panel could name another plugin's domain.
        var context = HostContexts.Create(AccessPluginKeys.PluginId);
        _state = new AccessWorkspace(context.GetDomain<IAccessDomain>(), AccessStore);
        _state.Changed += OnStateChanged;

        // The address is an explicit intent and resolves synchronously, so a
        // deep link opens its surface on the first pass rather than flashing the
        // remembered one first. Only then does the remembered choice apply.
        var opening = AddressedSurface(Router.Current) ?? await RestoreSurfaceAsync();

        _state.OpenSurface(opening);

        await _state.InitializeAsync();
    }

    /// <summary>
    /// The surface the address names, or <see langword="null"/> when it names
    /// none this area offers.
    /// </summary>
    /// <remarks>
    /// Read from the path segment when the address carries a selection and from
    /// this area's parameter otherwise, because the grammar's surface segment
    /// qualifies a selection and is ignored without one - which is the ordinary
    /// case here, since Access scopes to a tree it picks itself.
    /// </remarks>
    private static string? AddressedSurface(ExplorerRoute route)
    {
        if (AccessSurfaces.IsKnown(route.Surface))
        {
            return route.Surface;
        }

        var parameter = route.Parameters.GetValueOrEmpty(AccessPluginKeys.SurfaceParameter);
        return AccessSurfaces.IsKnown(parameter) ? parameter : null;
    }

    /// <summary>
    /// Opens <paramref name="surfaceId"/>, remembering it and putting it in the
    /// address. The workspace ignores an id it does not offer, so a value edited
    /// into the address cannot open something that is not there.
    /// </summary>
    private async Task SelectSurfaceAsync(string surfaceId)
    {
        await _state.SelectSurfaceAsync(surfaceId);

        var opened = _state.ActiveSurfaceId;

        // Replaced rather than pushed, so the browser's Back button leaves the
        // area rather than walking back through every surface the caller opened.
        var route = Router.Current.HasSelection
            ? Router.Current.WithSurface(opened)
            : Router.Current.WithParameter(AccessPluginKeys.SurfaceParameter, opened);

        if (!ReferenceEquals(route, Router.Current))
        {
            Router.NavigateTo(route, replace: true);
        }

        await Preferences.SetAsync(AccessPluginKeys.SurfacePreference, opened);
    }

    // Validated against the surfaces this area actually offers, and a remembered
    // slug that resolves to none of them is forgotten rather than rejected again
    // on every later visit.
    private async Task<string> RestoreSurfaceAsync()
    {
        var restored = await Preferences.RestoreAsync(
            AccessPluginKeys.SurfacePreference,
            AccessSurfaces.Groups,
            state: 0,
            static (remembered, _) => AccessSurfaces.IsKnown(remembered));

        return AccessSurfaces.IsKnown(restored.Value) ? restored.Value : AccessSurfaces.Groups;
    }

    private void OnStateChanged() => InvokeAsync(_render);

    /// <inheritdoc />
    public void Dispose()
    {
        if (_state is null)
        {
            return;
        }

        _state.Changed -= OnStateChanged;
        _state.Dispose();
    }

    private RenderFragment Panel => @<section class="lxa-panel" aria-label="Access">
        @if (!_state.Allowed)
        {
            @*
                A refusal, and the kind is picked rather than defaulted: an
                unauthenticated connection is recoverable by signing in and is
                announced assertively because it is actionable now, where a
                refusal of a signed-in caller is a polite status naming the
                grant they lack.
            *@
            <div role="@(_state.AuthenticationRequired ? "alert" : "status")">
                <AccessStateBlock Message="RefusedMessage" Class="lxa-status is-denied" />
            </div>
        }

        @if (_state.LastResult is { } result)
        {
            <p class="lxa-status @AccessWorkspace.ResultClass(result.Status)" role="status">@result.Message</p>
        }

        @if (_state.Allowed && _state.AccessModel.Model.IsSuccess)
        {
            <p class="lxa-authmode" role="status">
                Authentication mode: <strong>@_state.AccessModel.AuthenticationModeLabel</strong>
            </p>
            @if (_state.AccessModel.ShowPosture)
            {
                @*
                    Each posture badge used to explain itself in a title
                    attribute, which neither a keyboard nor a touch caller can
                    reach. The explanation is now a real disclosure, associated
                    with the badge it explains.
                *@
                <p class="lxa-posture" role="status">
                    <span class="@(_state.AccessModel.AllTreesGrantsEnabled ? OnBadgeClass : OffBadgeClass)"
                          aria-describedby="@AllTreesExplanationId">
                        @_state.AccessModel.AllTreesGrantsLabel
                    </span>
                    <LatticeHelp Id="@AllTreesHelpId"
                                 Term="@_state.AccessModel.AllTreesGrantsLabel"
                                 Explanation="@AccessCreateModel.AllTreesGrantsExplanation" />
                    <span class="@(_state.AccessModel.AccessAdministrationDelegationEnabled ? OnBadgeClass : OffBadgeClass)"
                          aria-describedby="@DelegationExplanationId">
                        @_state.AccessModel.AccessAdministrationDelegationLabel
                    </span>
                    <LatticeHelp Id="@DelegationHelpId"
                                 Term="@_state.AccessModel.AccessAdministrationDelegationLabel"
                                 Explanation="@AccessCreateModel.AccessAdministrationDelegationExplanation" />
                </p>
            }
            @if (_state.AccessModel.ShowEnforcementNotice)
            {
                <p class="lxa-enforcement" role="status">@AccessCreateModel.EnforcementNoticeText</p>
            }
            @if (_state.AccessModel.ShowMembershipInertNotice)
            {
                <p class="lxa-enforcement" role="status">@AccessCreateModel.MembershipInertNoticeText</p>
            }
        }

        <LatticeAdaptiveTabs Tabs="AccessSurfaces.Tabs"
                             ActiveId="@_state.ActiveSurfaceId"
                             OnSelect="SelectSurface"
                             Label="@AccessSurfaces.StripLabel"
                             Variant="LatticeTabsVariant.Subordinate"
                             Id="@AccessSurfaces.StripElementId"
                             Class="lxa-tabs">
            <TrailingContent>
                <button type="button" class="lx-btn lxa-refresh-action"
                        disabled="@(_state.Busy || !_state.Allowed)"
                        @onclick="_state.ReloadAsync">Refresh</button>
            </TrailingContent>
            <ChildContent>
                @if (_state.ActiveSurfaceId == AccessSurfaces.Groups)
                {
                    <AccessGroupsView State="_state" />
                }
                else if (_state.ActiveSurfaceId == AccessSurfaces.Policies)
                {
                    <AccessPolicyView State="_state" />
                }
                else
                {
                    <AccessExplainView State="_state" />
                }
            </ChildContent>
        </LatticeAdaptiveTabs>
    </section>;
}
