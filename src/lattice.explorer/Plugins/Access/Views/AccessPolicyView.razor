@*
    The Policies sub-surface: the shared tree-selection panel, the precedence-
    ranked rule table for the pinned tree, and the rule authoring form.

    The table is the design system's adaptive one, so it reflows to a card list
    at compact instead of scrolling sideways.
*@

<div class="lxa-layout">
    <AccessTreeSelector State="State" />
    <div class="lxa-content">
        @if (State.SelectedTreeId is null)
        {
            <p class="lxa-empty">Select a tree from the list to author or edit a rule for it.</p>
        }
        <div class="lxa-grid is-split">
            <div class="lxa-listcol">
                <div class="lxa-listhead">
                    <h3 class="lxa-title">Rules</h3>
                    <button type="button" class="lx-btn"
                            disabled="@(State.Busy || !State.Allowed)" @onclick="State.NewRule">New rule</button>
                </div>
                @if (State.Rules.Count == 0)
                {
                    <p class="lxa-empty">No rules to show.</p>
                }
                else
                {
                    <RankedRuleTable Rules="State.RankedRules" Labels="State.Labels"
                                     Label="Authorization rules"
                                     RowActions="_editAction" />
                    <p class="lxa-note">
                        Ordered by precedence: most-specific scope first, deny ahead of allow
                        (deny-override). The server's verdict is authoritative; use Explain to
                        confirm an outcome.
                    </p>
                    @if (State.RulesNextToken is not null)
                    {
                        <button type="button" class="lx-btn" disabled="@(State.Busy || !State.Allowed)"
                                @onclick="State.LoadMoreRulesAsync">Load more</button>
                    }
                }
            </div>
            @if (State.RuleFormOpen)
            {
                <AccessRuleForm State="State" />
            }
            else
            {
                <div class="lxa-formcol">
                    <p class="lxa-empty">Select a rule to edit, or choose 'New rule' to add one.</p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private readonly Dictionary<string, RuleEdit> _editActions = new(StringComparer.Ordinal);

    private RenderFragment<RankedRule>? _editAction;

    /// <summary>The Access workspace this surface reads and drives.</summary>
    [Parameter, EditorRequired] public AccessWorkspace State { get; set; } = null!;

    /// <inheritdoc />
    protected override void OnInitialized() =>
        // Bound once at mount rather than rebuilt per render: the rule table
        // re-renders on every load, every selection, and every breakpoint
        // change, and a fresh template per render would allocate on all of them.
        _editAction = EditAction;

    private RenderFragment<RankedRule> EditAction => ranked =>
        @<button type="button" class="lx-btn" disabled="@State.Busy"
                 @onclick="Edit(ranked)">Edit</button>;

    /// <summary>
    /// The edit callback for one ranked rule, bound once and reused on every
    /// later render of that row.
    /// </summary>
    /// <remarks>
    /// The template above is built once, but the lambda inside it was not: it
    /// allocated a closure and an <see cref="EventCallback"/> per rule per
    /// render, and gave the delegate a new identity each time, so Blazor's
    /// attribute diffing re-registered every handler rather than skipping it.
    /// The callback closes over the entry rather than over the ranked rule, and
    /// the entry is re-bound to the instance being rendered, so editing opens
    /// the rule as the cluster last reported it.
    /// </remarks>
    private EventCallback Edit(RankedRule ranked)
    {
        var ruleId = ranked.Rule.RuleId;
        if (_editActions.TryGetValue(ruleId, out var entry))
        {
            entry.Bind(ranked);
            return entry.Edit;
        }

        // Bounded rather than unbounded: a map that has outgrown the rule list
        // it serves is holding callbacks for rules no longer rendered.
        if (_editActions.Count > State.RankedRules.Count * 2)
        {
            _editActions.Clear();
        }

        entry = new RuleEdit(this, ranked);
        _editActions.Add(ruleId, entry);
        return entry.Edit;
    }

    /// <summary>One rule row's pre-bound edit callback.</summary>
    private sealed class RuleEdit
    {
        private RankedRule _ranked;

        public RuleEdit(AccessPolicyView view, RankedRule ranked)
        {
            _ranked = ranked;
            Edit = EventCallback.Factory.Create(view, () => view.State.EditRule(_ranked.Rule));
        }

        public EventCallback Edit { get; }

        /// <summary>Re-points the bound callback at the rule instance being rendered.</summary>
        public void Bind(RankedRule ranked) => _ranked = ranked;
    }
}
