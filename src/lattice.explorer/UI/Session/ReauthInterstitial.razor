<LtDialog Open="true"
          Placement="Placement"
          Title="Your session expired"
          Description="Your sign-in could not be renewed. This can happen after the console moves between replicas, or when your session times out. Sign in again to continue where you left off."
          Alert="true"
          ShowClose="false"
          DismissOnEscape="false">
    <Actions>
        <LtButton OnClick="Reauthenticate">Sign in again</LtButton>
    </Actions>
</LtDialog>
