@implements IDisposable

@if (Folded)
{
    <section aria-label="Connection">
        <LtDefinitionList>
            <LtDefinition Term="Connection"><span role="status"><LtStatusPill State="Presentation.Role" Text="@Presentation.Text" /></span></LtDefinition>
            @if (Status.Endpoint is { Length: > 0 } endpoint)
            {
                <LtDefinition Term="Endpoint" Mono="true">@endpoint</LtDefinition>
            }
        </LtDefinitionList>
        <div class="lt-dialog__actions">@ConnectionActions</div>
    </section>
}
else
{
    <span role="status"><LtStatusPill State="Presentation.Role" Text="@Presentation.Text" /></span>
    @if (Status.Endpoint is { Length: > 0 } endpoint)
    {
        @if (OffersDetails)
        {
            @* The endpoint is itself the way into the read-only details, so the header gains no control of its own. *@
            <LtButton Variant="LtButtonVariant.Quiet" aria-haspopup="dialog" data-lt-connection-details="" OnClick="OpenConfiguration"><span class="lt-visually-hidden">Connection details: </span><code class="lt-mono-cell__value">@endpoint</code></LtButton>
        }
        else
        {
            <code class="lt-mono-cell__value">@endpoint</code>
        }
    }
    @ConnectionActions
}

@code {
    private RenderFragment ConnectionActions => __builder =>
    {
        @if (Status.RequiresAuthentication && (!Auth.IsAuthenticated || Status.CredentialRefused))
        {
            <LtButton OnClick="OpenSignIn">Sign in</LtButton>
        }
        @if (Explorer.IsConfigured && Status.IsDisconnected)
        {
            <LtButton Disabled="_reconnecting" OnClick="ReconnectAsync">@(_reconnecting ? "Reconnecting" : "Reconnect")</LtButton>
        }
        @if (EndpointOptions.AllowInteractiveEndpointConfiguration)
        {
            <LtButton Variant="LtButtonVariant.Quiet" aria-haspopup="dialog" OnClick="OpenConfiguration">Connection settings</LtButton>
        }
        else if (OffersDetails && (Folded || Status.Endpoint is not { Length: > 0 }))
        {
            <LtButton Variant="LtButtonVariant.Quiet" aria-haspopup="dialog" OnClick="OpenConfiguration">Connection details</LtButton>
        }
    };
}
