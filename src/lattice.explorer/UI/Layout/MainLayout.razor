@inherits LayoutComponentBase
@using Orleans.Lattice.Explorer.UI.Authentication
@implements IDisposable

<CascadingValue Value="_login" IsFixed="true">
    <div class="explorer-shell">
        <ConfigurationGate>
            <div class="explorer-body">
                <ClusterBadge />
                <AppAreaShell>
                    <div class="explorer-layout">
                        <NavigationPanel />
                        <main class="explorer-main">
                            @Body
                        </main>
                    </div>
                </AppAreaShell>
            </div>
        </ConfigurationGate>
    </div>

    @if (_login.IsVisible)
    {
        <div class="explorer-config-overlay">
            <LoginDialog OnClosed="_login.Close" />
        </div>
    }

    <ReauthInterstitial />
</CascadingValue>

@code {
    private readonly LoginDialogState _login = new();

    protected override void OnInitialized() => _login.Changed += OnLoginChanged;

    private void OnLoginChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => _login.Changed -= OnLoginChanged;
}
