@using Microsoft.JSInterop
@using Orleans.Lattice.Api.Backup
@using Orleans.Lattice.Backup
@using Orleans.Lattice.Explorer.Backup
@using Orleans.Lattice.Explorer.Core.Catalog
@using Orleans.Lattice.Explorer.Core.Navigation
@inject IBackupCatalogReader Reader
@inject ICatalogReader Catalog
@inject IJSRuntime JS

@*
    The Backups management area: lists the visible backup catalog and triggers
    capture, restore, and delete operations. A capture targets one or more trees
    selected from the cluster's tree list; a multi-tree capture is a backup set,
    optionally captured at a single cross-tree causal fence. No client-side
    permission pre-check gates the controls: the server is the fail-closed
    enforcement point, so every action folds a server denial into a clean "not
    permitted" status message rather than surfacing an unhandled error.
*@

<section class="explorer-backups" aria-label="Backups">
    <header class="explorer-backups-header">
        <h2>Backups</h2>
        <button type="button" class="explorer-btn" disabled="@_busy" @onclick="ReloadAsync">Refresh</button>
    </header>

    @if (_lastResult is not null)
    {
        <p class="explorer-backups-result @ResultClass(_lastResult.Status)" role="status">@_lastResult.Message</p>
    }

    <div class="explorer-backups-scope">
        <label class="explorer-backups-trees">
            Scope trees
            <select multiple size="6" @onchange="OnTreesChanged" disabled="@_busy" aria-label="Scope trees">
                @foreach (var tree in OrdinaryTrees)
                {
                    <option value="@tree.Id" selected="@_selectedTrees.Contains(tree.Id)">@tree.Id</option>
                }
                @foreach (var group in RestoreShadowGroups)
                {
                    <optgroup label="@($"{group.Key} (restore shadows)")">
                        @foreach (var shadow in group)
                        {
                            <option value="@shadow.Id" selected="@_selectedTrees.Contains(shadow.Id)">@shadow.Id</option>
                        }
                    </optgroup>
                }
            </select>
        </label>

        <label>
            Name
            <input type="text" value="@_captureName" @oninput="e => _captureName = e.Value?.ToString() ?? string.Empty" placeholder="backup name" />
        </label>

        <fieldset class="explorer-backups-kind" aria-label="Backup kind">
            <label>
                <input type="radio" name="backup-kind" checked="@(_captureKind == BackupKind.Full)"
                       @onchange="@(() => SetKind(BackupKind.Full))" />
                Full
            </label>
            <label>
                <input type="radio" name="backup-kind" checked="@(_captureKind == BackupKind.Incremental)"
                       @onchange="@(() => SetKind(BackupKind.Incremental))" />
                Incremental
            </label>
        </fieldset>

        <label>
            Base backup
            <select value="@_incrementalBaseId" @onchange="e => _incrementalBaseId = e.Value?.ToString() ?? string.Empty"
                    disabled="@(_captureKind == BackupKind.Full)">
                <option value="">(select a full backup)</option>
                @foreach (var full in FullBackups)
                {
                    <option value="@full.Id">@Shorten(full.Id) - @full.Name (@full.Scope.TreeId)</option>
                }
            </select>
        </label>

        <label class="explorer-backups-fence" title="Capture every selected tree at a single cross-tree causal fence.">
            <input type="checkbox" checked="@_crossTreeConsistent"
                   @onchange="e => _crossTreeConsistent = (bool?)e.Value ?? false"
                   disabled="@(_captureKind == BackupKind.Incremental || _selectedTrees.Count < 2)" />
            Cross-tree consistent
        </label>

        <button type="button" class="explorer-btn explorer-btn-primary"
                disabled="@(!CanBackup)" @onclick="BackupAsync">Backup</button>
    </div>

    @if (_captureKind == BackupKind.Incremental && _selectedTrees.Count > 1)
    {
        <p class="explorer-backups-hint">An incremental backup targets a single tree - select exactly one tree.</p>
    }

    <div class="explorer-backups-body">
        @if (_list.Status == BackupOperationStatus.Denied)
        {
            <p class="explorer-backups-empty">You are not permitted to list backups here.</p>
        }
        else if (_list.Status == BackupOperationStatus.Failed)
        {
            <p class="explorer-backups-empty">@_list.Message</p>
        }
        else if (_list.Entries.Count == 0)
        {
            <p class="explorer-backups-empty">No backups are visible.</p>
        }
        else
        {
            <p class="explorer-backups-hint">
                Restore mode: <strong>In-place</strong> merges the backup into the
                target by last-writer-wins, so writes made after the backup was
                taken are kept. <strong>Shadow-cutover</strong> rebuilds the tree
                from the backup and swaps it in, so the restored tree holds exactly
                the backup contents (post-backup writes are dropped) - the
                point-in-time-recovery path.
            </p>
            <table class="explorer-table">
                <thead>
                    <tr>
                        <th>Id</th><th>Name</th><th>Kind</th><th>Scope</th><th>Created</th><th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Rows)
                    {
                        <tr>
                            <td class="explorer-backups-id">
                                <span title="@row.DisplayId">@Shorten(row.DisplayId)</span>
                                <button type="button" class="explorer-btn explorer-btn-icon"
                                        title="Copy full id" aria-label="Copy id"
                                        @onclick="@(() => CopyIdAsync(row.DisplayId))">Copy</button>
                            </td>
                            <td>@row.Name</td>
                            <td>@row.Kind</td>
                            <td>@(row.IsSet ? string.Join(", ", row.TreeIds) : row.Members[0].Scope.TreeId)</td>
                            <td title="@row.CreatedAtUtc.UtcDateTime.ToString("u")">@row.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="explorer-backups-actions">
                                @if (!row.IsSet)
                                {
                                    var manifest = row.Members[0];
                                    <input type="text" value="@RestoreTargetFor(manifest)" @oninput="e => SetRestoreTarget(manifest.Id, e.Value?.ToString())" placeholder="target tree" />
                                }
                                <select class="explorer-backups-restore-mode" value="@_restoreMode"
                                        @onchange="OnRestoreModeChanged" title="Restore mode">
                                    <option value="@LatticeRestoreMode.InPlace">In-place (merge)</option>
                                    <option value="@LatticeRestoreMode.ShadowCutover">Shadow-cutover (point-in-time)</option>
                                </select>
                                <button type="button" class="explorer-btn"
                                        disabled="@(_busy || (!row.IsSet && string.IsNullOrWhiteSpace(RestoreTargetFor(row.Members[0]))))"
                                        @onclick="@(() => RequestRestore(row))">Restore</button>
                                <button type="button" class="explorer-btn explorer-btn-danger"
                                        disabled="@_busy"
                                        @onclick="@(() => RequestDelete(row))">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @if (_pendingDelete is not null)
    {
        <div class="explorer-modal-backdrop" role="presentation">
            <div class="explorer-modal" role="alertdialog" aria-modal="true" aria-labelledby="explorer-delete-title">
                <h3 id="explorer-delete-title">Delete backup?</h3>
                @if (_pendingDelete.IsSet)
                {
                    <p>
                        This permanently deletes all @_pendingDelete.Members.Count member backups
                        of set <code>@Shorten(_pendingDelete.DisplayId)</code>
                        ('@_pendingDelete.Name'). <strong>This action cannot be undone.</strong>
                    </p>
                }
                else
                {
                    <p>
                        This permanently deletes backup <code>@Shorten(_pendingDelete.DisplayId)</code>
                        ('@_pendingDelete.Name'). <strong>This action cannot be undone.</strong>
                    </p>
                }
                <div class="explorer-modal-actions">
                    <button type="button" class="explorer-btn" disabled="@_busy" @onclick="CancelDelete">Cancel</button>
                    <button type="button" class="explorer-btn explorer-btn-danger" disabled="@_busy" @onclick="ConfirmDeleteAsync">Delete</button>
                </div>
            </div>
        </div>
    }

    @if (_pendingRestore is not null)
    {
        <div class="explorer-modal-backdrop" role="presentation">
            <div class="explorer-modal" role="alertdialog" aria-modal="true" aria-labelledby="explorer-restore-title">
                <h3 id="explorer-restore-title">Restore backup?</h3>
                @if (_pendingRestore.IsSet)
                {
                    <p>
                        This restores each of the @_pendingRestore.Members.Count member backups
                        of set <code>@Shorten(_pendingRestore.DisplayId)</code>
                        ('@_pendingRestore.Name') back into its own tree, @RestoreModeDescription:
                    </p>
                    <ul>
                        @foreach (var member in _pendingRestore.Members)
                        {
                            <li><code>@Shorten(member.Id)</code> into tree <strong>@member.Scope.TreeId</strong></li>
                        }
                    </ul>
                }
                else
                {
                    <p>
                        This restores backup <code>@Shorten(_pendingRestore.DisplayId)</code>
                        ('@_pendingRestore.Name') into tree
                        <strong>@RestoreTargetFor(_pendingRestore.Members[0])</strong>,
                        @RestoreModeDescription.
                    </p>
                }
                <div class="explorer-modal-actions">
                    <button type="button" class="explorer-btn" disabled="@_busy" @onclick="CancelRestore">Cancel</button>
                    <button type="button" class="explorer-btn explorer-btn-primary" disabled="@_busy" @onclick="ConfirmRestoreAsync">Proceed</button>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private BackupListView _list = BackupListView.Empty;
    private BackupOperationResult? _lastResult;
    private IReadOnlyList<CatalogItem> _availableTrees = Array.Empty<CatalogItem>();
    private readonly HashSet<string> _selectedTrees = new(StringComparer.Ordinal);
    private string _captureName = string.Empty;
    private BackupKind _captureKind = BackupKind.Full;
    private bool _crossTreeConsistent;
    private string _incrementalBaseId = string.Empty;
    private readonly Dictionary<string, string> _restoreTargets = new(StringComparer.Ordinal);
    private LatticeRestoreMode _restoreMode = LatticeRestoreMode.InPlace;
    private BackupRow? _pendingDelete;
    private BackupRow? _pendingRestore;
    private bool _busy;

    private bool HasSelection => _selectedTrees.Count > 0;
    private bool HasName => !string.IsNullOrWhiteSpace(_captureName);

    // The listed backups collapsed into display rows, folding each backup set's
    // per-tree members (sharing a stamped SetId) into a single row.
    private IReadOnlyList<BackupRow> Rows => BackupRowGrouping.Group(_list.Entries);

    private IReadOnlyList<BackupManifest> FullBackups =>
        _list.Entries.Where(e => e.Kind == BackupKind.Full).ToList();

    // A one-line description of the selected restore mode for the confirmation
    // dialog, so the user sees exactly what the restore will do to the target.
    private string RestoreModeDescription => _restoreMode == LatticeRestoreMode.ShadowCutover
        ? "shadow-cutover (point-in-time: the tree is rebuilt from the backup and post-backup writes are dropped)"
        : "in-place (merge: the backup is merged by last-writer-wins and post-backup writes are kept)";

    private bool CanBackup
    {
        get
        {
            if (_busy || !HasSelection || !HasName)
            {
                return false;
            }

            if (_captureKind == BackupKind.Incremental)
            {
                return _selectedTrees.Count == 1
                    && !string.IsNullOrWhiteSpace(_incrementalBaseId);
            }

            return true;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadTreesAsync();
        await ReloadAsync();
    }

    private async Task LoadTreesAsync()
    {
        var trees = new List<CatalogItem>();
        string? token = null;
        try
        {
            do
            {
                var page = await Catalog.LoadAsync(CatalogKind.Trees, token, pageSize: 200);
                trees.AddRange(page.Items);
                token = page.NextPageToken;
            }
            while (token is not null);
        }
        catch (Exception)
        {
            // Leave the tree list empty on a discovery failure; the area still
            // lists any visible backups and the user can retry with Refresh.
        }

        _availableTrees = trees;
    }

    // Ordinary (non-shadow) trees render as flat options; restore-shadow trees
    // are grouped under an optgroup labelled by the logical tree they were
    // restored for, keyed off the first-class RestoreShadowOfTreeId marker rather
    // than the tree name.
    private IEnumerable<CatalogItem> OrdinaryTrees =>
        _availableTrees.Where(t => !t.IsRestoreShadow);

    private IEnumerable<IGrouping<string, CatalogItem>> RestoreShadowGroups =>
        _availableTrees
            .Where(t => t.IsRestoreShadow)
            .GroupBy(t => t.RestoreShadowOfTreeId!, StringComparer.Ordinal)
            .OrderBy(g => g.Key, StringComparer.Ordinal);

    private void OnTreesChanged(ChangeEventArgs e)
    {
        _selectedTrees.Clear();
        if (e.Value is string[] values)
        {
            foreach (var value in values)
            {
                _selectedTrees.Add(value);
            }
        }

        if (_selectedTrees.Count < 2)
        {
            _crossTreeConsistent = false;
        }
    }

    private void SetKind(BackupKind kind)
    {
        _captureKind = kind;
        if (kind == BackupKind.Full)
        {
            // Full captures carry no base; clear and disable the base selector.
            _incrementalBaseId = string.Empty;
        }
        else
        {
            _crossTreeConsistent = false;
        }
    }

    private async Task ReloadAsync()
    {
        _busy = true;
        try
        {
            _list = await Reader.LoadPageAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task BackupAsync()
    {
        var trees = _selectedTrees.ToList();

        if (_captureKind == BackupKind.Incremental)
        {
            await RunAsync(() => Reader.TriggerIncrementalAsync(
                _captureName, BackupScopeSelector.WholeTree(trees[0]), _incrementalBaseId));
            return;
        }

        if (trees.Count == 1)
        {
            await RunAsync(() => Reader.TriggerFullAsync(
                _captureName, BackupScopeSelector.WholeTree(trees[0])));
            return;
        }

        var scopes = trees.Select(BackupScopeSelector.WholeTree).ToList();
        await RunAsync(() => Reader.TriggerSetAsync(_captureName, scopes, _crossTreeConsistent));
    }

    private async Task CopyIdAsync(string id)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", id);
            _lastResult = BackupOperationResult.Success("Copied backup id to clipboard.");
        }
        catch (Exception)
        {
            _lastResult = BackupOperationResult.Failure("Copying to the clipboard is not available here.");
        }
    }

    private void RequestRestore(BackupRow row)
    {
        _pendingRestore = row;
    }

    private void CancelRestore()
    {
        _pendingRestore = null;
    }

    private async Task ConfirmRestoreAsync()
    {
        var row = _pendingRestore;
        if (row is null)
        {
            return;
        }

        _pendingRestore = null;
        await RestoreRowAsync(row);
    }

    private async Task RestoreRowAsync(BackupRow row)
    {
        if (!row.IsSet)
        {
            var manifest = row.Members[0];
            await RunAsync(() => Reader.RestoreAsync(manifest.Id, RestoreTargetFor(manifest), _restoreMode));
            return;
        }

        // A set restores every member back to its own tree in the chosen mode.
        var members = row.Members;
        await RunManyAsync(
            members.Select(m => (Func<Task<BackupOperationResult>>)(
                () => Reader.RestoreAsync(m.Id, m.Scope.TreeId, _restoreMode))),
            $"Restored {members.Count} member backups to their trees.");
    }

    // The restore target defaults to the backup's own scope tree, so an in-place
    // restore back into the original tree is one click; the user can retype it to
    // restore elsewhere. Tracked per backup id so each row keeps its own edit.
    private string RestoreTargetFor(BackupManifest manifest) =>
        _restoreTargets.TryGetValue(manifest.Id, out var target) ? target : manifest.Scope.TreeId;

    private void SetRestoreTarget(string backupId, string? value) =>
        _restoreTargets[backupId] = value ?? string.Empty;

    private void OnRestoreModeChanged(ChangeEventArgs e)
    {
        _restoreMode = Enum.TryParse<LatticeRestoreMode>(e.Value?.ToString(), out var mode)
            ? mode
            : LatticeRestoreMode.InPlace;
    }

    private void RequestDelete(BackupRow row)
    {
        _pendingDelete = row;
    }

    private void CancelDelete()
    {
        _pendingDelete = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        var row = _pendingDelete;
        if (row is null)
        {
            return;
        }

        _pendingDelete = null;

        if (!row.IsSet)
        {
            await RunAsync(() => Reader.DeleteAsync(row.Members[0].Id));
            return;
        }

        // Deleting a set removes every member backup.
        var members = row.Members;
        await RunManyAsync(
            members.Select(m => (Func<Task<BackupOperationResult>>)(() => Reader.DeleteAsync(m.Id))),
            $"Deleted {members.Count} member backups.");
    }

    private async Task RunAsync(Func<Task<BackupOperationResult>> action)
    {
        _busy = true;
        try
        {
            _lastResult = await action();
            _list = await Reader.LoadPageAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    // Runs a sequence of operations for a backup set, stopping at the first
    // non-success, then reloads the list once. On full success the aggregate
    // message is reported; otherwise the failing / denied result is surfaced.
    private async Task RunManyAsync(IEnumerable<Func<Task<BackupOperationResult>>> actions, string successMessage)
    {
        _busy = true;
        try
        {
            BackupOperationResult? last = null;
            foreach (var action in actions)
            {
                last = await action();
                if (last.Status != BackupOperationStatus.Succeeded)
                {
                    break;
                }
            }

            _lastResult = last is { Status: BackupOperationStatus.Succeeded }
                ? BackupOperationResult.Success(successMessage)
                : last;
            _list = await Reader.LoadPageAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static string Shorten(string id) => id.Length <= 12 ? id : id[..12] + "...";

    private static string ResultClass(BackupOperationStatus status) => status switch
    {
        BackupOperationStatus.Succeeded => "is-success",
        BackupOperationStatus.Denied => "is-denied",
        _ => "is-failed",
    };
}
