@using Orleans.Lattice.Api.Backup
@using Orleans.Lattice.Backup
@using Orleans.Lattice.Explorer.Backup
@using Orleans.Lattice.Explorer.Core.Catalog
@using Orleans.Lattice.Explorer.Core.Navigation
@using Orleans.Lattice.Explorer.Core.Session
@inject IBackupCatalogReader Reader
@inject ICatalogReader Catalog
@inject IUiPreferenceStore Preferences

@*
    The Backups management area: lists the visible backup catalog and triggers
    capture, restore, and delete operations. A capture targets one or more trees
    selected from the cluster's tree list; a multi-tree capture is a backup set,
    optionally captured at a single cross-tree causal fence. No client-side
    permission pre-check gates the controls: the server is the fail-closed
    enforcement point, so every action folds a server denial into a clean "not
    permitted" status message rather than surfacing an unhandled error.
*@

<section class="explorer-backups" aria-label="Backups">
    <header class="explorer-backups-header">
        <button type="button" class="explorer-btn" disabled="@_busy" @onclick="ReloadAsync">Refresh</button>
    </header>

    @if (_lastResult is not null)
    {
        <p class="explorer-backups-result @ResultClass(_lastResult.Status)" role="status">@_lastResult.Message</p>
    }

    <div class="explorer-tabstrip" role="tablist" aria-label="Backups tabs">
        <button type="button" role="tab"
                class="explorer-tab @(_subTabRestored && _activeSubTab == BackupsSubTab.New ? "is-active" : null)"
                aria-selected="@(_subTabRestored && _activeSubTab == BackupsSubTab.New)"
                @onclick="@(() => SetSubTab(BackupsSubTab.New))">New Backup</button>
        <button type="button" role="tab"
                class="explorer-tab @(_subTabRestored && _activeSubTab == BackupsSubTab.Existing ? "is-active" : null)"
                aria-selected="@(_subTabRestored && _activeSubTab == BackupsSubTab.Existing)"
                @onclick="@(() => SetSubTab(BackupsSubTab.Existing))">Existing Backups</button>
    </div>

    @if (!_subTabRestored)
    {
        <div class="explorer-backups-body" aria-busy="true"></div>
    }
    else if (_activeSubTab == BackupsSubTab.New)
    {
        <div class="explorer-backups-new">
            <div class="explorer-backups-treecol">
                <span class="explorer-backups-picker-label">Trees</span>
                @if (OrdinaryTrees.Any() || RestoreShadowGroups.Any())
                {
                    <ul class="explorer-nav-list" role="listbox" aria-label="Available trees">
                        @foreach (var tree in OrdinaryTrees)
                        {
                            var selected = _selectedTrees.Contains(tree.Id);
                            <li role="option" aria-selected="@selected">
                                <button type="button"
                                        class="explorer-nav-item @(selected ? "is-selected" : null)"
                                        disabled="@_busy"
                                        @onclick="@(() => AddTree(tree.Id))">
                                    <span class="explorer-nav-item-id">@tree.Id</span>
                                </button>
                            </li>
                        }
                        @foreach (var group in RestoreShadowGroups)
                        {
                            <li class="explorer-backups-treegroup" role="presentation">@group.Key (restore shadows)</li>
                            @foreach (var shadow in group)
                            {
                                var selected = _selectedTrees.Contains(shadow.Id);
                                <li role="option" aria-selected="@selected">
                                    <button type="button"
                                            class="explorer-nav-item @(selected ? "is-selected" : null)"
                                            disabled="@_busy"
                                            @onclick="@(() => AddTree(shadow.Id))">
                                        <span class="explorer-nav-item-id">@shadow.Id</span>
                                    </button>
                                </li>
                            }
                        }
                    </ul>
                }
                else
                {
                    <p class="explorer-backups-empty">No trees are visible.</p>
                }
            </div>

            <div class="explorer-backups-form">
                <div class="explorer-backups-selected">
                    <span class="explorer-backups-picker-label">Included in backup</span>
                    @if (_selectedTrees.Count == 0)
                    {
                        <p class="explorer-backups-empty">Select one or more trees from the list.</p>
                    }
                    else
                    {
                        <ul class="explorer-backups-selected-list">
                            @foreach (var id in _selectedTrees)
                            {
                                <li>
                                    <button type="button" class="explorer-btn explorer-btn-icon explorer-backups-remove"
                                            title="Remove tree" aria-label="@($"Remove {id}")"
                                            disabled="@_busy"
                                            @onclick="@(() => RemoveTree(id))">x</button>
                                    <span class="explorer-backups-selected-id">@id</span>
                                </li>
                            }
                        </ul>
                        @if (_selectedTrees.Count > 1)
                        {
                            <p class="explorer-backups-note">Multiple trees are captured as a cross-tree consistent backup set.</p>
                        }
                    }
                </div>

                <label class="explorer-backups-field">
                    Name
                    <input type="text" value="@_captureName" @oninput="e => _captureName = e.Value?.ToString() ?? string.Empty" placeholder="backup name" />
                </label>

                <fieldset class="explorer-backups-kind" aria-label="Backup kind">
                    <label>
                        <input type="radio" name="backup-kind" checked="@(_captureKind == BackupKind.Full)"
                               @onchange="@(() => SetKind(BackupKind.Full))" />
                        Full
                    </label>
                    <label>
                        <input type="radio" name="backup-kind" checked="@(_captureKind == BackupKind.Incremental)"
                               @onchange="@(() => SetKind(BackupKind.Incremental))" />
                        Incremental
                    </label>
                </fieldset>

                @if (_captureKind == BackupKind.Incremental)
                {
                    <label class="explorer-backups-field">
                        Base backup
                        <select value="@_incrementalBaseId" @onchange="e => _incrementalBaseId = e.Value?.ToString() ?? string.Empty">
                            <option value="">(select a full backup)</option>
                            @foreach (var full in FullBackups)
                            {
                                <option value="@full.Id">@Shorten(full.Id) - @full.Name (@full.Scope.TreeId)</option>
                            }
                        </select>
                    </label>
                }

                <fieldset class="explorer-backups-schedule" aria-label="Recurring schedule">
                    <label title="Also register a recurring backup of the selected tree at the interval below.">
                        <input type="checkbox" checked="@_scheduleEnabled"
                               @onchange="e => _scheduleEnabled = (bool?)e.Value ?? false"
                               disabled="@(!CanSchedule)" />
                        Schedule recurring
                    </label>
                    <label>
                        Every
                        <input type="number" min="0" max="168" value="@_scheduleHours"
                               @oninput="e => _scheduleHours = ParseInterval(e.Value, 0, 168)"
                               disabled="@(!_scheduleEnabled || !CanSchedule)" aria-label="Interval hours" />
                        h
                    </label>
                    <label>
                        <input type="number" min="0" max="59" value="@_scheduleMinutes"
                               @oninput="e => _scheduleMinutes = ParseInterval(e.Value, 0, 59)"
                               disabled="@(!_scheduleEnabled || !CanSchedule)" aria-label="Interval minutes" />
                        m
                    </label>
                </fieldset>

                <button type="button" class="explorer-btn explorer-btn-primary"
                        disabled="@(!CanBackup)" @onclick="BackupAsync">Backup</button>

                @if (_scheduleEnabled && !CanSchedule)
                {
                    <p class="explorer-backups-hint">A recurring schedule targets a single tree - select exactly one tree.</p>
                }
                else if (_scheduleEnabled && ScheduleInterval <= TimeSpan.Zero)
                {
                    <p class="explorer-backups-hint">Set a schedule interval greater than zero.</p>
                }

                @if (_captureKind == BackupKind.Incremental && _selectedTrees.Count > 1)
                {
                    <p class="explorer-backups-hint">An incremental backup targets a single tree - select exactly one tree.</p>
                }
            </div>
        </div>
    }
    else
    {
        <div class="explorer-backups-body">
            @if (_pager.Current.Status == BackupOperationStatus.Denied)
            {
                <p class="explorer-backups-empty">You are not permitted to list backups here.</p>
            }
            else if (_pager.Current.Status == BackupOperationStatus.Failed)
            {
                <p class="explorer-backups-empty">@_pager.Current.Message</p>
            }
            else
            {
                <table class="explorer-table explorer-backups-table">
                    <thead>
                        <tr>
                            <th>Name</th><th>Kind</th><th>Scope</th><th>Created</th><th>Actions</th>
                        </tr>
                        <tr class="explorer-backups-filterrow">
                            <th>
                                <BackupFilterBox Placeholder="Name starts with..." InitialValue="@_filterName"
                                                 Disabled="@_busy" OnFilter="OnNameFilterChanged" />
                            </th>
                            <th>
                                <select class="explorer-backups-filter-select" value="@_filterKind"
                                        disabled="@_busy" @onchange="OnKindFilterChanged" aria-label="Filter by kind">
                                    <option value="">(any)</option>
                                    @foreach (var kind in _summary.Kinds)
                                    {
                                        <option value="@kind">@kind</option>
                                    }
                                </select>
                            </th>
                            <th>
                                <select class="explorer-backups-filter-select" value="@_filterScope"
                                        disabled="@_busy" @onchange="OnScopeFilterChanged" aria-label="Filter by scope">
                                    <option value="">(any)</option>
                                    @foreach (var scope in _summary.Scopes)
                                    {
                                        <option value="@scope">@scope</option>
                                    }
                                </select>
                            </th>
                            <th>
                                <BackupFilterBox Placeholder="Created starts with..." InitialValue="@_filterCreated"
                                                 Disabled="@_busy" OnFilter="OnCreatedFilterChanged" />
                            </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Rows.Count == 0)
                        {
                            <tr><td colspan="5" class="explorer-backups-empty">@EmptyMessage</td></tr>
                        }
                        else
                        {
                            @foreach (var row in Rows)
                            {
                                var isSelected = string.Equals(_selectedRowId, row.DisplayId, StringComparison.Ordinal);
                                var isNew = _highlightedBackupIds.Contains(row.DisplayId);
                                <tr class="explorer-backups-row @(isSelected ? "is-selected" : null) @(isNew ? "is-new" : null)"
                                    @onclick="@(() => SelectRow(row))">
                                    <td>@row.Name</td>
                                    <td>@row.Kind</td>
                                    <td>@(row.IsSet ? string.Join(", ", row.TreeIds) : row.Members[0].Scope.TreeId)</td>
                                    <td title="@row.CreatedAtUtc.UtcDateTime.ToString("u")">@row.CreatedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td class="explorer-backups-actions" @onclick:stopPropagation="true">
                                        @if (isSelected)
                                        {
                                            @if (!row.IsSet)
                                            {
                                                var manifest = row.Members[0];
                                                <input type="text" value="@RestoreTargetFor(manifest)" @oninput="e => SetRestoreTarget(manifest.Id, e.Value?.ToString())" placeholder="target tree" />
                                            }
                                            <select class="explorer-backups-restore-mode" value="@_restoreMode"
                                                    @onchange="OnRestoreModeChanged" title="Restore mode">
                                                <option value="@LatticeRestoreMode.InPlace">Repair missing items (non-destructive)</option>
                                                <option value="@LatticeRestoreMode.ShadowCutover">Point-in-time replace (destructive)</option>
                                            </select>
                                            <button type="button" class="explorer-btn"
                                                    disabled="@(_busy || (!row.IsSet && string.IsNullOrWhiteSpace(RestoreTargetFor(row.Members[0]))))"
                                                    @onclick="@(() => RequestRestore(row))">Restore</button>
                                            <button type="button" class="explorer-btn explorer-btn-danger"
                                                    disabled="@_busy"
                                                    @onclick="@(() => RequestDelete(row))">Delete</button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                <div class="explorer-data-pager">
                    <button type="button" class="explorer-btn" disabled="@(_busy || !_pager.CanGoPrevious)" @onclick="PreviousPage">Prev</button>
                    <span class="explorer-data-pagenum">Page @(_pager.PageIndex + 1)</span>
                    <button type="button" class="explorer-btn" disabled="@(_busy || !_pager.CanGoNext)" @onclick="NextPageAsync">Next</button>
                </div>
            }
        </div>
    }

    @if (_pendingDelete is not null)
    {
        <div class="explorer-modal-backdrop" role="presentation">
            <div class="explorer-modal" role="alertdialog" aria-modal="true" aria-labelledby="explorer-delete-title">
                <h3 id="explorer-delete-title">Delete backup?</h3>
                @if (_pendingDelete.IsSet)
                {
                    <p>
                        This permanently deletes all @_pendingDelete.Members.Count member backups
                        of set <code>@Shorten(_pendingDelete.DisplayId)</code>
                        ('@_pendingDelete.Name'). <strong>This action cannot be undone.</strong>
                    </p>
                }
                else
                {
                    <p>
                        This permanently deletes backup <code>@Shorten(_pendingDelete.DisplayId)</code>
                        ('@_pendingDelete.Name'). <strong>This action cannot be undone.</strong>
                    </p>
                }
                <div class="explorer-modal-actions">
                    <button type="button" class="explorer-btn" disabled="@_busy" @onclick="CancelDelete">Cancel</button>
                    <button type="button" class="explorer-btn explorer-btn-danger" disabled="@_busy" @onclick="ConfirmDeleteAsync">Delete</button>
                </div>
            </div>
        </div>
    }

    @if (_pendingRestore is not null)
    {
        <div class="explorer-modal-backdrop" role="presentation">
            <div class="explorer-modal" role="alertdialog" aria-modal="true" aria-labelledby="explorer-restore-title">
                <h3 id="explorer-restore-title">Restore backup?</h3>
                @if (_pendingRestore.IsSet)
                {
                    <p>
                        This restores each of the @_pendingRestore.Members.Count member backups
                        of set <code>@Shorten(_pendingRestore.DisplayId)</code>
                        ('@_pendingRestore.Name') back into its own tree, @RestoreModeDescription:
                    </p>
                    <ul>
                        @foreach (var member in _pendingRestore.Members)
                        {
                            <li><code>@Shorten(member.Id)</code> into tree <strong>@member.Scope.TreeId</strong></li>
                        }
                    </ul>
                }
                else
                {
                    <p>
                        This restores backup <code>@Shorten(_pendingRestore.DisplayId)</code>
                        ('@_pendingRestore.Name') into tree
                        <strong>@RestoreTargetFor(_pendingRestore.Members[0])</strong>,
                        @RestoreModeDescription.
                    </p>
                }
                <div class="explorer-modal-actions">
                    <button type="button" class="explorer-btn" disabled="@_busy" @onclick="CancelRestore">Cancel</button>
                    <button type="button" class="explorer-btn explorer-btn-primary" disabled="@_busy" @onclick="ConfirmRestoreAsync">Proceed</button>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private BackupCatalogPager _pager = default!;
    private BackupCatalogSummary _summary = BackupCatalogSummary.Empty;
    private BackupOperationResult? _lastResult;
    private IReadOnlyList<CatalogItem> _availableTrees = Array.Empty<CatalogItem>();
    private readonly List<string> _selectedTrees = new();
    private string _captureName = string.Empty;
    private BackupKind _captureKind = BackupKind.Full;
    private string _incrementalBaseId = string.Empty;
    private readonly Dictionary<string, string> _restoreTargets = new(StringComparer.Ordinal);
    private LatticeRestoreMode _restoreMode = LatticeRestoreMode.InPlace;
    private bool _scheduleEnabled;
    private int _scheduleHours;
    private int _scheduleMinutes;
    private BackupRow? _pendingDelete;
    private BackupRow? _pendingRestore;
    private bool _busy;

    // The two Backups sub-tabs, with the active one retained as a durable
    // preference so the panel reopens on the same sub-tab.
    private enum BackupsSubTab { New, Existing }

    private BackupsSubTab _activeSubTab = BackupsSubTab.New;
    private bool _subTabRestored;
    private const string SubTabStateKey = "backups-subtab";

    // The Existing Backups row the user has selected (by display id); its
    // restore/delete controls are the only ones shown. Null when no row is
    // selected.
    private string? _selectedRowId;

    // Display ids of backups created by the most recent successful capture, so
    // the Existing Backups tab can highlight them right after creation.
    private readonly HashSet<string> _highlightedBackupIds = new(StringComparer.Ordinal);

    private bool HasSelection => _selectedTrees.Count > 0;
    private bool HasName => !string.IsNullOrWhiteSpace(_captureName);

    // Existing Backups paging + filter state. The list is served newest-first,
    // ten rows to a page, with the filter predicates pushed into the server scan.
    private const int ExistingPageSize = 10;
    private string _filterName = string.Empty;
    private string _filterCreated = string.Empty;
    private string _filterKind = string.Empty;
    private string _filterScope = string.Empty;

    // The current page's backups collapsed into display rows, folding each backup
    // set's per-tree members (sharing a stamped SetId) into a single row.
    private IReadOnlyList<BackupRow> Rows => BackupRowGrouping.Group(_pager.Current.Entries);

    // The full standalone backups an incremental capture may build on, gathered
    // across the whole catalog (not just the current page).
    private IReadOnlyList<BackupManifest> FullBackups => _summary.FullBackups;

    private bool HasActiveFilter =>
        !string.IsNullOrEmpty(_filterName)
        || !string.IsNullOrEmpty(_filterCreated)
        || !string.IsNullOrEmpty(_filterKind)
        || !string.IsNullOrEmpty(_filterScope);

    private string EmptyMessage => HasActiveFilter
        ? "No backups match the filters."
        : "No backups are visible.";

    private BackupCatalogFilter CurrentFilter => new()
    {
        Kind = Enum.TryParse<BackupKind>(_filterKind, out var kind) ? kind : null,
        Scope = string.IsNullOrEmpty(_filterScope) ? null : _filterScope,
        NamePrefix = string.IsNullOrEmpty(_filterName) ? null : _filterName,
        CreatedPrefix = string.IsNullOrEmpty(_filterCreated) ? null : _filterCreated,
    };

    // A one-line description of the selected restore mode for the confirmation
    // dialog, so the user sees exactly what the restore will do to the target.
    private string RestoreModeDescription => _restoreMode == LatticeRestoreMode.ShadowCutover
        ? "shadow-cutover (point-in-time: the tree is rebuilt from the backup and post-backup writes are dropped)"
        : "in-place (merge: the backup is merged by last-writer-wins and post-backup writes are kept)";

    // Scheduling attaches a recurring capture to a single tree; it is not offered
    // for a multi-tree backup set (mirroring the incremental single-tree rule).
    private bool CanSchedule => _selectedTrees.Count == 1;

    private TimeSpan ScheduleInterval => new(hours: _scheduleHours, minutes: _scheduleMinutes, seconds: 0);

    private bool CanBackup
    {
        get
        {
            if (_busy || !HasSelection || !HasName)
            {
                return false;
            }

            if (_scheduleEnabled && (!CanSchedule || ScheduleInterval <= TimeSpan.Zero))
            {
                return false;
            }

            if (_captureKind == BackupKind.Incremental)
            {
                return _selectedTrees.Count == 1
                    && !string.IsNullOrWhiteSpace(_incrementalBaseId);
            }

            return true;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _pager = new BackupCatalogPager(Reader);
        await LoadTreesAsync();
        await ReloadAsync();

        // Restore the prior active sub-tab so the panel reopens where it was.
        // Tolerant of an unreachable backing store (server prerender); the
        // first-render fallback re-applies once browser storage is reachable.
        await Preferences.EnsureLoadedAsync();
        RestoreSubTab();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _subTabRestored)
        {
            return;
        }

        await Preferences.EnsureLoadedAsync();

        // Restore the retained sub-tab if the mirror hydrated; otherwise fall
        // back to the default so a body renders rather than staying blank when
        // browser storage is unreachable (for example with JavaScript disabled).
        RestoreSubTab();
        if (!_subTabRestored)
        {
            _subTabRestored = true;
        }

        StateHasChanged();
    }

    private void RestoreSubTab()
    {
        if (_subTabRestored || !Preferences.IsLoaded)
        {
            return;
        }

        _subTabRestored = true;
        _activeSubTab = Preferences.GetOrDefault(SubTabStateKey, BackupsSubTab.New);
    }

    private async Task SetSubTab(BackupsSubTab tab)
    {
        if (_activeSubTab == tab)
        {
            return;
        }

        _activeSubTab = tab;
        await Preferences.SetAsync(SubTabStateKey, tab);
        StateHasChanged();
    }

    // Clicking a row selects it (revealing its restore/delete controls); clicking
    // the selected row again clears the selection. Interacting with the table
    // also drops the just-created highlight.
    private void SelectRow(BackupRow row)
    {
        _selectedRowId = string.Equals(_selectedRowId, row.DisplayId, StringComparison.Ordinal)
            ? null
            : row.DisplayId;
        _highlightedBackupIds.Clear();
    }

    private async Task LoadTreesAsync()
    {
        var trees = new List<CatalogItem>();
        string? token = null;
        try
        {
            do
            {
                var page = await Catalog.LoadAsync(CatalogKind.Trees, token, pageSize: 200);
                trees.AddRange(page.Items);
                token = page.NextPageToken;
            }
            while (token is not null);
        }
        catch (Exception)
        {
            // Leave the tree list empty on a discovery failure; the area still
            // lists any visible backups and the user can retry with Refresh.
        }

        _availableTrees = trees;
    }

    // Ordinary (non-shadow) trees render as flat options; restore-shadow trees
    // are grouped under an optgroup labelled by the logical tree they were
    // restored for, keyed off the first-class RestoreShadowOfTreeId marker rather
    // than the tree name.
    private IEnumerable<CatalogItem> OrdinaryTrees =>
        _availableTrees.Where(t => !t.IsRestoreShadow);

    private IEnumerable<IGrouping<string, CatalogItem>> RestoreShadowGroups =>
        _availableTrees
            .Where(t => t.IsRestoreShadow)
            .GroupBy(t => t.RestoreShadowOfTreeId!, StringComparer.Ordinal)
            .OrderBy(g => g.Key, StringComparer.Ordinal);

    private void AddTree(string id)
    {
        if (!_selectedTrees.Contains(id))
        {
            _selectedTrees.Add(id);
        }

        if (!CanSchedule)
        {
            _scheduleEnabled = false;
        }
    }

    private void RemoveTree(string id)
    {
        _selectedTrees.Remove(id);

        if (!CanSchedule)
        {
            _scheduleEnabled = false;
        }
    }

    private static int ParseInterval(object? value, int min, int max)
    {
        if (int.TryParse(value?.ToString(), out var parsed))
        {
            return Math.Clamp(parsed, min, max);
        }

        return min;
    }

    private void SetKind(BackupKind kind)
    {
        _captureKind = kind;
        if (kind == BackupKind.Full)
        {
            // Full captures carry no base; clear the base selector.
            _incrementalBaseId = string.Empty;
        }
    }

    private async Task ReloadAsync()
    {
        _busy = true;
        try
        {
            _summary = await Reader.LoadSummaryAsync();
            await _pager.ResetAsync(ExistingPageSize, CurrentFilter);
            _highlightedBackupIds.Clear();
        }
        finally
        {
            _busy = false;
        }
    }

    // Re-runs the current filter from the first page, gathering fresh facets. Used
    // after a capture / restore / delete so the list and drop-downs stay accurate.
    private async Task RefreshListAsync()
    {
        _summary = await Reader.LoadSummaryAsync();
        await _pager.ResetAsync(ExistingPageSize, CurrentFilter);
    }

    private async Task OnNameFilterChanged(string value)
    {
        _filterName = value;
        await ApplyFilterAsync();
    }

    private async Task OnCreatedFilterChanged(string value)
    {
        _filterCreated = value;
        await ApplyFilterAsync();
    }

    private async Task OnKindFilterChanged(ChangeEventArgs e)
    {
        _filterKind = e.Value?.ToString() ?? string.Empty;
        await ApplyFilterAsync();
    }

    private async Task OnScopeFilterChanged(ChangeEventArgs e)
    {
        _filterScope = e.Value?.ToString() ?? string.Empty;
        await ApplyFilterAsync();
    }

    // A filter change reopens the listing from the first page; the row selection
    // and just-created highlight are dropped since they may no longer be visible.
    private async Task ApplyFilterAsync()
    {
        _selectedRowId = null;
        _highlightedBackupIds.Clear();
        _busy = true;
        try
        {
            await _pager.ResetAsync(ExistingPageSize, CurrentFilter);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task NextPageAsync()
    {
        _busy = true;
        try
        {
            await _pager.NextAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void PreviousPage() => _pager.Previous();

    private async Task BackupAsync()
    {
        var trees = _selectedTrees.ToList();
        var scheduleThisRun = _scheduleEnabled && CanSchedule && ScheduleInterval > TimeSpan.Zero;

        // Snapshot the current rows so the newly created backup can be
        // highlighted once the list reloads after a successful capture.
        var beforeIds = Rows.Select(r => r.DisplayId).ToHashSet(StringComparer.Ordinal);

        if (_captureKind == BackupKind.Incremental)
        {
            var scope = BackupScopeSelector.WholeTree(trees[0]);
            var capture = (Func<Task<BackupOperationResult>>)(() => Reader.TriggerIncrementalAsync(
                _captureName, scope, _incrementalBaseId));
            await RunCaptureAsync(capture, scheduleThisRun, scope, incremental: true);
        }
        else if (trees.Count == 1)
        {
            var scope = BackupScopeSelector.WholeTree(trees[0]);
            var capture = (Func<Task<BackupOperationResult>>)(() => Reader.TriggerFullAsync(_captureName, scope));
            await RunCaptureAsync(capture, scheduleThisRun, scope, incremental: false);
        }
        else
        {
            // More than one tree implies a cross-tree consistent backup set.
            var scopes = trees.Select(BackupScopeSelector.WholeTree).ToList();
            await RunAsync(() => Reader.TriggerSetAsync(_captureName, scopes, crossTreeConsistent: true));
        }

        await RevealNewBackupAsync(beforeIds);
    }

    // After a successful capture, switch to the Existing Backups tab and
    // highlight (and select) the backup that was just created.
    private async Task RevealNewBackupAsync(HashSet<string> beforeIds)
    {
        if (_lastResult is not { Status: BackupOperationStatus.Succeeded })
        {
            return;
        }

        _highlightedBackupIds.Clear();
        foreach (var id in Rows.Select(r => r.DisplayId).Where(id => !beforeIds.Contains(id)))
        {
            _highlightedBackupIds.Add(id);
        }

        _selectedRowId = _highlightedBackupIds.Count > 0 ? _highlightedBackupIds.First() : null;
        _activeSubTab = BackupsSubTab.Existing;
        await Preferences.SetAsync(SubTabStateKey, _activeSubTab);
    }

    // Captures now and, when a recurring schedule was requested, also registers
    // it for the same scope and kind, surfacing a combined result.
    private async Task RunCaptureAsync(
        Func<Task<BackupOperationResult>> capture,
        bool schedule,
        BackupScopeSelector scope,
        bool incremental)
    {
        if (!schedule)
        {
            await RunAsync(capture);
            return;
        }

        var interval = ScheduleInterval;
        await RunManyAsync(
            new[]
            {
                capture,
                (Func<Task<BackupOperationResult>>)(() => Reader.ScheduleAsync(scope, incremental, interval)),
            },
            $"Captured backup and scheduled a recurring {(incremental ? "incremental" : "full")} backup.");
    }

    private void RequestRestore(BackupRow row)
    {
        _pendingRestore = row;
    }

    private void CancelRestore()
    {
        _pendingRestore = null;
    }

    private async Task ConfirmRestoreAsync()
    {
        var row = _pendingRestore;
        if (row is null)
        {
            return;
        }

        _pendingRestore = null;
        await RestoreRowAsync(row);
    }

    private async Task RestoreRowAsync(BackupRow row)
    {
        if (!row.IsSet)
        {
            var manifest = row.Members[0];
            await RunAsync(() => Reader.RestoreAsync(manifest.Id, RestoreTargetFor(manifest), _restoreMode));
            return;
        }

        // A set restores every member back to its own tree in the chosen mode.
        var members = row.Members;
        await RunManyAsync(
            members.Select(m => (Func<Task<BackupOperationResult>>)(
                () => Reader.RestoreAsync(m.Id, m.Scope.TreeId, _restoreMode))),
            $"Restored {members.Count} member backups to their trees.");
    }

    // The restore target defaults to the backup's own scope tree, so an in-place
    // restore back into the original tree is one click; the user can retype it to
    // restore elsewhere. Tracked per backup id so each row keeps its own edit.
    private string RestoreTargetFor(BackupManifest manifest) =>
        _restoreTargets.TryGetValue(manifest.Id, out var target) ? target : manifest.Scope.TreeId;

    private void SetRestoreTarget(string backupId, string? value) =>
        _restoreTargets[backupId] = value ?? string.Empty;

    private void OnRestoreModeChanged(ChangeEventArgs e)
    {
        _restoreMode = Enum.TryParse<LatticeRestoreMode>(e.Value?.ToString(), out var mode)
            ? mode
            : LatticeRestoreMode.InPlace;
    }

    private void RequestDelete(BackupRow row)
    {
        _pendingDelete = row;
    }

    private void CancelDelete()
    {
        _pendingDelete = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        var row = _pendingDelete;
        if (row is null)
        {
            return;
        }

        _pendingDelete = null;

        if (!row.IsSet)
        {
            await RunAsync(() => Reader.DeleteAsync(row.Members[0].Id));
            return;
        }

        // Deleting a set removes every member backup.
        var members = row.Members;
        await RunManyAsync(
            members.Select(m => (Func<Task<BackupOperationResult>>)(() => Reader.DeleteAsync(m.Id))),
            $"Deleted {members.Count} member backups.");
    }

    private async Task RunAsync(Func<Task<BackupOperationResult>> action)
    {
        _busy = true;
        try
        {
            _lastResult = await action();
            await RefreshListAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    // Runs a sequence of operations for a backup set, stopping at the first
    // non-success, then reloads the list once. On full success the aggregate
    // message is reported; otherwise the failing / denied result is surfaced.
    private async Task RunManyAsync(IEnumerable<Func<Task<BackupOperationResult>>> actions, string successMessage)
    {
        _busy = true;
        try
        {
            BackupOperationResult? last = null;
            foreach (var action in actions)
            {
                last = await action();
                if (last.Status != BackupOperationStatus.Succeeded)
                {
                    break;
                }
            }

            _lastResult = last is { Status: BackupOperationStatus.Succeeded }
                ? BackupOperationResult.Success(successMessage)
                : last;
            await RefreshListAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static string Shorten(string id) => id.Length <= 12 ? id : id[..12] + "...";

    private static string ResultClass(BackupOperationStatus status) => status switch
    {
        BackupOperationStatus.Succeeded => "is-success",
        BackupOperationStatus.Denied => "is-denied",
        _ => "is-failed",
    };
}
