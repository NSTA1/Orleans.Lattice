@using Orleans.Lattice.Api.Backup
@using Orleans.Lattice.Backup
@using Orleans.Lattice.Explorer.Backup
@using Orleans.Lattice.Explorer.Core.Catalog
@using Orleans.Lattice.Explorer.Core.Navigation
@using Orleans.Lattice.Explorer.Core.Session
@inject IBackupCatalogReader Reader
@inject ICatalogReader Catalog
@inject IUiPreferenceStore Preferences

@*
    The Backups management area: lists the visible backup catalog and triggers
    capture, restore, and delete operations. A capture targets one or more trees
    selected from the cluster's tree list; a multi-tree capture is a backup set,
    optionally captured at a single cross-tree causal fence. No client-side
    permission pre-check gates the controls: the server is the fail-closed
    enforcement point, so every action folds a server denial into a clean "not
    permitted" status message rather than surfacing an unhandled error.
*@

<section class="explorer-backups" aria-label="Backups">
    <header class="explorer-backups-header">
        <button type="button" class="explorer-btn" disabled="@_busy" @onclick="ReloadAsync">Refresh</button>
    </header>

    @if (_lastResult is not null)
    {
        <p class="explorer-backups-result @ResultClass(_lastResult.Status)" role="status">@_lastResult.Message</p>
    }

    <div class="explorer-tabstrip" role="tablist" aria-label="Backups tabs">
        <button type="button" role="tab"
                class="explorer-tab @(_subTabRestored && _activeSubTab == BackupsSubTab.New ? "is-active" : null)"
                aria-selected="@(_subTabRestored && _activeSubTab == BackupsSubTab.New)"
                @onclick="@(() => SetSubTab(BackupsSubTab.New))">New Backup</button>
        <button type="button" role="tab"
                class="explorer-tab @(_subTabRestored && _activeSubTab == BackupsSubTab.Existing ? "is-active" : null)"
                aria-selected="@(_subTabRestored && _activeSubTab == BackupsSubTab.Existing)"
                @onclick="@(() => SetSubTab(BackupsSubTab.Existing))">Existing Backups</button>
    </div>

    @if (!_subTabRestored)
    {
        <div class="explorer-backups-body" aria-busy="true"></div>
    }
    else if (_activeSubTab == BackupsSubTab.New)
    {
        <div class="explorer-backups-new">
            <div class="explorer-backups-treecol">
                <span class="explorer-backups-picker-label">Trees</span>
                @if (OrdinaryTrees.Any() || RestoreShadowGroups.Any())
                {
                    <ul class="explorer-nav-list" role="listbox" aria-label="Available trees">
                        @foreach (var tree in OrdinaryTrees)
                        {
                            var selected = _selectedTrees.Contains(tree.Id);
                            <li role="option" aria-selected="@selected">
                                <button type="button"
                                        class="explorer-nav-item @(selected ? "is-selected" : null)"
                                        disabled="@_busy"
                                        @onclick="@(() => AddTree(tree.Id))">
                                    <span class="explorer-nav-item-id">@tree.Id</span>
                                </button>
                            </li>
                        }
                        @foreach (var group in RestoreShadowGroups)
                        {
                            <li class="explorer-backups-treegroup" role="presentation">@group.Key (restore shadows)</li>
                            @foreach (var shadow in group)
                            {
                                var selected = _selectedTrees.Contains(shadow.Id);
                                <li role="option" aria-selected="@selected">
                                    <button type="button"
                                            class="explorer-nav-item @(selected ? "is-selected" : null)"
                                            disabled="@_busy"
                                            @onclick="@(() => AddTree(shadow.Id))">
                                        <span class="explorer-nav-item-id">@shadow.Id</span>
                                    </button>
                                </li>
                            }
                        }
                    </ul>
                }
                else
                {
                    <p class="explorer-backups-empty">No trees are visible.</p>
                }
            </div>

            <div class="explorer-backups-form">
                <table class="explorer-backups-actionpanel-table explorer-backups-newtable">
                    <tbody>
                        <tr>
                            <td class="explorer-backups-actionpanel-label">Name</td>
                            <td>
                                <input type="text" value="@_captureName" @oninput="e => _captureName = e.Value?.ToString() ?? string.Empty" placeholder="backup name" />
                            </td>
                        </tr>

                        <tr>
                            <td class="explorer-backups-actionpanel-label">Included in backup</td>
                            <td>
                                @if (_selectedTrees.Count == 0)
                                {
                                    <p class="explorer-backups-empty">Select one or more trees from the list.</p>
                                }
                                else
                                {
                                    <ul class="explorer-backups-selected-list">
                                        @foreach (var id in _selectedTrees)
                                        {
                                            <li>
                                                <button type="button" class="explorer-btn explorer-btn-icon explorer-backups-remove"
                                                        title="Remove tree" aria-label="@($"Remove {id}")"
                                                        disabled="@_busy"
                                                        @onclick="@(() => RemoveTree(id))">x</button>
                                                <span class="explorer-backups-selected-id">@id</span>
                                            </li>
                                        }
                                    </ul>
                                    @if (_selectedTrees.Count > 1)
                                    {
                                        <p class="explorer-backups-note">Multiple trees are captured as a cross-tree consistent backup set.</p>
                                    }
                                }
                            </td>
                        </tr>

                        <tr>
                            <td class="explorer-backups-actionpanel-label">Kind</td>
                            <td>
                                <fieldset class="explorer-backups-kind" aria-label="Backup kind">
                                    <label>
                                        <input type="radio" name="backup-kind" checked="@(_captureKind == BackupKind.Full)"
                                               @onchange="@(() => SetKind(BackupKind.Full))" />
                                        Full
                                    </label>
                                    <label>
                                        <input type="radio" name="backup-kind" checked="@(_captureKind == BackupKind.Incremental)"
                                               @onchange="@(() => SetKind(BackupKind.Incremental))" />
                                        Incremental
                                    </label>
                                </fieldset>
                            </td>
                        </tr>

                        @if (_captureKind == BackupKind.Incremental)
                        {
                            <tr>
                                <td class="explorer-backups-actionpanel-label">Base backup</td>
                                <td>
                                    <div class="explorer-backups-basecell">
                                        <select value="@_incrementalBaseId" @onchange="e => _incrementalBaseId = e.Value?.ToString() ?? string.Empty"
                                                disabled="@(IncrementalTree is null || _baseBackups.Count == 0)">
                                            <option value="">(select a full backup)</option>
                                            @foreach (var full in _baseBackups)
                                            {
                                                <option value="@full.Id">@Shorten(full.Id) - @full.Name</option>
                                            }
                                        </select>
                                        @if (IncrementalTree is { } baseTree && _baseBackups.Count == 0)
                                        {
                                            <span class="explorer-backups-warning" role="alert">
                                                No full backup exists for tree '@baseTree'. Create a full backup first.
                                            </span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }

                        <tr>
                            <td class="explorer-backups-actionpanel-label">Schedule</td>
                            <td>
                                <fieldset class="explorer-backups-schedule" aria-label="Recurring schedule">
                                    <label title="Also register a recurring backup of the selected tree at the interval below.">
                                        <input type="checkbox" checked="@_scheduleEnabled"
                                               @onchange="e => _scheduleEnabled = (bool?)e.Value ?? false"
                                               disabled="@(!CanSchedule)" />
                                        Schedule recurring
                                    </label>
                                    <label>
                                        Every
                                        <input type="number" min="0" max="168" value="@_scheduleHours"
                                               @oninput="e => _scheduleHours = ParseInterval(e.Value, 0, 168)"
                                               disabled="@(!_scheduleEnabled || !CanSchedule)" aria-label="Interval hours" />
                                        h
                                    </label>
                                    <label>
                                        <input type="number" min="0" max="59" value="@_scheduleMinutes"
                                               @oninput="e => _scheduleMinutes = ParseInterval(e.Value, 0, 59)"
                                               disabled="@(!_scheduleEnabled || !CanSchedule)" aria-label="Interval minutes" />
                                        m
                                    </label>
                                </fieldset>
                            </td>
                        </tr>

                        <tr>
                            <td class="explorer-backups-actionpanel-label"></td>
                            <td>
                                <button type="button" class="explorer-btn explorer-btn-primary"
                                        disabled="@(!CanBackup)" @onclick="BackupAsync">Backup</button>

                                @if (_scheduleEnabled && !CanSchedule)
                                {
                                    <p class="explorer-backups-hint">A recurring schedule targets a single tree - select exactly one tree.</p>
                                }
                                else if (_scheduleEnabled && ScheduleInterval <= TimeSpan.Zero)
                                {
                                    <p class="explorer-backups-hint">Set a schedule interval greater than zero.</p>
                                }

                                @if (_captureKind == BackupKind.Incremental && _selectedTrees.Count > 1)
                                {
                                    <p class="explorer-backups-hint">An incremental backup targets a single tree - select exactly one tree.</p>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="explorer-backups-body">
            @if (_pager.Current.Status == BackupOperationStatus.Denied)
            {
                <p class="explorer-backups-empty">You are not permitted to list backups here.</p>
            }
            else if (_pager.Current.Status == BackupOperationStatus.Failed)
            {
                <p class="explorer-backups-empty">@_pager.Current.Message</p>
            }
            else
            {
                <table class="explorer-table explorer-backups-table">
                    <thead>
                        <tr>
                            <th>Name</th><th>Kind</th><th>Scope</th><th>Created</th>
                            @if (_healthAvailable)
                            {
                                <th>Health</th>
                            }
                        </tr>
                        <tr class="explorer-backups-filterrow">
                            <th>
                                <BackupFilterBox Placeholder="Name starts with..." InitialValue="@_filterName"
                                                 OnFilter="OnNameFilterChanged" />
                            </th>
                            <th>
                                <select class="explorer-backups-filter-select" value="@_filterKind"
                                        disabled="@_busy" @onchange="OnKindFilterChanged" aria-label="Filter by kind">
                                    <option value="">(any)</option>
                                    @foreach (var kind in _summary.Kinds)
                                    {
                                        <option value="@kind">@kind</option>
                                    }
                                </select>
                            </th>
                            <th>
                                <select class="explorer-backups-filter-select" value="@_filterScope"
                                        disabled="@_busy" @onchange="OnScopeFilterChanged" aria-label="Filter by scope">
                                    <option value="">(any)</option>
                                    @foreach (var scope in _summary.Scopes)
                                    {
                                        <option value="@scope">@scope</option>
                                    }
                                </select>
                            </th>
                            <th>
                                <BackupFilterBox Placeholder="Created starts with..." InitialValue="@_filterCreated"
                                                 OnFilter="OnCreatedFilterChanged" />
                            </th>
                            @if (_healthAvailable)
                            {
                                <th></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Rows.Count == 0)
                        {
                            <tr><td colspan="@(_healthAvailable ? 5 : 4)" class="explorer-backups-empty">@EmptyMessage</td></tr>
                        }
                        else
                        {
                            @foreach (var row in Rows)
                            {
                                var isSelected = string.Equals(_selectedRowId, row.DisplayId, StringComparison.Ordinal);
                                var isNew = _highlightedBackupIds.Contains(row.DisplayId);
                                <tr class="explorer-backups-row @(isSelected ? "is-selected" : null) @(isNew ? "is-new" : null)"
                                    @onclick="@(() => SelectRow(row))">
                                    <td>@row.Name</td>
                                    <td>@row.Kind</td>
                                    <td>@(row.IsSet ? string.Join(", ", row.TreeIds) : row.Members[0].Scope.TreeId)</td>
                                    <td title="@row.CreatedAtUtc.UtcDateTime.ToString("u")">@row.CreatedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    @if (_healthAvailable)
                                    {
                                        var health = RowHealth(row);
                                        <td class="explorer-backups-health">
                                            @if (health is null || health.Status == BackupHealthStatus.Unknown)
                                            {
                                                <span class="explorer-health-dot explorer-health-unknown" title="Not yet verified">-</span>
                                            }
                                            else if (health.Status == BackupHealthStatus.Healthy)
                                            {
                                                <span class="explorer-health-dot explorer-health-ok" title="Healthy (verified @health.CheckedAtUtc.UtcDateTime.ToString("u"))">OK</span>
                                            }
                                            else
                                            {
                                                <button type="button" class="explorer-health-dot explorer-health-warn"
                                                        title="@(health.Status == BackupHealthStatus.Missing ? "Manifest missing - click for details" : "Unresolvable - click for details")"
                                                        @onclick:stopPropagation="true"
                                                        @onclick="@(() => OpenHealthDialog(health))">!</button>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                <div class="explorer-data-pager">
                    <button type="button" class="explorer-btn" disabled="@(_busy || !_pager.CanGoPrevious)" @onclick="PreviousPage">Prev</button>
                    <span class="explorer-data-pagenum">Page @(_pager.PageIndex + 1)</span>
                    <button type="button" class="explorer-btn" disabled="@(_busy || !_pager.CanGoNext)" @onclick="NextPageAsync">Next</button>
                </div>

                @if (SelectedRow is { } selected)
                {
                    <div class="explorer-backups-actionpanel">
                        <h4 class="explorer-backups-actionpanel-title">Actions</h4>
                        <table class="explorer-backups-actionpanel-table">
                            <tbody>
                                @if (!selected.IsSet)
                                {
                                    var manifest = selected.Members[0];
                                    <tr>
                                        <td class="explorer-backups-actionpanel-label">Target tree</td>
                                        <td><input type="text" value="@RestoreTargetFor(manifest)" @oninput="e => SetRestoreTarget(manifest.Id, e.Value?.ToString())" placeholder="target tree" /></td>
                                    </tr>
                                }
                                @if (selected.IsIncrementalChain)
                                {
                                    <tr>
                                        <td class="explorer-backups-actionpanel-label">Restore point</td>
                                        <td>
                                            <select class="explorer-backups-restore-point" value="@SelectedRestorePoint(selected)"
                                                    @onchange="e => OnRestorePointChanged(selected, e)" title="Restore point (point in time)">
                                                @foreach (var member in ChainMembersNewestFirst(selected))
                                                {
                                                    <option value="@member.Id">@member.CreatedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</option>
                                                }
                                            </select>
                                        </td>
                                    </tr>
                                }
                                <tr>
                                    <td class="explorer-backups-actionpanel-label">Restore mode</td>
                                    <td>
                                        <select class="explorer-backups-restore-mode" value="@_restoreMode"
                                                @onchange="OnRestoreModeChanged" title="Restore mode">
                                            <option value="@LatticeRestoreMode.InPlace">Repair missing items (non-destructive)</option>
                                            <option value="@LatticeRestoreMode.ShadowCutover">Point-in-time replace (destructive)</option>
                                        </select>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="explorer-backups-actionpanel-label"></td>
                                    <td>
                                        <button type="button" class="explorer-btn"
                                                disabled="@(_busy || (!selected.IsSet && string.IsNullOrWhiteSpace(RestoreTargetFor(selected.Members[0]))))"
                                                @onclick="@(() => RequestRestore(selected))">Restore</button>
                                        <button type="button" class="explorer-btn explorer-btn-danger"
                                                disabled="@_busy"
                                                @onclick="@(() => RequestDelete(selected))">Delete</button>
                                        @if (!selected.IsSet)
                                        {
                                            <button type="button" class="explorer-btn"
                                                    disabled="@_busy"
                                                    @onclick="@(() => OpenScheduleAsync(selected))"
                                                    title="Edit or remove this scope's recurring backup schedule">Schedule</button>
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    }

    @if (_pendingDelete is not null)
    {
        <div class="explorer-modal-backdrop" role="presentation">
            <div class="explorer-modal" role="alertdialog" aria-modal="true" aria-labelledby="explorer-delete-title">
                <h3 id="explorer-delete-title">Delete backup?</h3>
                @if (_pendingDelete.IsIncrementalChain)
                {
                    var chainCount = _chainCache.TryGetValue(_pendingDelete.Members[0].Id, out var members)
                        ? members.Count
                        : _pendingDelete.Members.Count;
                    <p>
                        This permanently deletes all @chainCount backups in the incremental
                        chain <code>@Shorten(_pendingDelete.DisplayId)</code>
                        ('@_pendingDelete.Name') - the base full backup and every increment.
                        <strong>This action cannot be undone.</strong>
                    </p>
                }
                else if (_pendingDelete.IsSet)
                {
                    <p>
                        This permanently deletes all @_pendingDelete.Members.Count member backups
                        of set <code>@Shorten(_pendingDelete.DisplayId)</code>
                        ('@_pendingDelete.Name'). <strong>This action cannot be undone.</strong>
                    </p>
                }
                else
                {
                    <p>
                        This permanently deletes backup <code>@Shorten(_pendingDelete.DisplayId)</code>
                        ('@_pendingDelete.Name'). <strong>This action cannot be undone.</strong>
                    </p>
                }
                <div class="explorer-modal-actions">
                    <button type="button" class="explorer-btn" disabled="@_busy" @onclick="CancelDelete">Cancel</button>
                    <button type="button" class="explorer-btn explorer-btn-danger" disabled="@_busy" @onclick="ConfirmDeleteAsync">Delete</button>
                </div>
            </div>
        </div>
    }

    @if (_pendingRestore is not null)
    {
        <div class="explorer-modal-backdrop" role="presentation">
            <div class="explorer-modal" role="alertdialog" aria-modal="true" aria-labelledby="explorer-restore-title">
                <h3 id="explorer-restore-title">Restore backup?</h3>
                @if (_pendingRestore.IsIncrementalChain)
                {
                    var restoreId = SelectedRestorePoint(_pendingRestore);
                    var point = ChainMembersNewestFirst(_pendingRestore).FirstOrDefault(m => string.Equals(m.Id, restoreId, StringComparison.Ordinal));
                    <p>
                        This restores the incremental chain
                        '@_pendingRestore.Name' as at
                        <strong>@((point?.CreatedAtUtc ?? _pendingRestore.CreatedAtUtc).UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss"))</strong>
                        into tree <strong>@RestoreTargetFor(_pendingRestore.Members[0])</strong>,
                        @RestoreModeDescription.
                    </p>
                }
                else if (_pendingRestore.IsSet)
                {
                    <p>
                        This restores each of the @_pendingRestore.Members.Count member backups
                        of set <code>@Shorten(_pendingRestore.DisplayId)</code>
                        ('@_pendingRestore.Name') back into its own tree, @RestoreModeDescription:
                    </p>
                    <ul>
                        @foreach (var member in _pendingRestore.Members)
                        {
                            <li><code>@Shorten(member.Id)</code> into tree <strong>@member.Scope.TreeId</strong></li>
                        }
                    </ul>
                }
                else
                {
                    <p>
                        This restores backup <code>@Shorten(_pendingRestore.DisplayId)</code>
                        ('@_pendingRestore.Name') into tree
                        <strong>@RestoreTargetFor(_pendingRestore.Members[0])</strong>,
                        @RestoreModeDescription.
                    </p>
                }
                <div class="explorer-modal-actions">
                    <button type="button" class="explorer-btn" disabled="@_busy" @onclick="CancelRestore">Cancel</button>
                    <button type="button" class="explorer-btn explorer-btn-primary" disabled="@_busy" @onclick="ConfirmRestoreAsync">Proceed</button>
                </div>
            </div>
        </div>
    }

    @if (_pendingSchedule is not null)
    {
        <div class="explorer-modal-backdrop" role="presentation">
            <div class="explorer-modal" role="dialog" aria-modal="true" aria-labelledby="explorer-schedule-title">
                <h3 id="explorer-schedule-title">Manage schedule</h3>
                <p>
                    Recurring backup schedule for tree
                    <strong>@_pendingSchedule.Members[0].Scope.TreeId</strong>.
                </p>
                @if (_scheduleLoading)
                {
                    <p class="explorer-backups-hint">Loading schedule...</p>
                }
                else
                {
                    var scheduleIncremental = _pendingSchedule.Kind == BackupKind.Incremental;
                    if (!scheduleIncremental)
                    {
                        <fieldset class="explorer-backups-schedule" aria-label="Full backup schedule">
                            <legend>Full backup @(( _scheduleStatus?.FullScheduleRegistered ?? false) ? "(scheduled)" : "(not scheduled)")</legend>
                            <label>
                                Every
                                <input type="number" min="0" max="168" value="@_editFullHours"
                                       @oninput="e => _editFullHours = ParseInterval(e.Value, 0, 168)"
                                       disabled="@_busy" aria-label="Full interval hours" /> h
                            </label>
                            <label>
                                <input type="number" min="0" max="59" value="@_editFullMinutes"
                                       @oninput="e => _editFullMinutes = ParseInterval(e.Value, 0, 59)"
                                       disabled="@_busy" aria-label="Full interval minutes" /> m
                            </label>
                            <button type="button" class="explorer-btn explorer-btn-primary"
                                    disabled="@(_busy || EditFullInterval <= TimeSpan.Zero)"
                                    @onclick="@(() => SaveScheduleAsync(incremental: false))">Save</button>
                            @if (_scheduleStatus?.FullScheduleRegistered ?? false)
                            {
                                <button type="button" class="explorer-btn explorer-btn-danger"
                                        disabled="@_busy"
                                        @onclick="@(() => RemoveScheduleAsync(incremental: false))">Remove</button>
                            }
                        </fieldset>
                    }
                    else
                    {
                        <fieldset class="explorer-backups-schedule" aria-label="Incremental backup schedule">
                            <legend>Incremental backup @(( _scheduleStatus?.IncrementalScheduleRegistered ?? false) ? "(scheduled)" : "(not scheduled)")</legend>
                            <label>
                                Every
                                <input type="number" min="0" max="168" value="@_editIncHours"
                                       @oninput="e => _editIncHours = ParseInterval(e.Value, 0, 168)"
                                       disabled="@_busy" aria-label="Incremental interval hours" /> h
                            </label>
                            <label>
                                <input type="number" min="0" max="59" value="@_editIncMinutes"
                                       @oninput="e => _editIncMinutes = ParseInterval(e.Value, 0, 59)"
                                       disabled="@_busy" aria-label="Incremental interval minutes" /> m
                            </label>
                            <button type="button" class="explorer-btn explorer-btn-primary"
                                    disabled="@(_busy || EditIncrementalInterval <= TimeSpan.Zero)"
                                    @onclick="@(() => SaveScheduleAsync(incremental: true))">Save</button>
                            @if (_scheduleStatus?.IncrementalScheduleRegistered ?? false)
                            {
                                <button type="button" class="explorer-btn explorer-btn-danger"
                                        disabled="@_busy"
                                        @onclick="@(() => RemoveScheduleAsync(incremental: true))">Remove</button>
                            }
                        </fieldset>
                    }

                    var relevantRegistered = scheduleIncremental
                        ? (_scheduleStatus?.IncrementalScheduleRegistered ?? false)
                        : (_scheduleStatus?.FullScheduleRegistered ?? false);
                    if (!relevantRegistered)
                    {
                        <p class="explorer-backups-hint">
                            No @(scheduleIncremental ? "incremental" : "full") backup schedule is registered for
                            this scope. Set an interval and click Save to register one, or create a scheduled
                            backup from the New Backup tab.
                        </p>
                    }

                    @if (_healthAvailable)
                    {
                        <fieldset class="explorer-backups-schedule" aria-label="Health monitoring">
                            <legend>Health monitoring</legend>
                            <label>
                                <input type="checkbox" checked="@_editHealthEnabled"
                                       @onchange="e => _editHealthEnabled = (bool)(e.Value ?? false)"
                                       disabled="@_busy" aria-label="Enable health monitoring" />
                                Verify this backup's sink payload periodically
                            </label>
                            <label>
                                Every
                                <input type="number" min="0" max="168" value="@_editHealthHours"
                                       @oninput="e => _editHealthHours = ParseInterval(e.Value, 0, 168)"
                                       disabled="@(_busy || !_editHealthEnabled)" aria-label="Health interval hours" /> h
                            </label>
                            <label>
                                <input type="number" min="0" max="59" value="@_editHealthMinutes"
                                       @oninput="e => _editHealthMinutes = ParseInterval(e.Value, 0, 59)"
                                       disabled="@(_busy || !_editHealthEnabled)" aria-label="Health interval minutes" /> m
                            </label>
                            <button type="button" class="explorer-btn explorer-btn-primary"
                                    disabled="@(_busy || (_editHealthEnabled && EditHealthInterval <= TimeSpan.Zero))"
                                    @onclick="SaveHealthConfigAsync">Save</button>
                        </fieldset>
                    }
                }
                <div class="explorer-modal-actions">
                    <button type="button" class="explorer-btn" disabled="@_busy" @onclick="CloseSchedule">Close</button>
                </div>
            </div>
        </div>
    }

    @if (_healthDialog is not null)
    {
        <div class="explorer-modal-backdrop" role="presentation">
            <div class="explorer-modal" role="dialog" aria-modal="true" aria-labelledby="explorer-health-title">
                <h3 id="explorer-health-title">Backup health</h3>
                <p>
                    Backup <strong>@_healthDialog.BackupId</strong> is
                    <strong>@_healthDialog.Status</strong>.
                </p>
                <p class="explorer-backups-hint">@_healthDialog.Explanation</p>
                @if (_healthDialog.MissingArtifactIds.Count > 0)
                {
                    <p><strong>Missing or uncommitted artifacts:</strong></p>
                    <ul class="explorer-health-list">
                        @foreach (var id in _healthDialog.MissingArtifactIds)
                        {
                            <li>@id</li>
                        }
                    </ul>
                }
                @if (_healthDialog.HashMismatchArtifactIds.Count > 0)
                {
                    <p><strong>Content-hash mismatches:</strong></p>
                    <ul class="explorer-health-list">
                        @foreach (var id in _healthDialog.HashMismatchArtifactIds)
                        {
                            <li>@id</li>
                        }
                    </ul>
                }
                <p class="explorer-backups-hint">Last checked @_healthDialog.CheckedAtUtc.UtcDateTime.ToString("u").</p>
                <div class="explorer-modal-actions">
                    <button type="button" class="explorer-btn explorer-btn-primary" disabled="@_busy"
                            @onclick="@(() => RecheckHealthAsync(_healthDialog.BackupId))">Re-check now</button>
                    <button type="button" class="explorer-btn" disabled="@_busy" @onclick="CloseHealthDialog">Close</button>
                </div>
            </div>
        </div>
    }
</section>

@code {
