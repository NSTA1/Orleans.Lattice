@using Microsoft.JSInterop
@using Orleans.Lattice.Api.Backup
@using Orleans.Lattice.Backup
@using Orleans.Lattice.Explorer.Core.Catalog
@using Orleans.Lattice.Explorer.Core.Navigation
@inject IBackupCatalogReader Reader
@inject IBackupCapabilityService CapabilityService
@inject ICatalogReader Catalog
@inject IJSRuntime JS

@*
    The Backups management area: lists the visible backup catalog, probes the
    per-scope capabilities to enable / disable the capture, restore, and delete
    controls, and triggers those operations. A capture targets one or more trees
    selected from the cluster's tree list; a multi-tree capture is a backup set,
    optionally captured at a single cross-tree causal fence. Every action folds a
    server denial into a clean "not permitted" message rather than surfacing an
    unhandled error, because the advisory capability map can be over-optimistic -
    the server is the fail-closed enforcement point.
*@

<section class="explorer-backups" aria-label="Backups">
    <header class="explorer-backups-header">
        <h2>Backups</h2>
        <button type="button" class="explorer-btn" disabled="@_busy" @onclick="ReloadAsync">Refresh</button>
    </header>

    @if (_lastResult is not null)
    {
        <p class="explorer-backups-result @ResultClass(_lastResult.Status)" role="status">@_lastResult.Message</p>
    }

    <div class="explorer-backups-scope">
        <label class="explorer-backups-trees">
            Scope trees
            <select multiple size="4" @onchange="OnTreesChanged" disabled="@_busy" aria-label="Scope trees">
                @foreach (var tree in _availableTrees)
                {
                    <option value="@tree" selected="@_selectedTrees.Contains(tree)">@tree</option>
                }
            </select>
        </label>
        <button type="button" class="explorer-btn"
                disabled="@(_busy || !HasSelection)" @onclick="CheckAccessAsync">Check access</button>

        <label>
            Name
            <input type="text" value="@_captureName" @oninput="e => _captureName = e.Value?.ToString() ?? string.Empty" placeholder="backup name" />
        </label>

        <fieldset class="explorer-backups-kind" aria-label="Backup kind">
            <label>
                <input type="radio" name="backup-kind" checked="@(_captureKind == BackupKind.Full)"
                       @onchange="@(() => SetKind(BackupKind.Full))" />
                Full
            </label>
            <label>
                <input type="radio" name="backup-kind" checked="@(_captureKind == BackupKind.Incremental)"
                       @onchange="@(() => SetKind(BackupKind.Incremental))" />
                Incremental
            </label>
        </fieldset>

        <label>
            Base backup
            <select value="@_incrementalBaseId" @onchange="e => _incrementalBaseId = e.Value?.ToString() ?? string.Empty"
                    disabled="@(_captureKind == BackupKind.Full)">
                <option value="">(select a full backup)</option>
                @foreach (var full in FullBackups)
                {
                    <option value="@full.Id">@Shorten(full.Id) - @full.Name (@full.Scope.TreeId)</option>
                }
            </select>
        </label>

        <label class="explorer-backups-fence" title="Capture every selected tree at a single cross-tree causal fence.">
            <input type="checkbox" checked="@_crossTreeConsistent"
                   @onchange="e => _crossTreeConsistent = (bool?)e.Value ?? false"
                   disabled="@(_captureKind == BackupKind.Incremental || _selectedTrees.Count < 2)" />
            Cross-tree consistent
        </label>

        <button type="button" class="explorer-btn explorer-btn-primary"
                disabled="@(!CanBackup)" @onclick="BackupAsync">Backup</button>
    </div>

    @if (_captureKind == BackupKind.Incremental && _selectedTrees.Count > 1)
    {
        <p class="explorer-backups-hint">An incremental backup targets a single tree - select exactly one tree.</p>
    }

    <div class="explorer-backups-body">
        @if (_list.Status == BackupOperationStatus.Denied)
        {
            <p class="explorer-backups-empty">You are not permitted to list backups here.</p>
        }
        else if (_list.Status == BackupOperationStatus.Failed)
        {
            <p class="explorer-backups-empty">@_list.Message</p>
        }
        else if (_list.Entries.Count == 0)
        {
            <p class="explorer-backups-empty">No backups are visible.</p>
        }
        else
        {
            <p class="explorer-backups-hint">
                Restore mode: <strong>In-place</strong> merges the backup into the
                target by last-writer-wins, so writes made after the backup was
                taken are kept. <strong>Shadow-cutover</strong> rebuilds the tree
                from the backup and swaps it in, so the restored tree holds exactly
                the backup contents (post-backup writes are dropped) - the
                point-in-time-recovery path.
            </p>
            <table class="explorer-table">
                <thead>
                    <tr>
                        <th>Id</th><th>Name</th><th>Kind</th><th>Scope</th><th>Created (UTC)</th><th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var manifest in _list.Entries)
                    {
                        <tr>
                            <td class="explorer-backups-id">
                                <span title="@manifest.Id">@Shorten(manifest.Id)</span>
                                <button type="button" class="explorer-btn explorer-btn-icon"
                                        title="Copy full id" aria-label="Copy id"
                                        @onclick="@(() => CopyIdAsync(manifest.Id))">Copy</button>
                            </td>
                            <td>@manifest.Name</td>
                            <td>@manifest.Kind</td>
                            <td>@manifest.Scope.TreeId</td>
                            <td>@manifest.CreatedAtUtc.UtcDateTime.ToString("u")</td>
                            <td class="explorer-backups-actions">
                                <input type="text" value="@_restoreTarget" @oninput="e => _restoreTarget = e.Value?.ToString() ?? string.Empty" placeholder="target tree" />
                                <select class="explorer-backups-restore-mode" value="@_restoreMode"
                                        @onchange="OnRestoreModeChanged" title="Restore mode">
                                    <option value="@LatticeRestoreMode.InPlace">In-place (merge)</option>
                                    <option value="@LatticeRestoreMode.ShadowCutover">Shadow-cutover (point-in-time)</option>
                                </select>
                                <button type="button" class="explorer-btn"
                                        disabled="@(!CanRestoreManifest(manifest) || string.IsNullOrWhiteSpace(_restoreTarget))"
                                        @onclick="@(() => RestoreAsync(manifest.Id))">Restore</button>
                                <button type="button" class="explorer-btn explorer-btn-danger"
                                        disabled="@(!CanDeleteManifest(manifest))"
                                        @onclick="@(() => RequestDelete(manifest))">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @if (_pendingDelete is not null)
    {
        <div class="explorer-modal-backdrop" role="presentation">
            <div class="explorer-modal" role="alertdialog" aria-modal="true" aria-labelledby="explorer-delete-title">
                <h3 id="explorer-delete-title">Delete backup?</h3>
                <p>
                    This permanently deletes backup <code>@Shorten(_pendingDelete.Id)</code>
                    ('@_pendingDelete.Name'). <strong>This action cannot be undone.</strong>
                </p>
                <div class="explorer-modal-actions">
                    <button type="button" class="explorer-btn" disabled="@_busy" @onclick="CancelDelete">Cancel</button>
                    <button type="button" class="explorer-btn explorer-btn-danger" disabled="@_busy" @onclick="ConfirmDeleteAsync">Delete</button>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private BackupListView _list = BackupListView.Empty;
    private BackupScopeCapabilitySnapshot _scopeCaps = BackupScopeCapabilitySnapshot.None;
    private BackupOperationResult? _lastResult;
    private IReadOnlyList<string> _availableTrees = Array.Empty<string>();
    private readonly HashSet<string> _selectedTrees = new(StringComparer.Ordinal);
    private string _captureName = string.Empty;
    private BackupKind _captureKind = BackupKind.Full;
    private bool _crossTreeConsistent;
    private string _incrementalBaseId = string.Empty;
    private string _restoreTarget = string.Empty;
    private LatticeRestoreMode _restoreMode = LatticeRestoreMode.InPlace;
    private BackupManifest? _pendingDelete;
    private bool _busy;

    // Per-tree capability snapshots for the scopes that appear in the listed
    // backups, probed automatically when the list loads. Restore / delete gate on
    // the row's own scope from this map, so they do not depend on the capture
    // tree selection or the "Check access" button.
    private readonly Dictionary<string, BackupScopeCapabilitySnapshot> _treeCaps = new(StringComparer.Ordinal);

    private bool HasSelection => _selectedTrees.Count > 0;
    private bool HasName => !string.IsNullOrWhiteSpace(_captureName);

    private bool CanRestoreManifest(BackupManifest manifest) =>
        !_busy && _treeCaps.TryGetValue(manifest.Scope.TreeId, out var caps) && caps.CanRestore;

    private bool CanDeleteManifest(BackupManifest manifest) =>
        !_busy && _treeCaps.TryGetValue(manifest.Scope.TreeId, out var caps) && caps.CanDelete;

    private IReadOnlyList<BackupManifest> FullBackups =>
        _list.Entries.Where(e => e.Kind == BackupKind.Full).ToList();

    private bool CanBackup
    {
        get
        {
            if (_busy || !HasSelection || !HasName)
            {
                return false;
            }

            if (_captureKind == BackupKind.Incremental)
            {
                return _scopeCaps.CanCaptureIncremental
                    && _selectedTrees.Count == 1
                    && !string.IsNullOrWhiteSpace(_incrementalBaseId);
            }

            return _scopeCaps.CanCapture;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadTreesAsync();
        await ReloadAsync();
    }

    private async Task LoadTreesAsync()
    {
        var trees = new List<string>();
        string? token = null;
        try
        {
            do
            {
                var page = await Catalog.LoadAsync(CatalogKind.Trees, token, pageSize: 200);
                trees.AddRange(page.Items.Select(i => i.Id));
                token = page.NextPageToken;
            }
            while (token is not null);
        }
        catch (Exception)
        {
            // Leave the tree list empty on a discovery failure; the area still
            // lists any visible backups and the user can retry with Refresh.
        }

        _availableTrees = trees;
    }

    private void OnTreesChanged(ChangeEventArgs e)
    {
        _selectedTrees.Clear();
        if (e.Value is string[] values)
        {
            foreach (var value in values)
            {
                _selectedTrees.Add(value);
            }
        }

        // The probed capabilities no longer apply to the new selection; reset to
        // deny until the user re-checks access so the controls never over-enable.
        _scopeCaps = BackupScopeCapabilitySnapshot.None;

        if (_selectedTrees.Count < 2)
        {
            _crossTreeConsistent = false;
        }
    }

    private void SetKind(BackupKind kind)
    {
        _captureKind = kind;
        if (kind == BackupKind.Full)
        {
            // Full captures carry no base; clear and disable the base selector.
            _incrementalBaseId = string.Empty;
        }
        else
        {
            _crossTreeConsistent = false;
        }
    }

    private async Task CheckAccessAsync()
    {
        if (_selectedTrees.Count == 0)
        {
            _scopeCaps = BackupScopeCapabilitySnapshot.None;
            return;
        }

        // Combine the per-tree probes: a capability is offered only when every
        // selected tree allows it, so a multi-tree capture is never enabled on
        // the strength of one permissive tree.
        var combined = new BackupScopeCapabilitySnapshot
        {
            CanList = true,
            CanCapture = true,
            CanCaptureIncremental = true,
            CanRestore = true,
            CanDelete = true,
        };

        foreach (var tree in _selectedTrees)
        {
            var probe = await CapabilityService.ProbeScopeAsync(tree);
            combined = new BackupScopeCapabilitySnapshot
            {
                CanList = combined.CanList && probe.CanList,
                CanCapture = combined.CanCapture && probe.CanCapture,
                CanCaptureIncremental = combined.CanCaptureIncremental && probe.CanCaptureIncremental,
                CanRestore = combined.CanRestore && probe.CanRestore,
                CanDelete = combined.CanDelete && probe.CanDelete,
            };
        }

        _scopeCaps = combined;
        StateHasChanged();
    }

    private async Task ReloadAsync()
    {
        _busy = true;
        try
        {
            // An explicit refresh re-probes every listed scope from scratch so a
            // permissions change since the last load is reflected.
            _treeCaps.Clear();
            _list = await Reader.LoadPageAsync();
            await ProbeListedScopesAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    // Probes the restore / delete capabilities for each distinct scope that
    // appears in the loaded backups, caching per tree so a reload after an action
    // only probes newly-appeared scopes.
    private async Task ProbeListedScopesAsync()
    {
        foreach (var tree in _list.Entries
            .Select(e => e.Scope.TreeId)
            .Distinct(StringComparer.Ordinal))
        {
            if (!_treeCaps.ContainsKey(tree))
            {
                _treeCaps[tree] = await CapabilityService.ProbeScopeAsync(tree);
            }
        }
    }

    private async Task BackupAsync()
    {
        var trees = _selectedTrees.ToList();

        if (_captureKind == BackupKind.Incremental)
        {
            await RunAsync(() => Reader.TriggerIncrementalAsync(
                _captureName, BackupScopeSelector.WholeTree(trees[0]), _incrementalBaseId));
            return;
        }

        if (trees.Count == 1)
        {
            await RunAsync(() => Reader.TriggerFullAsync(
                _captureName, BackupScopeSelector.WholeTree(trees[0])));
            return;
        }

        var scopes = trees.Select(BackupScopeSelector.WholeTree).ToList();
        await RunAsync(() => Reader.TriggerSetAsync(_captureName, scopes, _crossTreeConsistent));
    }

    private async Task CopyIdAsync(string id)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", id);
            _lastResult = BackupOperationResult.Success("Copied backup id to clipboard.");
        }
        catch (Exception)
        {
            _lastResult = BackupOperationResult.Failure("Copying to the clipboard is not available here.");
        }
    }

    private async Task RestoreAsync(string backupId)
    {
        await RunAsync(() => Reader.RestoreAsync(backupId, _restoreTarget, _restoreMode));
    }

    private void OnRestoreModeChanged(ChangeEventArgs e)
    {
        _restoreMode = Enum.TryParse<LatticeRestoreMode>(e.Value?.ToString(), out var mode)
            ? mode
            : LatticeRestoreMode.InPlace;
    }

    private void RequestDelete(BackupManifest manifest)
    {
        _pendingDelete = manifest;
    }

    private void CancelDelete()
    {
        _pendingDelete = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        var manifest = _pendingDelete;
        if (manifest is null)
        {
            return;
        }

        _pendingDelete = null;
        await RunAsync(() => Reader.DeleteAsync(manifest.Id));
    }

    private async Task RunAsync(Func<Task<BackupOperationResult>> action)
    {
        _busy = true;
        try
        {
            _lastResult = await action();
            _list = await Reader.LoadPageAsync();
            await ProbeListedScopesAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static string Shorten(string id) => id.Length <= 12 ? id : id[..12] + "...";

    private static string ResultClass(BackupOperationStatus status) => status switch
    {
        BackupOperationStatus.Succeeded => "is-success",
        BackupOperationStatus.Denied => "is-denied",
        _ => "is-failed",
    };
}
