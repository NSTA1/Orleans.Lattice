    private BackupRow? _pendingSchedule;
    private BackupScopeStatus? _scheduleStatus;
    private bool _scheduleLoading;
    private int _editFullHours;
    private int _editFullMinutes;
    private int _editIncHours;
    private int _editIncMinutes;

    // Backup-health state. Availability gates the whole feature (true only when the
    // server's backup sink is durable/external); the per-backup reports back the
    // health column and diagnostics dialog; the editor fields back the per-backup
    // health-monitor config in the schedule modal.
    private bool _healthAvailable;
    private readonly Dictionary<string, BackupHealthReport> _health = new(StringComparer.Ordinal);
    private BackupHealthReport? _healthDialog;
    private bool _editHealthEnabled = true;
    private int _editHealthHours = 6;
    private int _editHealthMinutes;

    private TimeSpan EditHealthInterval => new(hours: _editHealthHours, minutes: _editHealthMinutes, seconds: 0);

    // The two Backups sub-tabs, with the active one retained as a durable
    // preference so the panel reopens on the same sub-tab.
    private enum BackupsSubTab { New, Existing }

    private BackupsSubTab _activeSubTab = BackupsSubTab.New;
    private bool _subTabRestored;
