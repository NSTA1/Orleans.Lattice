@typeparam TItem
@attribute [CascadingTypeParameter(nameof(TItem))]

<CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>
@if (_rows.Count == 0)
{
    @* No rows: the empty state alone, with no column headers above it and no rules around it. *@
    <div class="lt-table-empty">
        <p id="@CaptionId" class="@(CaptionHidden ? "lt-table__caption lt-visually-hidden" : "lt-table__caption")">@Caption</p>
        <div class="lt-table__empty">
            @if (EmptyContent is not null)
            {
                @EmptyContent
            }
            else
            {
                <span>No rows.</span>
            }
        </div>
    </div>
}
else if (IsCompactList)
{
    <div class="lt-table-list" role="region" aria-labelledby="@CaptionId">
        <p id="@CaptionId" class="@(CaptionHidden ? "lt-table__caption lt-visually-hidden" : "lt-table__caption")">@Caption</p>
        @if (SortOptions.Count > 1)
        {
            <div class="lt-table-list__sort">
                <LtSelect Label="Sort by" Options="@SortOptions" Value="@SortValue" ValueChanged="SortFromValueAsync" />
            </div>
        }
        <ul class="lt-table-list__rows">
            @if (IsVirtualized)
            {
                <Virtualize Items="_rows" ItemSize="CompactRowHeight" SpacerElement="li" Context="item">
                    @RenderCompactRow(item)
                </Virtualize>
            }
            else
            {
                @foreach (var item in PlainRows)
                {
                    @RenderCompactRow(item)
                }
            }
        </ul>
    </div>
}
else
{
    <div class="lt-table-frame" role="region" aria-labelledby="@CaptionId" tabindex="0">
        <table class="lt-table">
            <caption id="@CaptionId" class="@(CaptionHidden ? "lt-table__caption lt-visually-hidden" : "lt-table__caption")">@Caption</caption>
            <thead>
                <tr>
                    @foreach (var column in _columns)
                    {
                        <th @key="column" scope="col" class="@HeaderClass(column)" aria-sort="@AriaSort(column)">
                            @if (column.IsSortable)
                            {
                                <button type="button"
                                        class="lt-table__sort"
                                        data-lt-sort="@SortState(column)"
                                        @onclick="() => SortByAsync(column)">
                                    @column.Title<span class="lt-table__sort-mark" aria-hidden="true"></span>
                                </button>
                            }
                            else
                            {
                                @column.Title
                            }
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (IsVirtualized)
                {
                    <Virtualize Items="_rows" ItemSize="RowHeight" SpacerElement="tr" Context="item">
                        @RenderRow(item)
                    </Virtualize>
                }
                else
                {
                    @foreach (var item in PlainRows)
                    {
                        @RenderRow(item)
                    }
                }
            </tbody>
        </table>
    </div>
}
@if (IsCompactList)
{
    <LtDialog Open="_detailOpen"
              OpenChanged="OnDetailOpenChanged"
              Title="@DetailTitleText"
              Placement="LtDialogPlacement.End"
              ReturnFocus="_returnFocus"
              Actions="@(_hasDetail && DetailActions is not null ? DetailActions(_detailItem!) : null)">
        @if (_hasDetail)
        {
            @if (Detail is not null)
            {
                @Detail(_detailItem!)
            }
            else
            {
                <LtDefinitionList>
                    @foreach (var column in _columns)
                    {
                        <LtDefinition Term="@column.Title" Mono="@column.Mono">@RenderCell(column, _detailItem!)</LtDefinition>
                    }
                </LtDefinitionList>
            }
        }
    </LtDialog>
}

@code {
    private RenderFragment RenderRow(TItem item) => __builder =>
    {
        <tr @key="RowKeyOf(item)" class="lt-table__row" aria-current="@(IsCurrent?.Invoke(item) == true ? "true" : null)">
            @foreach (var column in _columns)
            {
                @if (column.RowHeader)
                {
                    <th scope="row" class="@CellClass(column)" title="@column.TooltipOf(item)">@RenderCell(column, item)</th>
                }
                else
                {
                    <td class="@CellClass(column)" title="@column.TooltipOf(item)">@RenderCell(column, item)</td>
                }
            }
        </tr>
    };

    private RenderFragment RenderCompactRow(TItem item) => __builder =>
    {
        var key = RowKeyOf(item) ?? NullRowKey;
        <li @key="key" class="lt-table-list__row" aria-current="@(IsCurrent?.Invoke(item) == true ? "true" : null)">
            <button type="button"
                    class="lt-table-list__open"
                    aria-haspopup="dialog"
                    @onclick="() => OpenDetail(item, key)"
                    @ref="_rowButtons[key]">
                @if (CompactRow is not null)
                {
                    @CompactRow(item)
                }
                else
                {
                    @RenderDefaultCompactRow(item)
                }
            </button>
        </li>
    };

    private RenderFragment RenderDefaultCompactRow(TItem item) => __builder =>
    {
        var primary = PrimaryColumn;
        <LtCompactRow Mono="@(primary?.Mono == true)">
            <Primary>
                @if (primary is not null)
                {
                    @RenderCell(primary, item)
                }
            </Primary>
            <Secondary>
                @foreach (var column in SecondaryColumns)
                {
                    <span class="lt-compact-row__field"><span class="lt-compact-row__term">@column.Title</span> @RenderCell(column, item)</span>
                }
            </Secondary>
        </LtCompactRow>
    };

    private RenderFragment RenderCell(LtColumn<TItem> column, TItem item) => column.ChildContent is { } template
        ? template(item)
        : __builder => __builder.AddContent(0, column.Value?.Invoke(item)?.ToString());
}
