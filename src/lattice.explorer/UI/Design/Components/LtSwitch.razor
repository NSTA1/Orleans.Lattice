@*
    The switch and its hint are one item: wherever the switch is placed - a
    toolbar's control row included - its hint travels under it, never beside it
    as a separate item.
*@
<div class="lt-switch-field">
    <button @attributes="AdditionalAttributes"
            type="button"
            role="switch"
            class="lt-switch"
            aria-checked="@(Checked ? "true" : "false")"
            aria-describedby="@(Hint is null ? null : HintId)"
            disabled="@Disabled"
            @onclick="ToggleAsync">
        <span class="lt-switch__track" aria-hidden="true"><span class="lt-switch__thumb"></span></span>
        <span class="lt-switch__label">@Label</span>
        <span class="lt-switch__state" aria-hidden="true">@(Checked ? OnText : OffText)</span>
    </button>
    @if (Hint is not null)
    {
        <p id="@HintId" class="lt-field__hint lt-switch__hint">@Hint</p>
    }
</div>
