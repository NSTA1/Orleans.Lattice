@using Orleans.Lattice.Explorer.Core.Catalog
@using Orleans.Lattice.Explorer.Core.Detail
@using Orleans.Lattice.Explorer.Core.Session
@using Orleans.Lattice.Explorer.UI.Detail.Tabs
@implements IDisposable
@inject IExplorerSelection Selection
@inject IUiPreferenceStore Preferences

<section class="explorer-detail" aria-label="Detail">
    @{
        var selected = Selection.Selected;
    }
    <header class="explorer-detail-header">
        <div class="explorer-tabstrip" role="tablist" aria-label="Detail tabs">
            @foreach (var tab in DetailTabs.Ordered)
            {
                <button type="button"
                        role="tab"
                        class="explorer-tab @(_tabRestored && tab == _activeTab ? "is-active" : null)"
                        aria-selected="@(_tabRestored && tab == _activeTab)"
                        @onclick="@(() => SetTab(tab))">
                    @DetailTabs.Label(tab)
                </button>
            }
        </div>
        @if (selected is not null)
        {
            <span class="explorer-detail-title" title="@selected.Id">@selected.Id</span>
        }
    </header>

    <div class="explorer-detail-body">
        @if (selected is null)
        {
            <div class="explorer-detail-empty">
                <p>Select a tree or view to inspect it.</p>
            </div>
        }
        else if (!_tabRestored)
        {
            // Hold the body until the retained tab is known so the default tab
            // never renders first and then switches (a visible flicker).
            <div class="explorer-detail-empty" aria-busy="true"></div>
        }
        else
        {
            var key = $"{selected.Kind}:{selected.Id}:{_activeTab}";
            switch (_activeTab)
            {
                case DetailTab.Metrics:
                    <MetricsTab @key="key" Selection="selected" />
                    break;
                case DetailTab.Topology:
                    <TopologyTab @key="key" Selection="selected" />
                    break;
                case DetailTab.Data:
                    <DataTab @key="key" Selection="selected" />
                    break;
            }
        }
    </div>
</section>

@code {
    private DetailTab _activeTab = DetailTabs.Default;
    private bool _tabRestored;

    // Durable-preference key for the active detail tab (global, not per selection).
    private const string TabStateKey = "detail-tab";

    protected override async Task OnInitializedAsync()
    {
        Selection.SelectionChanged += OnSelectionChanged;

        // Restore the prior active tab so the panel reopens on the same tab.
        // Tolerant of an unreachable backing store (server prerender); the
        // first-render fallback re-applies once browser storage is reachable.
        await Preferences.EnsureLoadedAsync();
        RestoreTab();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _tabRestored)
        {
            return;
        }

        await Preferences.EnsureLoadedAsync();

        // Restore the retained tab if the mirror hydrated; otherwise fall back to
        // the default so the body renders rather than staying blank when browser
        // storage is unreachable (for example with JavaScript disabled).
        RestoreTab();
        if (!_tabRestored)
        {
            _tabRestored = true;
        }

        StateHasChanged();
    }

    private void RestoreTab()
    {
        if (_tabRestored || !Preferences.IsLoaded)
        {
            return;
        }

        _tabRestored = true;
        _activeTab = Preferences.GetOrDefault(TabStateKey, DetailTabs.Default);
    }

    private async Task SetTab(DetailTab tab)
    {
        if (_activeTab == tab)
        {
            return;
        }

        _activeTab = tab;

        // Retain the active tab as a durable preference.
        await Preferences.SetAsync(TabStateKey, tab);
        StateHasChanged();
    }

    private void OnSelectionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Selection.SelectionChanged -= OnSelectionChanged;
}
