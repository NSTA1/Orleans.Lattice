@using Orleans.Lattice.Explorer.Core.Catalog
@using Orleans.Lattice.Explorer.Core.Navigation
@using Orleans.Lattice.Explorer.Core.Session
@using Orleans.Lattice.Explorer.Core.Vocabulary
@using Orleans.Lattice.Explorer.Plugins
@using Orleans.Lattice.Explorer.UI.Authentication
@using Orleans.Lattice.Explorer.UI.Plugins
@implements IDisposable
@inject IExplorerPluginCatalog Catalog
@inject IExplorerPluginAccessStore AccessStore
@inject IExplorerSelection Selection
@inject IExplorerShellRouter Router
@inject IUiPreferenceStore Preferences

@*
    The per-selection tier: the surfaces that render whatever tree, view or tag
    index is currently selected. It is the same plugin model the area switcher
    above it runs on (epic decision D4) - the panel enumerates IExplorerPlugin
    from the container, filters to the Selection surface and to the plugins that
    declare the selected kind, orders them, and renders the active one through
    DynamicComponent - so it names no surface and gains no per-surface service
    injection.

    Two things follow from that, and they are the point of the rewrite:

      - A tag-index selection is no longer a hard-coded branch that bypasses the
        tier. The tag-index browser simply declares that it applies to tag-index
        selections and the generic surfaces declare that they do not, so the
        selection resolves to a different plugin set through ordinary
        applicability.

      - The tier is gated for the first time. Gating is advisory, exactly as it
        is for areas (epic decision D6 - the server stays the sole enforcement
        point): allowed renders active, denied renders disabled-and-visible and
        never renders its content, authentication-required stays clickable and
        opens the sign-in dialog, and unavailable renders no tab at all.

    A selection plugin's view is handed the selected catalog entry as a
    Selection parameter, which is what SelectionPluginViewBase declares - so a
    view derives from it rather than re-declaring the parameter and the
    lifetime token by hand.
*@

<section class="lx-shell-detail" aria-label="Detail">
    <header class="lx-shell-detail-header">
        <h2 class="lx-shell-detail-heading">@DetailHeading</h2>
        @*
            Tier three: the per-selection surfaces, as the underlined strip - the
            primitive's default presentation, so it reads as neither the rail
            above it nor the segmented toggle beside it.

            The strip names the body it swaps. A role=tab that controls nothing
            announces the tabs pattern without implementing it, leaving a
            screen-reader caller with nothing to move into (WCAG SC 4.1.2). The
            body is rendered here rather than as the strip's ChildContent because
            the layout puts the title beside the strip and the content beneath
            both.
        *@
        <LatticeAdaptiveTabs Tabs="_tabs"
                             ActiveId="@(_restored ? _activePluginId : null)"
                             OnSelect="_activate"
                             Label="Detail tabs"
                             Id="@ExplorerShellRegions.DetailStrip"
                             PanelId="@ExplorerShellRegions.DetailPanel"
                             Class="lx-shell-detail-tabs" />
        @if (_selected is not null)
        {
            <span class="lx-shell-detail-title"
                  id="@SelectionTitleElementId"
                  aria-describedby="@(string.IsNullOrEmpty(_selectionExplanation) ? null : SelectionHelpExplanationId)">@_selected.Label</span>
            <LatticeHelp Id="@SelectionHelpId"
                         Term="@_selected.Label"
                         Explanation="@_selectionExplanation" />
        }
    </header>

    <div class="lx-shell-detail-body"
         id="@ExplorerShellRegions.DetailPanel"
         role="tabpanel"
         tabindex="0"
         aria-labelledby="@_activeTabElementId">
        @if (_selected is null)
        {
            <div class="lx-shell-detail-empty">
                <p><strong>@ExplorerVocabulary.NoSelectionHeadline</strong></p>
                <p>@ExplorerVocabulary.NoSelectionExplanation</p>
            </div>
        }
        else if (!_restored)
        {
            @* Hold the body until the retained surface is known so the default
               one never renders first and then switches (a visible flicker). *@
            <div class="lx-shell-detail-empty" aria-busy="true"></div>
        }
        else if (_activePlugin is null)
        {
            <div class="lx-shell-detail-empty">
                <p><strong>@_emptyBodyMessage.Headline</strong></p>
                <p>@_emptyBodyMessage.Explanation</p>
                @if (!string.IsNullOrEmpty(_emptyBodyMessage.Remedy))
                {
                    <p><strong>@_emptyBodyMessage.RemedyLabel</strong> @_emptyBodyMessage.Remedy</p>
                }
            </div>
        }
        else
        {
            <DynamicComponent @key="_viewKey" Type="_activePlugin.ViewType" Parameters="_viewParameters" />
        }
    </div>
</section>

@code {
    private static readonly SelectionTab[] NoTabSources = [];
    private static readonly LatticeTabItem[] NoTabs = [];
    private static readonly IExplorerPlugin[] NoPlugins = [];
    private static readonly string[] NoSurfaces = [];

    // The two reasons the panel can resolve no surface, written once from the
    // shared vocabulary rather than as prose here: no surface is registered for
    // this kind of selection, or every registered surface is refused. The second
    // is a refusal aimed at the caller, so it carries a remedy.
    private static readonly ExplorerStateMessage NoSurfaceRegistered =
        ExplorerStateCopy.Unavailable(ExplorerSubjects.DetailSurfaces) with
        {
            Headline = "No surface for this selection",
            Explanation = "This Explorer registers no detail surface for this kind of selection, so there is nothing to show.",
            Remedy = "Select a tree, view or tag index that has surfaces, or add the plugin that provides one.",
            TermId = null,
            DocsLink = ExplorerDocsLinks.WritingAPlugin,
        };

    private static readonly ExplorerStateMessage NoSurfaceAvailable =
        ExplorerStateCopy.NotPermitted(ExplorerSubjects.DetailSurfaces);

    /// <summary>The id of the element rendering the current selection's label.</summary>
    private const string SelectionTitleElementId = "lx-shell-detail-title";

    /// <summary>The element-id prefix of the disclosure explaining the current selection.</summary>
    private const string SelectionHelpId = "lx-shell-detail-selection";

    /// <summary>
    /// The id of that disclosure's explanation element, resolved once so the
    /// title's <c>aria-describedby</c> costs nothing per render.
    /// </summary>
    private static readonly string SelectionHelpExplanationId = LatticeHelp.ExplanationElementId(SelectionHelpId);

    /// <summary>The detail pane's heading, the level below the surface title.</summary>
    private const string DetailHeading = "Detail";

    private readonly Action _render;

    private CatalogItem? _selected;
    private ExplorerPluginSelectionKind _kind = ExplorerPluginSelectionKind.Tree;
    private bool _kindResolved;

    private IReadOnlyList<IExplorerPlugin> _plugins = NoPlugins;
    private SelectionTab[] _tabSources = NoTabSources;
    private LatticeTabItem[] _tabs = NoTabs;

    // Each applicable plugin's route surface slug, derived once with the
    // applicable set rather than on the resolve path: deriving a slug takes the
    // tail of a dotted id, which allocates a string, and resolving runs on every
    // selection change and every access report.
    private string[] _pluginSurfaces = NoSurfaces;

    private IExplorerPlugin? _activePlugin;
    private string? _activePluginId;

    // The active tab's element id, so the body can name the tab that selected
    // it. Recomputed with the active surface rather than per render.
    private string? _activeTabElementId;
    private string? _retainedPluginId;
    private ExplorerStateMessage _emptyBodyMessage = NoSurfaceRegistered;

    // What the selected item is, in the glossary's words, plus its underlying id
    // when that differs from the label a view shows. Composed when the selection
    // changes rather than per render, and rendered through the help disclosure so
    // it is reachable by keyboard and touch - it used to be a bare title
    // attribute, which is neither.
    private string? _selectionExplanation;

    // The DynamicComponent's identity and its parameter set are both rebuilt only
    // when the selection or the active surface actually changes, never per
    // render: the panel re-renders on every access change and every selection
    // notification, and composing either here would allocate on all of them.
    private string _viewKey = string.Empty;
    private Dictionary<string, object?>? _viewParameters;

    private EventCallback<string> _activate;
    private bool _restored;

    // The surface slug the address names, kept in step with the route so the
    // resolve path compares two strings instead of re-reading the router, and
    // whether the applicable set actually contained it.
    private string _routeSurface = string.Empty;
    private bool _routeMatched;

    private readonly Action _adopt;

    /// <summary>Creates the panel, caching the delegates its subscriptions marshal.</summary>
    public DetailPanel()
    {
        _render = StateHasChanged;
        _adopt = AdoptRoute;
    }

    /// <summary>Shared dialog state used to offer a sign-in for a surface that requires one.</summary>
    [CascadingParameter] public LoginDialogState? Login { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Bound once rather than per render, so the strip's selection callback
        // does not allocate a delegate on every pass.
        _activate = EventCallback.Factory.Create<string>(this, ActivateAsync);

        Selection.SelectionChanged += OnSelectionChanged;
        AccessStore.Changed += OnAccessChanged;
        Router.RouteChanged += OnRouteChanged;

        _routeSurface = Router.Current.Surface;
        ApplySelection(Selection.Selected);

        // Restore the prior active surface so the panel reopens on it. Tolerant
        // of an unreachable backing store (server prerender); the first-render
        // fallback re-applies once browser storage is reachable.
        await Preferences.EnsureLoadedAsync();
        RestoreRetained();
        Resolve();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _restored)
        {
            return;
        }

        await Preferences.EnsureLoadedAsync();

        // Restore the retained surface if the mirror hydrated; otherwise release
        // the hold anyway so the body renders rather than staying blank when
        // browser storage is unreachable (for example with JavaScript disabled).
        RestoreRetained();
        if (!_restored)
        {
            _restored = true;
        }

        Resolve();
        StateHasChanged();
    }

    /// <summary>
    /// Takes the surface the panel should open on from the durable hand-off key.
    /// </summary>
    /// <remarks>
    /// This is the fallback, not the authority. The address is the authority -
    /// see <see cref="Resolve"/> - and it is what survives a reload, a bookmark
    /// and Back. The key is still read because it is how a sibling surface hands
    /// a caller off to a specific surface as it changes the selection (the
    /// tag-index browser opening a covered tree on its data surface), and how the
    /// panel reopens on the same tab when the address names no surface at all.
    /// </remarks>
    private void RestoreRetained()
    {
        if (_restored || !Preferences.IsLoaded)
        {
            return;
        }

        _restored = true;
        _retainedPluginId = Preferences.GetOrDefault<string?>(SelectionPluginKeys.ActivePluginPreferenceKey, null);
    }

    /// <summary>
    /// Points the panel at <paramref name="selected"/>, re-resolving the
    /// applicable plugin set when the selection's kind changed and rebuilding
    /// the parameters handed to the rendered view.
    /// </summary>
    private void ApplySelection(CatalogItem? selected)
    {
        _selected = selected;

        if (selected is null)
        {
            // Nothing is selected, so no plugin applies: the per-selection tier
            // has nothing to key, gate or activate until something is.
            _selectionExplanation = null;
            _kindResolved = false;
            _plugins = NoPlugins;
            _tabSources = NoTabSources;
            _pluginSurfaces = NoSurfaces;
            _tabs = NoTabs;
            return;
        }

        _selectionExplanation = DescribeSelection(selected);

        var kind = ExplorerSelectionKindProjection.ToPluginKind(selected.Kind);
        if (!_kindResolved || kind != _kind)
        {
            // The applicable set - and therefore the strip - depends only on the
            // selection's kind, so moving between two trees rebuilds neither.
            _kind = kind;
            _kindResolved = true;
            _plugins = Catalog.ForSelection(kind);
            _tabSources = BuildTabSources(_plugins);
            _pluginSurfaces = BuildSurfaces(_plugins);
            RebuildTabs();
        }

        // One dictionary for the panel's lifetime rather than one per selection:
        // the view is re-mounted on every selection change (see the key), so a
        // fresh instance reads whatever is currently filed here.
        _viewParameters ??= new Dictionary<string, object?>(StringComparer.Ordinal);
        _viewParameters[nameof(SelectionPluginViewBase.Selection)] = selected;
    }

    /// <summary>
    /// Recomputes which surface is active and the key that re-mounts its view.
    /// Called on every input that can change either - a new selection, a new
    /// access decision, a tab switch, a new address - and never from the render
    /// path.
    /// </summary>
    /// <remarks>
    /// Three candidates, in order. The address wins when it names a surface this
    /// selection actually has, because a link someone sent must show what they
    /// saw. Otherwise the retained surface, which is how the panel reopens on the
    /// same tab and how a sibling surface hands a caller off to a specific one.
    /// Otherwise the first reachable surface. A denied surface is never a
    /// candidate, so its content never renders.
    /// </remarks>
    private void Resolve()
    {
        var plugins = _plugins;
        IExplorerPlugin? first = null;
        IExplorerPlugin? routed = null;
        IExplorerPlugin? retained = null;

        for (var i = 0; i < plugins.Count; i++)
        {
            var descriptor = plugins[i].Descriptor;
            if (!AccessStore.Get(descriptor.PluginId).IsAllowed)
            {
                continue;
            }

            first ??= plugins[i];

            if (_routeSurface.Length != 0
                && i < _pluginSurfaces.Length
                && string.Equals(_pluginSurfaces[i], _routeSurface, StringComparison.Ordinal))
            {
                routed = plugins[i];
                break;
            }

            if (_retainedPluginId is not null
                && string.Equals(descriptor.PluginId, _retainedPluginId, StringComparison.Ordinal))
            {
                retained ??= plugins[i];
            }
        }

        var active = routed ?? retained ?? first;
        _routeMatched = routed is not null;

        _activePlugin = active;
        _activePluginId = active?.Descriptor.PluginId;
        _activeTabElementId = _activePluginId is null
            ? null
            : ExplorerShellRegions.TabElementId(ExplorerShellRegions.DetailStrip, _activePluginId);
        _emptyBodyMessage = plugins.Count == 0 ? NoSurfaceRegistered : NoSurfaceAvailable;

        RebuildViewKey();
    }

    /// <summary>
    /// Rewrites the address when it names a surface this selection does not have
    /// - a link into a tag-index surface followed to a tree, say. The view is
    /// already right; the address is not, and leaving it would let the stale
    /// segment ride along on every later selection and be remembered as the
    /// surface to reopen on. A correction the caller did not ask for, so it
    /// replaces the history entry rather than pushing one.
    /// </summary>
    private void CorrectUnmatchedAddress()
    {
        if (_routeSurface.Length == 0 || _routeMatched || _activePluginId is null)
        {
            return;
        }

        var surface = ExplorerRouteSlug.FromIdentifier(_activePluginId);
        _routeSurface = surface;
        Publish(Router.Current.WithSurface(surface), replace: true);
    }

    /// <summary>
    /// The route surface slug of every plugin in <paramref name="plugins"/>, in
    /// the same order, so matching an address against the applicable set is an
    /// indexed string comparison rather than a per-call derivation.
    /// </summary>
    private static string[] BuildSurfaces(IReadOnlyList<IExplorerPlugin> plugins)
    {
        if (plugins.Count == 0)
        {
            return NoSurfaces;
        }

        var surfaces = new string[plugins.Count];
        for (var i = 0; i < plugins.Count; i++)
        {
            surfaces[i] = ExplorerRouteSlug.FromIdentifier(plugins[i].Descriptor.PluginId);
        }

        return surfaces;
    }

    /// <summary>
    /// Recomposes the strip from the current access decisions. Driven only by
    /// the two inputs that can change it - the applicable plugin set and a
    /// plugin-level decision - so switching tabs or moving between two trees
    /// re-renders the existing strip rather than rebuilding it.
    /// </summary>
    private void RebuildTabs()
    {
        var sources = _tabSources;

        var visible = 0;
        for (var i = 0; i < sources.Length; i++)
        {
            if (AccessStore.Get(sources[i].PluginId).IsVisible)
            {
                visible++;
            }
        }

        if (visible == 0)
        {
            _tabs = NoTabs;
            return;
        }

        var tabs = new LatticeTabItem[visible];
        var next = 0;
        for (var i = 0; i < sources.Length; i++)
        {
            var source = sources[i];
            var item = source.For(AccessStore.Get(source.PluginId).State);
            if (item is not null)
            {
                tabs[next++] = item;
            }
        }

        _tabs = tabs;
    }

    private void RebuildViewKey() =>
        // Keyed on the selection and the active surface, so switching either
        // re-mounts the view rather than reusing one holding the previous
        // selection's state - which is also what cancels its in-flight loads.
        _viewKey = _selected is null || _activePluginId is null
            ? string.Empty
            : $"{_selected.Kind}:{_selected.Id}:{_activePluginId}";

    private async Task ActivateAsync(string pluginId)
    {
        // Membership is checked before the decision is read, so an id that does
        // not belong to this selection's set can never reach the sign-in prompt
        // or the retained preference.
        var index = IndexOf(pluginId);
        if (index < 0)
        {
            return;
        }

        var access = AccessStore.Get(pluginId);
        if (access.State == ExplorerPluginAccessState.AuthenticationRequired)
        {
            // A recoverable state, so offer the remedy instead of an inert
            // grey-out. The active surface stays where it is until the sign-in
            // lands and the gate re-probes.
            Login?.Open();
            return;
        }

        if (!access.IsAllowed || string.Equals(pluginId, _activePluginId, StringComparison.Ordinal))
        {
            return;
        }

        _retainedPluginId = pluginId;

        // Published to the address bar, which is what makes the open surface
        // shareable, bookmarkable and reachable by Back. Retained as well,
        // because the key is the channel a sibling surface hands off through and
        // it must not go stale behind a tab the caller has since moved off.
        PublishSurface(index);
        Resolve();

        await Preferences.SetAsync(SelectionPluginKeys.ActivePluginPreferenceKey, pluginId);
        StateHasChanged();
    }

    /// <summary>
    /// Puts the surface at <paramref name="index"/> in the address bar, reading
    /// its slug from the set derived with the applicable plugins rather than
    /// re-deriving it.
    /// </summary>
    private void PublishSurface(int index)
    {
        var surface = index < _pluginSurfaces.Length ? _pluginSurfaces[index] : string.Empty;
        if (surface.Length == 0)
        {
            return;
        }

        _routeSurface = surface;
        Publish(Router.Current.WithSurface(surface));
    }

    /// <summary>
    /// Asks the router for <paramref name="route"/>, unless it is the route
    /// already showing.
    /// </summary>
    /// <remarks>
    /// The router suppresses the <em>announcement</em> for an unchanged route but
    /// still raises the address request, so a caller that publishes
    /// unconditionally asks the head to navigate to the address it is already on.
    /// At first render the head buffers such a request and keeps only the latest,
    /// so an unnecessary publication displaces the entry policy's buffered
    /// restore and turns its history replace into a push. See the twin guard on
    /// the navigation panel for the whole story.
    /// </remarks>
    private void Publish(ExplorerRoute route, bool replace = false)
    {
        if (route.Equals(Router.Current))
        {
            return;
        }

        Router.NavigateTo(route, replace);
    }

    /// <summary>
    /// Puts the surface <paramref name="pluginId"/> addresses in the address bar.
    /// A no-op when nothing is selected (a surface addresses a selection, so
    /// there is nothing for it to qualify) or when the route already names it, so
    /// adopting an address never echoes back as a second navigation.
    /// </summary>
    private void PublishSurface(string pluginId)
    {
        var surface = ExplorerRouteSlug.FromIdentifier(pluginId);
        if (surface.Length == 0)
        {
            return;
        }

        _routeSurface = surface;
        Router.NavigateTo(Router.Current.WithSurface(surface));
    }

    private void OnRouteChanged(ExplorerRoute route) => InvokeAsync(_adopt);

    /// <summary>
    /// Follows the address when it changes underneath the panel - a deep link,
    /// Back, Forward, or a restore - so the open surface and the URL never
    /// disagree.
    /// </summary>
    private void AdoptRoute()
    {
        var surface = Router.Current.Surface;
        if (string.Equals(surface, _routeSurface, StringComparison.Ordinal))
        {
            // The echo of this panel's own navigation, or a route change that did
            // not touch the surface. Nothing moved, so nothing is re-resolved.
            return;
        }

        _routeSurface = surface;
        Resolve();
        CorrectUnmatchedAddress();
        _render();
    }

    private IExplorerPlugin? Find(string pluginId)
    {
        var index = IndexOf(pluginId);
        return index < 0 ? null : _plugins[index];
    }

    /// <summary>
    /// The position of <paramref name="pluginId"/> in the applicable set, or
    /// <c>-1</c>. Indexed rather than looked up: a selection resolves to a
    /// handful of surfaces, and the index is also the key into the derived slug
    /// set.
    /// </summary>
    private int IndexOf(string pluginId)
    {
        var plugins = _plugins;
        for (var i = 0; i < plugins.Count; i++)
        {
            if (string.Equals(plugins[i].Descriptor.PluginId, pluginId, StringComparison.Ordinal))
            {
                return i;
            }
        }

        return -1;
    }

    private void OnSelectionChanged()
    {
        ApplySelection(Selection.Selected);

        // A programmatic navigation (for example clicking a covered tree or a
        // member from the tag-index view) can seed a new active surface alongside
        // the new selection. Re-apply the retained preference so the panel opens
        // on the seeded surface rather than the one that was active before; in the
        // ordinary case the preference still holds the last-used surface, so this
        // is a no-op that preserves the "reopen on the same tab" behaviour.
        if (_restored && Preferences.IsLoaded)
        {
            _retainedPluginId = Preferences.GetOrDefault<string?>(
                SelectionPluginKeys.ActivePluginPreferenceKey,
                null);
        }

        Resolve();
        CorrectUnmatchedAddress();
        InvokeAsync(_render);
    }

    private void OnAccessChanged(ExplorerPluginAccessChange change)
    {
        // The strip reads only plugin-level decisions, and only for the surfaces
        // this selection resolves to, so neither a scoped sub-capability nor
        // another tier's plugin is a reason to re-resolve.
        if (change.Key.Scope is not null || Find(change.Key.PluginId) is null)
        {
            return;
        }

        RebuildTabs();
        Resolve();
        InvokeAsync(_render);
    }

    public void Dispose()
    {
        Selection.SelectionChanged -= OnSelectionChanged;
        AccessStore.Changed -= OnAccessChanged;
        Router.RouteChanged -= OnRouteChanged;
    }

    /// <summary>
    /// What the selected item is, in the shared glossary's words, plus its
    /// underlying id when the label shown is not that id - which is the case for
    /// a view, whose label is its bare name while its id carries the physical
    /// <c>view-</c> prefix.
    /// </summary>
    /// <remarks>
    /// Called when the selection changes, never on the render path, so the one
    /// composed string it produces for a view is not a per-render cost.
    /// </remarks>
    private static string DescribeSelection(CatalogItem selected)
    {
        var subject = ExplorerSubjects.ForCatalogKind(selected.Kind);
        var explanation = ExplorerGlossary.ExplanationFor(subject.TermId) ?? string.Empty;

        return string.Equals(selected.Label, selected.Id, StringComparison.Ordinal)
            ? explanation
            : explanation + " The underlying id of this " + subject.Singular + " is '" + selected.Id + "'.";
    }

    private static SelectionTab[] BuildTabSources(IReadOnlyList<IExplorerPlugin> plugins)
    {
        if (plugins.Count == 0)
        {
            return NoTabSources;
        }

        var sources = new SelectionTab[plugins.Count];
        for (var i = 0; i < plugins.Count; i++)
        {
            sources[i] = new SelectionTab(plugins[i].Descriptor);
        }

        return sources;
    }

    /// <summary>
    /// One surface's pre-composed strip entries: the tab it renders in each of
    /// the three visible access states, built once when the applicable plugin
    /// set changes. A rebuild after a probe then picks one of the three instead
    /// of composing a tab and two tooltips per surface per access change.
    /// </summary>
    private sealed class SelectionTab
    {
        private readonly LatticeTabItem _allowed;
        private readonly LatticeTabItem _denied;
        private readonly LatticeTabItem _signInRequired;

        public SelectionTab(ExplorerPluginDescriptor descriptor)
        {
            PluginId = descriptor.PluginId;

            _allowed = new LatticeTabItem(PluginId, descriptor.Label);
            _denied = new LatticeTabItem(PluginId, descriptor.Label)
            {
                IsEnabled = false,
                Description = ExplorerAccessCopy.Describe(ExplorerAccessCopy.Denied(descriptor.Label)),
            };
            _signInRequired = new LatticeTabItem(PluginId, descriptor.Label)
            {
                Description = ExplorerAccessCopy.Describe(ExplorerAccessCopy.SignInRequired(descriptor.Label)),
            };
        }

        public string PluginId { get; }

        /// <summary>
        /// The strip entry for <paramref name="state"/>, or <see langword="null"/>
        /// when the surface renders no entry at all because its capability is
        /// absent from this cluster.
        /// </summary>
        public LatticeTabItem? For(ExplorerPluginAccessState state) => state switch
        {
            ExplorerPluginAccessState.Allowed => _allowed,
            ExplorerPluginAccessState.AuthenticationRequired => _signInRequired,
            ExplorerPluginAccessState.Unavailable => null,
            _ => _denied,
        };
    }
}
