@using Orleans.Lattice.Explorer.Core.Connection
@using Orleans.Lattice.Explorer.UI.Authentication
@implements IDisposable
@inject ILatticeStateConnection Connection

@{
    var status = Connection.Status;
}
@if (status.State == LatticeConnectionState.Reconnecting)
{
    <div class="explorer-connbar explorer-connbar-warn" role="status">
        <span class="explorer-conndot"></span>
        <span class="explorer-connmsg">Reconnecting...</span>
    </div>
}
else if (status.IsDisconnected)
{
    <div class="explorer-connbar explorer-connbar-down" role="alert">
        <span class="explorer-conndot"></span>
        <span class="explorer-connmsg">@(status.Message ?? "Disconnected from the state API.")</span>
        @if (status.RequiresAuthentication)
        {
            <button type="button"
                    class="explorer-btn explorer-btn-primary explorer-reconnect"
                    @onclick="OpenLogin">
                Sign in
            </button>
        }
        <button type="button"
                class="explorer-btn explorer-reconnect"
                disabled="@_reconnecting"
                @onclick="ReconnectAsync">
            @(_reconnecting ? "Reconnecting..." : "Reconnect")
        </button>
    </div>
}

@code {
    private bool _reconnecting;

    /// <summary>Shared dialog state used to open the login dialog on an auth failure.</summary>
    [CascadingParameter]
    public LoginDialogState? Login { get; set; }

    protected override void OnInitialized()
    {
        Connection.StatusChanged += OnStatusChanged;
    }

    private void OpenLogin() => Login?.Open();

    private async Task ReconnectAsync()
    {
        if (_reconnecting)
        {
            return;
        }

        _reconnecting = true;
        StateHasChanged();
        try
        {
            await Connection.ReconnectAsync();
        }
        finally
        {
            _reconnecting = false;
            StateHasChanged();
        }
    }

    private void OnStatusChanged(LatticeConnectionStatus _) => InvokeAsync(StateHasChanged);

    public void Dispose() => Connection.StatusChanged -= OnStatusChanged;
}
