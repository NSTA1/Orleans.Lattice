@inject IExplorerSelection ExplorerSelection

@* Shared guidance card shown on a detail tab when the selection is a
   change-history view: its rows are serialized history records rather than
   directly inspectable value data (or a tree whose metrics are reported), so
   every tab routes the operator to the source table's History timeline with a
   single consistent message and action. *@
<div class="explorer-data-state explorer-data-guidance">
    <p class="explorer-data-guidance-title">This is a change-history view.</p>
    <p class="explorer-data-guidance-body">
        Its rows are serialized history records that back the
        <strong>History</strong> timeline, not directly inspectable value
        data. Inspect its timeline from its source table
        @if (Selection.SourceTreeId is { Length: > 0 } named)
        {
            <code>@named</code>
        }
        else
        {
            <span>(unknown)</span>
        }:
        select the source table, open a key in its <strong>Data</strong>
        tab, then choose <strong>History</strong>.
    </p>
    @if (Selection.SourceTreeId is { Length: > 0 } sourceTreeId)
    {
        <button type="button"
                class="explorer-btn explorer-data-guidance-action"
                @onclick="@(() => GoToSourceTree(sourceTreeId))">
            Go to source table @sourceTreeId
        </button>
    }
</div>

@code {
    /// <summary>The selected change-history view this guidance describes.</summary>
    [Parameter, EditorRequired]
    public CatalogItem Selection { get; set; } = default!;

    // Selecting the source tree keys the detail tabs off its id; the navigation
    // panel rehydrates the richer badge metadata from the catalog on its next
    // list render.
    private void GoToSourceTree(string sourceTreeId) =>
        ExplorerSelection.Select(new CatalogItem
        {
            Id = sourceTreeId,
            Kind = CatalogKind.Trees,
        });
}
