@using Orleans.Lattice.Explorer.Core.Data
@using Orleans.Lattice.Explorer.Core.DeadLetter
@inherits SelectionPluginViewBase
@inject IDeadLetterReader DeadLetterReader

<div class="explorer-data explorer-deadletter">
    <div class="explorer-data-toolbar">
        <button type="button" class="explorer-btn" disabled="@_loading" @onclick="ReloadAsync">
            @(_loading ? "Loading..." : "Refresh")
        </button>
        @if (_count > 0)
        {
            <span class="explorer-deadletter-count" title="Dead-lettered items held for this tree">
                @_count dead-lettered
            </span>
        }
        else if (_loaded)
        {
            <span class="explorer-deadletter-count is-empty">Queue empty</span>
        }
    </div>

    @* Read-only inspection surface. Replay / requeue of a corrected item is a
       deliberate follow-up (out of scope for issue #1196): the state API exposes
       no write path, so this tab never mutates or re-applies an entry. *@

    <div class="explorer-data-body">
        <div class="explorer-data-keys">
            @if (_loading && _entries.Count == 0)
            {
                <div class="explorer-data-state">Loading dead-letter queue...</div>
            }
            else if (_error is not null)
            {
                <div class="explorer-data-state explorer-data-error">
                    <span>@_error</span>
                    <button type="button" class="explorer-btn-link" @onclick="ReloadAsync">Try again</button>
                </div>
            }
            else if (_entries.Count == 0)
            {
                <div class="explorer-data-state">No dead-lettered items for this tree.</div>
            }
            else
            {
                <table class="explorer-table explorer-deadletter-table">
                    <thead>
                        <tr>
                            <th>Timestamp (UTC)</th>
                            <th>Source</th>
                            <th>Reason</th>
                            <th>Key</th>
                            <th>Size</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in _entries)
                        {
                            <tr class="explorer-data-keyrow @(ReferenceEquals(entry, _selected) ? "is-selected" : null)"
                                @onclick="@(() => Select(entry))">
                                <td class="explorer-deadletter-time">@entry.TimestampUtc.UtcDateTime.ToString("u")</td>
                                <td><span class="explorer-deadletter-source">@SourceLabel(entry.Source)</span></td>
                                <td class="explorer-deadletter-reason" title="@entry.Reason">@entry.Reason</td>
                                <td class="explorer-deadletter-key" title="@entry.Key">@entry.Key</td>
                                <td>@entry.ValueByteLength B</td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (_hasMore)
                {
                    <div class="explorer-data-state">
                        <button type="button" class="explorer-btn" disabled="@_loading" @onclick="LoadMoreAsync">
                            @(_loading ? "Loading..." : "Load more")
                        </button>
                    </div>
                }
            }
        </div>

        <div class="explorer-data-detail">
            @if (_selected is null)
            {
                <div class="explorer-data-state">Select a dead-lettered item to inspect it.</div>
            }
            else
            {
                <dl class="explorer-deadletter-meta">
                    <dt>Key</dt>
                    <dd><code>@_selected.Key</code></dd>
                    <dt>Reason</dt>
                    <dd>@_selected.Reason</dd>
                    <dt>Source</dt>
                    <dd>@SourceLabel(_selected.Source)</dd>
                    <dt>Timestamp</dt>
                    <dd>@_selected.TimestampUtc.UtcDateTime.ToString("u")</dd>
                    <dt>Value length</dt>
                    <dd>@_selected.ValueByteLength bytes@(_selected.Truncated ? " (preview truncated)" : null)</dd>
                </dl>

                @if (_rendered is not null)
                {
                    @if (_rendered.Note is not null)
                    {
                        <p class="explorer-data-value-note">@_rendered.Note</p>
                    }
                    <pre class="explorer-data-value explorer-data-value-@_rendered.Format.ToString().ToLowerInvariant()">@_rendered.Content</pre>
                }
            }
        </div>
    </div>
</div>

@code {
    // The DLQ list page size. Fixed (no user control) to keep this read-only
    // inspection surface simple; the tab pages with a "Load more" cursor.
    private const int PageSize = 100;

    private readonly List<DeadLetterEntry> _entries = new();
    private DeadLetterEntry? _selected;
    private RenderedValue? _rendered;
    private string? _continuationToken;
    private bool _hasMore;
    private bool _loading;
    private bool _loaded;
    private int _count;
    private string? _error;

    /// <inheritdoc />
    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        _entries.Clear();
        _selected = null;
        _rendered = null;
        _continuationToken = null;
        _hasMore = false;
        _loaded = false;
        await LoadPageAsync(reloadCount: true);
    }

    private Task LoadMoreAsync() => LoadPageAsync(reloadCount: false);

    private async Task LoadPageAsync(bool reloadCount)
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            if (reloadCount)
            {
                _count = await DeadLetterReader.CountAsync(Selection.Id, TabToken);
            }

            var page = await DeadLetterReader.ListAsync(Selection.Id, PageSize, _continuationToken, TabToken);
            _entries.AddRange(page.Entries);
            _continuationToken = page.ContinuationToken;
            _hasMore = page.HasMore;
            _loaded = true;
        }
        catch (OperationCanceledException)
        {
            // The tab was disposed (selection change or tab switch); drop quietly.
        }
        catch (Exception ex)
        {
            _error = $"Failed to load the dead-letter queue: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void Select(DeadLetterEntry entry)
    {
        _selected = entry;
        _rendered = ValueRenderer.Render(entry.Value, entry.Truncated);
    }

    private static string SourceLabel(DeadLetterSource source) => source switch
    {
        DeadLetterSource.Replication => "Replication",
        DeadLetterSource.Restore => "Restore",
        DeadLetterSource.LocalRejected => "Local (rejected)",
        _ => "Unknown",
    };
}
