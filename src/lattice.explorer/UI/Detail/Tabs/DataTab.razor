@using Orleans.Lattice.Explorer.Core.Data
@inherits DetailTabBase
@inject IDataReader DataReader
@inject IUiSessionStore SessionStore

<div class="explorer-data">
    <div class="explorer-data-toolbar">
        <button type="button" class="explorer-btn" disabled="@_loading" @onclick="ReloadFirstPageAsync">
            @(_loading ? "Loading..." : "Refresh")
        </button>
        <label class="explorer-data-pagesize">
            Page size
            <select disabled="@_loading" @onchange="OnPageSizeChanged">
                @foreach (var size in DataPaging.PageSizes)
                {
                    <option value="@size" selected="@(size == _pageSize)">@size</option>
                }
            </select>
        </label>
        <div class="explorer-data-pager">
            <button type="button" class="explorer-btn" disabled="@(_loading || !_pager.CanGoPrevious)" @onclick="PreviousPage">Prev</button>
            <span class="explorer-data-pagenum">Page @(_pager.PageIndex + 1)</span>
            <button type="button" class="explorer-btn" disabled="@(_loading || !_pager.CanGoNext)" @onclick="NextPageAsync">Next</button>
        </div>
    </div>

    <DataKeySearch Loading="@_loading" Disabled="@(_activeTagFilter is not null)"
                   InitialValue="@_keyPrefix" OnSearch="OnKeySearchAsync" />

    @if (_tagIndexes.Count > 0)
    {
        <div class="explorer-data-toolbar explorer-data-tagfilter">
            <label class="explorer-data-tagfilter-field">
                Tag index
                <select disabled="@_loading" @bind="_selectedIndex">
                    @foreach (var name in _tagIndexes)
                    {
                        <option value="@name">@name</option>
                    }
                </select>
            </label>
            <label class="explorer-data-tagfilter-field">
                Tag
                <input type="text" disabled="@_loading" placeholder="tag value"
                       @bind="_tagValue" @bind:event="oninput" @onkeyup="OnTagKeyUp" />
            </label>
            <button type="button" class="explorer-btn"
                    disabled="@(_loading || string.IsNullOrWhiteSpace(_tagValue))"
                    @onclick="ApplyTagFilterAsync">
                Filter
            </button>
            @if (_activeTagFilter is not null)
            {
                <span class="explorer-data-tagfilter-active">
                    Showing rows tagged <code>@_activeTagFilter.Tag</code> in <code>@_activeTagFilter.IndexName</code>
                </span>
                <button type="button" class="explorer-btn-link" disabled="@_loading" @onclick="ClearTagFilterAsync">Clear</button>
            }
        </div>
    }

    <div class="explorer-data-body">
        <div class="explorer-data-keys">
            @if (_loading && _pager.Current.Entries.Count == 0)
            {
                <div class="explorer-data-state">Loading entries...</div>
            }
            else if (_error is not null)
            {
                <div class="explorer-data-state explorer-data-error">
                    <span>@_error</span>
                    <button type="button" class="explorer-btn-link" @onclick="ReloadFirstPageAsync">Try again</button>
                </div>
            }
            else if (_pager.Current.Entries.Count == 0)
            {
                <div class="explorer-data-state">No entries on this page.</div>
            }
            else
            {
                <table class="explorer-table explorer-data-keytable">
                    <thead>
                        <tr>
                            <th>Key</th>
                            <th>Size</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in _pager.Current.Entries)
                        {
                            <tr class="explorer-data-keyrow @(entry.Key == _selectedKey ? "is-selected" : null)"
                                @onclick="@(() => SelectAsync(entry.Key))">
                                <td class="explorer-data-key">@entry.Key</td>
                                <td>@entry.ValueLength.ToString("N0")</td>
                                <td>
                                    @if (entry.IsTombstone)
                                    {
                                        <span class="explorer-data-flag explorer-data-flag-tomb">tomb</span>
                                    }
                                    @if (entry.CrdtShape is not null)
                                    {
                                        <span class="explorer-data-flag">@entry.CrdtShape</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="explorer-data-detail">
            @if (_selectedKey is null)
            {
                <div class="explorer-data-state">Select a key to inspect its value.</div>
            }
            else if (_detailLoading)
            {
                <div class="explorer-data-state">Loading value...</div>
            }
            else if (_detailError is not null)
            {
                <div class="explorer-data-state explorer-data-error">
                    <span>@_detailError</span>
                    <button type="button" class="explorer-btn-link" @onclick="@(() => SelectAsync(_selectedKey))">Try again</button>
                </div>
            }
            else if (_detail is null)
            {
                <div class="explorer-data-state">Key not found (it may have changed since the scan).</div>
            }
            else
            {
                var d = _detail;
                <div class="explorer-data-detail-head">
                    <code class="explorer-data-detail-key">@d.Key</code>
                    @if (_rendered is not null)
                    {
                        <span class="explorer-data-format">@_rendered.Format.ToString().ToLowerInvariant()</span>
                    }
                </div>

                <dl class="explorer-data-meta">
                    <div><dt>Value length</dt><dd>@d.ValueLength.ToString("N0") bytes</dd></div>
                    <div><dt>Timestamp</dt><dd>@FormatHlc(d)</dd></div>
                    <div><dt>Tombstone</dt><dd>@(d.IsTombstone ? "yes" : "no")</dd></div>
                    <div><dt>Expires</dt><dd>@FormatExpiry(d)</dd></div>
                    @if (d.CrdtShape is not null)
                    {
                        <div><dt>CRDT shape</dt><dd>@d.CrdtShape</dd></div>
                    }
                </dl>

                @if (_rendered?.Note is not null)
                {
                    <p class="explorer-data-note">@_rendered.Note</p>
                }

                @if (_rendered is null || _rendered.Format == ValueFormat.Empty)
                {
                    <p class="explorer-data-muted">No value bytes.</p>
                }
                else
                {
                    <pre class="explorer-data-value explorer-data-value-@_rendered.Format.ToString().ToLowerInvariant()">@_rendered.Content</pre>
                }
            }
        </div>
    </div>
</div>

@code {
    private DataPager _pager = default!;
    private int _pageSize = DataPaging.DefaultPageSize;
    private bool _loading;
    private string? _error;

    private string? _selectedKey;
    private DataEntry? _detail;
    private RenderedValue? _rendered;
    private bool _detailLoading;
    private string? _detailError;

    private IReadOnlyList<string> _tagIndexes = Array.Empty<string>();
    private string? _selectedIndex;
    private string? _tagValue;
    private TagFilter? _activeTagFilter;

    // The committed key starts-with filter, kept in sync from the search box so
    // other reload triggers (Refresh, page size) reuse it. Only applied to an
    // untagged scan; the state-API range is ignored under a tag filter.
    private string _keyPrefix = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _pager = new DataPager(DataReader);

        // Restore this selection's retained search (session-scoped, not durable)
        // so the first scan and the search box both reflect the prior prefix.
        _keyPrefix = SessionStore.GetOrDefault(SearchStateKey, string.Empty);

        await LoadTagIndexesAsync();
        await ReloadFirstPageAsync();
    }

    private async Task LoadTagIndexesAsync()
    {
        try
        {
            _tagIndexes = await DataReader.ListTagIndexesForTreeAsync(Selection.Id, TabToken);
            _selectedIndex = _tagIndexes.Count > 0 ? _tagIndexes[0] : null;
        }
        catch (OperationCanceledException) when (TabToken.IsCancellationRequested)
        {
            // Tab navigated away mid-load; nothing to surface.
        }
        catch
        {
            // The tag filter is a progressive enhancement: if the catalog probe
            // fails the Data tab still works as an unfiltered scan.
            _tagIndexes = Array.Empty<string>();
            _selectedIndex = null;
        }
    }

    private Task ReloadFirstPageAsync()
    {
        ClearSelection();

        // A key prefix only applies to an untagged scan; the state-API range is
        // ignored under a tag filter (and the prefix box is disabled then).
        var prefix = _activeTagFilter is null && !string.IsNullOrEmpty(_keyPrefix) ? _keyPrefix : null;
        return RunAsync(() => _pager.ResetAsync(Selection.Id, _pageSize, _activeTagFilter, prefix, TabToken));
    }

    private async Task OnKeySearchAsync(string prefix)
    {
        _keyPrefix = prefix;

        // Retain per selection for the session; an empty search clears the entry.
        if (string.IsNullOrWhiteSpace(prefix))
        {
            SessionStore.Remove(SearchStateKey);
        }
        else
        {
            SessionStore.Set(SearchStateKey, prefix);
        }

        await ReloadFirstPageAsync();
    }

    // Session-store key for this selection's retained key search. The feature
    // prefix keeps it distinct from any other UI state stored for the selection.
    private string SearchStateKey => $"data-search:{Selection.Id}";

    private async Task OnTagKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_tagValue))
        {
            await ApplyTagFilterAsync();
        }
    }

    private async Task ApplyTagFilterAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedIndex) || string.IsNullOrWhiteSpace(_tagValue))
        {
            return;
        }

        _activeTagFilter = new TagFilter(_selectedIndex, _tagValue.Trim());
        await ReloadFirstPageAsync();
    }

    private async Task ClearTagFilterAsync()
    {
        _activeTagFilter = null;
        await ReloadFirstPageAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size))
        {
            _pageSize = DataPaging.Normalize(size);
        }

        // Page-size change opens a fresh snapshot from the first page.
        await ReloadFirstPageAsync();
    }

    private Task NextPageAsync()
    {
        ClearSelection();
        return RunAsync(() => _pager.NextAsync(TabToken));
    }

    private void PreviousPage()
    {
        ClearSelection();
        _pager.Previous();
        StateHasChanged();
    }

    private async Task RunAsync(Func<Task> operation)
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            await operation();
        }
        catch (OperationCanceledException) when (TabToken.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task SelectAsync(string? key)
    {
        if (key is null)
        {
            return;
        }

        _selectedKey = key;
        _detail = null;
        _rendered = null;
        _detailError = null;
        _detailLoading = true;
        StateHasChanged();

        try
        {
            _detail = await DataReader.GetEntryAsync(Selection.Id, key, TabToken);
            _rendered = _detail is null ? null : ValueRenderer.Render(_detail.Value, _detail.Truncated);
        }
        catch (OperationCanceledException) when (TabToken.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            _detailError = ex.Message;
        }
        finally
        {
            _detailLoading = false;
            StateHasChanged();
        }
    }

    private void ClearSelection()
    {
        _selectedKey = null;
        _detail = null;
        _rendered = null;
        _detailError = null;
    }

    private static string FormatHlc(DataEntry entry)
    {
        if (entry.Hlc.WallClockTicks <= 0)
        {
            return "-";
        }

        var wall = new DateTime(entry.Hlc.WallClockTicks, DateTimeKind.Utc).ToLocalTime();
        return $"{wall:yyyy-MM-dd HH:mm:ss} (+{entry.Hlc.Counter})";
    }

    private static string FormatExpiry(DataEntry entry)
    {
        if (entry.ExpiresAtTicks <= 0)
        {
            return "never";
        }

        return new DateTime(entry.ExpiresAtTicks, DateTimeKind.Utc).ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
    }

    /// <summary>
    /// Releases the active snapshot cursor best-effort on teardown so an
    /// abandoned scan does not retain its server-side WAL pin and baseline until
    /// the idle TTL. Fire-and-forget with a fresh token: the base disposal
    /// cancels <see cref="DetailTabBase.TabToken"/>, so the cancel must not ride
    /// on it.
    /// </summary>
    protected override void Dispose(bool disposing)
    {
        if (disposing && _pager is not null)
        {
            _ = _pager.CloseAsync(CancellationToken.None);
        }

        base.Dispose(disposing);
    }
}
