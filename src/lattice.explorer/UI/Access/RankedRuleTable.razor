@using Orleans.Lattice.Explorer.Access
@using Orleans.Lattice.Explorer.UI.Access

@*
    Renders a precedence-ranked set of authorization rules as a compact table.
    Shared by the Explain (matched rules) and EffectivePermissions views. The
    ranking is a presentation aid only - the authoritative verdict is the facade's
    Allowed flag, rendered separately by the Explain view.
*@

@if (Rules.Count == 0)
{
    <p class="explorer-backups-empty">No rules apply.</p>
}
else
{
    <table class="explorer-access-ruletable">
        <thead>
            <tr><th>Rule</th><th>Subject</th><th>Scope</th><th>Ops</th><th>Effect</th></tr>
        </thead>
        <tbody>
            @foreach (var ranked in Rules)
            {
                var rule = ranked.Rule;
                <tr class="@(ranked.DenyOverrides ? "is-deny" : null)">
                    <td>@rule.RuleId</td>
                    <td>@AccessRuleFormat.SubjectLabel(rule.Subject)</td>
                    <td>@AccessRuleFormat.ScopeLabel(rule.Scope)</td>
                    <td>@AccessRuleFormat.OperationsLabel(rule.Operations)</td>
                    <td>@rule.Effect</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    /// <summary>The precedence-ranked rules to render, highest precedence first.</summary>
    [Parameter]
    public IReadOnlyList<RankedRule> Rules { get; set; } = Array.Empty<RankedRule>();
}
