@page "/"
@page "/t/{tenant}"
@inherits ExplorerPage

@*
    Home: the estate overview. Each shown area is a stop on a spine with its
    one-line status beneath its name - drawn as a spine, never as cards. The
    statuses arrive independently, each time-boxed, so a slow area never holds
    back the others.
*@

<PageTitle>Orleans.Lattice Explorer</PageTitle>

<h1 class="lt-shell-page-title">Estate</h1>
<p class="lt-shell-page-lede">Every area you can reach, and how each is doing.</p>

@if (!CurrentLocation.EntriesLoaded)
{
    <LtSkeleton Lines="5" Label="Loading the estate" />
}
else if (CurrentLocation.Entries.Count == 0)
{
    <LtEmptyState Title="Nothing to show yet" HeadingLevel="2">
        No area is available to you. Connect to a cluster, or sign in with an identity that holds a grant.
    </LtEmptyState>
}
else
{
    @if (AnyNeedsRecheck)
    {
        <AreaRecheckNotice />
    }
    <ul class="lt-spine lt-shell-estate">
        @foreach (var entry in CurrentLocation.Entries)
        {
            var status = StatusOf(entry);
            <li class="lt-spine__stop lt-shell-estate__stop" @key="entry.Area.Key" data-lt-area-state="@StateOf(entry)">
                <a class="lt-spine__link lt-shell-estate__link" href="@AreaHref(entry)">
                    <LtNode Kind="LtNodeKind.Hollow" />
                    <span class="lt-shell-estate__text">
                        <span class="lt-shell-estate__name">@entry.Area.DisplayName</span>
                        @if (!entry.IsVisible)
                        {
                            <span class="lt-shell-estate__status lt-shell-estate__status--unavailable">@entry.Availability.Reason</span>
                        }
                        else if (status is not null)
                        {
                            <span class="@(status.IsUnchecked ? "lt-shell-estate__status lt-shell-estate__status--unavailable" : "lt-shell-estate__status")"
                                  data-lt-area-status="@(status.IsUnchecked ? "unchecked" : status.IsStale ? "stale" : "current")">@status.Text</span>
                        }
                        @if (entry.IsStale || status is { IsStale: true })
                        {
                            <span class="lt-shell-estate__status lt-shell-estate__status--stale">@StaleNote</span>
                        }
                    </span>
                </a>
            </li>
        }
    </ul>
}
