<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Orleans.Lattice.Explorer.UI</RootNamespace>
    <PackageId>Orleans.Lattice.Explorer.UI</PackageId>
    <Version>10.0.0</Version>
    <Description>The Orleans.Lattice Explorer UI: a Razor class library for everything outside a Lattice App's frame - the navigation and session chrome, the shell-owned native areas (Data, Apps, Access, Schema, Tenancy, Replication, Backups, Telemetry and Cluster), the order-diagram design system in its Operate register, the credential-aware transport adapters, and the app frame host and bridge broker. Its static assets are served from _content/Orleans.Lattice.Explorer.UI. Nothing in it is an extension point: areas are compiled in, and the only third-party UI surface is a sandboxed Lattice App frame.</Description>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Explorer.Tests" />
    <InternalsVisibleTo Include="Orleans.Lattice.Explorer.Web" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
  </ItemGroup>

  <!--
    Every project reference the Explorer UI needs. Areas bind to the transport-neutral contracts in
    lattice.api.abstractions; the gRPC client packages back the Explorer's own
    credential-aware transport adapters (T1). AppKit is referenced only so its
    static web assets flow to a head that references the UI.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Core\Orleans.Lattice.Explorer.Core.csproj" />
    <ProjectReference Include="..\AppKit\Orleans.Lattice.Explorer.AppKit.csproj" />
    <ProjectReference Include="..\..\lattice.api.abstractions\Orleans.Lattice.Api.Abstractions.csproj" />
    <ProjectReference Include="..\..\lattice.api.state.grpc\Orleans.Lattice.Api.State.Grpc.csproj" />
    <ProjectReference Include="..\..\lattice.api.data.grpc\Orleans.Lattice.Api.Data.Grpc.csproj" />
    <ProjectReference Include="..\..\lattice.api.auth.grpc\Orleans.Lattice.Api.Auth.Grpc.csproj" />
    <ProjectReference Include="..\..\lattice.api.schema.grpc\Orleans.Lattice.Api.Schema.Grpc.csproj" />
    <ProjectReference Include="..\..\lattice.api.tenantadmin.grpc\Orleans.Lattice.Api.TenantAdmin.Grpc.csproj" />
    <ProjectReference Include="..\..\lattice.api.backup.grpc\Orleans.Lattice.Api.Backup.Grpc.csproj" />
    <ProjectReference Include="..\..\lattice.api.telemetry.grpc\Orleans.Lattice.Api.Telemetry.Grpc.csproj" />
    <ProjectReference Include="..\..\lattice.api.treeadmin.grpc\Orleans.Lattice.Api.TreeAdmin.Grpc.csproj" />
    <ProjectReference Include="..\..\lattice.api.replication.grpc\Orleans.Lattice.Api.Replication.Grpc.csproj" />
    <ProjectReference Include="..\..\lattice.api.apps.grpc\Orleans.Lattice.Api.Apps.Grpc.csproj" />
  </ItemGroup>

  <!--
    wwwroot/design/ carries byte-identical copies of the documentation site's
    tokens.css, fonts, font licences and favicon (epic #3807, E10). They are
    real files, not build-time links or staged copies: the static web asset
    runtime resolves every asset as its project's content root plus a relative
    path, so a file that lives anywhere else is served as an empty 200 under
    `dotnet run` and every token is undefined. docs-site/template/public/ stays
    the one source of truth, and ShellTokenParityTests fails the build the
    moment a copy's bytes differ from it.
  -->

</Project>
