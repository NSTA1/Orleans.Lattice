@using Orleans.Lattice.Explorer.Core.Authentication
@using Orleans.Lattice.Explorer.UI.Authentication
@inject IExplorerAuthSession AuthSession
@inject IServiceProvider Services

<div class="explorer-config-dialog" role="dialog" aria-modal="true" aria-label="Sign in to the state API">
    <h2>Sign in</h2>

    @if (_mode == SignInMode.Unsupported)
    {
        <p class="explorer-config-help">
            This endpoint requires the <strong>@_unsupportedScheme</strong> sign-in method, which is not
            available in this build of the explorer. Install the matching login provider package (for example
            <code>Orleans.Lattice.Explorer.Entra</code> for Entra ID) and reconnect.
        </p>
        <div class="explorer-config-actions">
            <button type="button" class="explorer-btn" @onclick="Cancel">Close</button>
        </div>
    }
    else if (_mode == SignInMode.Token)
    {
        <p class="explorer-config-help">
            This endpoint uses <strong>@_selectedDisplay</strong>. Continue to sign in; a browser window
            or device-code prompt may open to complete authentication.
        </p>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="explorer-config-error" role="alert">@_error</p>
        }

        <div class="explorer-config-actions">
            <button type="button" class="explorer-btn" disabled="@_busy" @onclick="Cancel">Cancel</button>
            <button type="button" class="explorer-btn explorer-btn-primary" disabled="@_busy" @onclick="SignInWithMethodAsync">
                @(_busy ? "Signing in..." : $"Sign in with {_selectedDisplay}")
            </button>
        </div>
    }
    else if (_options.UseServerFormPost)
    {
        <p class="explorer-config-help">
            Enter the username and password for the Lattice state-API endpoint.
        </p>
        <form method="post" action="@_options.LoginPath">
            <AntiforgeryToken />
            <label class="explorer-config-field">
                <span>Username</span>
                <input type="text" name="username" autocomplete="username" />
            </label>
            <label class="explorer-config-field">
                <span>Password</span>
                <input type="password" name="password" autocomplete="current-password" />
            </label>
            <div class="explorer-config-actions">
                <button type="button" class="explorer-btn" @onclick="Cancel">Cancel</button>
                <button type="submit" class="explorer-btn explorer-btn-primary">Sign in</button>
            </div>
        </form>
    }
    else
    {
        <p class="explorer-config-help">
            Enter the username and password for the Lattice state-API endpoint.
        </p>
        <label class="explorer-config-field">
            <span>Username</span>
            <input type="text"
                   autocomplete="username"
                   value="@_username"
                   @oninput="OnUsernameInput"
                   @onkeydown="OnKeyDown" />
        </label>
        <label class="explorer-config-field">
            <span>Password</span>
            <input type="password"
                   autocomplete="current-password"
                   value="@_password"
                   @oninput="OnPasswordInput"
                   @onkeydown="OnKeyDown" />
        </label>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="explorer-config-error" role="alert">@_error</p>
        }

        <div class="explorer-config-actions">
            <button type="button" class="explorer-btn" disabled="@_busy" @onclick="Cancel">Cancel</button>
            <button type="button" class="explorer-btn explorer-btn-primary" disabled="@_busy" @onclick="SignInAsync">
                @(_busy ? "Signing in..." : "Sign in")
            </button>
        </div>
    }
</div>

@code {
    private enum SignInMode
    {
        Basic,
        Token,
        Unsupported,
    }

    private string _username = string.Empty;
    private string _password = string.Empty;
    private string? _error;
    private bool _busy;
    private ExplorerAuthUiOptions _options = new();
    private SignInMode _mode = SignInMode.Basic;
    private string? _selectedScheme;
    private string _selectedDisplay = string.Empty;
    private string? _unsupportedScheme;

    /// <summary>Invoked when the dialog is dismissed (cancel or successful sign-in).</summary>
    [Parameter]
    public EventCallback OnClosed { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _options = (ExplorerAuthUiOptions?)Services.GetService(typeof(ExplorerAuthUiOptions)) ?? new ExplorerAuthUiOptions();

        // Ask the endpoint which scheme it requires. Discovery degrades to Basic
        // when the endpoint does not advertise or is unreachable, so the original
        // username/password flow is always the safe fallback.
        try
        {
            var advertisement = await AuthSession.DiscoverAsync();
            ResolveMode(advertisement);
        }
        catch
        {
            _mode = SignInMode.Basic;
        }
    }

    private void ResolveMode(ExplorerAuthSchemeAdvertisement advertisement)
    {
        foreach (var scheme in advertisement.Schemes)
        {
            if (AuthSession.AvailableSchemes.Any(a => string.Equals(a, scheme.SchemeId, StringComparison.OrdinalIgnoreCase)))
            {
                _selectedScheme = scheme.SchemeId;
                _selectedDisplay = string.IsNullOrWhiteSpace(scheme.DisplayName) ? scheme.SchemeId : scheme.DisplayName;
                _mode = string.Equals(scheme.SchemeId, ExplorerAuthSchemes.Basic, StringComparison.OrdinalIgnoreCase)
                    ? SignInMode.Basic
                    : SignInMode.Token;
                return;
            }
        }

        if (advertisement.HasSchemes)
        {
            _mode = SignInMode.Unsupported;
            _unsupportedScheme = advertisement.Schemes[0].SchemeId;
        }
    }

    private void OnUsernameInput(ChangeEventArgs e) => _username = e.Value?.ToString() ?? string.Empty;

    private void OnPasswordInput(ChangeEventArgs e) => _password = e.Value?.ToString() ?? string.Empty;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter")
        {
            await SignInAsync();
        }
    }

    private async Task SignInAsync()
    {
        if (string.IsNullOrWhiteSpace(_username))
        {
            _error = "Enter a username.";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await AuthSession.LoginAsync(_username.Trim(), _password);
            await OnClosed.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SignInWithMethodAsync()
    {
        if (_selectedScheme is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await AuthSession.LoginWithMethodAsync(_selectedScheme);
            await OnClosed.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Cancel() => await OnClosed.InvokeAsync();
}
