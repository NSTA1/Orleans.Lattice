@*
    The former free-text tenant controls, now a placement shim over the real
    control.

    It demanded a tenant id from memory, discarded the fail-closed result of the
    switch it performed, and sat inside the sign-in cluster. TenantScope replaces
    all three. This file remains only so an existing placement keeps working
    while the chrome moves the control to where it belongs; it holds no state and
    no behaviour of its own.
*@

<TenantScope Class="@Class" />

@code {
    /// <summary>Additional CSS classes forwarded to the tenant scope control.</summary>
    [Parameter] public string? Class { get; set; }
}
