@using Orleans.Lattice.Schema
@using Orleans.Lattice.Explorer.Schema
@using Orleans.Lattice.Explorer.Core.Catalog
@using Orleans.Lattice.Explorer.Core.Navigation
@implements IDisposable
@inject ISchemaPolicyService PolicyService
@inject ISchemaVersioningService VersioningService
@inject ISchemaComplianceService ComplianceService
@inject ISchemaAdminCapabilityService CapabilityService
@inject ICatalogReader CatalogReader
@inject IExplorerCapabilityStore Capabilities

@*
    The Schema management area. Four sub-tabs scoped to a single governed tree:
    Policy views / sets / clears the enforcement policy; Versions views / sets /
    advances / migrates / clears the envelope-version config and shows remediation
    status; Compliance runs a read-only audit; Dead letters lists the strict-mode
    diverted items. The coarse SchemaAllowed capability gates the whole area (the
    shell greys the top-level tab when the schema endpoint is unreachable); within
    the area every action additionally renders disabled (never hidden) while a
    request is in flight or when the per-tree capability probe denies it, and every
    server denial folds into a clean "not permitted" banner rather than an unhandled
    error.
*@

<section class="explorer-backups explorer-schema" aria-label="Schema">
    <div class="explorer-schema-layout">
        <aside class="explorer-schema-treepanel" aria-label="Schema tree selection">
            <header class="explorer-schema-treepanel-header">
                <span class="explorer-schema-treepanel-title">Trees</span>
                <button type="button"
                        class="explorer-nav-refresh"
                        title="Refresh trees"
                        aria-label="Refresh trees"
                        disabled="@(_treesLoading || !_allowed)"
                        @onclick="RefreshTreesAsync">
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                        <path fill="currentColor"
                              d="M17.65 6.35A8 8 0 1 0 19.73 14h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35Z" />
                    </svg>
                </button>
            </header>
            <div class="explorer-schema-treelist">
                @if (!_allowed)
                {
                    <p class="explorer-nav-state">Schema management is unavailable.</p>
                }
                else if (_treesLoading && _trees.Count == 0)
                {
                    <p class="explorer-nav-state">Loading trees...</p>
                }
                else if (_treesError is not null)
                {
                    <div class="explorer-nav-state explorer-nav-error">
                        <span>@_treesError</span>
                        <button type="button" class="explorer-btn-link" @onclick="RefreshTreesAsync">Try again</button>
                    </div>
                }
                else if (_trees.Count == 0)
                {
                    <p class="explorer-nav-state">No trees found.</p>
                }
                else
                {
                    <ul class="explorer-nav-list" role="listbox" aria-label="Trees">
                        @foreach (var tree in _trees)
                        {
                            var isSelected = string.Equals(_treeId, tree.Id, StringComparison.Ordinal);
                            <li role="option" aria-selected="@isSelected">
                                <button type="button"
                                        class="explorer-nav-item @(isSelected ? "is-selected" : null)"
                                        disabled="@_busy"
                                        @onclick="@(() => SelectTreeAsync(tree.Id))">
                                    <span class="explorer-nav-item-id">@tree.Label</span>
                                    @if (tree.Lifecycle is not null || tree.ShardCount is int)
                                    {
                                        <span class="explorer-nav-item-meta">
                                            @if (tree.Lifecycle is not null)
                                            {
                                                <span class="explorer-badge">@tree.Lifecycle</span>
                                            }
                                            @if (tree.ShardCount is int shards)
                                            {
                                                <span class="explorer-badge" title="Shard count">@shards sh</span>
                                            }
                                        </span>
                                    }
                                </button>
                            </li>
                        }
                    </ul>
                }
            </div>
        </aside>

        <div class="explorer-schema-content">
            <header class="explorer-backups-header">
                <div class="explorer-tabstrip" role="tablist" aria-label="Schema tabs">
                    <button type="button" role="tab"
                            class="explorer-tab @(_tab == SchemaTab.Policy ? "is-active" : null)"
                            aria-selected="@(_tab == SchemaTab.Policy)"
                            @onclick="@(() => SetTab(SchemaTab.Policy))">Policy</button>
                    <button type="button" role="tab"
                            class="explorer-tab @(_tab == SchemaTab.Versions ? "is-active" : null)"
                            aria-selected="@(_tab == SchemaTab.Versions)"
                            @onclick="@(() => SetTab(SchemaTab.Versions))">Versions</button>
                    <button type="button" role="tab"
                            class="explorer-tab @(_tab == SchemaTab.Compliance ? "is-active" : null)"
                            aria-selected="@(_tab == SchemaTab.Compliance)"
                            @onclick="@(() => SetTab(SchemaTab.Compliance))">Compliance</button>
                    <button type="button" role="tab"
                            class="explorer-tab @(_tab == SchemaTab.DeadLetters ? "is-active" : null)"
                            aria-selected="@(_tab == SchemaTab.DeadLetters)"
                            @onclick="@(() => SetTab(SchemaTab.DeadLetters))">Dead letters</button>
                </div>
            </header>

            <p class="explorer-backups-note">
                Schema governance is opt-in per tree: control how values are validated (Policy) and how their shape evolves over time (Versions).
            </p>

            @if (!_allowed)
            {
                <p class="explorer-backups-result is-denied" role="status">
                    Schema management is not available: the cluster has no schema control endpoint configured, or it is unreachable.
                </p>
            }
            else if (_probedTreeId is null)
            {
                <p class="explorer-backups-empty">Select a tree from the list to manage its schema.</p>
            }

            @if (_lastResult is not null)
            {
                <p class="explorer-backups-result @ResultClass(_lastResult.Status)" role="status">@_lastResult.Message</p>
            }

            @if (_tab == SchemaTab.Policy)
    {
        <div class="explorer-access-grid explorer-schema-narrow">
            <div class="explorer-access-listcol">
                <div class="explorer-access-listhead">
                    <h3 class="explorer-access-title">Current policy</h3>
                    <button type="button" class="explorer-btn"
                            disabled="@(_busy || !_allowed || !_caps.CanManagePolicy || string.IsNullOrWhiteSpace(_treeId))" @onclick="EditPolicy">Edit policy</button>
                </div>
                @if (_policyView is null)
                {
                    <p class="explorer-backups-empty">Select a tree to view its policy.</p>
                }
                else if (!_policyView.IsSuccess)
                {
                    <p class="explorer-backups-result @ResultClass(_policyView.Status)" role="status">@_policyView.Message</p>
                }
                else if (_policyView.Value is null)
                {
                    <div class="explorer-schema-statuscard">
                        <p class="explorer-access-title">This tree has no schema policy</p>
                        <p class="explorer-access-sub">Every value is accepted. Add a policy to validate the shape of each value written to this tree.</p>
                        <div class="explorer-access-actions">
                            <button type="button" class="explorer-btn explorer-btn-primary"
                                    disabled="@(_busy || !_allowed || !_caps.CanManagePolicy || string.IsNullOrWhiteSpace(_treeId))" @onclick="EditPolicy">Add a policy</button>
                        </div>
                    </div>
                }
                else
                {
                    <p class="explorer-access-sub">Strict ingest: @(_policyView.Value.StrictIngest ? "on" : "off")</p>
                    @if (_policyView.Value.Rules.Count == 0)
                    {
                        <p class="explorer-backups-empty">Policy present with no rules (every value accepted).</p>
                    }
                    else
                    {
                        <table class="explorer-access-ruletable">
                            <thead><tr><th>#</th><th>Kind</th><th>Detail</th></tr></thead>
                            <tbody>
                                @for (var i = 0; i < _policyRuleRows.Count; i++)
                                {
                                    var row = _policyRuleRows[i];
                                    <tr><td>@(i + 1)</td><td>@row.Kind</td><td>@row.Detail</td></tr>
                                }
                            </tbody>
                        </table>
                    }
                }
            </div>
            @if (_policyFormOpen)
            {
            <div class="explorer-access-formcol">
                <h3 class="explorer-access-title">Set policy</h3>
                <label class="explorer-access-opcheck">
                    <input type="checkbox" checked="@_draftStrictIngest" disabled="@(_busy || !_allowed || !_caps.CanManagePolicy)"
                           @onchange="e => _draftStrictIngest = (bool)(e.Value ?? false)" />
                    <span>Strict ingest (dead-letter non-compliant ingested items)</span>
                </label>

                <h4 class="explorer-schema-subtitle">Draft rules</h4>
                @if (_draftRules.Count == 0)
                {
                    <p class="explorer-backups-empty">No draft rules. An empty policy accepts every value.</p>
                }
                else
                {
                    <ul class="explorer-access-memberlist">
                        @for (var i = 0; i < _draftRules.Count; i++)
                        {
                            var index = i;
                            var label = _draftRuleLabels[i];
                            <li>
                                <button type="button" class="explorer-btn explorer-btn-icon explorer-access-danger"
                                        title="Remove rule" aria-label="Remove rule"
                                        disabled="@(_busy || !_allowed || !_caps.CanManagePolicy)"
                                        @onclick="@(() => RemoveDraftRule(index))">x</button>
                                <span class="explorer-access-member-id">@label</span>
                            </li>
                        }
                    </ul>
                }

                <div class="explorer-schema-ruleform">
                    <label class="explorer-access-field">
                        <span>Rule kind</span>
                        <select value="@_draftRuleKind" disabled="@(_busy || !_allowed || !_caps.CanManagePolicy)"
                                @onchange="e => _draftRuleKind = Enum.Parse<SchemaRuleDraftKind>(e.Value?.ToString() ?? nameof(SchemaRuleDraftKind.Utf8))">
                            @foreach (var kind in RuleKinds)
                            {
                                <option value="@kind">@kind</option>
                            }
                        </select>
                    </label>
                    @if (_draftRuleKind == SchemaRuleDraftKind.MaxLength)
                    {
                        <label class="explorer-access-field">
                            <span>Max byte length</span>
                            <input type="number" min="0" value="@_draftRuleMaxLength" disabled="@(_busy || !_allowed || !_caps.CanManagePolicy)"
                                   @oninput="e => int.TryParse(e.Value?.ToString(), out _draftRuleMaxLength)" />
                        </label>
                    }
                    @if (_draftRuleKind == SchemaRuleDraftKind.Regex)
                    {
                        <label class="explorer-access-field">
                            <span>Pattern</span>
                            <input type="text" value="@_draftRuleRegex" disabled="@(_busy || !_allowed || !_caps.CanManagePolicy)"
                                   @oninput="e => _draftRuleRegex = e.Value?.ToString() ?? string.Empty" placeholder="regex pattern" />
                        </label>
                        <label class="explorer-access-field">
                            <span>Member path</span>
                            <input type="text" value="@_draftRuleMemberPath" disabled="@(_busy || !_allowed || !_caps.CanManagePolicy)"
                                   @oninput="e => _draftRuleMemberPath = e.Value?.ToString() ?? string.Empty" placeholder="optional dotted path" />
                        </label>
                    }
                    <label class="explorer-access-field">
                        <span>Description</span>
                        <input type="text" value="@_draftRuleDescription" disabled="@(_busy || !_allowed || !_caps.CanManagePolicy)"
                               @oninput="e => _draftRuleDescription = e.Value?.ToString() ?? string.Empty" placeholder="optional" />
                    </label>
                    <button type="button" class="explorer-btn"
                            disabled="@(_busy || !_allowed || !_caps.CanManagePolicy || !CanAddDraftRule())" @onclick="AddDraftRule">Add rule</button>
                </div>

                <div class="explorer-access-actions">
                    <button type="button" class="explorer-btn"
                            disabled="@(_busy || !_allowed || !_caps.CanManagePolicy || string.IsNullOrWhiteSpace(_treeId))" @onclick="SavePolicyAsync">Set policy</button>
                    <button type="button" class="explorer-btn" disabled="@_busy" @onclick="CancelPolicyForm">Cancel</button>
                    <button type="button" class="explorer-btn explorer-access-danger"
                            disabled="@(_busy || !_allowed || !_caps.CanManagePolicy || string.IsNullOrWhiteSpace(_treeId))" @onclick="ClearPolicyAsync">Clear policy</button>
                </div>
            </div>
            }
            else
            {
                <div class="explorer-access-formcol">
                    <p class="explorer-backups-empty">Choose 'Edit policy' to author or replace this tree's schema policy.</p>
                </div>
            }
        </div>
    }
    else if (_tab == SchemaTab.Versions)
    {
        <div class="explorer-access-grid explorer-schema-narrow">
            <div class="explorer-access-listcol">
                <div class="explorer-access-listhead">
                    <h3 class="explorer-access-title">Versioning</h3>
                </div>
                @if (_versionView is null)
                {
                    <p class="explorer-backups-empty">Select a tree to view its versioning.</p>
                }
                else if (!_versionView.IsSuccess)
                {
                    <p class="explorer-backups-result @ResultClass(_versionView.Status)" role="status">@_versionView.Message</p>
                }
                else if (_versionView.Value.TargetVersion == 0)
                {
                    <div class="explorer-schema-statuscard">
                        <p class="explorer-access-title">This tree is unversioned</p>
                        <p class="explorer-access-sub">Values are stored exactly as written. Enable versioning to stamp each value with a schema version so its shape can evolve over time.</p>
                        <div class="explorer-access-actions">
                            <button type="button" class="explorer-btn explorer-btn-primary"
                                    disabled="@(_busy || !_allowed || !_caps.CanManageVersion || string.IsNullOrWhiteSpace(_treeId))" @onclick="EnableVersioning">Enable versioning</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="explorer-schema-statuscard">
                        <p class="explorer-access-sub">Schema @_versionView.Value.SchemaId, target v@(_versionView.Value.TargetVersion), strict ingest @(_versionView.Value.StrictIngest ? "on" : "off").</p>
                        <p class="explorer-access-sub">New writes are stamped v@(_versionView.Value.TargetVersion); older values are upcast to v@(_versionView.Value.TargetVersion) when read.</p>
                        @if (_remediationView is { IsSuccess: true })
                        {
                            <p class="explorer-access-sub">Re-stamp: @_remediationView.Value.Phase, @(_remediationView.Value.InProgress ? "in progress" : "idle"), scanned @_remediationView.Value.ScannedCount.</p>
                            @if (_remediationView.Value.DidAbort)
                            {
                                <p class="explorer-access-sub">Aborted on key '@_remediationView.Value.OffendingKey': @_remediationView.Value.Reason</p>
                            }
                        }
                        else if (_remediationView is not null && !_remediationView.IsSuccess)
                        {
                            <p class="explorer-backups-result @ResultClass(_remediationView.Status)" role="status">@_remediationView.Message</p>
                        }
                        <div class="explorer-access-actions">
                            <button type="button" class="explorer-btn explorer-btn-primary"
                                    disabled="@(_busy || !_allowed || !_caps.CanManageVersion || string.IsNullOrWhiteSpace(_treeId))" @onclick="BeginAdvance">Advance version</button>
                            <button type="button" class="explorer-btn-link"
                                    @onclick="@(() => _showAdvancedVersions = !_showAdvancedVersions)">@(_showAdvancedVersions ? "Hide advanced" : "Advanced")</button>
                        </div>
                        @if (_showAdvancedVersions)
                        {
                            <div class="explorer-schema-advanced">
                                <button type="button" class="explorer-btn"
                                        disabled="@(_busy || !_allowed || !_caps.CanManageVersion || string.IsNullOrWhiteSpace(_treeId))" @onclick="ShowAdvancedSetConfig">Set config directly</button>
                                <button type="button" class="explorer-btn"
                                        disabled="@(_busy || !_allowed || !_caps.CanManageVersion || string.IsNullOrWhiteSpace(_treeId))" @onclick="MigrateToTargetVersionAsync">Migrate stored values to target</button>
                                <p class="explorer-access-sub">Re-stamps existing values now so reads stop paying the per-read upcast cost.</p>
                            </div>
                        }
                    </div>
                }
            </div>
            @if (_versionEditor == VersionEditor.Configure)
            {
            <div class="explorer-access-formcol">
                <h3 class="explorer-access-title">@(IsVersioned ? "Set config directly" : "Enable versioning")</h3>
                <label class="explorer-access-field">
                    <span>Schema id</span>
                    <input type="number" min="0" value="@_setSchemaId" disabled="@(_busy || !_allowed || !_caps.CanManageVersion)"
                           @oninput="e => uint.TryParse(e.Value?.ToString(), out _setSchemaId)" />
                </label>
                <label class="explorer-access-field">
                    <span>@(IsVersioned ? "Target version" : "Starting version")</span>
                    <input type="number" min="1" value="@_setTargetVersion" disabled="@(_busy || !_allowed || !_caps.CanManageVersion)"
                           @oninput="e => uint.TryParse(e.Value?.ToString(), out _setTargetVersion)" />
                </label>
                <label class="explorer-access-opcheck">
                    <input type="checkbox" checked="@_setStrictIngest" disabled="@(_busy || !_allowed || !_caps.CanManageVersion)"
                           @onchange="e => _setStrictIngest = (bool)(e.Value ?? false)" />
                    <span>Strict ingest</span>
                </label>
                <div class="explorer-access-actions">
                    <button type="button" class="explorer-btn"
                            disabled="@(_busy || !_allowed || !_caps.CanManageVersion || _setTargetVersion == 0 || string.IsNullOrWhiteSpace(_treeId))" @onclick="SetVersionConfigAsync">@(IsVersioned ? "Set config" : "Enable versioning")</button>
                    <button type="button" class="explorer-btn" disabled="@_busy" @onclick="CancelVersionEditor">Cancel</button>
                    @if (IsVersioned)
                    {
                        <button type="button" class="explorer-btn explorer-access-danger"
                                disabled="@(_busy || !_allowed || !_caps.CanManageVersion || string.IsNullOrWhiteSpace(_treeId))" @onclick="ClearVersionConfigAsync">Clear config</button>
                    }
                </div>
            </div>
            }
            else if (_versionEditor == VersionEditor.Advance)
            {
            <div class="explorer-access-formcol">
                <h3 class="explorer-access-title">Advance version</h3>
                <label class="explorer-access-field">
                    <span>New target version</span>
                    <input type="number" min="1" value="@_advanceTargetVersion" disabled="@(_busy || !_allowed || !_caps.CanManageVersion)"
                           @oninput="e => uint.TryParse(e.Value?.ToString(), out _advanceTargetVersion)" />
                </label>
                <p class="explorer-access-sub">Advance changes only new writes; re-stamp also rewrites stored values now.</p>
                <div class="explorer-access-actions">
                    <button type="button" class="explorer-btn"
                            disabled="@(_busy || !_allowed || !_caps.CanManageVersion || _advanceTargetVersion == 0 || string.IsNullOrWhiteSpace(_treeId))" @onclick="AdvanceTargetVersionAsync">Advance target</button>
                    <button type="button" class="explorer-btn"
                            disabled="@(_busy || !_allowed || !_caps.CanManageVersion || _advanceTargetVersion == 0 || string.IsNullOrWhiteSpace(_treeId))" @onclick="AdvanceAndMigrateAsync">Advance and re-stamp existing values</button>
                    <button type="button" class="explorer-btn" disabled="@_busy" @onclick="CancelVersionEditor">Cancel</button>
                </div>
            </div>
            }
            else
            {
                <div class="explorer-access-formcol">
                    <p class="explorer-backups-empty">Choose 'Enable versioning' or 'Advance version' to change this tree's schema versioning.</p>
                </div>
            }
        </div>
    }
    else if (_tab == SchemaTab.Compliance)
    {
        <div class="explorer-access-grid explorer-schema-narrow">
            <div class="explorer-access-formcol">
                <h3 class="explorer-access-title">Compliance audit</h3>
                <p class="explorer-backups-note">A read-only scan of every current value against the tree's compiled policy. It never rewrites or dead-letters data.</p>
                <button type="button" class="explorer-btn"
                        disabled="@(_busy || !_allowed || !_caps.CanScanCompliance || string.IsNullOrWhiteSpace(_treeId))" @onclick="ScanComplianceAsync">Scan compliance</button>
            </div>
            <div class="explorer-access-formcol">
                @if (_complianceView is null)
                {
                    <p class="explorer-backups-empty">Select and scan a tree to view its compliance.</p>
                }
                else if (!_complianceView.IsSuccess)
                {
                    <p class="explorer-backups-result @ResultClass(_complianceView.Status)" role="status">@_complianceView.Message</p>
                }
                else if (!_complianceView.Value.HasPolicy)
                {
                    <p class="explorer-backups-empty">Tree '@_complianceView.Value.TreeId' is ungoverned (no policy).</p>
                }
                else
                {
                    <h3 class="explorer-access-title">Result for '@_complianceView.Value.TreeId'</h3>
                    <p class="explorer-schema-compliant">Compliant: @_complianceView.Value.CompliantCount</p>
                    <p class="explorer-schema-noncompliant">Non-compliant: @_complianceView.Value.NonCompliantCount</p>
                    <p class="explorer-access-sub">Scanned: @_complianceView.Value.ScannedCount</p>
                    @if (_complianceView.Value.RuleBreakdown.Count > 0)
                    {
                        <h4 class="explorer-schema-subtitle">Breakdown by reason</h4>
                        <table class="explorer-access-ruletable">
                            <thead><tr><th>Reason</th><th>Count</th></tr></thead>
                            <tbody>
                                @foreach (var row in _complianceView.Value.RuleBreakdown)
                                {
                                    <tr><td>@row.Reason</td><td>@row.Count</td></tr>
                                }
                            </tbody>
                        </table>
                    }
                }
            </div>
        </div>
    }
    else
    {
        <div class="explorer-access-grid">
            <div class="explorer-access-formcol">
                <h3 class="explorer-access-title">Dead letters</h3>
                <p class="explorer-backups-note">Strict-mode ingest diverts non-compliant items here instead of applying them. Read-only.</p>
                <button type="button" class="explorer-btn"
                        disabled="@(_busy || !_allowed || !_caps.CanViewDeadLetters || string.IsNullOrWhiteSpace(_treeId))" @onclick="LoadDeadLettersAsync">Load dead letters</button>
            </div>
            <div class="explorer-access-formcol">
                @if (_deadLetterView is null)
                {
                    <p class="explorer-backups-empty">Select a tree, then load its dead letters.</p>
                }
                else if (!_deadLetterView.IsSuccess)
                {
                    <p class="explorer-backups-result @ResultClass(_deadLetterView.Status)" role="status">@_deadLetterView.Message</p>
                }
                else
                {
                    <p class="explorer-access-sub">Total: @_deadLetterView.Count (showing @_deadLetterView.Entries.Count)</p>
                    @if (_deadLetterView.Entries.Count == 0)
                    {
                        <p class="explorer-backups-empty">No dead letters.</p>
                    }
                    else
                    {
                        <table class="explorer-access-ruletable">
                            <thead><tr><th>Key</th><th>Reason</th><th>Source</th><th>Bytes</th><th>When (UTC)</th></tr></thead>
                            <tbody>
                                @foreach (var entry in _deadLetterView.Entries)
                                {
                                    <tr>
                                        <td>@entry.Key</td>
                                        <td>@entry.Reason</td>
                                        <td>@entry.Source</td>
                                        <td>@entry.ValueByteLength</td>
                                        <td>@entry.TimestampUtc.UtcDateTime.ToString("u")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }
            </div>
        </div>
    }
        </div>
    </div>
</section>
