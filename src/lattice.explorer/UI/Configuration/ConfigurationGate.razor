@using Orleans.Lattice.Explorer.Core.Authentication
@using Orleans.Lattice.Explorer.Core.Configuration
@implements IDisposable
@inject IExplorerSession Session
@inject IExplorerAuthSession AuthSession

@if (!_initialized)
{
    <div class="lx-shell-config-loading">Loading configuration...</div>
}
else if (!Session.IsConfigured)
{
    <div class="lx-shell-config-overlay">
        <ConfigurationDialog AllowCancel="false" OnSaved="OnConfigured" />
    </div>
}
else
{
    @ChildContent
}

@code {
    private bool _initialized;

    /// <summary>The explorer content shown once a valid endpoint is configured.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Session.ConfigurationChanged += OnConfigurationChanged;
        await Session.InitializeAsync();
        await AuthSession.InitializeAsync();
        _initialized = true;
    }

    private void OnConfigured() => StateHasChanged();

    private void OnConfigurationChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.ConfigurationChanged -= OnConfigurationChanged;
}
