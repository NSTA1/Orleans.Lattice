<PageTitle>@TreeId - Cluster - Orleans.Lattice Explorer</PageTitle>

@if (_access.IsLoading)
{
    <ClusterTreeHeader TreeId="@TreeId" />
    <LtSkeleton Lines="4" Label="Loading the tree" />
}
else if (_access.Value is not { } access)
{
    <ClusterTreeHeader TreeId="@TreeId" />
    <p class="lt-cluster-error" role="alert">@_access.Error</p>
}
else if (_missingUnder is { } tenant)
{
    <ClusterTreeHeader TreeId="@TreeId" />
    <LtEmptyState Title="@($"Tenant {tenant} has no tree by this name")" HeadingLevel="2">
        The Cluster area reads a tree name as the tenant you hold sees it, so this address names
        a tree in another tenant, or none. Switch to the tenant that owns it, or
        <a href="@Href(ClusterAddresses.Trees)">see the trees of tenant @tenant</a>.
    </LtEmptyState>
}
else if (!ClusterTreeAccess.Any(access))
{
    <ClusterTreeHeader TreeId="@TreeId" />
    <LtEmptyState Title="Nothing you can administer" HeadingLevel="2">
        Your identity holds no tree-administration grant over this tree.
    </LtEmptyState>
}
else
{
    <ClusterTreeHeader TreeId="@TreeId">@Lede</ClusterTreeHeader>

    <nav class="lt-toolbar lt-cluster-actions" aria-label="Tree operations">
        @if (access.CanManageTreeLifecycle || access.CanViewDiagnostics)
        {
            <ClusterTreeLink TreeId="@TreeId" View="reshard" Text="Reshard" />
            <ClusterTreeLink TreeId="@TreeId" View="resize" Text="Resize" />
        }
        @if (access.CanAdministerTree || access.CanViewDiagnostics)
        {
            <ClusterTreeLink TreeId="@TreeId" View="snapshot" Text="Snapshot" />
        }
        <ClusterTreeLink TreeId="@TreeId" View="tools" Text="Admin tools" />
        @if (access.CanViewDiagnostics)
        {
            <a class="lt-cluster-link" href="@Href(ClusterAddresses.Wal(TreeId))">WAL placement</a>
            <a class="lt-cluster-link" href="@Href(ClusterAddresses.Orphans(TreeId))">Orphaned leaves</a>
        }
    </nav>

    <LtTabs Label="Tree administration" ActiveId="@ActiveTab" ActiveIdChanged="OnTabChanged">
        <LtTab Id="summary" Title="Summary">
            <ClusterTreeSummary TreeId="@TreeId" Capabilities="access" OperationSettled="OnOperationSettledAsync" />
        </LtTab>
        <LtTab Id="configuration" Title="Configuration">
            <ClusterTreeConfiguration TreeId="@TreeId" Capabilities="access" />
        </LtTab>
        <LtTab Id="shards" Title="Shards">
            <ClusterTreeShards TreeId="@TreeId" Capabilities="access" />
        </LtTab>
        <LtTab Id="storage" Title="Storage">
            <ClusterTreeStorage TreeId="@TreeId" Capabilities="access" />
        </LtTab>
        <LtTab Id="lifecycle" Title="Lifecycle">
            <ClusterTreeLifecycle TreeId="@TreeId" Capabilities="access" />
        </LtTab>
    </LtTabs>
}
