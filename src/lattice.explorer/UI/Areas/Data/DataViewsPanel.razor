@*
    Views: for a tree, the materialised views that read from it; for a view,
    the view itself. Each shows its kind, projection version and apply lag, and
    - when the caller holds administrative authority over the source tree - the
    reconcile and rebuild actions the tree-administration facade offers, each
    behind the destructive-action confirmation. A reconcile or rebuild runs on
    the cluster as a tracked operation whose progress the tab follows and picks
    up again when it is reopened. A view's physical generation tree is never shown.
*@
@using Orleans.Lattice.Explorer.UI.Operations

@if (Workspace is not null)
{
    <div class="lt-toolbar">
        <LtButton OnClick="RefreshStatusesAsync" Disabled="@(Busy is not null)">Refresh</LtButton>
        <span class="lt-data-toolbar__status" role="status">@DataArea.Plural(_views.Count, "view")</span>
    </div>

    @if (_watch.Status is { } operation)
    {
        <section class="lt-data-entry" aria-live="polite" data-lt-data-operation="@operation.Kind">
            <div class="lt-data-heading">
                <h2 class="lt-data-section-title">@OperationTitle(operation)</h2>
                @if (!operation.IsTerminal)
                {
                    <LtButton Variant="LtButtonVariant.Quiet" Disabled="@(_cancelling || operation.CancelRequested)" OnClick="CancelAsync">Stop</LtButton>
                }
            </div>
            <LtOperationProgress Status="@operation" Label="@(operation.Kind == Orleans.Lattice.Api.TreeAdmin.TreeAdminOperationKinds.ViewRebuild ? "View rebuild progress" : "View reconcile progress")" />
            @if (_watch.LastError is not null)
            {
                <p class="lt-data-note" role="alert">The progress could not be read just now; trying again. The operation keeps running on the cluster.</p>
            }
            else if (!operation.IsTerminal)
            {
                <p class="lt-data-note">It runs on the cluster: you can leave this page and come back to it.</p>
            }
        </section>
    }

    @if (_views.Count == 0)
    {
        <LtEmptyState Title="No views" HeadingLevel="2">
            No materialised view reads from this tree.
        </LtEmptyState>
    }
    else
    {
        <LtTable TItem="DataTreeEntry"
                 Items="@_views"
                 Caption="Views"
                 CaptionHidden="true"
                 RowKey="@(view => view.StateId)"
                 DetailTitle="@(view => view.DisplayName)">
            <ChildContent>
                <LtColumn TItem="DataTreeEntry" Context="view" Title="View" RowHeader="true" Mono="true">
                    <a href="@Workspace.Href(view.Address)">@view.DisplayName</a>
                </LtColumn>
                <LtColumn TItem="DataTreeEntry" Title="Kind" Value="@(view => view.KindText)" />
                <LtColumn TItem="DataTreeEntry" Title="Projection" Mono="true" Value="@(view => view.ProjectionVersion)" />
                <LtColumn TItem="DataTreeEntry" Context="view" Title="Status">
                    <LtStatusPill State="@LagRole(view)" Text="@LagText(view)" />
                </LtColumn>
                <LtColumn TItem="DataTreeEntry" Context="view" Title="Actions">
                    @RenderActions(view)
                </LtColumn>
            </ChildContent>
            <CompactRow Context="view">
                <LtCompactRow Mono="true">
                    <Primary>@view.DisplayName</Primary>
                    <Secondary>@view.KindText</Secondary>
                    <State><LtStatusPill State="@LagRole(view)" Text="@LagText(view)" /></State>
                </LtCompactRow>
            </CompactRow>
            <DetailActions Context="view">
                <a class="lt-btn" href="@Workspace.Href(view.Address)">Open @view.DisplayName</a>
                @RenderActions(view)
            </DetailActions>
        </LtTable>
    }

    @if (_pending is { } pending)
    {
        <LtConfirmDestructive Open="true"
                              OpenChanged="OnConfirmOpenChanged"
                              Title="@(pending.Rebuild ? "Rebuild this view?" : "Reconcile this view?")"
                              ObjectKind="view"
                              ObjectName="@pending.View.DisplayName"
                              ConfirmText="@(pending.Rebuild ? "Rebuild" : "Reconcile")"
                              OnConfirm="RunPendingAsync">
            @if (pending.Rebuild)
            {
                <span>Rebuilding builds a complete new generation of the view from its source and swaps it in at once. The source keeps serving throughout, but the rebuild reads every source key. It runs on the cluster, so you can leave this page while it does.</span>
            }
            else
            {
                <span>Reconciling builds the expected view, compares it with the live one, and swaps it in only if they differ. It reads every source key.</span>
            }
        </LtConfirmDestructive>
    }
}

@code {
    private RenderFragment RenderActions(DataTreeEntry view) => __builder =>
    {
        @if (CanAdminister(view))
        {
            <span class="lt-data-actions">
                <LtButton Variant="LtButtonVariant.Quiet" Disabled="@(Busy is not null)" OnClick="() => Ask(view, rebuild: false)">
                    @(Busy == view.StateId && !BusyRebuild ? "Reconciling" : "Reconcile")
                </LtButton>
                <LtButton Variant="LtButtonVariant.Destructive" Disabled="@(Busy is not null)" OnClick="() => Ask(view, rebuild: true)">
                    @(Busy == view.StateId && BusyRebuild ? "Rebuilding" : "Rebuild")
                </LtButton>
            </span>
        }
    };
}
