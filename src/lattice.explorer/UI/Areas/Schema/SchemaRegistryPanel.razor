@using System.Text.Json
@using System.Text.Json.Serialization
@implements IDisposable

@if (Workspace is { Grants.SupportsVersioning: true, Grants.ViewVersion: true, Grants.SupportsRuntimeRegistration: false })
{
    <section class="lt-schema-editor" aria-labelledby="lt-schema-registry-title">
        <h2 id="lt-schema-registry-title" class="lt-schema-section-title">Versions and migration paths</h2>
        <p class="lt-schema-note">This host defines its versions and migration paths in code and does not report them, so they cannot be shown or registered here. A value stamped below the target reads only when the host provides a path from its version to the target.</p>
    </section>
}
else if (Workspace is { Grants.SupportsRuntimeRegistration: true, Grants.ViewVersion: true })
{
    <section class="lt-schema-editor" aria-labelledby="lt-schema-registry-title">
        <h2 id="lt-schema-registry-title" class="lt-schema-section-title">Versions and migration paths</h2>
        <p class="lt-schema-note">These definitions belong to this tree in the selected region and survive silo restarts. They combine what the host provisions at startup with what is registered here; the cluster does not say which is which. A registered version or migration hop cannot be changed or removed.</p>
        @if (_catalog is { } catalog)
        {
            var map = Map(catalog);
            @if (map.IsEmpty)
            {
                <p class="lt-schema-note">No versions or migration paths are registered.@(Config is { } config ? $" A value stamped below version {config.TargetVersion} cannot be read until a path from its version to the target is registered." : string.Empty)</p>
            }
            @foreach (var family in map.Families)
            {
                <h3 class="lt-schema-subtitle">@FamilyTitle(family)</h3>
                <LtTable TItem="SchemaVersionRow" Items="@family.Versions" Caption="@($"Versions of family {family.SchemaId}")" CaptionHidden="true">
                    <ChildContent>
                        <LtColumn TItem="SchemaVersionRow" Title="Version" Value="@(row => row.Version)" />
                        <LtColumn TItem="SchemaVersionRow" Title="Name" Value="@(row => row.Name ?? "Not registered")" />
                        <LtColumn TItem="SchemaVersionRow" Title="A value stamped with it" Value="@(row => ReachText(row))" />
                    </ChildContent>
                    <CompactRow Context="row">
                        <LtCompactRow>
                            <Primary>Version @row.Version: @(row.Name ?? "Not registered")</Primary>
                            <Secondary>@ReachText(row)</Secondary>
                        </LtCompactRow>
                    </CompactRow>
                </LtTable>
                @if (family.Hops.Count > 0)
                {
                    <ol class="lt-schema-hops" aria-label="@($"What changes between versions of family {family.SchemaId}")">
                        @foreach (var hop in family.Hops)
                        {
                            <li class="lt-schema-hops__hop">
                                <span class="lt-schema-hops__label">Version @hop.FromVersion to @hop.ToVersion</span>
                                @if (hop.TransformId is { } transformId)
                                {
                                    <p class="lt-schema-hops__step">Runs the host transform <code class="lt-shell-mono">@transformId</code>, installed code whose changes the cluster does not describe.</p>
                                    @if (!hop.Installed)
                                    {
                                        <p class="lt-schema-error">The silo that answered does not install this transform, so a value that needs this hop fails to read there.</p>
                                    }
                                }
                                else
                                {
                                    <ul class="lt-schema-hops__steps">
                                        @foreach (var step in hop.Steps)
                                        {
                                            <li class="lt-schema-hops__step">@step</li>
                                        }
                                    </ul>
                                }
                            </li>
                        }
                    </ol>
                }
            }
            <p class="lt-schema-note">Host-supported transform ids: @(catalog.SupportedTransformIds.Length == 0 ? "none; use a declarative transform" : string.Join(", ", catalog.SupportedTransformIds)). An id references installed code; registration never uploads code or assemblies.</p>
        }
        @if (Workspace.Grants.ManageVersion)
        {
            <details>
                <summary>Register versions and migration paths</summary>
                <p id="lt-schema-registry-hint" class="lt-schema-note">Append a JSON definition. A descriptor names a version; what differs between two versions is the transform of the hop between them, which is listed above once registered. A hop must specify either a declarative transform or one advertised transformId. Validation rules stay on the Policy tab and apply to every version alike. Register prerequisites in every serving region before advancing a replicated tree.</p>
                <div class="lt-field">
                    <label class="lt-field__label" for="lt-schema-registry-json">Registration JSON</label>
                    <textarea id="lt-schema-registry-json" class="lt-input lt-shell-mono" rows="10" spellcheck="false"
                              aria-describedby="lt-schema-registry-hint" disabled="@_busy" @bind="_json"></textarea>
                </div>
                <LtButton OnClick="RegisterAsync" Disabled="@_busy">Register definitions</LtButton>
            </details>
        }
        @if (_error is not null)
        {
            <p class="lt-schema-error" role="alert">@_error</p>
        }
        <LtButton Variant="LtButtonVariant.Quiet" OnClick="ReloadAsync" Disabled="@_busy">Refresh definitions</LtButton>
    </section>
}

@code {
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web)
    {
        Converters = { new JsonStringEnumConverter() },
        UnmappedMemberHandling = JsonUnmappedMemberHandling.Disallow,
    };

    private const string Example = """
        {
          "descriptors": [
            { "schemaId": 1, "version": 1, "name": "Initial" },
            { "schemaId": 1, "version": 2, "name": "Renamed quantity" }
          ],
          "upcasters": [
            { "schemaId": 1, "fromVersion": 1, "toVersion": 2,
              "transform": { "kind": "Passthrough", "children": [
                { "kind": "RenameMember", "memberPath": "qty", "toPath": "quantity" }
              ] } }
          ]
        }
        """;

    private readonly ComponentLifetime _lifetime = new();
    private LatticeSchemaRuntimeRegistration? _catalog;
    private (LatticeSchemaRuntimeRegistration Catalog, LatticeSchemaVersionConfig? Config, SchemaVersionMap Map)? _map;
    private string? _loadedTree;
    private string _json = Example;
    private string? _error;
    private bool _busy;

    [CascadingParameter]
    internal SchemaWorkspace? Workspace { get; set; }

    /// <summary>The tree's version config, which the map reads the catalog against; <see langword="null"/> when unversioned.</summary>
    [Parameter]
    public LatticeSchemaVersionConfig? Config { get; set; }

    /// <summary>Raised with the catalog each time it is read, and with <see langword="null"/> when it could not be.</summary>
    [Parameter]
    public EventCallback<LatticeSchemaRuntimeRegistration?> CatalogChanged { get; set; }

    [Inject]
    internal SchemaFacades Facades { get; set; } = default!;

    [Inject]
    internal LtToastService Toasts { get; set; } = default!;

    /// <summary>The map of <paramref name="catalog"/> at the current config, rebuilt only when either changes.</summary>
    private SchemaVersionMap Map(LatticeSchemaRuntimeRegistration catalog)
    {
        if (_map is not { } cached || !ReferenceEquals(cached.Catalog, catalog) || !Nullable.Equals(cached.Config, Config))
        {
            cached = (catalog, Config, SchemaVersionMap.Build(catalog, Config));
            _map = cached;
        }

        return cached.Map;
    }

    /// <summary>The heading of one family's versions.</summary>
    /// <param name="family">The family.</param>
    /// <returns>The heading.</returns>
    internal static string FamilyTitle(SchemaVersionFamily family) => family.IsConfigured
        ? $"Family {family.SchemaId}, which this tree stamps"
        : $"Family {family.SchemaId}";

    /// <summary>How a value stamped with <paramref name="row"/>'s version reads at the target.</summary>
    /// <param name="row">The version.</param>
    /// <returns>A sentence.</returns>
    internal static string ReachText(SchemaVersionRow row) => row.Reach switch
    {
        SchemaVersionReach.Target => "Reads as stored: this is the target version",
        SchemaVersionReach.Upgraded => "Upgraded as it is read, through versions " + string.Join(", ", row.Route),
        SchemaVersionReach.NoPath => "Cannot be read: no migration path leads to the target",
        SchemaVersionReach.AboveTarget => "Cannot be read: it is newer than the target",
        _ => "Not this tree's family",
    };

    /// <inheritdoc />
    public void Dispose()
    {
        _lifetime.Leave();
        GC.SuppressFinalize(this);
    }

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (Workspace is { } workspace && workspace.TreeId != _loadedTree)
        {
            _loadedTree = workspace.TreeId;
            _json = Example;
            await ReloadAsync();
        }
    }

    private async Task ReloadAsync()
    {
        if (Workspace is not { Grants.SupportsRuntimeRegistration: true, Grants.ViewVersion: true } workspace)
        {
            return;
        }

        _error = null;
        try
        {
            var catalog = await Facades.RequireSchema().GetRegistryAsync(workspace.TreeId, _lifetime.Token);
            if (!_lifetime.IsLeft)
            {
                _catalog = catalog;
                await CatalogChanged.InvokeAsync(catalog);
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsLeft)
        {
        }
        catch (Exception exception)
        {
            // A catalog that could not be re-read is no longer shown as current.
            _catalog = null;
            _error = SchemaFailure.Describe(exception, "read the schema definitions");
            if (!_lifetime.IsLeft)
            {
                await CatalogChanged.InvokeAsync(null);
            }
        }
    }

    private async Task RegisterAsync()
    {
        if (Workspace is not { Grants.ManageVersion: true } workspace)
        {
            return;
        }

        LatticeSchemaRuntimeRegistration registration;
        try
        {
            registration = JsonSerializer.Deserialize<LatticeSchemaRuntimeRegistration>(_json, JsonOptions)
                ?? throw new JsonException();
        }
        catch (JsonException)
        {
            _error = "Enter a registration JSON object with descriptors and upcasters. Use the documented field names and transform kinds.";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await Facades.RequireSchema().RegisterSchemaAsync(workspace.TreeId, registration, _lifetime.Token);
            if (_lifetime.IsLeft)
            {
                return;
            }
            Toasts.Show("Schema definitions are registered.", LtToastTone.Success);
            await ReloadAsync();
            await workspace.RefreshAsync();
        }
        catch (OperationCanceledException) when (_lifetime.IsLeft)
        {
        }
        catch (Exception exception)
        {
            _error = SchemaFailure.Describe(exception, "register the schema definitions");
        }
        finally
        {
            _busy = false;
        }
    }
}
