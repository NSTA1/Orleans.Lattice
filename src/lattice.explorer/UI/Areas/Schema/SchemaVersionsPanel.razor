@*
    Versions: the tree's envelope-version config - schema family, target version
    and strict ingest - with configuration, durable definitions and migrations.
*@

@if (Workspace is not null)
{
    <aside class="lt-schema-note" aria-label="How versioning works">
        <p>A version is a stamp, not a shape: it records which version a value was written at. These are separate operations:</p>
        <dl class="lt-schema-explain">
            <dt>Stamping</dt>
            <dd>Every new write is stamped with the tree's family and target version.</dd>
            <dt>Advancing the target</dt>
            <dd>Changes the stamp on later writes only, and cannot be undone. Stored values are not rewritten, and materialised views over this tree are not refreshed: a view keeps seeing each value at the version it was stamped with.</dd>
            <dt>Upgrading on read</dt>
            <dd>A value stamped below the target is upgraded through the registered migration hops each time it is read. A value with no path to the target, or stamped above it, cannot be read.</dd>
            <dt>Migrating</dt>
            <dd>Rewrites every stored value at the target once, in the background, so it no longer needs upgrading; views see the rewritten values.</dd>
            <dt>Enforcing</dt>
            <dd>The Policy tab's rules check values as they are written. One policy covers every version: rules cannot be scoped to a version.</dd>
        </dl>
        <p>A change here applies at once on the silo that serves it; the cluster's other silos pick it up shortly after.</p>
    </aside>

    @if (Operations.Find(Workspace.TreeId) is { IsActive: true } running)
    {
        <p class="lt-schema-running" role="status">
            @running.Summary is running.
            <a href="@Workspace.Href(Workspace.ForTab(SchemaTabs.Remediation))">Follow its status</a>
        </p>
    }

    @if (!Workspace.Grants.SupportsVersioning)
    {
        <LtEmptyState Title="Versioning is not available" HeadingLevel="2">
            This cluster's silos do not register schema versioning. A host operator must enable AddLatticeSchemaVersioning; policy enforcement can still be used independently.
        </LtEmptyState>
    }
    else if (!Workspace.Grants.ViewVersion)
    {
        <LtEmptyState Title="You may not read this tree's versioning" HeadingLevel="2">
            Reading the version config needs read authority on the tree.
        </LtEmptyState>
    }
    else if (_error is not null)
    {
        <LtEmptyState Title="The version config did not load" HeadingLevel="2">
            <ChildContent>@_error</ChildContent>
            <Actions><LtButton OnClick="ReloadAsync">Try again</LtButton></Actions>
        </LtEmptyState>
    }
    else if (!_loaded)
    {
        <LtSkeleton Lines="3" Label="Reading the version config" />
    }
    else
    {
        @switch (_editor)
        {
            case Editor.Configure:
                @RenderConfigure()
                break;
            case Editor.Advance:
                @RenderAdvance()
                break;
            default:
                @RenderCurrent()
                break;
        }
    }

    <SchemaRegistryPanel Config="@_config" CatalogChanged="OnCatalogChanged" />

    <LtConfirmDestructive Open="@(_confirm == Confirm.Clear)"
                          OpenChanged="OnConfirmOpenChanged"
                          Title="Turn off versioning"
                          ObjectKind="tree"
                          ObjectName="@Workspace.TreeId"
                          ConfirmText="Turn off versioning"
                          OnConfirm="ClearAsync">
        New writes will no longer be stamped. Values already stamped keep their stamp and are still read.
    </LtConfirmDestructive>

    <LtConfirmDestructive Open="@(_confirm == Confirm.Advance)"
                          OpenChanged="OnConfirmOpenChanged"
                          Title="@($"Advance to version {_advanceTarget}")"
                          ObjectKind="tree"
                          ObjectName="@Workspace.TreeId"
                          ConfirmText="Advance"
                          OnConfirm="AdvanceAsync">
        <p>New writes will be stamped with version @_advanceTarget from now on. The target version cannot be lowered again. Stored values stay at their version until they are read or migrated.</p>
        <p>Materialised views over this tree are not refreshed: they keep seeing each value at the version it was stamped with.</p>
        @RenderAdvanceRisks()
    </LtConfirmDestructive>

    <LtConfirmDestructive Open="@(_confirm == Confirm.AdvanceAndMigrate)"
                          OpenChanged="OnConfirmOpenChanged"
                          Title="@($"Advance to version {_advanceTarget} and migrate")"
                          ObjectKind="tree"
                          ObjectName="@Workspace.TreeId"
                          ConfirmText="Advance and migrate"
                          OnConfirm="AdvanceAndMigrateAsync">
        <p>New writes will be stamped with version @_advanceTarget, which cannot be lowered again, and then every stored value is rewritten at that version in the background. You can follow the migration on the Remediation tab, and leave while it runs.</p>
        <p>@MigrationStops(_advanceTarget)</p>
        @RenderAdvanceRisks()
    </LtConfirmDestructive>

    <LtDialog Open="@(_confirm == Confirm.Migrate)"
              OpenChanged="OnConfirmOpenChanged"
              Title="Migrate stored values"
              Placement="@DialogPlacement">
        <ChildContent>
            <p>Every stored value is rewritten at the current target version, @(_config?.TargetVersion), in the background. Values already at that version are left alone, and running it again resumes or does nothing.</p>
            <p>@MigrationStops(_config?.TargetVersion ?? 0)</p>
            <p>You can follow the migration on the Remediation tab, and leave while it runs.</p>
        </ChildContent>
        <Actions>
            <LtButton Variant="LtButtonVariant.Quiet" OnClick="() => _confirm = Confirm.None">Cancel</LtButton>
            <LtButton OnClick="MigrateAsync">Start migration</LtButton>
        </Actions>
    </LtDialog>
}

@code {
    private RenderFragment RenderAdvanceRisks() => __builder =>
    {
        if (_config is not { } config || _catalog is null)
        {
            return;
        }

        var map = SchemaVersionMap.Build(_catalog, config);
        if (!map.IsEmpty && !map.IsRegistered(config.SchemaId, _advanceTarget))
        {
            <p class="lt-schema-error">Version @_advanceTarget is not registered for family @config.SchemaId. Register it, and a migration path to it, before advancing.</p>
        }

        var stranded = map.StrandedBy(_advanceTarget);
        if (stranded.Count > 0)
        {
            <p class="lt-schema-error">@StrandedText(stranded, _advanceTarget)</p>
        }
    };

    private RenderFragment RenderCurrent() => __builder =>
    {
        if (_config is not { } config)
        {
            <LtEmptyState Title="Unversioned" HeadingLevel="2">
                <ChildContent>Values are stored exactly as written, with no version stamp.</ChildContent>
                <Actions>
                    @if (Workspace!.Grants.ManageVersion)
                    {
                        <LtButton OnClick="OpenEnable">Turn on versioning</LtButton>
                    }
                </Actions>
            </LtEmptyState>
            return;
        }

        <LtDefinitionList>
            <LtDefinition Term="Schema family" Mono="true">@config.SchemaId</LtDefinition>
            <LtDefinition Term="Target version" Mono="true">@config.TargetVersion</LtDefinition>
            <LtDefinition Term="Strict ingest">@(config.StrictIngest ? "On: a replicated CRDT or atomic-batch entry whose version cannot be upgraded to the target goes to the dead letters; plain last-writer-wins replication, restore and merge are never checked" : "Off: replicated and restored values are stored with whatever version they carry")</LtDefinition>
        </LtDefinitionList>

        @if (Workspace!.Grants.ManageVersion)
        {
            <div class="lt-toolbar lt-schema-actions">
                <LtButton OnClick="OpenAdvance" Disabled="@(Busy || !CanAdvance)">Advance target version...</LtButton>
                <LtButton OnClick="() => _confirm = Confirm.Migrate" Disabled="@(Busy || !Workspace.Grants.CanStartMigration)">Migrate stored values...</LtButton>
                <LtButton Variant="LtButtonVariant.Quiet" OnClick="OpenConfigure" Disabled="@Busy">Change config</LtButton>
                <LtButton Variant="LtButtonVariant.Destructive" OnClick="() => _confirm = Confirm.Clear" Disabled="@Busy">Turn off versioning</LtButton>
            </div>
            @if (!Workspace.Grants.CanStartMigration && Workspace.Grants.MigrationUnavailableReason is { } reason)
            {
                <p class="lt-schema-note">@reason</p>
            }
            @if (!CanAdvance)
            {
                <p class="lt-schema-note">The target is the highest version there is, so it cannot be advanced.</p>
            }
        }
    };

    private RenderFragment RenderConfigure() => __builder =>
    {
        <section class="lt-schema-editor" aria-labelledby="lt-schema-version-editor-title">
            <h2 id="lt-schema-version-editor-title" class="lt-schema-section-title">@(_config is null ? "Turn on versioning" : "Change the version config")</h2>
            @if (_config is not null)
            {
                <p class="lt-schema-note">This replaces the config as it is. To move to a higher version, advance the target instead: advancing is checked, this is not. Changing the family leaves values stamped with the old family to be read as they were stored.</p>
            }
            <LtTextInput Label="Schema family" Mono="true" Value="@_familyText" ValueChanged="value => _familyText = value" inputmode="numeric"
                         Hint="The number that names this tree's value family, stamped into every value." />
            <LtTextInput Label="Target version" Mono="true" Value="@_versionText" ValueChanged="value => _versionText = value" inputmode="numeric"
                         Hint="1 or more. New writes are stamped with it." />
            <LtSwitch Label="Strict ingest" Checked="@_strict" CheckedChanged="value => _strict = value"
                      Hint="On: a replicated CRDT or atomic-batch entry whose version cannot be upgraded goes to the dead letters; plain last-writer-wins replication, restore and merge are never checked." />
            @if (_formError is not null)
            {
                <p class="lt-schema-error" role="alert">@_formError</p>
            }
            <div class="lt-toolbar lt-schema-actions">
                <LtButton OnClick="SaveConfigAsync" Disabled="@Busy">Save config</LtButton>
                <LtButton Variant="LtButtonVariant.Quiet" OnClick="CloseEditor">Cancel</LtButton>
            </div>
        </section>
    };

    private RenderFragment RenderAdvance() => __builder =>
    {
        <section class="lt-schema-editor" aria-labelledby="lt-schema-advance-title">
            <h2 id="lt-schema-advance-title" class="lt-schema-section-title">Advance the target version</h2>
            <p class="lt-schema-note">The target is now @(_config?.TargetVersion). It only ever goes up.</p>
            <LtTextInput Label="New target version" Mono="true" Value="@_versionText" ValueChanged="value => _versionText = value" inputmode="numeric" Error="@_formError" />
            <div class="lt-toolbar lt-schema-actions">
                <LtButton OnClick="() => ReviewAdvance(migrate: false)" Disabled="@Busy">Advance...</LtButton>
                <LtButton OnClick="() => ReviewAdvance(migrate: true)" Disabled="@(Busy || Workspace?.Grants.SupportsRemediation != true)">Advance and migrate...</LtButton>
                <LtButton Variant="LtButtonVariant.Quiet" OnClick="CloseEditor">Cancel</LtButton>
            </div>
        </section>
    };
}
