@page "/replication"
@page "/t/{tenant}/replication"
@inherits ExplorerPage
@implements IDisposable
@using Orleans.Lattice.Api.TenantAdmin

@*
    /replication: the estate's replication as an order diagram (this region as
    the marker node, each peer a node, each direction an edge labelled with its
    health and backlog), and beneath it every (tree, peer, direction) link as a
    sortable booktabs table. ?health=, ?region= and ?app= filter both.
*@

<PageTitle>Replication - Orleans.Lattice Explorer</PageTitle>

<h1 class="lt-shell-page-title">Replication</h1>
<p class="lt-shell-page-lede">How this region's trees replicate to and from its peer regions, and how far behind each link is.</p>

<ReplicationSections />

@if (_estate is null && _fault is null)
{
    <LtSkeleton Lines="6" Label="Reading replication status" />
}
else if (_estate is null)
{
    <LtEmptyState Title="@FaultTitle" HeadingLevel="2">
        <ChildContent>@_fault!.Message</ChildContent>
        <Actions>
            @if (_fault?.Kind == ReplicationFaultKind.Failed)
            {
                <LtButton OnClick="RefreshAsync" data-lt-command="@ReplicationArea.RefreshCommandId">Try again</LtButton>
            }
            <a class="lt-btn" href="@TreesHref">See enrolled trees</a>
        </Actions>
    </LtEmptyState>
}
else
{
    <ReplicationToolbar Regions="@_estate.PeerRegions" Apps="@_apps" />

    <div class="lt-replication-status" role="status">
        <span>@StatusLine</span>
        <LtButton Variant="LtButtonVariant.Quiet" OnClick="RefreshAsync" Disabled="_refreshing" data-lt-command="@ReplicationArea.RefreshCommandId">
            @(_refreshing ? "Refreshing" : "Refresh")
        </LtButton>
    </div>

    @if (_estate.Truncated)
    {
        <p class="lt-replication-note">The report was longer than one read follows, so only the first @ReplicationFormat.Count(_estate.Links.Count, "link is", "links are") shown. Filter by region or app to narrow it.</p>
    }

    <ReplicationMap LocalRegionId="@_estate.LocalRegionId" Links="@_filtered" Filtered="@_filter.IsActive" />

    @if (Data.HasTenantBackfill)
    {
        <section aria-labelledby="tenant-backfill-heading">
            <h2 id="tenant-backfill-heading" class="lt-replication-heading">Tenant backfill</h2>
            @if (_tenantBackfill is { } backfill)
            {
                <p class="lt-replication-note">
                    Region backfill: <strong>@backfill.Phase</strong>.
                    @if (!string.IsNullOrWhiteSpace(backfill.StallReason))
                    {
                        <span>@backfill.StallReason</span>
                    }
                </p>
                <LtTable TItem="TenantRegionBackfillTreeProgress"
                         Items="@backfill.Trees"
                         Caption="Tenant tree backfill progress"
                         CaptionHidden="true"
                         RowKey="@(tree => tree.TreeId)">
                    <ChildContent>
                        <LtColumn TItem="TenantRegionBackfillTreeProgress" Title="Tree" RowHeader="true" Mono="true" Value="@(tree => tree.TreeId)" />
                        <LtColumn TItem="TenantRegionBackfillTreeProgress" Title="Source" Mono="true" Value="@(tree => tree.SourceClusterId ?? "Pending")" />
                        <LtColumn TItem="TenantRegionBackfillTreeProgress" Title="Phase" Value="@(tree => tree.Phase)" />
                        <LtColumn TItem="TenantRegionBackfillTreeProgress" Title="Entries applied" Align="LtColumnAlign.End" Mono="true" Value="@(tree => ReplicationFormat.Count(tree.EntriesApplied))" />
                        <LtColumn TItem="TenantRegionBackfillTreeProgress" Title="Parked entries" Align="LtColumnAlign.End" Mono="true" Value="@(tree => ReplicationFormat.Count(tree.PendingDeadLetters))" />
                        <LtColumn TItem="TenantRegionBackfillTreeProgress" Title="Read fenced" Value="@(tree => tree.ReadFenced ? "Yes" : "No")" />
                    </ChildContent>
                    <EmptyContent><span>No tenant-tree bootstrap progress is available yet.</span></EmptyContent>
                    <CompactRow>
                        <LtCompactRow Mono="true">
                            <Primary>@context.TreeId</Primary>
                            <State>@context.Phase</State>
                            <Secondary>@($"{ReplicationFormat.Count(context.EntriesApplied)} entries applied; {ReplicationFormat.Count(context.PendingDeadLetters)} parked; source {context.SourceClusterId ?? "pending"}")</Secondary>
                        </LtCompactRow>
                    </CompactRow>
                    <Detail>
                        <LtDefinitionList>
                            <LtDefinition Term="Source region" Mono="true">@(context.SourceClusterId ?? "Pending")</LtDefinition>
                            <LtDefinition Term="Phase">@context.Phase</LtDefinition>
                            <LtDefinition Term="Entries applied" Mono="true">@ReplicationFormat.Count(context.EntriesApplied)</LtDefinition>
                            <LtDefinition Term="Parked entries" Mono="true">@ReplicationFormat.Count(context.PendingDeadLetters)</LtDefinition>
                            <LtDefinition Term="Read fenced">@(context.ReadFenced ? "Yes" : "No")</LtDefinition>
                        </LtDefinitionList>
                    </Detail>
                </LtTable>
            }
        else if (_tenantBackfillFault is not null)
        {
            <p class="lt-replication-note" role="status">@_tenantBackfillFault.Message</p>
        }
        </section>
    }

    <h2 class="lt-replication-heading">Links</h2>
    <ReplicationLinkTable Links="@_filtered"
                          Caption="@($"Replication links of {_estate.LocalRegionId}, one per tree, peer and direction")"
                          CaptionHidden="true"
                          EmptyText="@(_filter.IsActive ? "No replication links match these filters." : "This region has no replication links yet.")" />
}
