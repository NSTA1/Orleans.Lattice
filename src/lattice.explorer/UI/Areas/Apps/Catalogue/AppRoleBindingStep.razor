@using Orleans.Lattice.Explorer.UI.Suggestions
@using Orleans.Lattice.Explorer.UI.Areas.Access.Tenant
@using Orleans.Lattice.Explorer.UI.Design.Components
@implements IDisposable

@*
    Bind roles: each role the app declares is bound to one membership group - never
    to a user. The same step changes the installed version's bindings, where a role
    may also be left unbound. The group is typed into a type-ahead picker that
    suggests the cluster's groups (from the directory or, without one, the auth
    store) and, when the installing tenant's delegated access administration is open
    to the caller, the tenant's own groups, labelled Tenant. Another tenant's group is
    never offered, and one typed in is refused before anything is sent. It is
    read-only here: nothing is created or changed in the directory.
*@
@if (Flow?.Descriptor is { } app)
{
    <section class="lt-apps-section" aria-labelledby="lt-apps-bind">
        <h2 id="lt-apps-bind" class="lt-apps-section__title">@(Flow.IsRebinding ? "Change role bindings" : "Bind roles to groups")</h2>
        <p>Members of each group receive that role in @AppsPresentation.DisplayName(app.Presentation, app.Slug). @(Flow.IsRebinding ? "Clear a group to leave its role unbound; nobody then holds it." : "Bind every role to continue.")</p>
        @foreach (var role in app.Roles)
        {
            var name = role.Name;
            <div class="lt-apps-binding" @key="name">
                <span class="lt-apps-binding__role">@name</span>
                <span class="lt-apps-hint">May @AppsPresentation.OperationsText(role.Operations).</span>
                <LtComboBox Label="@($"Group for {name}")"
                            Value="@Flow.Bindings.GetValueOrDefault(name)"
                            ValueChanged="value => Flow.Bind(name, value)"
                            Source="@GroupSource"
                            Mode="LtComboBoxMode.Suggest"
                            Noun="group"
                            ExistingMessage="A group the cluster knows."
                            Error="@ErrorFor(Flow.Bindings.GetValueOrDefault(name))"
                            Hint="@GroupHint" />
                @if (Flow.Bindings.GetValueOrDefault(name) is { } group && IsBindable(group))
                {
                    @switch (_caller.Of(group))
                    {
                        case AppGroupMembership.Member:
                            <p class="lt-apps-hint" data-lt-holding="member">You are in @group, the group @name is bound to.</p>
                            break;
                        case AppGroupMembership.NotMember:
                            <p class="lt-apps-hint" data-lt-holding="not-member">
                                You are not in @group, so you will not hold the @name role.
                                <a class="lt-apps-link" href="@Navigator.Canonicalize(AppBindingGroups.JoinAddress(group)).ToHref()" data-lt-join="@group">Add me to @group</a>,
                                or bind it to a group you are in.
                            </p>
                            break;
                        default:
                            <p class="lt-apps-hint" data-lt-holding="unknown">Whether you are in @group is unknown: your group membership could not be read.</p>
                            break;
                    }
                }
            </div>
        }
        @if (app.Roles.IsDefaultOrEmpty)
        {
            <p class="lt-apps-hint">It declares no role, so there is nothing to bind.</p>
        }
        @if (Holding is { HoldsAny: false } holding && holding.BoundGroups.Count > 0)
        {
            <p class="lt-apps-hint" role="status" data-lt-holding-summary="none">You will hold no role in @AppsPresentation.DisplayName(app.Presentation, app.Slug), so you won't be able to open it. A role is held only through membership of the group it is bound to; administrator rights do not grant one.</p>
        }
        <div class="lt-apps-actions">
            <LtButton Variant="LtButtonVariant.Quiet" OnClick="Flow.Back">Back</LtButton>
            <LtButton OnClick="Flow.ConfirmBindings" Disabled="@((!Flow.IsRebinding && Flow.UnboundRoles.Count > 0) || HasForeignBinding)">Continue</LtButton>
        </div>
        @if (Flow.UnboundRoles.Count > 0)
        {
            <p class="lt-apps-hint">@(Flow.IsRebinding ? "Held by nobody" : "Still unbound"): @string.Join(", ", Flow.UnboundRoles).</p>
        }
    </section>
}

@code {
    private readonly ComponentLifetime _lifetime = new();
    private AppsCallerGroups _caller = AppsCallerGroups.Unknown;
    private AppGroupSuggestionSource? _groups;
    private string? _ownGroupsTenant;

    [CascadingParameter]
    internal AppInstallFlow? Flow { get; set; }

    [Inject]
    internal ExplorerSuggestions Suggestions { get; set; } = default!;

    [Inject]
    internal AppsMembership Membership { get; set; } = default!;

    [Inject]
    internal ExplorerNavigator Navigator { get; set; } = default!;

    [Inject]
    internal TenantAccessCatalog TenantAccess { get; set; } = default!;

    private AppRoleHoldingAssessment? Holding => Flow is { } flow ? AppRoleHoldingAssessment.Assess(flow.DraftedRoleGroups, _caller) : null;

    // The installing tenant's own groups are offered only once its delegated access administration is open to the caller.
    private ILtSuggestionSource GroupSource
    {
        get
        {
            if (_groups is null || !string.Equals(_groups.Tenant, _ownGroupsTenant, StringComparison.Ordinal))
            {
                _groups = new AppGroupSuggestionSource(Suggestions.GroupsOrStoredGroups, TenantAccess, _ownGroupsTenant);
            }

            return _groups;
        }
    }

    private string GroupHint => _ownGroupsTenant is { } tenant
        ? $"A cluster group, or one of tenant {tenant}'s own groups. Type part of a name or id to find one."
        : "A membership group id. Type part of a name or id to find one.";

    private bool HasForeignBinding
    {
        get
        {
            if (Flow is null)
            {
                return false;
            }

            foreach (var group in Flow.Bindings.Values)
            {
                if (!IsBindable(group))
                {
                    return true;
                }
            }

            return false;
        }
    }

    private bool IsBindable(string group) => AppBindingGroups.IsBindable(Flow?.Key.Tenant, group);

    private string? ErrorFor(string? group) => group is not null && !IsBindable(group) ? AppBindingGroups.MismatchMessage : null;

    /// <summary>Stops reading the caller's groups.</summary>
    public void Dispose() => _lifetime.Leave();

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        // Advisory only: the step works the same whether or not the caller's groups can be read.
        try
        {
            _caller = await Membership.ReadAsync(_lifetime.Token);
        }
        catch (OperationCanceledException)
        {
        }

        try
        {
            if (Flow?.Key.Tenant is { } tenant && TenantAccessCatalog.Administers(tenant))
            {
                var state = await TenantAccess.GetStateAsync(tenant, _lifetime.Token);
                if (!_lifetime.IsLeft && state.IsDelegated)
                {
                    _ownGroupsTenant = tenant;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }
}