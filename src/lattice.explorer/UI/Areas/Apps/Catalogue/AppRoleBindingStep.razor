@using Orleans.Lattice.Api.Auth
@using Orleans.Lattice.Membership

@*
    Bind roles: each role the app declares is bound to one membership group - never
    to a user. The same step changes the installed version's bindings, where a role
    may also be left unbound. The group is typed, or found with the auth facade's group search,
    which is read-only here: nothing is created or changed in the directory.
*@
@if (Flow?.Descriptor is { } app)
{
    <section class="lt-apps-section" aria-labelledby="lt-apps-bind">
        <h2 id="lt-apps-bind" class="lt-apps-section__title">@(Flow.IsRebinding ? "Change role bindings" : "Bind roles to groups")</h2>
        <p>Members of each group receive that role in @AppsPresentation.DisplayName(app.Presentation, app.Slug). @(Flow.IsRebinding ? "Clear a group to leave its role unbound; nobody then holds it." : "Bind every role to continue.")</p>
        @foreach (var role in app.Roles)
        {
            var name = role.Name;
            <div class="lt-apps-binding" @key="name">
                <span class="lt-apps-binding__role">@name</span>
                <span class="lt-apps-hint">May @AppsPresentation.OperationsText(role.Operations).</span>
                <LtTextInput Label="@($"Group for {name}")"
                             Mono="true"
                             Value="@Flow.Bindings.GetValueOrDefault(name)"
                             ValueChanged="value => Flow.Bind(name, value)"
                             Hint="A membership group id." />
                <div class="lt-apps-actions">
                    <LtButton Variant="LtButtonVariant.Quiet" OnClick="() => SearchAsync(name)" Disabled="@(_searching == name)">Find groups</LtButton>
                </div>
                @if (_results.TryGetValue(name, out var result))
                {
                    @if (result.Message is { } message)
                    {
                        <p class="lt-apps-hint" role="status">@message</p>
                    }
                    else
                    {
                        <ul class="lt-apps-results" aria-label="@($"Groups for {name}")">
                            @foreach (var group in result.Groups)
                            {
                                <li @key="group.Id">
                                    <LtButton Variant="LtButtonVariant.Outlined" Pressed="@(Flow.Bindings.GetValueOrDefault(name) == group.Id)" OnClick="() => Choose(name, group.Id)">
                                        @group.DisplayName <span class="lt-shell-mono">@group.Id</span>
                                    </LtButton>
                                </li>
                            }
                        </ul>
                    }
                }
            </div>
        }
        @if (app.Roles.IsDefaultOrEmpty)
        {
            <p class="lt-apps-hint">It declares no role, so there is nothing to bind.</p>
        }
        <div class="lt-apps-actions">
            <LtButton Variant="LtButtonVariant.Quiet" OnClick="Flow.Back">Back</LtButton>
            <LtButton OnClick="Flow.ConfirmBindings" Disabled="@(!Flow.IsRebinding && Flow.UnboundRoles.Count > 0)">Continue</LtButton>
        </div>
        @if (Flow.UnboundRoles.Count > 0)
        {
            <p class="lt-apps-hint">@(Flow.IsRebinding ? "Held by nobody" : "Still unbound"): @string.Join(", ", Flow.UnboundRoles).</p>
        }
    </section>
}

@code {
    private readonly Dictionary<string, (IReadOnlyList<(string Id, string DisplayName)> Groups, string? Message)> _results = new(StringComparer.Ordinal);
    private string? _searching;

    [CascadingParameter]
    internal AppInstallFlow? Flow { get; set; }

    [Inject]
    internal AppsFacades Facades { get; set; } = default!;

    private void Choose(string role, string groupId) => Flow!.Bind(role, groupId);

    private async Task SearchAsync(string role)
    {
        var term = Flow!.Bindings.GetValueOrDefault(role) ?? string.Empty;
        _searching = role;
        try
        {
            _results[role] = await FindAsync(term);
        }
        catch (Exception)
        {
            _results[role] = ([], "Group search is not available. Type the group id.");
        }
        finally
        {
            _searching = null;
        }
    }

    private async Task<(IReadOnlyList<(string Id, string DisplayName)> Groups, string? Message)> FindAsync(string term)
    {
        if (Facades.Auth is not { } auth)
        {
            return ([], "Group search is not available. Type the group id.");
        }

        var search = await auth.SearchDirectoryAsync(new DirectorySearchRequest { Term = term, Kind = DirectoryPrincipalKind.Group, PageSize = 10 });
        IReadOnlyList<(string Id, string DisplayName)> groups;
        if (search.Available)
        {
            groups = [.. search.Principals.Select(principal => (principal.Id, principal.DisplayName))];
        }
        else
        {
            var page = await auth.ListGroupsAsync(new AuthPageRequest { PageSize = 200 });
            groups = [.. page.Entries
                .Where(group => term.Length == 0
                    || group.GroupId.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || group.DisplayName?.Contains(term, StringComparison.OrdinalIgnoreCase) == true)
                .Take(10)
                .Select(group => (group.GroupId, group.DisplayName ?? group.GroupId))];
        }

        return groups.Count == 0 ? ([], "No group matches.") : (groups, null);
    }
}
