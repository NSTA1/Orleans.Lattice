@implements IDisposable

@*
    Lifecycle of the installed app: enable, disable and uninstall, each behind a
    confirmation that states its consequences. Uninstall soft-deletes the trees the
    app owns on their retention and leaves adopted trees in place, and asks for the
    slug to be typed. A palette command for this app opens the same confirmation.
*@
@if (Installed is { } installed)
{
    var (role, text) = AppsPresentation.LifecycleState(_state ?? installed.State, installed.Version, _state is null ? _observed : null);
    var name = AppsPresentation.DisplayName(installed.Presentation ?? Flow!.Descriptor?.Presentation, installed.Slug);

    <section class="lt-apps-section" aria-labelledby="lt-apps-lifecycle">
        <h2 id="lt-apps-lifecycle" class="lt-apps-section__title">Lifecycle in this tenant</h2>
        <p><LtStatusPill State="role" Text="@text" /></p>
        @if (_error is not null)
        {
            <p class="lt-apps-error" role="alert">@_error</p>
        }
        @if (_pending is { } pending)
        {
            <p role="status" data-lt-app-lifecycle-pending="@pending.ToString().ToLowerInvariant()">@PendingText(pending, name)</p>
        }
        else if (_observed is { } observed)
        {
            <p role="status" data-lt-app-lifecycle-pending="@ObservedKey(installed.State, observed)">@ObservedText(installed.State, observed, name)</p>
        }
        @if (!InFlight)
        {
        <div class="lt-apps-actions">
            @if (CanEnable)
            {
                <LtButton OnClick="() => Ask(AppLifecycleVerb.Enable)" Disabled="_busy">Enable</LtButton>
            }
            @if (CanDisable)
            {
                <LtButton OnClick="() => Ask(AppLifecycleVerb.Disable)" Disabled="_busy" data-lt-command="@AppsArea.DisableCommandId(installed.Slug)">Disable</LtButton>
            }
            @if (Access.Current?.Control.CanUninstall == true)
            {
                <LtButton Variant="LtButtonVariant.Destructive" OnClick="() => Ask(AppLifecycleVerb.Uninstall)" Disabled="_busy">Uninstall</LtButton>
            }
        </div>
        }
    </section>

    <LtDialog Open="@(_asking is AppLifecycleVerb.Enable or AppLifecycleVerb.Disable)"
              OpenChanged="open => { if (!open) { _asking = null; } }"
              Title="@(_asking == AppLifecycleVerb.Enable ? $"Enable {name}?" : $"Disable {name}?")">
        <ChildContent>
            @if (_asking == AppLifecycleVerb.Enable)
            {
                <p>Its manifest is validated and every role is intersected with the consented ceiling before its access rules are written. If the consent no longer covers what it asks for, activation fails and nothing is granted.</p>
            }
            else
            {
                <p>Its access rules are withdrawn at once, so its UI, bridge and MCP tools stop answering for everyone in this tenant. Its trees and data are kept unchanged, and you can enable it again at any time.</p>
            }
        </ChildContent>
        <Actions>
            <LtButton Variant="LtButtonVariant.Quiet" OnClick="() => _asking = null">Cancel</LtButton>
            <LtButton OnClick="ConfirmAsync">@(_asking == AppLifecycleVerb.Enable ? "Enable" : "Disable")</LtButton>
        </Actions>
    </LtDialog>

    <LtConfirmDestructive Open="@(_asking == AppLifecycleVerb.Uninstall)"
                          OpenChanged="open => { if (!open) { _asking = null; } }"
                          Title="@($"Uninstall {name}?")"
                          ObjectKind="app"
                          ObjectName="@installed.Slug"
                          ConfirmText="Uninstall"
                          OnConfirm="ConfirmAsync">
        <p>Its access rules are removed and the trees it owns are soft-deleted on their retention, then purged unless recovered first:</p>
        <ul class="lt-apps-list">
            @foreach (var tree in installed.Trees.Where(tree => tree.AdoptedTreeId is null))
            {
                <li><span class="lt-shell-mono">@AppsPresentation.TreePath(installed.Slug, tree.Name)</span>, @(tree.SoftDeleteDuration is { } retention ? $"recoverable for {AppReviewDetails.Retention(retention)}" : "recoverable for the cluster's soft-delete window")</li>
            }
        </ul>
        @if (installed.Trees.Any(tree => tree.AdoptedTreeId is not null))
        {
            <p>Adopted trees survive: @string.Join(", ", installed.Trees.Where(tree => tree.AdoptedTreeId is not null).Select(tree => tree.AdoptedTreeId)).</p>
        }
    </LtConfirmDestructive>
}

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private AppLifecycleVerb? _asking;
    private AppLifecycleVerb? _pending;
    private AppLifecycleState? _observed;
    private AppLifecycleState? _state;
    private string? _error;
    private bool _busy;

    [CascadingParameter]
    internal AppInstallFlow? Flow { get; set; }

    /// <summary>Raised after a lifecycle change succeeded, so the page can reload what it shows.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Inject]
    internal AppsAccess Access { get; set; } = default!;

    [Inject]
    internal Orleans.Lattice.Explorer.UI.Navigation.ExplorerAreaDirectory Directory { get; set; } = default!;

    [Inject]
    internal AppsFacades Facades { get; set; } = default!;

    [Inject]
    internal AppsLifecycleIntents Intents { get; set; } = default!;

    [Inject]
    internal LtToastService Toasts { get; set; } = default!;

    [Inject]
    internal TimeProvider Time { get; set; } = default!;

    private AppDescriptor? Installed => Flow?.Installed is { State: not (AppLifecycleState.NotInstalled or AppLifecycleState.Uninstalled) } installed ? installed : null;

    private AppLifecycleState CurrentState => _state ?? Installed!.State;

    /// <summary>Whether a lifecycle change is still being applied, so no other is offered.</summary>
    private bool InFlight => _pending is not null || _observed is not null;

    private bool CanEnable => Access.Current?.Control.CanEnable == true && CurrentState is AppLifecycleState.Installed or AppLifecycleState.Disabled or AppLifecycleState.Failed;

    private bool CanDisable => Access.Current?.Control.CanDisable == true && CurrentState == AppLifecycleState.Enabled;

    /// <summary>Stops listening for palette commands and stops following a pending change.</summary>
    public void Dispose()
    {
        Intents.Posted -= OnPosted;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    /// <inheritdoc />
    protected override void OnInitialized() => Intents.Posted += OnPosted;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        TakeIntent();
        FollowObserved();
    }

    /// <inheritdoc />
    protected override void OnAfterRender(bool firstRender)
    {
        // The flow can load the install after the last parameter pass; pick a change in flight up then.
        if (!_busy && _state is null && Installed is { PendingState: not null })
        {
            FollowObserved();
            if (_observed is not null)
            {
                StateHasChanged();
            }
        }
    }

    /// <summary>
    /// Follows a change already in flight when the page loaded (issue #5482): the described install
    /// carries the state its run is moving it to. The change is badged and no other is offered until
    /// it settles.
    /// </summary>
    private void FollowObserved()
    {
        if (_busy || _state is not null || Installed is not { PendingState: { } target } installed || Facades.Control is not { } control)
        {
            return;
        }

        _busy = true;
        _observed = target;
        _asking = null;
        _ = FollowObservedAsync(installed, target, control);
    }

    private async Task FollowObservedAsync(AppDescriptor installed, AppLifecycleState target, ILatticeAppsControl control)
    {
        var name = AppsPresentation.DisplayName(installed.Presentation ?? Flow!.Descriptor?.Presentation, installed.Slug);
        var change = ObservedKey(installed.State, target);
        try
        {
            var accepted = new AppLifecycleResult { Slug = installed.Slug, Version = installed.Version, State = installed.State, Pending = true };
            var result = await AppLifecycleFollow.FollowAsync(control, accepted, target, Time, _lifetime.Token);
            _observed = null;
            await ReportAsync(change, installed, name, result);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
            // The page was left while the change was still running.
            return;
        }
        catch (Exception error)
        {
            _observed = null;
            _error = AppsFailureMessages.Describe(error, change, name);
        }
        finally
        {
            _busy = false;
        }

        StateHasChanged();
    }

    private void OnPosted() => _ = InvokeAsync(() =>
    {
        TakeIntent();
        StateHasChanged();
    });

    private void TakeIntent()
    {
        if (Installed is not { } installed)
        {
            return;
        }

        foreach (var verb in new[] { AppLifecycleVerb.Disable, AppLifecycleVerb.Enable, AppLifecycleVerb.Uninstall })
        {
            if (Intents.TryTake(installed.Slug, verb))
            {
                Ask(verb);
            }
        }
    }

    private void Ask(AppLifecycleVerb verb)
    {
        if (InFlight)
        {
            return;
        }

        _error = null;
        _asking = verb;
    }

    private async Task ConfirmAsync()
    {
        if (_asking is not { } verb || Installed is not { } installed || Facades.Control is not { } control)
        {
            return;
        }

        _asking = null;
        _busy = true;
        var name = AppsPresentation.DisplayName(installed.Presentation ?? Flow!.Descriptor?.Presentation, installed.Slug);
        try
        {
            var result = verb switch
            {
                AppLifecycleVerb.Enable => await control.EnableAsync(installed.Slug),
                AppLifecycleVerb.Disable => await control.DisableAsync(installed.Slug),
                _ => await control.UninstallAsync(installed.Slug),
            };

            if (result.Pending)
            {
                _pending = verb;
                StateHasChanged();
                result = await AppLifecycleFollow.FollowAsync(control, result, Target(verb), Time, _lifetime.Token);
                _pending = null;
            }

            await ReportAsync(verb.ToString().ToLowerInvariant(), installed, name, result);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
            // The page was left while a change it started was still running.
        }
        catch (Exception error)
        {
            _pending = null;
            _error = AppsFailureMessages.Describe(error, verb.ToString().ToLowerInvariant(), name);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Reports the outcome of a change this page started or followed, and has the page reload.</summary>
    private async Task ReportAsync(string change, AppDescriptor installed, string name, AppLifecycleResult result)
    {
        _state = result.State;
        if (result.Pending)
        {
            _error = $"The {change} of {name} is still running after {AppLifecycleFollow.Limit.TotalMinutes:0} minutes. Reload the page later to see its outcome.";
        }
        else if (result.State == AppLifecycleState.Failed)
        {
            _error = $"The {change} of {name} failed. Its status records why.";
        }
        else
        {
            Toasts.Show($"{name} is {result.State.ToString().ToLowerInvariant()}.", LtToastTone.Success);
        }

        Access.Invalidate(installed.Slug);
        Directory.Invalidate();
        await OnChanged.InvokeAsync();
    }

    /// <summary>The change a run in flight is making, from the state before it and its target.</summary>
    private static string ObservedKey(AppLifecycleState state, AppLifecycleState target) => target switch
    {
        AppLifecycleState.Uninstalled => "uninstall",
        AppLifecycleState.Disabled when state != AppLifecycleState.Disabled => "disable",
        AppLifecycleState.Enabled when state != AppLifecycleState.Enabled => "enable",
        _ => "reconcile",
    };

    private static string ObservedText(AppLifecycleState state, AppLifecycleState target, string name) =>
        $"{AppsPresentation.PendingLifecycleText(state, target).TrimEnd('.')} {name}. A change started earlier is still being applied; this page updates when it finishes.";

    private static string PendingText(AppLifecycleVerb verb, string name) => verb switch
    {
        AppLifecycleVerb.Enable => $"Enabling {name}. The cluster accepted the change and is still applying it; this page updates when it finishes.",
        AppLifecycleVerb.Disable => $"Disabling {name}. The cluster accepted the change and is still applying it; this page updates when it finishes.",
        _ => $"Uninstalling {name}. The cluster accepted the change and is still applying it; this page updates when it finishes.",
    };

    private static AppLifecycleState Target(AppLifecycleVerb verb) => verb switch
    {
        AppLifecycleVerb.Enable => AppLifecycleState.Enabled,
        AppLifecycleVerb.Disable => AppLifecycleState.Disabled,
        _ => AppLifecycleState.Uninstalled,
    };
}
