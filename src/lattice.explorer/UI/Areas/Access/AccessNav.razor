@*
    The Access area's own navigation, drawn as the tab row with the marker under
    the current one. Cluster-wide and at a tenant whose access is not delegated it
    is Rules, Groups and Explain; at a tenant whose access administration is
    delegated to the caller it is that tenant's Groups, Members, Rules and Explain.
    It also links the area's stylesheet, so every Access page carries it without a
    head change.
*@
<link rel="stylesheet" href="@AccessAssets.Stylesheet" />
<nav class="lt-access-nav" aria-label="Access" data-lt-access-scope="@(IsTenantDelegated ? "tenant" : null)">
    <ul class="lt-access-nav__list">
        @if (IsTenantDelegated)
        {
            @foreach (var (segment, label, address) in AccessRoutes.TenantSections(Tenant!))
            {
                <li @key="segment"><a class="lt-access-nav__link" href="@Href(address)" aria-current="@CurrentFor(segment)" data-lt-command="@CommandFor(segment)">@label</a></li>
            }
        }
        else
        {
            <li><a class="lt-access-nav__link" href="@Href(AccessRoutes.Rules)" aria-current="@CurrentFor(AccessRoutes.RulesSegment)">Rules</a></li>
            <li><a class="lt-access-nav__link" href="@Href(AccessRoutes.Groups)" aria-current="@CurrentFor(AccessRoutes.GroupsSegment)">Groups</a></li>
            <li><a class="lt-access-nav__link" href="@Href(AccessRoutes.Explain)" aria-current="@CurrentFor(AccessRoutes.ExplainSegment)" data-lt-command="@AccessArea.ExplainCommandId">Explain</a></li>
        }
    </ul>
</nav>
