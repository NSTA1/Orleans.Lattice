@*
    The rule editor: id, effect, subject, scope and the operation checklist.
    App install and Telemetry sit in their own group as scopeless cluster-wide
    capabilities; with a narrower scope they cannot be ticked, and a draft that
    pairs them with one is refused before it is sent. No condition is offered:
    conditions are not evaluated in this version.
*@
<form class="lt-access-form" @onsubmit="SaveAsync" novalidate>
    <LtNameInput @ref="_ruleIdBox" Label="Rule id" Value="@_draft.RuleId" ValueChanged="@(value => _draft.RuleId = value)"
                 Existing="@(_draft.IsExisting ? null : _ruleIds)" Noun="rule"
                 ExistingMessage="A rule with this id already governs this tree."
                 ReadOnly="_draft.IsExisting" Error="@_errors.RuleId"
                 Hint="@(_draft.IsExisting ? "A rule's id and governed tree are fixed once it exists." : "A stable id, unique within the governed tree.")" />
    <LtSelect Label="Effect" Options="EffectOptions" Value="@(_draft.Effect == LatticeEffect.Deny ? "deny" : "allow")"
              ValueChanged="@(value => _draft.Effect = value == "deny" ? LatticeEffect.Deny : LatticeEffect.Allow)"
              Hint="Where two rules of equal standing disagree, Deny wins." />
    <AccessSubjectPicker @ref="_subjectPicker"
                         Label="Subject"
                         Kind="_draft.SubjectKind"
                         KindChanged="@(kind => _draft.SubjectKind = kind)"
                         Id="@_draft.SubjectId"
                         IdChanged="@(value => _draft.SubjectId = value)"
                         Error="@_errors.Subject"
                         DirectoryAvailable="@(Model?.DirectoryAvailable == true)"
                         DirectoryExplanation="@Model?.DirectoryExplanation"
                         AllowTenantGroups="true" />
    <LtSelect Label="Scope" Options="ScopeOptions" Value="@_draft.ScopeKind" ValueChanged="OnScopeChanged" Disabled="_draft.IsExisting" Hint="@ScopeHint" />
    @if (_draft.NeedsTree)
    {
        <LtComboBox @ref="_treeBox" Label="Tree" Value="@_draft.TreeId" ValueChanged="@(value => _draft.TreeId = value)" ReadOnly="_draft.IsExisting" Error="@_errors.Tree" Hint="@TreeHint" Source="@TreeSource" Noun="tree" />
    }
    @if (_draft.NeedsKeyOrPrefix)
    {
        <LtTextInput Label="@(_draft.ScopeKind == AccessRuleDraft.KeyScope ? "Key" : "Key prefix")" Mono="true" Value="@_draft.KeyOrPrefix" ValueChanged="@(value => _draft.KeyOrPrefix = value)" ReadOnly="_draft.IsExisting" Error="@_errors.KeyOrPrefix" />
    }
    @foreach (var group in OperationGroups)
    {
        <fieldset class="lt-access-fieldset" @key="group.Key">
            <legend class="lt-access-fieldset__legend">@GroupTitle(group.Key)</legend>
            @if (group.Key == AccessOperationGroup.ClusterWide)
            {
                <p class="lt-access-fieldset__hint">Scopeless capabilities are checked against the cluster itself, so they can only be granted with the cluster-wide scope.</p>
            }
            <div class="lt-access-fieldset__options">
                @foreach (var option in group)
                {
                    <LtCheckbox @key="option.Value"
                                Label="@option.Label"
                                Checked="_draft.HasOperation(option.Flag)"
                                CheckedChanged="@(value => _draft.SetOperation(option.Flag, value))"
                                Disabled="@(option.IsScopeless && !_draft.IsClusterWide && !_draft.HasOperation(option.Flag))"
                                data-lt-operation="@option.Value" />
                }
            </div>
        </fieldset>
    }
    @if (_errors.Operations is not null)
    {
        <p class="lt-access-form__error" role="alert" data-lt-field="operations">@_errors.Operations</p>
    }
    @if (_draft.HasCondition)
    {
        @* A condition is never evaluated, so the editor never authors one; a rule written
           with one through the API shows it read-only, warned, and saves it unchanged. *@
        <LtTextInput Label="Condition (not evaluated)" Mono="true" Value="@_draft.Condition" ReadOnly="true"
                     Hint="Written through the API. It is kept as written when you save." />
        <p class="lt-access-notice lt-access-notice--warning" role="note" data-lt-condition-warning="true">@AccessRuleFormat.ConditionNotEvaluatedMessage</p>
    }
    @if (_errors.Form is not null)
    {
        <p class="lt-access-form__error" role="alert" data-lt-field="form">@_errors.Form</p>
    }
    <div class="lt-access-form__actions">
        <LtButton Type="LtButtonType.Submit" Disabled="_saving">Save rule</LtButton>
        <LtButton Variant="LtButtonVariant.Quiet" OnClick="CancelAsync" Disabled="_saving">Cancel</LtButton>
    </div>
</form>
