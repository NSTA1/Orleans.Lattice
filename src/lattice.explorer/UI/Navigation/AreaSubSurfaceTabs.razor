@*
    Tier four: an area plugin's own sub-surfaces.

    The shell has four navigation tiers and they must not read alike. This is
    the last of them, and it is deliberately the quietest control in the set:

      1. areas            a stable vertical rail (AppShell)
      2. catalog kind     a segmented toggle inside the catalog (NavigationPanel)
      3. detail surfaces  an underlined tab strip over a selection (DetailPanel)
      4. sub-surfaces     THIS - the subordinate variant, tighter and quieter,
                          so it reads as sitting below the thing that selected
                          the surface rather than as a fourth peer strip

    A plugin uses this rather than LatticeAdaptiveTabs directly for two reasons.
    It gets the subordinate presentation without having to know that is the
    house rule, and it gets the cross-tier label check for free: an area and its
    own first sub-surface must not share a name, and the shell is the only place
    that knows both.
*@

<div class="lx-shell-subsurface">
    @*
        ChildContent is passed as a parameter rather than as element content on
        purpose. Razor composes a render fragment for element content whether or
        not the caller supplied any, and the tab primitive reads a non-null
        ChildContent as "I own the panel" - which would silently ignore a
        PanelId the plugin passed and leave its own panel unreferenced.
    *@
    <LatticeAdaptiveTabs Tabs="_tabs"
                         ActiveId="@ActiveId"
                         OnSelect="OnSelect"
                         Label="@_label"
                         Variant="LatticeTabsVariant.Subordinate"
                         Orientation="Orientation"
                         Id="@Id"
                         PanelId="@PanelId"
                         ChildContent="ChildContent"
                         Class="lx-shell-subsurface-strip" />
</div>

@code {
    private const string DefaultLabelSuffix = " surfaces";

    private IReadOnlyList<LatticeTabItem>? _tabs;
    private string _label = "Surfaces";
    private string? _labelSourceArea;
    private string? _labelSourceOverride;

    /// <summary>The sub-surfaces to offer, in display order.</summary>
    [Parameter] public IReadOnlyList<LatticeTabItem>? Tabs { get; set; }

    /// <summary>The identity of the sub-surface currently open.</summary>
    [Parameter] public string? ActiveId { get; set; }

    /// <summary>Invoked with the sub-surface's identity when the caller opens one.</summary>
    [Parameter] public EventCallback<string> OnSelect { get; set; }

    /// <summary>
    /// The strip's accessible name. Leave <see langword="null"/> to compose it
    /// from the cascaded area - "Tenants surfaces" - which is what distinguishes
    /// this strip from the tiers above it for a caller listing the page's
    /// controls.
    /// </summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>
    /// The axis the strip runs along. Horizontal by default, which is the shape
    /// a sub-surface control wears beneath the surface that selected it.
    /// </summary>
    [Parameter] public LatticeTabsOrientation Orientation { get; set; }

    /// <summary>A stable element-id prefix for the strip's tabs and panel.</summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>
    /// The id of the <c>role="tabpanel"</c> this strip controls, when the plugin
    /// renders the panel itself. Supply this or <see cref="ChildContent"/>: a
    /// tab that names no panel leaves a screen-reader caller with nothing to
    /// move into.
    /// </summary>
    [Parameter] public string? PanelId { get; set; }

    /// <summary>
    /// The open sub-surface's content. Supplying it makes the strip render its
    /// own <c>role="tabpanel"</c>, which is the simplest way to satisfy the tabs
    /// pattern.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// The area this strip is nested in, cascaded by the shell. Absent when the
    /// strip is rendered outside an area, in which case no label collision is
    /// possible and none is looked for.
    /// </summary>
    [CascadingParameter] public ExplorerAreaContext? Area { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        // Returns the caller's own instance when nothing collides, so a plugin
        // whose surfaces are already named distinctly pays no allocation and the
        // tab primitive keeps diffing against the same cached list.
        _tabs = ExplorerAreaSurfaceLabels.Disambiguate(Area?.Label, Tabs);

        RebuildLabel();
    }

    // Composed once per area (or override) change rather than per render: this
    // strip re-renders on every sub-surface activation.
    private void RebuildLabel()
    {
        var area = Area?.Label;
        if (string.Equals(_labelSourceArea, area, StringComparison.Ordinal)
            && string.Equals(_labelSourceOverride, Label, StringComparison.Ordinal))
        {
            return;
        }

        _labelSourceArea = area;
        _labelSourceOverride = Label;

        _label = !string.IsNullOrEmpty(Label)
            ? Label
            : string.IsNullOrEmpty(area) ? "Surfaces" : area + DefaultLabelSuffix;
    }
}
