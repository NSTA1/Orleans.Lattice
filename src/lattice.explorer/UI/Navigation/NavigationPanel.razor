@using Orleans.Lattice.Explorer.Core.Catalog
@using Orleans.Lattice.Explorer.Core.Configuration
@using Orleans.Lattice.Explorer.Core.DeadLetter
@using Orleans.Lattice.Explorer.Core.Navigation
@using Orleans.Lattice.Explorer.Core.Session
@implements IDisposable
@inject ICatalogReader CatalogReader
@inject IDeadLetterReader DeadLetterReader
@inject IExplorerSelection Selection
@inject IExplorerSession Session
@inject IServiceProvider Services
@inject IUiPreferenceStore Preferences

<nav class="lx-shell-nav" aria-label="Tree and view catalog">
    <header class="lx-shell-nav-header">
        <div class="lx-shell-nav-actions">
            @if (_navOptions.AllowEndpointConfiguration)
            {
                <CogButton Title="Connection settings" OnClick="OpenConfig" />
            }

            <button type="button"
                    class="lx-shell-nav-refresh"
                    title="Refresh"
                    aria-label="Refresh catalog"
                    disabled="@_loading"
                    @onclick="RefreshAsync">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                    <path fill="currentColor"
                          d="M17.65 6.35A8 8 0 1 0 19.73 14h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35Z" />
                </svg>
            </button>
        </div>

        <div class="lx-shell-nav-toggle" role="tablist" aria-label="Catalog kind">
            <button type="button"
                    role="tab"
                    class="lx-shell-toggle-option @(_preferencesApplied && _kind == CatalogKind.Trees ? "is-active" : null)"
                    aria-selected="@(_preferencesApplied && _kind == CatalogKind.Trees)"
                    @onclick="@(() => SwitchKindAsync(CatalogKind.Trees))">
                Trees
            </button>
            <button type="button"
                    role="tab"
                    class="lx-shell-toggle-option @(_preferencesApplied && _kind == CatalogKind.Views ? "is-active" : null)"
                    aria-selected="@(_preferencesApplied && _kind == CatalogKind.Views)"
                    @onclick="@(() => SwitchKindAsync(CatalogKind.Views))">
                Views
            </button>
            <button type="button"
                    role="tab"
                    class="lx-shell-toggle-option @(_preferencesApplied && _kind == CatalogKind.TagIndexes ? "is-active" : null)"
                    aria-selected="@(_preferencesApplied && _kind == CatalogKind.TagIndexes)"
                    @onclick="@(() => SwitchKindAsync(CatalogKind.TagIndexes))">
                Tag indexes
            </button>
        </div>
    </header>

    <div class="lx-shell-nav-body">
        @if (_loading && _items.Count == 0)
        {
            <div class="lx-shell-nav-state">Loading catalog...</div>
        }
        else if (_error is not null)
        {
            <div class="lx-shell-nav-state lx-shell-nav-error">
                <span>@_error</span>
                <button type="button" class="lx-btn-link" @onclick="RefreshAsync">Try again</button>
            </div>
        }
        else if (_items.Count == 0)
        {
            <div class="lx-shell-nav-state">
                @EmptyMessage
            </div>
        }
        else
        {
            <ul class="lx-shell-nav-list" role="listbox" aria-label="@KindLabel">
                @foreach (var item in _items)
                {
                    var isSelected = string.Equals(Selection.Selected?.Id, item.Id, StringComparison.Ordinal)
                        && Selection.Selected?.Kind == item.Kind;
                    <li role="option" aria-selected="@isSelected">
                        <button type="button"
                                class="lx-shell-nav-item @(isSelected ? "is-selected" : null)"
                                @onclick="@(() => SelectAsync(item))">
                            <span class="lx-shell-nav-item-id">@(item.Kind == CatalogKind.TagIndexes ? item.IndexName ?? item.Id : item.Label)</span>
                            <span class="lx-shell-nav-item-meta">
                                @if (item.Kind == CatalogKind.Trees)
                                {
                                    @if (item.Lifecycle is not null)
                                    {
                                        <span class="lx-badge">@item.Lifecycle</span>
                                    }
                                    @if (item.ShardCount is int shards)
                                    {
                                        <span class="lx-badge" title="Shard count">@shards sh</span>
                                    }
                                    @if (_deadLetterCounts.TryGetValue(item.Id, out var dlq) && dlq > 0)
                                    {
                                        <span class="lx-badge"
                                              title="Dead-lettered items (strict-mode schema rejects)">@dlq DLQ</span>
                                    }
                                }
                                else if (item.Kind == CatalogKind.TagIndexes)
                                {
                                    <span class="lx-badge" title="Tag index">tag</span>
                                    @if (item.ShardCount is int tagShards)
                                    {
                                        <span class="lx-badge" title="Shard count">@tagShards sh</span>
                                    }
                                }
                                else
                                {
                                    @if (item.IsAggregation)
                                    {
                                        <span class="lx-badge" title="Aggregation view">agg</span>
                                    }
                                    @if (item.IsHistory)
                                    {
                                        <span class="lx-badge" title="Change-history view">history</span>
                                    }
                                    @if (item.SourceTreeId is not null)
                                    {
                                        <span class="lx-badge lx-badge-muted" title="Source tree">@item.SourceTreeId</span>
                                    }
                                    @if (item.ProjectionProviderKey is not null)
                                    {
                                        <span class="lx-badge lx-badge-muted" title="Runtime projection provider">@item.ProjectionProviderKey</span>
                                    }
                                    @if (item.ProjectionVersion is not null)
                                    {
                                        <span class="lx-badge lx-badge-muted" title="Projection version">@item.ProjectionVersion</span>
                                    }
                                }
                            </span>
                        </button>
                    </li>
                }
            </ul>

            @if (_hasMore)
            {
                <button type="button"
                        class="lx-shell-nav-more"
                        disabled="@_loading"
                        @onclick="LoadMoreAsync">
                    @(_loading ? "Loading..." : "Load more")
                </button>
            }
        }
    </div>
</nav>

@if (_showConfig)
{
    <div class="lx-shell-config-overlay">
        <ConfigurationDialog Initial="Session.Current"
                             AllowCancel="true"
                             OnSaved="CloseConfig"
                             OnCancelled="CloseConfig" />
    </div>
}

@code {
    private const int PageSize = 100;

    private ExplorerNavigationOptions _navOptions = new();

    private readonly List<CatalogItem> _items = new();

    // Per-tree dead-letter-queue counts for the at-a-glance DLQ badge, keyed by
    // tree id. Populated after each tree page loads; a zero (or missing) count
    // shows no badge. Empty for the Views / Tag-index kinds, which have no DLQ.
    private readonly Dictionary<string, int> _deadLetterCounts = new(StringComparer.Ordinal);
    private CatalogKind _kind = CatalogKind.Trees;
    private string KindLabel => _kind switch
    {
        CatalogKind.Trees => "Trees",
        CatalogKind.Views => "Views",
        CatalogKind.TagIndexes => "Tag indexes",
        _ => "Catalog",
    };
    private string EmptyMessage => _kind switch
    {
        CatalogKind.Trees => "No trees found.",
        CatalogKind.Views => "No views found.",
        CatalogKind.TagIndexes => "No tag indexes found.",
        _ => "No items found.",
    };
    private string? _nextToken;
    private bool _hasMore;
    private bool _loading = true;
    private string? _error;
    private bool _showConfig;
    private bool _preferencesApplied;

    // Durable-preference keys for the navigation panel's global UI state: the
    // catalog-kind toggle and the active catalog selection (the whole item, so
    // it can be restored without re-discovering it from the catalog).
    private const string KindStateKey = "nav-kind";
    private const string SelectionStateKey = "nav-selected";

    protected override async Task OnInitializedAsync()
    {
        _navOptions = (ExplorerNavigationOptions?)Services.GetService(typeof(ExplorerNavigationOptions))
            ?? new ExplorerNavigationOptions();
        Selection.SelectionChanged += OnSelectionChanged;
        Session.ConfigurationChanged += OnConfigurationChanged;

        // Restore the prior kind toggle and active selection before the first
        // catalog load so the panel opens on the retained kind (and never shows
        // the default kind selected first). When browser storage is not yet
        // reachable (server prerender), defer the first load to the first
        // interactive render so the wrong kind is never shown.
        await Preferences.EnsureLoadedAsync();
        ApplyPreferences();
        if (_preferencesApplied)
        {
            await ReloadAsync();
        }
    }

    // Completes restoration on the first interactive render when initialization
    // could not reach browser storage (for example after server prerender). Falls
    // back to the defaults if storage is still unreachable so the panel always
    // ends up with a selected kind and a loaded list rather than a blank toggle.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _preferencesApplied)
        {
            return;
        }

        await Preferences.EnsureLoadedAsync();
        ApplyPreferences();
        _preferencesApplied = true;
        await ReloadAsync();
        StateHasChanged();
    }

    // Applies the retained kind and selection from durable preferences (once,
    // and only after the mirror has hydrated).
    private void ApplyPreferences()
    {
        if (_preferencesApplied || !Preferences.IsLoaded)
        {
            return;
        }

        _preferencesApplied = true;
        _kind = Preferences.GetOrDefault(KindStateKey, CatalogKind.Trees);

        var saved = Preferences.GetOrDefault<CatalogItem?>(SelectionStateKey, null);
        if (saved is not null)
        {
            Selection.Select(saved);
        }
    }

    private async Task SwitchKindAsync(CatalogKind kind)
    {
        if (_kind == kind)
        {
            return;
        }

        _kind = kind;

        // Retain the toggle as a durable preference.
        await Preferences.SetAsync(KindStateKey, kind);
        await ReloadAsync();
    }

    private Task RefreshAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        _items.Clear();
        _deadLetterCounts.Clear();
        _nextToken = null;
        _hasMore = false;
        await LoadPageAsync(reset: true);
    }

    private Task LoadMoreAsync() => LoadPageAsync(reset: false);

    private async Task LoadPageAsync(bool reset)
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            var page = await CatalogReader.LoadAsync(_kind, reset ? null : _nextToken, PageSize);
            // Restore-shadow trees are an internal artifact of a shadow-cutover
            // restore; they are surfaced only under their logical alias in the
            // Backups area, never in the general catalog. The flag is carried from
            // the state API, so this is not a name-based filter.
            _items.AddRange(page.Items.Where(item => !item.IsRestoreShadow));
            _nextToken = page.NextPageToken;
            _hasMore = page.HasMore;

            // Populate the DLQ badge counts for the freshly loaded trees. Zero /
            // absent counts (including a cluster with no schema enforcement, where
            // the reader returns 0) simply render no badge. Views and tag indexes
            // have no dead-letter queue, so this is skipped for those kinds.
            if (_kind == CatalogKind.Trees)
            {
                await LoadDeadLetterCountsAsync(page.Items);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    // Fetches the dead-letter count for each of the given trees and records the
    // non-zero counts for the badge. Counts are fetched concurrently (no delays /
    // ordering) and a per-tree failure is swallowed so the catalog list still
    // renders; a tree simply shows no badge when its count cannot be read.
    private async Task LoadDeadLetterCountsAsync(IReadOnlyList<CatalogItem> trees)
    {
        if (trees.Count == 0)
        {
            return;
        }

        var counts = await Task.WhenAll(trees.Select(async tree =>
        {
            try
            {
                var count = await DeadLetterReader.CountAsync(tree.Id);
                return (tree.Id, count);
            }
            catch (Exception)
            {
                return (tree.Id, 0);
            }
        }));

        foreach (var (treeId, count) in counts)
        {
            if (count > 0)
            {
                _deadLetterCounts[treeId] = count;
            }
        }
    }

    // Selects an item and retains it as a durable preference so the selection
    // is restored when the panel reopens.
    private async Task SelectAsync(CatalogItem item)
    {
        await Preferences.SetAsync(SelectionStateKey, item);
        Selection.Select(item);
    }

    private void OpenConfig()
    {
        if (!_navOptions.AllowEndpointConfiguration)
        {
            // The affordance is withheld, but a circuit handler stays invokable, so
            // do not open a dialog whose save the store would refuse. Presentation
            // only - the enforcing check lives at the configuration store.
            return;
        }

        _showConfig = true;
        StateHasChanged();
    }

    private void CloseConfig()
    {
        _showConfig = false;
        StateHasChanged();
    }

    private void OnSelectionChanged() => InvokeAsync(SyncSelectionKindAsync);

    // A selection can be driven from outside the navigation list - for example the
    // Data tab's "Go to source table" action on a history view selects the source
    // tree while the Views toggle is active. When the selected item's kind differs
    // from the kind currently listed, switch the toggle (persisting it like a manual
    // switch) and reload so the item appears in the list and is highlighted;
    // otherwise just re-render in place.
    private async Task SyncSelectionKindAsync()
    {
        var selected = Selection.Selected;
        if (_preferencesApplied && selected is not null && selected.Kind != _kind)
        {
            _kind = selected.Kind;
            await Preferences.SetAsync(KindStateKey, _kind);
            await ReloadAsync();
            return;
        }

        StateHasChanged();
    }

    private void OnConfigurationChanged() => InvokeAsync(async () =>
    {
        // A new endpoint invalidates the retained selection (it belongs to the
        // previous cluster); clear it so it is not restored against the new one.
        Selection.Select(null);
        await Preferences.RemoveAsync(SelectionStateKey);
        await ReloadAsync();
    });

    public void Dispose()
    {
        Selection.SelectionChanged -= OnSelectionChanged;
        Session.ConfigurationChanged -= OnConfigurationChanged;
    }
}
