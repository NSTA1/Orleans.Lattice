@using Orleans.Lattice.Explorer.Core.Catalog
@using Orleans.Lattice.Explorer.Core.Configuration
@using Orleans.Lattice.Explorer.Core.DeadLetter
@using Orleans.Lattice.Explorer.Core.Navigation
@using Orleans.Lattice.Explorer.Core.Session
@using Orleans.Lattice.Explorer.Core.Vocabulary
@implements IDisposable
@inject ICatalogReader CatalogReader
@inject IDeadLetterReader DeadLetterReader
@inject IExplorerSelection Selection
@inject IExplorerSession Session
@inject IServiceProvider Services
@inject IUiPreferenceStore Preferences

<nav class="lx-shell-nav" aria-label="Tree and view catalog">
    <header class="lx-shell-nav-header">
        <h2 class="lx-shell-nav-title">@CatalogHeading</h2>
        <div class="lx-shell-nav-actions">
            @if (_navOptions.AllowEndpointConfiguration)
            {
                <CogButton Title="Connection settings" OnClick="OpenConfig" />
            }

            <button type="button"
                    class="lx-shell-nav-refresh"
                    title="Refresh"
                    aria-label="Refresh catalog"
                    disabled="@_loading"
                    @onclick="RefreshAsync">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                    <path fill="currentColor"
                          d="M17.65 6.35A8 8 0 1 0 19.73 14h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35Z" />
                </svg>
            </button>
        </div>

        @*
            Tier two: the catalog kind, as the segmented variant of the one tab
            primitive. It used to be a hand-rolled role=tablist whose tabs
            carried no tabindex and answered no arrow key, so a keyboard caller
            tabbed through all three to pass it and a screen-reader caller was
            promised the tabs pattern without being given it. The segmented
            variant also reproduces the sunken-track look, so the strip reads as
            a toggle between peers rather than as a second copy of the rail.
        *@
        <LatticeAdaptiveTabs Tabs="KindTabs"
                             ActiveId="@(_preferencesApplied ? _kindId : null)"
                             OnSelect="_switchKind"
                             Label="Catalog kind"
                             Variant="LatticeTabsVariant.Segmented"
                             Id="@ExplorerShellRegions.CatalogKindStrip"
                             PanelId="@ExplorerShellRegions.CatalogList"
                             Class="lx-shell-nav-toggle" />
    </header>

    @*
        The catalog is swapped wholesale by a control the caller used, but the
        swap itself completes asynchronously and off-screen: the list below
        empties, reloads, and re-renders with entirely different content. Without
        an announcement a screen-reader caller is told nothing at all, so the
        region is rendered from the first pass - empty - and its text is set when
        a load settles. A live region created at the same moment as its message
        is silent (WCAG SC 4.1.3 Status Messages).
    *@
    <div class="lx-visually-hidden" role="status" aria-live="polite">@_announcement</div>

    <div class="lx-shell-nav-body"
         id="@ExplorerShellRegions.CatalogList"
         role="tabpanel"
         aria-labelledby="@_kindTabElementId">
        @if (_loading && _items.Count == 0)
        {
            <div class="lx-shell-nav-state">Loading catalog...</div>
        }
        else if (_error is not null)
        {
            <div class="lx-shell-nav-state lx-shell-nav-error">
                <span>@_error</span>
                <button type="button" class="lx-btn-link" @onclick="RefreshAsync">Try again</button>
            </div>
        }
        else if (_items.Count == 0)
        {
            <div class="lx-shell-nav-state">
                <p class="lx-shell-nav-state-headline">@_state.Headline</p>
                <p>@_state.Explanation</p>
                @if (!string.IsNullOrEmpty(_state.Remedy))
                {
                    <p><strong>@_state.RemedyLabel</strong> @_state.Remedy</p>
                }
            </div>
        }
        else
        {
            <ul class="lx-shell-nav-list" role="listbox" aria-label="@KindLabel">
                @for (var row = 0; row < _items.Count; row++)
                {
                    var item = _items[row];
                    var isSelected = string.Equals(Selection.Selected?.Id, item.Id, StringComparison.Ordinal)
                        && Selection.Selected?.Kind == item.Kind;
                    var badgeStart = row * ExplorerBadges.MaxCatalogBadges;
                    var badgeCount = _rowBadgeCounts[row];
                    <li role="option" aria-selected="@(isSelected ? "true" : "false")">
                        <button type="button"
                                class="lx-shell-nav-item @(isSelected ? "is-selected" : null)"
                                @onclick="@(() => SelectAsync(item))">
                            <span class="lx-shell-nav-item-id">@(item.Kind == CatalogKind.TagIndexes ? item.IndexName ?? item.Id : item.Label)</span>
                            @*
                                Badges come from the shared vocabulary, which
                                spells them out: "64 shards" rather than "64 sh",
                                "Aggregation" rather than "agg". The expansion is
                                the visible text, so it is not hidden behind a
                                title attribute - which is invisible on touch and
                                unreachable by keyboard, and was the defect here.

                                Deliberately no per-badge help disclosure: a
                                focusable trigger on every badge of every row
                                would put hundreds of stops in the tab order
                                between the catalog and the surface below it. The
                                readable text is what a caller needs at this
                                density; the glossary explains the terms where
                                they head a surface.
                            *@
                            <span class="lx-shell-nav-item-meta">
                                @for (var i = 0; i < badgeCount; i++)
                                {
                                    var badge = _rowBadges[badgeStart + i];
                                    <span class="@(badge.IsMuted ? MutedBadgeClass : BadgeClass)">@badge.Text</span>
                                }
                            </span>
                        </button>
                    </li>
                }
            </ul>

            @if (_hasMore)
            {
                <button type="button"
                        class="lx-shell-nav-more"
                        disabled="@_loading"
                        @onclick="LoadMoreAsync">
                    @(_loading ? "Loading..." : "Load more")
                </button>
            }
        }
    </div>
</nav>

@if (_showConfig)
{
    <div class="lx-shell-config-overlay">
        <ConfigurationDialog Initial="Session.Current"
                             AllowCancel="true"
                             OnSaved="CloseConfig"
                             OnCancelled="CloseConfig" />
    </div>
}

@code {
    private const int PageSize = 100;

    /// <summary>The catalog pane's heading, the level below the surface title.</summary>
    private const string CatalogHeading = "Catalog";

    // The catalog-kind strip's three options, composed once as a static: the
    // panel re-renders on every selection notification and every load, and
    // rebuilding the tab items per render would allocate on all of them. The
    // identities are the route kind slugs, so the strip, the address bar and the
    // preference contract all spell a kind the same way.
    private static readonly LatticeTabItem[] KindTabs =
    [
        new LatticeTabItem(ExplorerRouteSegments.Trees, "Trees")
        {
            Description = "Every tree on the cluster.",
        },
        new LatticeTabItem(ExplorerRouteSegments.Views, "Views")
        {
            Description = "Projections and change-history views over the trees.",
        },
        new LatticeTabItem(ExplorerRouteSegments.TagIndexes, "Tag indexes")
        {
            Description = "Tag indexes and the trees they cover.",
        },
    ];

    private ExplorerNavigationOptions _navOptions = new();

    private readonly List<CatalogItem> _items = new();

    // Per-tree dead-letter-queue counts for the at-a-glance DLQ badge, keyed by
    // tree id. Populated after each tree page loads; a zero (or missing) count
    // shows no badge. Empty for the Views / Tag-index kinds, which have no DLQ.
    private readonly Dictionary<string, int> _deadLetterCounts = new(StringComparer.Ordinal);
    private CatalogKind _kind = CatalogKind.Trees;
    private readonly EventCallback<string> _switchKind;

    /// <summary>The active kind's tab identity, which is its route slug.</summary>
    private string _kindId = ExplorerRouteSegments.Trees;

    /// <summary>The active kind's tab element id, so the catalog list names the tab that chose it.</summary>
    private string _kindTabElementId =
        ExplorerShellRegions.TabElementId(
            ExplorerShellRegions.CatalogKindStrip,
            ExplorerRouteSegments.Trees);

    /// <summary>
    /// The polite announcement for the last asynchronous catalog change. Empty
    /// until one happens, so the region is in the accessibility tree before it
    /// has anything to say.
    /// </summary>
    private string _announcement = string.Empty;

    private string KindLabel => _kind switch
    {
        CatalogKind.Trees => "Trees",
        CatalogKind.Views => "Views",
        CatalogKind.TagIndexes => "Tag indexes",
        _ => "Catalog",
    };
    private string EmptyMessage => _state.Explanation;

    /// <summary>
    /// The state the catalog is in, as the shared vocabulary words it. Never
    /// defaulted to "empty": a list that is empty because the read failed says
    /// so, and says what to try.
    /// </summary>
    private ExplorerStateMessage _state = ExplorerStateCopy.Loading(ExplorerSubjects.Trees);

    // The rows' badges, composed on the LOAD path and indexed on the render
    // path. A row's badges depend only on its catalog item and its dead-letter
    // count, and neither changes between loads - so building them here means a
    // re-render caused by a selection notification reads a struct out of an
    // array instead of re-deriving every row. Flat, one row's slots at
    // row * MaxCatalogBadges, so there is one array rather than one per row.
    private ExplorerBadge[] _rowBadges = [];
    private int[] _rowBadgeCounts = [];

    private const string BadgeClass = "lx-badge";
    private const string MutedBadgeClass = "lx-badge lx-badge-muted";

    private string? _nextToken;
    private bool _hasMore;
    private bool _loading = true;
    private string? _error;
    private bool _showConfig;
    private bool _preferencesApplied;

    // Durable-preference keys for the navigation panel's global UI state: the
    // catalog-kind toggle and the active catalog selection (the whole item, so
    // it can be restored without re-discovering it from the catalog).
    private const string KindStateKey = "nav-kind";
    private const string SelectionStateKey = "nav-selected";

    /// <summary>Creates the panel, caching the delegate the catalog-kind strip binds.</summary>
    public NavigationPanel() =>
        // Bound once rather than per render: the strip re-renders on every
        // selection notification and every load, and a lambda in the markup would
        // allocate a delegate on each of them.
        _switchKind = EventCallback.Factory.Create<string>(this, SwitchKindAsync);

    /// <summary>The route kind slug naming <paramref name="kind"/>.</summary>
    private static string SlugFor(CatalogKind kind) => kind switch
    {
        CatalogKind.Views => ExplorerRouteSegments.Views,
        CatalogKind.TagIndexes => ExplorerRouteSegments.TagIndexes,
        _ => ExplorerRouteSegments.Trees,
    };

    /// <summary>The catalog kind <paramref name="slug"/> names.</summary>
    private static CatalogKind KindFor(string? slug) => slug switch
    {
        ExplorerRouteSegments.Views => CatalogKind.Views,
        ExplorerRouteSegments.TagIndexes => CatalogKind.TagIndexes,
        _ => CatalogKind.Trees,
    };

    // Kept in step with _kind, so the strip's active id and the panel's
    // aria-labelledby are field reads rather than per-render switches.
    private void SyncKindIdentity()
    {
        _kindId = SlugFor(_kind);
        _kindTabElementId =
            ExplorerShellRegions.TabElementId(ExplorerShellRegions.CatalogKindStrip, _kindId);
    }

    /// <summary>
    /// Composes every loaded row's badges into the flat buffer, growing it only
    /// when the catalog has become longer than it has ever been.
    /// </summary>
    private void RebuildBadges()
    {
        var rows = _items.Count;
        if (_rowBadgeCounts.Length < rows)
        {
            _rowBadgeCounts = new int[rows];
            _rowBadges = new ExplorerBadge[rows * ExplorerBadges.MaxCatalogBadges];
        }

        for (var row = 0; row < rows; row++)
        {
            var item = _items[row];
            var deadLetters = item.Kind == CatalogKind.Trees
                && _deadLetterCounts.TryGetValue(item.Id, out var count)
                    ? count
                    : 0;

            var slots = _rowBadges.AsSpan(
                row * ExplorerBadges.MaxCatalogBadges,
                ExplorerBadges.MaxCatalogBadges);

            _rowBadgeCounts[row] = ExplorerBadges.ForCatalogItem(item, deadLetters, slots);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _navOptions = (ExplorerNavigationOptions?)Services.GetService(typeof(ExplorerNavigationOptions))
            ?? new ExplorerNavigationOptions();
        Selection.SelectionChanged += OnSelectionChanged;
        Session.ConfigurationChanged += OnConfigurationChanged;

        // Restore the prior kind toggle and active selection before the first
        // catalog load so the panel opens on the retained kind (and never shows
        // the default kind selected first). When browser storage is not yet
        // reachable (server prerender), defer the first load to the first
        // interactive render so the wrong kind is never shown.
        await Preferences.EnsureLoadedAsync();
        ApplyPreferences();
        if (_preferencesApplied)
        {
            await ReloadAsync();
        }
    }

    // Completes restoration on the first interactive render when initialization
    // could not reach browser storage (for example after server prerender). Falls
    // back to the defaults if storage is still unreachable so the panel always
    // ends up with a selected kind and a loaded list rather than a blank toggle.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _preferencesApplied)
        {
            return;
        }

        await Preferences.EnsureLoadedAsync();
        ApplyPreferences();
        _preferencesApplied = true;
        await ReloadAsync();
        StateHasChanged();
    }

    // Applies the retained kind and selection from durable preferences (once,
    // and only after the mirror has hydrated).
    private void ApplyPreferences()
    {
        if (_preferencesApplied || !Preferences.IsLoaded)
        {
            return;
        }

        _preferencesApplied = true;
        _kind = Preferences.GetOrDefault(KindStateKey, CatalogKind.Trees);
        SyncKindIdentity();

        var saved = Preferences.GetOrDefault<CatalogItem?>(SelectionStateKey, null);
        if (saved is not null)
        {
            Selection.Select(saved);
        }
    }

    private async Task SwitchKindAsync(string kindId)
    {
        var kind = KindFor(kindId);
        if (_kind == kind)
        {
            return;
        }

        _kind = kind;
        SyncKindIdentity();

        // Retain the toggle as a durable preference.
        await Preferences.SetAsync(KindStateKey, kind);
        await ReloadAsync();
    }

    private Task RefreshAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        _items.Clear();
        _deadLetterCounts.Clear();
        _nextToken = null;
        _hasMore = false;
        await LoadPageAsync(reset: true);
    }

    private Task LoadMoreAsync() => LoadPageAsync(reset: false);

    private async Task LoadPageAsync(bool reset)
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            var page = await CatalogReader.LoadAsync(_kind, reset ? null : _nextToken, PageSize);
            // Restore-shadow trees are an internal artifact of a shadow-cutover
            // restore; they are surfaced only under their logical alias in the
            // Backups area, never in the general catalog. The flag is carried from
            // the state API, so this is not a name-based filter.
            _items.AddRange(page.Items.Where(item => !item.IsRestoreShadow));
            _nextToken = page.NextPageToken;
            _hasMore = page.HasMore;

            // Populate the DLQ badge counts for the freshly loaded trees. Zero /
            // absent counts (including a cluster with no schema enforcement, where
            // the reader returns 0) simply render no badge. Views and tag indexes
            // have no dead-letter queue, so this is skipped for those kinds.
            if (_kind == CatalogKind.Trees)
            {
                await LoadDeadLetterCountsAsync(page.Items);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            RebuildBadges();
            Announce();
            StateHasChanged();
        }
    }

    // Says what the catalog now holds, once a load has settled. Composed on the
    // load path rather than on the render path: this runs once per catalog
    // change, where a render runs on every selection notification.
    private void Announce()
    {
        // Pick the kind rather than defaulting to Empty: a list that is empty
        // because the read failed is a different thing from one that is empty
        // because there is nothing there, and only one of them has a remedy.
        var subject = ExplorerSubjects.ForCatalogKind(_kind);
        _state = _error is not null
            ? ExplorerStateCopy.Failed(subject, _error)
            : ExplorerStateCopy.Empty(subject);

        if (_error is not null)
        {
            _announcement = _state.Headline + " " + _state.Explanation;
            return;
        }

        _announcement = _items.Count == 0
            ? KindLabel + ": " + _state.Headline
            : _items.Count == 1
                ? KindLabel + ": 1 " + subject.Singular + "."
                : KindLabel + ": " + _items.Count.ToString(System.Globalization.CultureInfo.CurrentCulture)
                    + " " + subject.Plural + ".";
    }

    // Fetches the dead-letter count for each of the given trees and records the
    // non-zero counts for the badge. Counts are fetched concurrently (no delays /
    // ordering) and a per-tree failure is swallowed so the catalog list still
    // renders; a tree simply shows no badge when its count cannot be read.
    private async Task LoadDeadLetterCountsAsync(IReadOnlyList<CatalogItem> trees)
    {
        if (trees.Count == 0)
        {
            return;
        }

        var counts = await Task.WhenAll(trees.Select(async tree =>
        {
            try
            {
                var count = await DeadLetterReader.CountAsync(tree.Id);
                return (tree.Id, count);
            }
            catch (Exception)
            {
                return (tree.Id, 0);
            }
        }));

        foreach (var (treeId, count) in counts)
        {
            if (count > 0)
            {
                _deadLetterCounts[treeId] = count;
            }
        }
    }

    // Selects an item and retains it as a durable preference so the selection
    // is restored when the panel reopens.
    private async Task SelectAsync(CatalogItem item)
    {
        await Preferences.SetAsync(SelectionStateKey, item);
        Selection.Select(item);
    }

    private void OpenConfig()
    {
        if (!_navOptions.AllowEndpointConfiguration)
        {
            // The affordance is withheld, but a circuit handler stays invokable, so
            // do not open a dialog whose save the store would refuse. Presentation
            // only - the enforcing check lives at the configuration store.
            return;
        }

        _showConfig = true;
        StateHasChanged();
    }

    private void CloseConfig()
    {
        _showConfig = false;
        StateHasChanged();
    }

    private void OnSelectionChanged() => InvokeAsync(SyncSelectionKindAsync);

    // A selection can be driven from outside the navigation list - for example the
    // Data tab's "Go to source table" action on a history view selects the source
    // tree while the Views toggle is active. When the selected item's kind differs
    // from the kind currently listed, switch the toggle (persisting it like a manual
    // switch) and reload so the item appears in the list and is highlighted;
    // otherwise just re-render in place.
    private async Task SyncSelectionKindAsync()
    {
        var selected = Selection.Selected;
        if (_preferencesApplied && selected is not null && selected.Kind != _kind)
        {
            _kind = selected.Kind;
            SyncKindIdentity();
            await Preferences.SetAsync(KindStateKey, _kind);
            await ReloadAsync();
            return;
        }

        StateHasChanged();
    }

    private void OnConfigurationChanged() => InvokeAsync(async () =>
    {
        // A new endpoint invalidates the retained selection (it belongs to the
        // previous cluster); clear it so it is not restored against the new one.
        Selection.Select(null);
        await Preferences.RemoveAsync(SelectionStateKey);
        await ReloadAsync();
    });

    public void Dispose()
    {
        Selection.SelectionChanged -= OnSelectionChanged;
        Session.ConfigurationChanged -= OnConfigurationChanged;
    }
}
