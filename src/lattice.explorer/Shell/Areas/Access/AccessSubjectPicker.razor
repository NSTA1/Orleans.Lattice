@*
    The subject picker: a User / Group choice, the id in mono, and - when the
    cluster has an identity directory - a search that lists matching principals
    by their display name (rendered as text) with the id beside it. Without a
    directory it degrades to the plain id box and says the id is not validated.
*@
<div class="lt-access-form__row">
    @if (AllowKindChange)
    {
        <LtSelect Label="@($"{Label} kind")" Options="KindOptions" Value="@KindValue" ValueChanged="OnKindChangedAsync" />
    }
    <LtTextInput Label="@Label" Mono="true" Value="@Id" ValueChanged="OnIdChangedAsync" Error="@Error" Hint="@IdHint" Disabled="Disabled" />
    @if (DirectoryAvailable)
    {
        <LtButton Variant="LtButtonVariant.Quiet" OnClick="SearchAsync" Disabled="@(Disabled || _searching)">Search the directory</LtButton>
    }
</div>
@if (_searchError is not null)
{
    <p class="lt-access-form__error" role="alert">@_searchError</p>
}
@if (_results is not null)
{
    @if (_results.Count == 0)
    {
        <p class="lt-access-fieldset__hint" role="status">No @KindWord in the directory matches.</p>
    }
    else
    {
        <ul class="lt-access-results" aria-label="@($"Directory matches for {Label.ToLowerInvariant()}")">
            @foreach (var principal in _results)
            {
                <li @key="principal.Id">
                    <button type="button" class="lt-access-results__option" @onclick="() => SelectAsync(principal)">
                        <span>@principal.DisplayName</span>
                        <span class="lt-access-results__id">@principal.Id</span>
                    </button>
                </li>
            }
        </ul>
        @if (_continuation is not null)
        {
            <LtButton Variant="LtButtonVariant.Quiet" OnClick="LoadMoreAsync" Disabled="_searching">Load more matches</LtButton>
        }
    }
}
