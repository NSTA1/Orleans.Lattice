{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orleans-lattice:explorer:appkit:protocol:v1",
  "title": "Orleans.Lattice Explorer AppKit frame protocol, version 1",
  "description": "Every message a sandboxed Lattice App frame and its Explorer host exchange. Validate a frame-to-host message against #/$defs/frameToHost and a host-to-frame message against #/$defs/hostToFrame. Byte sizes that JSON Schema cannot express (the request and response envelope bounds, the decoded value bound, and bundle asset bytes) are listed under x-lattice-limits and enforced by both ends. There are deliberately no lifecycle, consent, authentication, cross-app, fetch or frame-sizing messages.",
  "x-lattice-protocol": 1,
  "x-lattice-limits": {
    "maxValueBytes": 65536,
    "maxRequestBytes": 131072,
    "maxResponseBytes": 1048576,
    "maxPageSize": 200,
    "maxNotifyLength": 200,
    "maxKeyLength": 1024,
    "maxTreeNameLength": 128,
    "maxPathLength": 1024,
    "maxContinuationLength": 4096,
    "maxAssets": 256,
    "maxAssetBytes": 2097152,
    "maxBundleBytes": 16777216
  },
  "$defs": {
    "frameToHost": {
      "description": "A message the frame sends: ready over the window, everything else over the port.",
      "oneOf": [
        { "$ref": "#/$defs/ready" },
        { "$ref": "#/$defs/loaded" },
        { "$ref": "#/$defs/failed" },
        { "$ref": "#/$defs/request" }
      ]
    },
    "hostToFrame": {
      "description": "A message the host sends: hello over the window (with one transferred port), everything else over the port.",
      "oneOf": [
        { "$ref": "#/$defs/hello" },
        { "$ref": "#/$defs/bundle" },
        { "$ref": "#/$defs/response" },
        { "$ref": "#/$defs/contextChanged" },
        { "$ref": "#/$defs/navChanged" },
        { "$ref": "#/$defs/revoked" }
      ]
    },
    "protocol": { "type": "integer", "const": 1 },
    "requestId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "assetPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!(?:.*/)?\\.{1,2}(?:/|$))[a-z0-9._-]+(?:/(?!\\.{1,2}(?:/|$))[a-z0-9._-]+)*$"
    },
    "tree": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9_-]*$" },
    "key": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "prefix": { "type": "string", "maxLength": 1024 },
    "value": {
      "description": "Base64 of at most 65536 bytes.",
      "type": "string",
      "maxLength": 87384,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "continuation": { "type": ["string", "null"], "minLength": 1, "maxLength": 4096 },
    "path": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^/[^\\u0000-\\u001f\\u007f]*$" },
    "theme": { "type": "string", "enum": ["paper", "board"] },
    "contrast": { "type": "string", "enum": ["standard", "more"] },
    "density": { "type": "string", "enum": ["comfortable", "compact"] },
    "appearance": {
      "type": "object",
      "required": ["theme", "contrast", "density", "reducedMotion"],
      "additionalProperties": false,
      "properties": {
        "theme": { "$ref": "#/$defs/theme" },
        "contrast": { "$ref": "#/$defs/contrast" },
        "density": { "$ref": "#/$defs/density" },
        "reducedMotion": { "type": "boolean" }
      }
    },
    "emptyArgs": { "type": "object", "additionalProperties": false, "properties": {} },
    "emptyResult": { "type": "object", "additionalProperties": false, "properties": {} },

    "ready": {
      "type": "object",
      "required": ["type", "protocol"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "lattice.ready" },
        "protocol": { "$ref": "#/$defs/protocol" }
      }
    },
    "hello": {
      "description": "Posted to the frame's window with exactly one MessagePort in the transfer list. The frame accepts only the first.",
      "type": "object",
      "required": ["type", "protocol"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "lattice.hello" },
        "protocol": { "$ref": "#/$defs/protocol" }
      }
    },
    "bundle": {
      "description": "Sent once over the port after the host has verified every digest. assets carries every manifest asset.",
      "type": "object",
      "required": ["type", "protocol", "appearance", "bundle"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "lattice.bundle" },
        "protocol": { "$ref": "#/$defs/protocol" },
        "appearance": { "$ref": "#/$defs/appearance" },
        "bundle": {
          "type": "object",
          "required": ["entry", "styles", "scripts", "assets", "bundleDigest"],
          "additionalProperties": false,
          "properties": {
            "entry": { "$ref": "#/$defs/assetPath" },
            "styles": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/assetPath" } },
            "scripts": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "object",
                "required": ["path", "module"],
                "additionalProperties": false,
                "properties": {
                  "path": { "$ref": "#/$defs/assetPath" },
                  "module": { "type": "boolean" }
                }
              }
            },
            "bundleDigest": { "$ref": "#/$defs/digest" },
            "assets": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 256,
              "propertyNames": { "$ref": "#/$defs/assetPath" },
              "additionalProperties": {
                "type": "object",
                "required": ["mediaType", "digest", "bytes"],
                "additionalProperties": false,
                "properties": {
                  "mediaType": {
                    "type": "string",
                    "enum": ["text/html", "text/css", "text/javascript", "image/svg+xml", "image/png", "image/webp", "font/woff2", "application/json"]
                  },
                  "digest": { "$ref": "#/$defs/digest" },
                  "bytes": {
                    "description": "An ArrayBuffer or Uint8Array of at most 2 MiB, transferred by structured clone. Not representable in JSON.",
                    "x-lattice-binary": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "loaded": {
      "type": "object",
      "required": ["type", "protocol"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "lattice.loaded" },
        "protocol": { "$ref": "#/$defs/protocol" }
      }
    },
    "failed": {
      "type": "object",
      "required": ["type", "protocol", "code", "message"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "lattice.failed" },
        "protocol": { "$ref": "#/$defs/protocol" },
        "code": {
          "type": "string",
          "enum": ["protocol_unsupported", "bundle_malformed", "bundle_too_large", "asset_missing", "digest_mismatch", "bundle_digest_mismatch", "crypto_unavailable", "load_failed", "internal"]
        },
        "message": { "type": "string", "maxLength": 512 }
      }
    },

    "request": {
      "description": "{ id, op, args }. The operations are exactly Orleans.Lattice.Apps.AppUiBridgeOperations.",
      "oneOf": [
        { "$ref": "#/$defs/contextReadRequest" },
        { "$ref": "#/$defs/contextUserRequest" },
        { "$ref": "#/$defs/dataGetRequest" },
        { "$ref": "#/$defs/dataScanRequest" },
        { "$ref": "#/$defs/dataSetRequest" },
        { "$ref": "#/$defs/dataDeleteRequest" },
        { "$ref": "#/$defs/navSyncRequest" },
        { "$ref": "#/$defs/uiNotifyRequest" }
      ]
    },
    "contextReadRequest": {
      "type": "object",
      "required": ["id", "op", "args"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/requestId" },
        "op": { "const": "context.read" },
        "args": { "$ref": "#/$defs/emptyArgs" }
      }
    },
    "contextUserRequest": {
      "type": "object",
      "required": ["id", "op", "args"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/requestId" },
        "op": { "const": "context.user" },
        "args": { "$ref": "#/$defs/emptyArgs" }
      }
    },
    "dataGetRequest": {
      "type": "object",
      "required": ["id", "op", "args"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/requestId" },
        "op": { "const": "data.read" },
        "args": {
          "type": "object",
          "required": ["action", "tree", "key"],
          "additionalProperties": false,
          "properties": {
            "action": { "const": "get" },
            "tree": { "$ref": "#/$defs/tree" },
            "key": { "$ref": "#/$defs/key" }
          }
        }
      }
    },
    "dataScanRequest": {
      "type": "object",
      "required": ["id", "op", "args"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/requestId" },
        "op": { "const": "data.read" },
        "args": {
          "type": "object",
          "required": ["action", "tree", "prefix"],
          "additionalProperties": false,
          "properties": {
            "action": { "const": "scan" },
            "tree": { "$ref": "#/$defs/tree" },
            "prefix": { "$ref": "#/$defs/prefix" },
            "pageSize": { "type": "integer", "minimum": 1, "maximum": 200 },
            "continuation": { "$ref": "#/$defs/continuation" }
          }
        }
      }
    },
    "dataSetRequest": {
      "type": "object",
      "required": ["id", "op", "args"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/requestId" },
        "op": { "const": "data.write" },
        "args": {
          "type": "object",
          "required": ["action", "tree", "key", "value"],
          "additionalProperties": false,
          "properties": {
            "action": { "const": "set" },
            "tree": { "$ref": "#/$defs/tree" },
            "key": { "$ref": "#/$defs/key" },
            "value": { "$ref": "#/$defs/value" }
          }
        }
      }
    },
    "dataDeleteRequest": {
      "type": "object",
      "required": ["id", "op", "args"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/requestId" },
        "op": { "const": "data.delete" },
        "args": {
          "type": "object",
          "required": ["action", "tree", "key"],
          "additionalProperties": false,
          "properties": {
            "action": { "const": "delete" },
            "tree": { "$ref": "#/$defs/tree" },
            "key": { "$ref": "#/$defs/key" }
          }
        }
      }
    },
    "navSyncRequest": {
      "type": "object",
      "required": ["id", "op", "args"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/requestId" },
        "op": { "const": "nav.sync" },
        "args": {
          "type": "object",
          "required": ["path"],
          "additionalProperties": false,
          "properties": { "path": { "$ref": "#/$defs/path" } }
        }
      }
    },
    "uiNotifyRequest": {
      "type": "object",
      "required": ["id", "op", "args"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/requestId" },
        "op": { "const": "ui.notify" },
        "args": {
          "type": "object",
          "required": ["text"],
          "additionalProperties": false,
          "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 200 } }
        }
      }
    },

    "response": {
      "description": "{ id, ok, result | error }. A response carries no type member. The result shape is the one its request's operation defines.",
      "oneOf": [
        { "$ref": "#/$defs/successResponse" },
        { "$ref": "#/$defs/errorResponse" }
      ]
    },
    "successResponse": {
      "type": "object",
      "required": ["id", "ok", "result"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/requestId" },
        "ok": { "const": true },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/contextReadResult" },
            { "$ref": "#/$defs/contextUserResult" },
            { "$ref": "#/$defs/dataGetResult" },
            { "$ref": "#/$defs/dataScanResult" },
            { "$ref": "#/$defs/dataDeleteResult" },
            { "$ref": "#/$defs/emptyResult" }
          ]
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "required": ["id", "ok", "error"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/requestId" },
        "ok": { "const": false },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "enum": ["denied", "not_found", "invalid", "too_large", "rate_limited", "unavailable", "conflict"]
            },
            "message": { "type": "string", "maxLength": 512 }
          }
        }
      }
    },
    "contextReadResult": {
      "type": "object",
      "required": ["slug", "version", "protocol", "theme", "contrast", "density", "reducedMotion", "tenant"],
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "protocol": { "$ref": "#/$defs/protocol" },
        "theme": { "$ref": "#/$defs/theme" },
        "contrast": { "$ref": "#/$defs/contrast" },
        "density": { "$ref": "#/$defs/density" },
        "reducedMotion": { "type": "boolean" },
        "tenant": { "description": "The tenant's display name, never its id; null when tenancy is off.", "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "contextUserResult": {
      "type": "object",
      "required": ["displayName"],
      "additionalProperties": false,
      "properties": { "displayName": { "type": "string", "maxLength": 256 } }
    },
    "dataGetResult": {
      "type": "object",
      "required": ["found", "value"],
      "additionalProperties": false,
      "properties": {
        "found": { "type": "boolean" },
        "value": { "oneOf": [{ "$ref": "#/$defs/value" }, { "type": "null" }] }
      }
    },
    "dataScanResult": {
      "type": "object",
      "required": ["entries", "continuation"],
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": ["key", "value"],
            "additionalProperties": false,
            "properties": {
              "key": { "$ref": "#/$defs/key" },
              "value": { "$ref": "#/$defs/value" }
            }
          }
        },
        "continuation": { "$ref": "#/$defs/continuation" }
      }
    },
    "dataDeleteResult": {
      "type": "object",
      "required": ["deleted"],
      "additionalProperties": false,
      "properties": { "deleted": { "type": "boolean" } }
    },

    "contextChanged": {
      "type": "object",
      "required": ["type", "data"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "context.changed" },
        "data": { "$ref": "#/$defs/appearance" }
      }
    },
    "navChanged": {
      "type": "object",
      "required": ["type", "data"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "nav.changed" },
        "data": {
          "type": "object",
          "required": ["path"],
          "additionalProperties": false,
          "properties": { "path": { "$ref": "#/$defs/path" } }
        }
      }
    },
    "revoked": {
      "type": "object",
      "required": ["type", "data"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "lattice.revoked" },
        "data": {
          "type": "object",
          "required": ["reason"],
          "additionalProperties": false,
          "properties": {
            "reason": { "type": "string", "enum": ["disabled", "uninstalled", "upgraded", "revision", "closed"] }
          }
        }
      }
    }
  }
}
