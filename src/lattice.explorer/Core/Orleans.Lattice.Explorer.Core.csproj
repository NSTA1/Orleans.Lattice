<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Orleans.Lattice.Explorer.Core</RootNamespace>
    <PackageId>Orleans.Lattice.Explorer.Core</PackageId>
    <Version>9.1.0</Version>
    <Description>Head-agnostic core of the Orleans.Lattice Explorer: the read-only state-API connection seam, configuration store, session, capability model, and the catalog / metrics / topology / data / dead-letter / history navigation services shared by every explorer head. Its only cluster dependency is the public read-only state-API gRPC client.</Description>
    <PackageProjectUrl>https://github.com/NSTA1/Orleans.Lattice</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NSTA1/Orleans.Lattice</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Explorer.Tests" />
    <InternalsVisibleTo Include="Orleans.Lattice.Explorer.Backup" />
    <InternalsVisibleTo Include="Orleans.Lattice.Explorer.Access" />
    <InternalsVisibleTo Include="Orleans.Lattice.Explorer.Schema" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <!--
    The explorer's ONLY cluster dependency is the public read-only state API
    gRPC client. It must never reference Orleans.Lattice core or any grain
    interface - all cluster access flows through this client (see the
    connection layer). This single ProjectReference is the enforcement point.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\lattice.api.state.grpc\Orleans.Lattice.Api.State.Grpc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Orleans.Serialization" Version="10.2.2" />
  </ItemGroup>

</Project>
