<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Orleans.Lattice.Explorer.Core</RootNamespace>
    <PackageId>Orleans.Lattice.Explorer.Core</PackageId>
    <Version>9.4.2</Version>
    <Description>Head-agnostic core of the Orleans.Lattice Explorer: the read-only state-API connection seam, active-tenant assertion, configuration store, session, sign-in and credential seam, tenant-aware view scoping, shared vocabulary, and the catalog / metrics / data / dead-letter / history services the Explorer's web head composes. Its direct cluster dependencies are the public state-API gRPC client and the abstractions needed to stamp active-tenant calls.</Description>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Explorer.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <!--
    The explorer core's direct cluster dependencies are the public state API
    gRPC client and the abstractions needed to stamp active-tenant calls. Do not
    add direct references to Orleans.Lattice core or any grain interface here -
    cluster access in this layer should flow through the client/abstraction
    packages so the head keeps a transport seam.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\lattice.api.state.grpc\Orleans.Lattice.Api.State.Grpc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Orleans.Serialization" Version="10.2.2" />
  </ItemGroup>

</Project>
