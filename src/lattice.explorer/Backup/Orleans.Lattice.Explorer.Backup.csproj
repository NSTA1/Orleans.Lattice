<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Orleans.Lattice.Explorer.Backup</RootNamespace>
    <PackageId>Orleans.Lattice.Explorer.Backup</PackageId>
    <Version>9.1.0</Version>
    <Description>Backups management area for the Orleans.Lattice Explorer: bridges the backup control-API gRPC client to the explorer's navigation and capability model, and gates the Backups area and its per-scope actions behind a capability probe. Companion to Orleans.Lattice.Explorer.Core.</Description>
    <PackageProjectUrl>https://github.com/NSTA1/Orleans.Lattice</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NSTA1/Orleans.Lattice</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Explorer.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <!--
    Unlike Explorer.Core (which is walled off to the state-API client), this
    feature project is allowed to reference the backup control-API gRPC client,
    which transitively pulls in the backup engine and core. It bridges that
    client to the pure navigation / capability model in Core.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Core\Orleans.Lattice.Explorer.Core.csproj" />
    <ProjectReference Include="..\..\lattice.api.backup.grpc\Orleans.Lattice.Api.Backup.Grpc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Orleans.Serialization" Version="10.2.2" />
  </ItemGroup>

</Project>
