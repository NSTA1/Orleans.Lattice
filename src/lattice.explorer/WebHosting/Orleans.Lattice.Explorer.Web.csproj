<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Orleans.Lattice.Explorer.Web</RootNamespace>
    <AssemblyName>Orleans.Lattice.Explorer.Web</AssemblyName>
    <PackageId>Orleans.Lattice.Explorer.Web</PackageId>
    <Version>9.4.0</Version>
    <Description>Opt-in embeddable hosting library for the Orleans.Lattice Explorer Blazor Server web head. AddLatticeExplorerWeb(...) registers the Razor components, shared explorer UI, state-API connection seam, configuration and capability stores, the Backups, Access, and Schema areas, and the cookie / data-protection auth plumbing; MapLatticeExplorer(...) maps the interactive server components, static assets, and server-side sign-in / sign-out endpoints under a configurable base path so a consumer can co-host the read-only explorer inside their own ASP.NET app.</Description>
    <PackageProjectUrl>https://github.com/NSTA1/Orleans.Lattice</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NSTA1/Orleans.Lattice</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
    <None Include="build\Orleans.Lattice.Explorer.Web.props" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Explorer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Core" Version="1.62.0" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UI\Orleans.Lattice.Explorer.UI.csproj" />
    <!--
      The Backups plugin is now a self-contained package that the shared UI
      library no longer references, so a head that surfaces the Backups area
      takes the dependency itself. That is the whole of a head's opt-in.
    -->
    <ProjectReference Include="..\Plugins\Backups\Orleans.Lattice.Explorer.Backup.csproj" />
    <!--
      The Access plugin is likewise self-contained (services, Razor views, and
      its own stylesheet), so the shared UI library no longer references it and
      a head takes it directly. Withholding this reference ships no Access area.
    -->
    <ProjectReference Include="..\Plugins\Access\Orleans.Lattice.Explorer.Access.csproj" />
    <ProjectReference Include="..\Plugins\MyTenant\Orleans.Lattice.Explorer.MyTenant.csproj" />
  </ItemGroup>

</Project>
