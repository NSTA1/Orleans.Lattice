@inject LatticeExplorerWebOptions Options
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="@Options.BaseHref" />
    <title>Lattice Explorer</title>
    @* The design system: fonts, the documentation site's tokens, the Operate tokens, breakpoints, primitives and the favicon. *@
    <LtDesignHead />
    <link rel="stylesheet" href="@ShellChromeAssets.Stylesheet" />
    @*
        Areas whose pages do not link their own stylesheet. Every other area
        (Apps, Access, Tenancy, Schema, Replication) links its stylesheet from its
        own pages, as the app frame does.
    *@
    <link rel="stylesheet" href="@DataStylesheet" />
    <link rel="stylesheet" href="@BackupsStylesheet" />
    <link rel="stylesheet" href="@TelemetryStylesheet" />
    <link rel="stylesheet" href="@ClusterStylesheet" />
    @*
        The operator's material has to be on the document at the FIRST paint, so
        this is a classic, blocking script in <head>: the parser stops on it before
        anything is laid out or painted. It must not gain `defer` or `async`, and it
        must not move into <body>; either change reintroduces a flash of the wrong
        material on every load.
    *@
    <script src="@ShellChromeAssets.FirstPaintScript"></script>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    private const string DataStylesheet = Orleans.Lattice.Explorer.UI.Areas.Data.DataAssets.Stylesheet;
    private const string BackupsStylesheet = Orleans.Lattice.Explorer.UI.Areas.Backups.BackupsAssets.Stylesheet;
    private const string TelemetryStylesheet = Orleans.Lattice.Explorer.UI.Areas.Telemetry.TelemetryAssets.Stylesheet;
    private const string ClusterStylesheet = Orleans.Lattice.Explorer.UI.Areas.Cluster.ClusterAssets.Stylesheet;
}
