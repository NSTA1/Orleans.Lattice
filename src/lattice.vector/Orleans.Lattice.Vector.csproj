<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Orleans.Lattice.Vector</PackageId>
    <Version>9.4.0</Version>
    <Description>Allocation-lean approximate nearest-neighbour vector index for Orleans.Lattice. Ships VectorIndex, an in-memory inverted-file (IVF) index over dense float vectors with first-class deletes, deterministic results, a zero-allocation steady-state query path, and a chunked, version-stamped persistence seam. Has no Orleans dependency and can be consumed standalone.</Description>
    <PackageProjectUrl>https://github.com/NSTA1/Orleans.Lattice</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NSTA1/Orleans.Lattice</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Vector.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.11" />
  </ItemGroup>

</Project>
