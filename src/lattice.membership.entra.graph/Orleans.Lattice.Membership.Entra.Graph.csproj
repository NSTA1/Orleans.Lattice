<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Orleans.Lattice.Membership.Entra.Graph</PackageId>
    <Version>9.5.0</Version>
    <Description>Microsoft Graph-backed group resolver for Orleans.Lattice.Membership.Entra. Resolves a caller's full transitive Entra group membership when a token's groups claim overflows, using an app-only Microsoft Graph client whose access token is acquired, cached, and transparently refreshed via the MSAL confidential-client token cache with a single shared in-flight refresh. Isolates the Microsoft Graph and MSAL dependencies from the core Entra authenticator package.</Description>
    <PackageProjectUrl>https://github.com/NSTA1/Orleans.Lattice</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NSTA1/Orleans.Lattice</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Membership.Entra.Graph.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\lattice.membership.entra\Orleans.Lattice.Membership.Entra.csproj" />
    <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.2.2" />
    <PackageReference Include="Microsoft.Graph" Version="6.5.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.88.0" />
    <!-- Override the transitive Kiota.Abstractions pulled by Microsoft.Graph to a
         version without the RedirectHandler header-leak advisory (GHSA-7j59-v9qr-6fq9). -->
    <PackageReference Include="Microsoft.Kiota.Abstractions" Version="2.0.0" />
  </ItemGroup>

</Project>
