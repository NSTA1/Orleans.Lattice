<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Orleans.Lattice.Tenancy</PackageId>
    <Version>9.5.0</Version>
    <Description>Durable, CRDT-backed tenant registry add-on for Orleans.Lattice. Persists tenant definitions (status, quotas, burst, placement binding, tenant-admin subjects, and cross-tenant grants) in reserved sys-tenant-* Lattice trees under system-origin, converging concurrent updates with LWW-register semantics, and fails fast at startup when tenancy is enabled without the auth and membership add-ons it depends on.</Description>
    <PackageProjectUrl>https://github.com/NSTA1/Orleans.Lattice</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NSTA1/Orleans.Lattice</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Tenancy.Tests" />
    <!-- The microbench host drives TenantRecord's internal slot maps directly so
         the "reshardfolds" suite can run the prior double-probe merge shape
         side-by-side with the shipped single-probe MergeFrom. -->
    <InternalsVisibleTo Include="Orleans.Lattice.Benchmark.Microbench" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\lattice\Orleans.Lattice.csproj" />
    <ProjectReference Include="..\lattice.membership\Orleans.Lattice.Membership.csproj" />
    <ProjectReference Include="..\lattice.auth\Orleans.Lattice.Auth.csproj" />
    <ProjectReference Include="..\lattice.backup\Orleans.Lattice.Backup.csproj" />
    <ProjectReference Include="..\lattice.replication\Orleans.Lattice.Replication.csproj" />
    <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.2.2" />
  </ItemGroup>

</Project>
