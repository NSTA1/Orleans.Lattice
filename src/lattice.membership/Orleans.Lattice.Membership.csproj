<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Orleans.Lattice.Membership</PackageId>
    <Version>9.9.0</Version>
    <Description>Identity and subject-resolution add-on for Orleans.Lattice. Resolves a propagated caller credential into a LatticeSubject (a stable subject id plus its transitively expanded group closure) via a pluggable, IDP-independent authenticator seam (a JWT authenticator built in and designed to be specialized, plus an anonymous fallback), with configurable merging of token-asserted and directory groups. Backed by an introspectable group and membership-edge directory dogfooded onto reserved sys-membership-* Lattice trees with durable per-key history and per-silo resolution caching, and provides the identity-directory seam (a no-op default and a static roster built in) that admin surfaces use to search and validate principal ids. Enforces nothing on its own: authorization and enforcement come from Orleans.Lattice.Auth.</Description>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Membership.Tests" />
    <InternalsVisibleTo Include="Orleans.Lattice.Tenancy" />
    <InternalsVisibleTo Include="Orleans.Lattice.Tenancy.Tests" />
    <InternalsVisibleTo Include="Orleans.Lattice.Api.TenantAdmin" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\lattice\Orleans.Lattice.csproj" />
    <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.2.2" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.22.0" />
  </ItemGroup>

</Project>
