<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Orleans.Lattice.Apps</PackageId>
    <Version>10.0.0</Version>
    <Description>Opt-in installable apps for Orleans.Lattice: embedded JSON manifests declaring an app's trees, roles, replication intent, change-feed subscriptions and MCP tools, validated without loading app code; a durable app registry of install records with group-only role bindings and a version-pinned capability ceiling; an activation pipeline, re-run for every enabled app after silo start, that compiles roles into ordinary authorization rules, provisions exclusively owned a/{app}/{tree} trees through the ownership ledger backing the core ITreeOwnershipGuard, and enrols declared replication per install; and a change-feed subscription runtime that delivers committed user writes to the handlers registered for an app's subscriptions. Registered with AddLatticeApps(), with apps shipped in the silo image added through AddLatticeApp(...).</Description>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="Manifest\app-manifest.schema.json" />
    <None Update="Manifest\app-manifest.schema.json" Pack="true" PackagePath="schema\" />
    <InternalsVisibleTo Include="Orleans.Lattice.Apps.Tests" />
    <InternalsVisibleTo Include="Orleans.Lattice.Api.Apps" />
    <InternalsVisibleTo Include="Orleans.Lattice.Api.Apps.Tests" />
    <InternalsVisibleTo Include="Orleans.Lattice.Api.Mcp.Apps" />
    <InternalsVisibleTo Include="Orleans.Lattice.Api.Mcp.Apps.Tests" />
    <InternalsVisibleTo Include="Orleans.Lattice.Api.Mcp.RepoContext.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\lattice\Orleans.Lattice.csproj" />
    <ProjectReference Include="..\lattice.auth\Orleans.Lattice.Auth.csproj" />
    <ProjectReference Include="..\lattice.membership\Orleans.Lattice.Membership.csproj" />
    <ProjectReference Include="..\lattice.replication\Orleans.Lattice.Replication.csproj" />
    <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.2.2" />
  </ItemGroup>
</Project>
