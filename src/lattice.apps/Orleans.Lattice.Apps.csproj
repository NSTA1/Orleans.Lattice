<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Orleans.Lattice.Apps</PackageId>
    <Version>9.6.0</Version>
    <Description>Installable app manifest contracts, identity, validation and embedded-resource loading for Orleans.Lattice.</Description>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="Manifest\app-manifest.schema.json" />
    <None Update="Manifest\app-manifest.schema.json" Pack="true" PackagePath="schema\" />
    <InternalsVisibleTo Include="Orleans.Lattice.Apps.Tests" />
    <InternalsVisibleTo Include="Orleans.Lattice.Api.Mcp.Apps.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\lattice\Orleans.Lattice.csproj" />
    <ProjectReference Include="..\lattice.auth\Orleans.Lattice.Auth.csproj" />
    <ProjectReference Include="..\lattice.membership\Orleans.Lattice.Membership.csproj" />
    <ProjectReference Include="..\lattice.replication\Orleans.Lattice.Replication.csproj" />
    <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.2.2" />
  </ItemGroup>
</Project>
