<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Orleans.Lattice.Api.Data.Grpc</PackageId>
    <Version>10.4.0</Version>
    <Description>gRPC transport binding and strongly typed client for Orleans.Lattice.Api.Data. Exposes the read-write external data-plane API (set, delete, non-atomic bulk upsert, single-tree and cross-tree atomic batches, point read, bounded range read, bounded range delete, the typed CRDT write and read verbs, and a capability probe) as unary gRPC RPCs, plus a duplex-streaming bulk upsert, over a code-first, Orleans-serialized contract, with a header-based identity bridge, a pluggable coarse authorization seam, and a default-deny posture. Registered with AddLatticeDataApiGrpc(...) and mapped with MapLatticeDataApiGrpc().</Description>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Api.Data.Grpc.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\lattice.api.abstractions\Orleans.Lattice.Api.Abstractions.csproj" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.85.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.85.0" />
  </ItemGroup>

</Project>
