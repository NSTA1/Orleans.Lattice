<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Orleans.Lattice.Api.TreeAdmin</PackageId>
    <Version>9.6.0</Version>
    <Description>Optional transport-agnostic control facade add-on for Orleans.Lattice whole-tree administration. Presents one discoverable, fail-closed control surface for tree-lifecycle administration by composing the existing single-responsibility facades - it wraps the schema control facade (Orleans.Lattice.Api.Schema) by delegation rather than re-implementing it. Registered separately; adds no transport behaviour of its own. Exposes a fail-closed capability probe; individual whole-tree lifecycle operations are added to the facade as they become available.</Description>
    <PackageProjectUrl>https://github.com/NSTA1/Orleans.Lattice</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NSTA1/Orleans.Lattice</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Api.TreeAdmin.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\lattice\Orleans.Lattice.csproj" />
    <ProjectReference Include="..\lattice.api.abstractions\Orleans.Lattice.Api.Abstractions.csproj" />
    <ProjectReference Include="..\lattice.api.schema\Orleans.Lattice.Api.Schema.csproj" />
    <ProjectReference Include="..\lattice.backup\Orleans.Lattice.Backup.csproj" />
    <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.2.2" />
  </ItemGroup>

</Project>
