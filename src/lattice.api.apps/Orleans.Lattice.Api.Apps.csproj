<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Orleans.Lattice.Api.Apps</PackageId>
    <Version>10.0.0</Version>
    <Description>Transport-agnostic app lifecycle, consent, catalogue, workspace, role-binding, and bridge facades for Orleans.Lattice. Composes the app registry, source seam and activation pipeline behind fail-closed surfaces that authorize with AppInstall or the caller's app-owned role grants, apply the caller's active tenant at entry, and never disclose composed physical tree ids. Adds no transport behaviour of its own.</Description>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Api.Apps.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\lattice\Orleans.Lattice.csproj" />
    <ProjectReference Include="..\lattice.api.abstractions\Orleans.Lattice.Api.Abstractions.csproj" />
    <ProjectReference Include="..\lattice.apps\Orleans.Lattice.Apps.csproj" />
    <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.2.2" />
  </ItemGroup>

</Project>
