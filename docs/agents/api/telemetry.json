  "operations": [
    {
      "id": "get-auth-scheme",
      "in_process": "ILatticeTelemetryApiAuthSchemeSource.GetAdvertisement",
      "grpc_method": "/orleans.lattice.api.telemetry/GetAuthScheme",
      "transport_scope": "both",
      "request": "AuthSchemeAdvertisementRequest",
      "response": "AuthSchemeAdvertisement",
      "errors": [],
      "retry": {
        "safe": true,
        "policy": "Unauthenticated read of configured public advertisement.",
        "source": "src/lattice.api.telemetry.grpc/Security/OptionsLatticeTelemetryApiAuthSchemeSource.cs#GetAdvertisement"
      },
      "idempotency": {
        "idempotent": true,
        "basis": "Returns the configured advertised auth schemes and has no side effects.",
        "source": "src/lattice.api.telemetry.grpc/Security/OptionsLatticeTelemetryApiAuthSchemeSource.cs#GetAdvertisement"
      },
      "concurrency": {
        "rule": "Exempt from the authorization interceptor so clients can discover how to sign in.",
        "source": "src/lattice.api.telemetry.grpc/Security/LatticeTelemetryApiGrpcAuthInterceptor.cs#IsUnauthenticatedMethod"
      },
      "sources": [
        "src/lattice.api.telemetry.grpc/LatticeTelemetryGrpcMethods.cs#GetAuthSchemeMethodName",
        "src/lattice.api.telemetry.grpc/LatticeTelemetryGrpcService.cs#GetAuthScheme"
      ]
    },
    {
      "id": "get-catalog",
      "in_process": "ILatticeTelemetry.GetCatalogAsync",
      "grpc_method": "/orleans.lattice.api.telemetry/GetCatalog",
      "transport_scope": "both",
      "request": "TelemetryCatalogRequest",
      "response": "TelemetryQueryCatalog",
      "errors": [
        {
          "error_id": "permission-denied",
          "condition": "Unauthorized callers receive the empty catalogue."
        }
      ],
      "retry": {
        "safe": true,
        "policy": "Read-only discovery; unauthorized or unconfigured clusters return an empty catalog.",
        "source": "src/lattice.api.abstractions/Telemetry/ILatticeTelemetry.cs#GetCatalogAsync"
      },
      "idempotency": {
        "idempotent": true,
        "basis": "Read-only operation returns scoped catalogue entries in ascending QueryId order.",
        "source": "src/lattice.api.abstractions/Telemetry/ILatticeTelemetry.cs#GetCatalogAsync"
      },
      "concurrency": {
        "rule": "Catalogue is scoped to caller entitlement; unoffered entries are absent rather than present-and-denied.",
        "source": "src/lattice.api.abstractions/Telemetry/ILatticeTelemetry.cs#GetCatalogAsync"
      },
      "sources": [
        "src/lattice.api.abstractions/Telemetry/ILatticeTelemetry.cs#GetCatalogAsync",
        "src/lattice.api.telemetry.grpc/LatticeTelemetryGrpcMethods.cs#GetCatalogMethodName",
        "src/lattice.api.telemetry.grpc/LatticeTelemetryGrpcService.cs#GetCatalog"
      ]
    },
    {
      "id": "query",
      "in_process": "ILatticeTelemetry.QueryAsync",
      "grpc_method": "/orleans.lattice.api.telemetry/Query",
      "transport_scope": "both",
      "request": "TelemetryQueryRequest",
      "response": "TelemetryQueryResponse",
      "errors": [
        {
          "error_id": "invalid-argument",
          "condition": "Request or QueryId is null, or the tree filter contains a control character."
        },
        {
          "error_id": "permission-denied",
          "condition": "Caller is not authorized or cannot be attributed to a tenant."
        },
        {
          "error_id": "not-found",
          "condition": "The query id is absent, unoffered to the caller, or no backend is configured."
        },
        {
          "error_id": "out-of-range",
          "condition": "The requested window violates catalogue or deployment guardrails."
        },
        {
          "error_id": "unavailable",
          "condition": "The metrics backend was unreachable, timed out, or answered unusably."
        }
      ],
      "retry": {
        "safe": true,
        "policy": "Retry Unavailable with backoff; do not retry NotFound or OutOfRange without changing inputs.",
        "source": "src/lattice.api.telemetry.grpc/LatticeTelemetryGrpcService.cs#InvokeAsync"
      },
      "idempotency": {
        "idempotent": "conditional",
        "basis": "Read-only; if EndUtc is omitted, the facade defaults it to the current time and a retry may evaluate a different instant.",
        "source": "src/lattice.api.telemetry/LatticeTelemetry.cs#ResolveRange"
      },
      "concurrency": {
        "rule": "Tenant scope is derived server-side; unvalidated widening requests degrade to the active tenant and are reported in the response scope.",
        "source": "src/lattice.api.telemetry/TelemetryTenantScopeResolver.cs#ResolveAsync"
      },
      "sources": [
        "src/lattice.api.abstractions/Telemetry/ILatticeTelemetry.cs#QueryAsync",
        "src/lattice.api.telemetry.grpc/LatticeTelemetryGrpcMethods.cs#QueryMethodName",
        "src/lattice.api.telemetry.grpc/LatticeTelemetryGrpcService.cs#Query"
      ]
    }
  ],
  "error_taxonomy": [
    {
      "id": "cancelled",
      "type": "OperationCanceledException",
      "grpc_status": "Cancelled",
      "retryable": false,
      "meaning": "The request or authorization check was cancelled.",
      "source": "src/lattice.api.telemetry.grpc/LatticeTelemetryGrpcService.cs#InvokeAsync"
    },
    {
      "id": "internal",
      "type": "Exception",
      "grpc_status": "Internal",
      "retryable": false,
      "meaning": "Unhandled server failure.",
      "source": "src/lattice.api.telemetry.grpc/LatticeTelemetryGrpcService.cs#InvokeAsync"
    },
    {
      "id": "invalid-argument",
      "type": "ArgumentException",
      "grpc_status": "InvalidArgument",
      "retryable": false,
      "meaning": "The request is invalid.",
      "source": "src/lattice.api.telemetry.grpc/LatticeTelemetryGrpcService.cs#InvokeAsync"
    },
    {
      "id": "not-found",
      "type": "TelemetryQueryNotFoundException",
      "grpc_status": "NotFound",
      "retryable": false,
      "meaning": "Unknown, unoffered, or unavailable query id; these cases are indistinguishable.",
      "source": "src/lattice.api.telemetry.grpc/LatticeTelemetryGrpcService.cs#InvokeAsync"
    },
    {
      "id": "out-of-range",
      "type": "TelemetryQueryBoundsException",
      "grpc_status": "OutOfRange",
      "retryable": false,
      "meaning": "The requested telemetry window violates declared bounds or host guardrails.",
      "source": "src/lattice.api.telemetry.grpc/LatticeTelemetryGrpcService.cs#InvokeAsync"
    },
    {
      "id": "permission-denied",
      "type": "LatticeAuthorizationDeniedException or LatticeTenantAccessDeniedException",
      "grpc_status": "PermissionDenied",
      "retryable": false,
      "meaning": "The caller is not authorized or cannot act as the asserted tenant.",
      "source": "src/lattice.api.telemetry.grpc/LatticeTelemetryGrpcService.cs#InvokeAsync"
    },
    {
      "id": "unavailable",
      "type": "TelemetryBackendException",
      "grpc_status": "Unavailable",
      "retryable": true,
      "meaning": "The metrics backend failed rather than the request.",
      "source": "src/lattice.api.telemetry.grpc/LatticeTelemetryGrpcService.cs#InvokeAsync"
    }
  ]
}
