  "operations": [
    {
      "id": "describe",
      "in_process": "ILatticeAppsControl.DescribeAsync",
      "grpc_method": "/orleans.lattice.api.apps/Describe",
      "transport_scope": "both",
      "request": "AppsDescribeRequest",
      "response": "AppsDescribeResponse",
      "errors": [
        {
          "error_id": "invalid-argument",
          "condition": "The app slug or optional version is malformed."
        },
        {
          "error_id": "permission-denied",
          "condition": "The gRPC transport authorizer denies the call, the facade AppInstall access-gate check fails, or active-tenant resolution is denied."
        },
        {
          "error_id": "failed-precondition",
          "condition": "The app source returns an unusable manifest result rather than a not-found or version-mismatch absence."
        }
      ],
      "retry": {
        "safe": true,
        "policy": "Read-only manifest and install-state inspection; unknown app slugs or versions return null through the response wrapper.",
        "source": "src/lattice.api.abstractions/Apps/ILatticeAppsControl.cs#DescribeAsync"
      },
      "idempotency": {
        "idempotent": true,
        "basis": "Reads source metadata and matching registry state without mutation; app code is not loaded.",
        "source": "src/lattice.api.abstractions/Apps/ILatticeAppsControl.cs#DescribeAsync"
      },
      "concurrency": {
        "rule": "The facade authorizes AppInstall before registry or source reads; responses use app-local tree names and matching install state only.",
        "source": "src/lattice.api.apps/LatticeAppsControl.Reads.cs#DescribeAsync"
      },
      "sources": [
        "src/lattice.api.abstractions/Apps/ILatticeAppsControl.cs#DescribeAsync",
        "src/lattice.api.apps/LatticeAppsControl.Reads.cs#DescribeAsync",
        "src/lattice.api.apps.grpc/LatticeAppsGrpcMethods.cs#Describe",
        "src/lattice.api.apps.grpc/LatticeAppsGrpcService.cs#Describe"
      ]
    },
    {
      "id": "disable",
      "in_process": "ILatticeAppsControl.DisableAsync",
      "grpc_method": "/orleans.lattice.api.apps/Disable",
      "transport_scope": "both",
      "request": "AppsSlugRequest",
      "response": "AppLifecycleResult",
      "errors": [
        {
          "error_id": "invalid-argument",
          "condition": "The app slug is malformed."
        },
        {
          "error_id": "permission-denied",
          "condition": "The gRPC transport authorizer denies the call, the facade AppInstall access-gate check fails, or active-tenant resolution is denied."
        },
        {
          "error_id": "not-found",
          "condition": "The app is not installed for the caller's tenant."
        },
        {
          "error_id": "failed-precondition",
          "condition": "The app is installed but not enabled, or the activation pipeline reports a failed disable."
        }
      ],
      "retry": {
        "safe": {
          "status": "uncertain",
          "reason": "The source states the lifecycle or consent transition semantics but does not state whether retrying after an ambiguous transport or process failure is safe without first reading current state.",
          "required_source": "src/lattice.api.abstractions/Apps/ILatticeAppsControl.cs#ILatticeAppsControl",
          "issue": 3635
        },
        "policy": "After an ambiguous failure, read Describe or List before retrying so a completed disable is not mistaken for a fresh failure.",
        "source": "src/lattice.apps/Registry/AppLifecycle.cs#Evaluate"
      },
      "idempotency": {
        "idempotent": true,
        "basis": "Disabling an already disabled app is an idempotent no-op; disabling any other non-enabled live state is rejected.",
        "source": "src/lattice.apps/Registry/AppLifecycle.cs#Evaluate"
      },
      "concurrency": {
        "rule": "Activation runs for one tenant's app are serialized cluster-wide, and the facade authorizes AppInstall before invoking the pipeline.",
        "source": "src/lattice.apps/Activation/IAppActivationPipeline.cs#IAppActivationPipeline"
      },
      "sources": [
        "src/lattice.api.abstractions/Apps/ILatticeAppsControl.cs#DisableAsync",
        "src/lattice.api.apps/LatticeAppsControl.cs#DisableAsync",
        "src/lattice.api.apps.grpc/LatticeAppsGrpcMethods.cs#Disable",
        "src/lattice.api.apps.grpc/LatticeAppsGrpcService.cs#Disable"
      ]
    },
    {
      "id": "enable",
      "in_process": "ILatticeAppsControl.EnableAsync",
      "grpc_method": "/orleans.lattice.api.apps/Enable",
      "transport_scope": "both",
      "request": "AppsSlugRequest",
      "response": "AppLifecycleResult",
      "errors": [
        {
          "error_id": "invalid-argument",
          "condition": "The app slug is malformed."
        },
        {
          "error_id": "permission-denied",
          "condition": "The gRPC transport authorizer denies the call, the facade AppInstall access-gate check fails, or active-tenant resolution is denied."
        },
        {
          "error_id": "not-found",
          "condition": "The app is not installed for the caller's tenant."
        },
        {
          "error_id": "failed-precondition",
          "condition": "The app ceiling is not pinned to the installed version, the manifest exceeds consent, prerequisites are missing, or activation otherwise fails."
        }
      ],
      "retry": {
        "safe": {
