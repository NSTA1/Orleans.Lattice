      "grpc_method": "/orleans.lattice.api.schema/ClearPolicy",
      "transport_scope": "both",
      "request": "SchemaTreeRequest",
      "response": "SchemaRemovedResponse",
      "errors": [
        {
          "error_id": "invalid-argument",
