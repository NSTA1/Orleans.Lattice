  "operations": [
    {
      "id": "advance-and-migrate",
      "in_process": "ILatticeSchemaControl.AdvanceAndMigrateAsync",
      "grpc_method": "/orleans.lattice.api.schema/AdvanceAndMigrate",
      "transport_scope": "both",
      "request": "AdvanceVersionRequest",
      "response": "SchemaRemediationReportResponse",
      "errors": [
        {
          "error_id": "invalid-argument",
          "condition": "TreeId is invalid."
        },
        {
          "error_id": "permission-denied",
          "condition": "Caller is not authorized."
        },
        {
          "error_id": "failed-precondition",
          "condition": "The tree is unversioned, the target does not advance, or versioning is not registered."
        }
      ],
      "retry": {
        "safe": false,
        "policy": "Do not retry blindly after success because the target version must strictly advance.",
        "source": "src/lattice.schema/ILatticeSchemaVersionAdmin.cs#AdvanceAndMigrateAsync"
      },
      "idempotency": {
        "idempotent": false,
        "basis": "The operation first advances a monotonic target version; repeating the same target no longer advances.",
        "source": "src/lattice.schema/ILatticeSchemaVersionAdmin.cs#AdvanceAndMigrateAsync"
      },
      "concurrency": {
        "rule": "Target version must be strictly greater than the current target; eager migration aborts without data cutover on the first value that cannot be upcast.",
        "source": "src/lattice.schema/ILatticeSchemaVersionAdmin.cs#AdvanceAndMigrateAsync"
      },
      "sources": [
        "src/lattice.api.abstractions/Schema/ILatticeSchemaControl.cs#AdvanceAndMigrateAsync",
        "src/lattice.api.schema.grpc/LatticeSchemaGrpcMethods.cs#AdvanceAndMigrateMethodName",
        "src/lattice.api.schema.grpc/LatticeSchemaGrpcService.cs#AdvanceAndMigrate"
      ]
    },
    {
      "id": "advance-target-version",
      "in_process": "ILatticeSchemaControl.AdvanceTargetVersionAsync",
      "grpc_method": "/orleans.lattice.api.schema/AdvanceTargetVersion",
      "transport_scope": "both",
      "request": "AdvanceVersionRequest",
      "response": "VersionConfigResponse",
      "errors": [
        {
          "error_id": "invalid-argument",
          "condition": "TreeId is invalid."
        },
        {
          "error_id": "permission-denied",
          "condition": "Caller is not authorized."
        },
        {
          "error_id": "failed-precondition",
          "condition": "The tree is unversioned, the target does not advance, or versioning is not registered."
        }
      ],
      "retry": {
        "safe": false,
        "policy": "Do not retry blindly after success because the target version must strictly advance.",
        "source": "src/lattice.schema/ILatticeSchemaVersionAdmin.cs#AdvanceTargetVersionAsync"
      },
      "idempotency": {
        "idempotent": false,
        "basis": "The target is monotonic and the new version must be strictly greater than the current target.",
        "source": "src/lattice.schema/ILatticeSchemaVersionAdmin.cs#AdvanceTargetVersionAsync"
      },
      "concurrency": {
        "rule": "New writes are stamped at the new version immediately; existing values are upcast lazily on read.",
        "source": "src/lattice.schema/ILatticeSchemaVersionAdmin.cs#AdvanceTargetVersionAsync"
      },
      "sources": [
        "src/lattice.api.abstractions/Schema/ILatticeSchemaControl.cs#AdvanceTargetVersionAsync",
        "src/lattice.api.schema.grpc/LatticeSchemaGrpcMethods.cs#AdvanceTargetVersionMethodName",
        "src/lattice.api.schema.grpc/LatticeSchemaGrpcService.cs#AdvanceTargetVersion"
      ]
    },
    {
      "id": "clear-policy",
