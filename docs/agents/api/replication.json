      "id": "disable-replication",
      "in_process": "ILatticeReplicationControl.DisableReplicationAsync",
      "grpc_method": "/orleans.lattice.api.replication/DisableReplication",
      "transport_scope": "both",
      "request": "ReplicationDisableRequestMessage",
      "response": "ReplicationDisableResponse",
      "errors": [
        {
          "error_id": "invalid-argument",
          "condition": "TreeId is null or empty."
        },
        {
          "error_id": "permission-denied",
          "condition": "Caller is not authorized."
        },
        {
          "error_id": "failed-precondition",
          "condition": "A real disable would be authored but no local replica id is configured."
        }
      ],
      "retry": {
        "safe": true,
        "policy": "Idempotent; absent or already disabled trees author no new dot and report AlreadyDisabled=true.",
        "source": "src/lattice.replication/ILatticeReplicationConfigAuthority.cs#DisableReplicationAsync"
      },
      "idempotency": {
        "idempotent": true,
        "basis": "Disabling a tree that is absent or already disabled authors no new dot.",
        "source": "src/lattice.replication/ILatticeReplicationConfigAuthority.cs#DisableReplicationAsync"
      },
      "concurrency": {
        "rule": "Disable authors a disable-wins flag dot and does not tear down already-active shippers or purge peer data.",
        "source": "src/lattice.replication/ILatticeReplicationConfigAuthority.cs#DisableReplicationAsync"
      },
