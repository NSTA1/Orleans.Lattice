{
  "schema": "lattice.agents/governance-audit-events/v1",
  "audit_records": [
    {
      "id": "auth-allowed-log",
      "type": "ILogger event 2",
      "fields": [
        "subject_id",
        "operation",
        "tree_id",
        "key",
        "matched_rule_id",
        "policy_epoch"
      ],
      "emitting_component": "LoggerLatticeAuthAuditSink",
      "source": "src/lattice.auth/LoggerLatticeAuthAuditSink.cs"
    },
    {
      "id": "auth-audit-sink-failure-log",
      "type": "ILogger event 3",
      "fields": [
        "sink_type"
      ],
      "emitting_component": "LatticeAuthDecisionObserver",
      "source": "src/lattice.auth/LatticeAuthDecisionObserver.cs"
    },
    {
      "id": "auth-decision-event",
      "type": "LatticeAuthDecisionEvent",
      "fields": [
        "subject_id",
        "operation",
        "tree_id",
        "effect",
        "policy_epoch",
        "timestamp_utc",
        "key",
        "range_start",
        "range_end",
        "matched_rule_id",
        "matched_scope_kind",
        "matched_scope_value",
        "reason"
      ],
      "emitting_component": "PolicyAccessGate through LatticeAuthDecisionObserver",
      "sinks": [
        "DurableAuthAuditTrailSink",
        "LoggerLatticeAuthAuditSink"
      ],
      "source": "src/lattice.auth/LatticeAuthDecisionEvent.cs"
    },
    {
      "id": "auth-denied-log",
      "type": "ILogger event 1",
      "fields": [
        "subject_id",
        "operation",
        "tree_id",
        "key",
        "matched_rule_id",
        "policy_epoch",
        "reason"
      ],
      "emitting_component": "LoggerLatticeAuthAuditSink",
      "source": "src/lattice.auth/LoggerLatticeAuthAuditSink.cs"
    },
    {
      "id": "auth-posture-log",
      "type": "ILogger information",
      "fields": [
        "default_effect",
        "all_trees_grants_enabled",
        "access_administration_delegation_enabled"
      ],
      "emitting_component": "AuthPostureLogger",
      "source": "src/lattice.auth/AuthPostureLogger.cs"
    },
    {
      "id": "compiled-auth-snapshot-warning",
      "type": "ILogger warning",
      "fields": [
        "exception"
      ],
      "emitting_component": "CompiledPolicySnapshotMaintainer",
      "source": "src/lattice.auth/CompiledPolicySnapshotMaintainer.cs"
    },
    {
      "id": "grpc-auth-interceptor-rejection-log",
      "type": "ILogger warning",
      "fields": [
        "method"
      ],
      "emitting_component": "LatticeAuthApiGrpcAuthInterceptor",
      "source": "src/lattice.api.auth.grpc/Security/LatticeAuthApiGrpcAuthInterceptor.cs"
    },
    {
      "id": "grpc-tenantadmin-interceptor-rejection-log",
      "type": "ILogger warning",
      "fields": [
        "method"
      ],
      "emitting_component": "LatticeTenantAdminApiGrpcAuthInterceptor",
      "source": "src/lattice.api.tenantadmin.grpc/Security/LatticeTenantAdminApiGrpcAuthInterceptor.cs"
    },
    {
      "id": "tenant-placement-snapshot-warning",
      "type": "ILogger warning",
      "fields": [
        "exception"
      ],
      "emitting_component": "TenantPlacementSnapshotMaintainer",
      "source": "src/lattice.tenancy/TenantPlacementSnapshotMaintainer.cs"
    },
    {
      "id": "tenant-policy-snapshot-warning",
      "type": "ILogger warning",
      "fields": [
        "exception"
      ],
      "emitting_component": "CompiledTenantPolicySnapshotMaintainer",
      "source": "src/lattice.tenancy/CompiledTenantPolicySnapshotMaintainer.cs"
    },
    {
      "id": "tenant-residency-snapshot-warning",
      "type": "ILogger warning",
      "fields": [
        "exception"
      ],
      "emitting_component": "TenantResidencySnapshotMaintainer",
      "source": "src/lattice.tenancy/TenantResidencySnapshotMaintainer.cs"
    },
    {
      "id": "tenant-usage-index-warning",
      "type": "ILogger warning",
      "fields": [
        "exception"
      ],
      "emitting_component": "TenantUsageIndexMaintainer",
      "source": "src/lattice.tenancy/TenantUsageIndexMaintainer.cs"
    }
  ],
  "metrics": [
    {
      "id": "auth-decision-duration",
      "name": "orleans.lattice.auth.decision.duration",
      "instrument": "Histogram<double>",
      "tags": [
        "operation",
        "tree",
        "tenant",
        "effect"
      ],
      "source": "src/lattice.auth/LatticeAuthMetrics.cs"
    },
    {
      "id": "auth-decisions",
      "name": "orleans.lattice.auth.decisions",
      "instrument": "Counter<long>",
      "tags": [
        "operation",
