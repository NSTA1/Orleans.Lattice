  ],
  "audit_controls": [
    {
      "id": "auth-audit-sampling",
      "field": "LatticeAuthOptions.AuditSamplingRatio",
      "default": 1.0,
      "source": "src/lattice.auth/LatticeAuthOptions.cs"
    },
    {
      "id": "auth-audit-switch",
      "field": "LatticeAuthOptions.EnableAuditSink",
      "default": false,
      "source": "src/lattice.auth/LatticeAuthOptions.cs"
    },
    {
      "id": "auth-audit-verbosity",
      "field": "LatticeAuthOptions.AuditVerbosity",
      "default": "DenyOnly",
      "source": "src/lattice.auth/LatticeAuthOptions.cs"
    },
    {
      "id": "auth-durable-trail",
      "field": "LatticeAuthOptions.EnableDurableAuditTrail",
      "default": false,
      "source": "src/lattice.auth/LatticeAuthOptions.cs"
    }
  ],
