{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nsta1.github.io/Orleans.Lattice/docs/agents/schemas/invariants.schema.json",
  "schema": "lattice.agents/json-schema/v1",
  "title": "Orleans.Lattice operational invariants",
  "description": "Operational invariants: scope, the ways each can be violated, the signals that detect a violation, and remediation steps.",
  "type": "object",
  "required": [
    "schema",
    "invariants"
  ],
  "properties": {
    "schema": {
      "const": "lattice.agents/invariants/v1"
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "scope",
          "violation_modes",
          "detection_signals",
          "remediation",
          "sources"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "object",
            "required": [
              "packages",
              "components"
            ],
            "properties": {
              "packages": {
                "$ref": "#/$defs/packages"
              },
              "components": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          "violation_modes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "detection_signals": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "name",
                "source"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "exception",
                    "health",
                    "log",
                    "metric",
                    "source",
                    "status",
                    "status-field",
                    "test"
                  ]
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "$ref": "#/$defs/source"
                }
              },
              "additionalProperties": false
            }
          },
          "remediation": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "step",
                "source"
              ],
              "properties": {
                "step": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "$ref": "#/$defs/source"
                }
              },
              "additionalProperties": false
            }
          },
          "sources": {
            "$ref": "#/$defs/sources"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "claim": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "statement",
            "source"
          ],
          "properties": {
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "$ref": "#/$defs/source"
            }
          },
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/uncertain"
        }
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "package": {
      "type": "string",
      "pattern": "^Orleans\\.Lattice(\\.[A-Z][A-Za-z0-9]*)*$"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^Orleans\\.Lattice(\\.[A-Z][A-Za-z0-9]*)*$"
      }
    },
    "source": {
      "type": "string",
      "pattern": "^((src|docs|test|samples|spec|tools|benchmark|reference-architecture|\\.github)/[A-Za-z0-9_./\\-]+|FEATURES\\.md|PACKAGES\\.md|README\\.md|reference-architecture\\.md)(#[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*)?$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^((src|docs|test|samples|spec|tools|benchmark|reference-architecture|\\.github)/[A-Za-z0-9_./\\-]+|FEATURES\\.md|PACKAGES\\.md|README\\.md|reference-architecture\\.md)(#[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*)?$"
      }
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "uncertain": {
      "type": "object",
      "required": [
        "status",
        "reason",
        "required_source"
      ],
      "properties": {
        "status": {
          "const": "uncertain"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "required_source": {
          "type": "string",
          "minLength": 1
        },
        "issue": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
