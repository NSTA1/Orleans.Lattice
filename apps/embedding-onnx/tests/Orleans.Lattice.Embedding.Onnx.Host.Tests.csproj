<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>Orleans.Lattice.Embedding.Onnx.Host.Tests</AssemblyName>
    <RootNamespace>Orleans.Lattice.Embedding.Onnx.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orleans.Lattice.Embedding.Onnx.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The golden HuggingFace token fixture and the WordPiece vocabulary. Both
         are small, committed, and model-free, so the tokenizer-parity gate runs
         in CI without downloading the half-gigabyte ONNX weights. -->
    <None Include="Fixtures\tokenizer-golden.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\assets\vocab.txt.gz" Link="Fixtures\vocab.txt.gz" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
