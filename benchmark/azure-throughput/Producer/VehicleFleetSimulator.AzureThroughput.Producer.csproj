<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>VehicleFleetSimulator.AzureThroughput.Producer</RootNamespace>
    <AssemblyName>VehicleFleetSimulator.AzureThroughput.Producer</AssemblyName>
    <!--
      Azure throughput benchmark harness (real Azure Storage). Built
      directly via `dotnet publish` from the Dockerfile.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Lattice.Benchmark.Microbench.Tests" />
    <ProjectReference Include="..\Engine\VehicleFleetSimulator.AzureThroughput.Engine.csproj" />
    <ProjectReference Include="..\..\..\src\lattice\Orleans.Lattice.csproj" />
    <ProjectReference Include="..\..\..\samples\VehicleFleetSimulator\src\VehicleFleetSimulator.Abstractions\VehicleFleetSimulator.Abstractions.csproj" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Orleans.Client" Version="10.2.2" />
    <PackageReference Include="Microsoft.Orleans.Clustering.AzureStorage" Version="10.2.2" />
    <!--
      Not used directly. Silo-side grain-storage faults propagate to this
      Orleans client as provider exception types defined in this package
      (observed: TableStorageUpdateConditionNotSatisfiedException, an ETag
      conflict during preseed); without it the client cannot deserialise them,
      fails with an opaque TypeLoadException and can crash outright.
    -->
    <PackageReference Include="Microsoft.Orleans.Persistence.AzureStorage" Version="10.2.2" />
  </ItemGroup>

</Project>
