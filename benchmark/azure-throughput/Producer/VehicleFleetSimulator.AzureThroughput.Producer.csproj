<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>VehicleFleetSimulator.AzureThroughput.Producer</RootNamespace>
    <AssemblyName>VehicleFleetSimulator.AzureThroughput.Producer</AssemblyName>
