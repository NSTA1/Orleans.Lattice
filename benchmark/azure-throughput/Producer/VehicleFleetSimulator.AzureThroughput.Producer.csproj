  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\samples\VehicleFleetSimulator\src\VehicleFleetSimulator.Abstractions\VehicleFleetSimulator.Abstractions.csproj" />
  </ItemGroup>

</Project>
