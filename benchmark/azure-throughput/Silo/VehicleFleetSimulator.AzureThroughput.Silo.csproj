<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>VehicleFleetSimulator.AzureThroughput.Silo</RootNamespace>
    <AssemblyName>VehicleFleetSimulator.AzureThroughput.Silo</AssemblyName>
    <!--
      Azure throughput benchmark harness (real Azure Storage). Built
      directly via `dotnet publish` from the Dockerfile.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\lattice\Orleans.Lattice.csproj" />
    <ProjectReference Include="..\..\..\src\lattice.storage.azuretable\Orleans.Lattice.Storage.AzureTable.csproj" />
    <ProjectReference Include="..\..\..\samples\VehicleFleetSimulator\src\VehicleFleetSimulator.Abstractions\VehicleFleetSimulator.Abstractions.csproj" />
    <PackageReference Include="Microsoft.Orleans.Server" Version="10.2.2" />
    <PackageReference Include="Microsoft.Orleans.Persistence.AzureStorage" Version="10.2.2" />
    <!--
      Bumped from 1.13.1 to satisfy the Microsoft.Diagnostics.Runtime 4.0
      transitive floor (>= 1.21.0); the diagnostics package is referenced
      below by the StallWatchdog.
    -->
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <!--
      In-process stall watchdog (StallWatchdog.cs): when the WAL write
      pipeline wedges at WalMaxPendingBatches the only ACI exfil channel
      is stdout (the deploy script streams it to .run/silo-*.log), so the
      watchdog self-snapshots with ClrMD and prints the parked async
      state-machine chain - the in-process equivalent of `dumpasync` /
      `dotnet-stack` - rather than writing a core dump we have no mount to
      retrieve.
    -->
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="4.0.726401" />
  </ItemGroup>

  <!--
    Expose internal types (StallWatchdog, TcpIngestService, ...) to the
    sibling test project so the test project can construct them
    directly. The silo is an Exe, not a published library, so the
    InternalsVisibleTo grant cannot accidentally leak into a downstream
    consumer's surface.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="VehicleFleetSimulator.AzureThroughput.Silo.Tests" />
  </ItemGroup>

</Project>
