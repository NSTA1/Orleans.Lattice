<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Orleans.Lattice.Benchmark.Microbench</RootNamespace>
    <AssemblyName>Orleans.Lattice.Benchmark.Microbench</AssemblyName>
    <!-- Workstation, non-concurrent GC is required for accurate BenchmarkDotNet
         MemoryDiagnoser results. Under Server GC each logical core gets its own
         heap with a large per-thread allocation context, and the concurrent
         (background) GC thread runs asynchronously to the measured operation.
         Together these make the per-operation allocated-bytes delta that
         MemoryDiagnoser computes (workload minus overhead) non-deterministic for
         the cheapest paths: on a busy multi-core Linux host the point-read family
         (~200-300 B/op) stochastically floored to a reported 0 B, while the same
         code measured a correct non-zero figure on a quieter host or run. A
         single-heap, blocking GC removes the background-thread contamination and
         the chunked allocation-context masking, so allocation is measured
         deterministically and reproducibly. This is the BDN-recommended config
         for per-operation microbenchmarks and only affects this measurement
         host - it does not change what the Orleans.Lattice library ships with. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
    <!-- BenchmarkDotNet 0.15.x pins Microsoft.CodeAnalysis.Common to 4.14.0 for its
         in-process Roslyn emit toolchain, while the surrounding solution uses 5.0.0.
         The two versions co-exist at runtime in this project's bin/ because nothing
         else here pulls 5.0.0; the warning is a transitive-resolution false positive. -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
    <!-- Selects the shipped nudge-only arm of ReplicationCommitObserverBenchmarks.
         Undefined on the legacy `main` checkout, which compiles the WalRecord /
         LocalVectorClockCache arm instead, so the identical harness measures
         both sides of the #942 change. -->
    <DefineConstants>$(DefineConstants);REPLOG_NUDGE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Targets the leaf-grain primitive directly via InternalsVisibleTo. No
         Orleans silo, no shard routing, no grain dispatch - pure algorithmic
         cost. Orleans-native end-to-end cost is measured by current-state-no-replication+ instead. -->
    <ProjectReference Include="..\..\..\src\lattice\Orleans.Lattice.csproj" />
    <!-- The Azure-Table WAL provider is referenced directly so the bench host
         can drive AzureTableWalStorageProvider.EncodeEntriesForBatch in-process,
         isolating the per-entry encode allocation pattern from the live
         Azure SDK transaction surface. Pulled in via InternalsVisibleTo on
         the provider csproj so the helper is reachable without exposing it
         on the public API. -->
    <ProjectReference Include="..\..\..\src\lattice.storage.azuretable\Orleans.Lattice.Storage.AzureTable.csproj" />
    <!-- The replication package is referenced so the bench host can drive
         the typed-envelope encode (OrleansBinaryReplicationBatchEncoder.Encode)
         and the framing-only encode (IReplicationBatchEncoder.EncodeFraming)
         side-by-side. Used by the Ship_TypedEnvelope vs Ship_FramingOnly pair
         to surface the per-batch allocation drop introduced by R-114 stages 3-4b
         on the shipper -> gRPC marshaller leg of the composite ship path. -->
    <ProjectReference Include="..\..\..\src\lattice.replication\Orleans.Lattice.Replication.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- BenchmarkDotNet pins Microsoft.CodeAnalysis.* to 4.14.0; Orleans 10.1
         transitively requires >= 5.0.0. A direct reference to 5.0.0 satisfies
         the Orleans floor without changing what BDN's in-process emit toolchain
         actually loads at run time. -->
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.0.0" />
    <!-- NSubstitute drives IGrainContext / IGrainFactory / IOptionsMonitor mocks
         in the same shape as the unit-test fakes under test/lattice/Fakes/. -->
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.9" />
    <!-- EventPipe-driven per-method allocation and CPU-sample profiler. The
         NETCore.Client package opens an in-process EventPipe session against
         the current PID; TraceEvent parses the streaming .nettrace event
         blob and symbolicates managed-method stack frames. Together they
         power the BenchmarkProfiler harness under Profiling/, which surfaces
         per-method allocation and sample distributions as profile.json next
         to the run's results.json. Disabled by default - opt in via
         BENCH_MICROBENCH_PROFILE=alloc|cpu|both. -->
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.661903" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned microbench baseline consumed by RegressionGate when BENCH_BASELINE_PATH
         is unset. CopyToOutputDirectory ensures the file is copied next to the
         assembly so `dotnet run` invocations find it without the caller having to
         point at the source-tree path. -->
    <None Update="baseline-v3.4.0.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
