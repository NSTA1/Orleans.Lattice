{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Orleans": "Warning"
    }
  },
  "Orleans": {
    "ClusterId": "vfs-bench",
    "ServiceId": "VehicleFleetSimulator"
  },
  "Persistence": {
    "ConnectionString": "UseDevelopmentStorage=true"
  },
  "Telemetry": {
    "Sink": "fanout",
    "Prometheus": {
      "Port": 9090
    }
  },
  "LatticeSink": {
    "TreeId": "vehicle-fleet",
    "KeyShape": "CurrentStateByVehicleId",
    "BatchSize": 256,
    "FlushInterval": "00:00:00.050",
    "ChannelCapacity": 100000,
    "EventLogTtl": "01:00:00",
    "Regions": "eu-west,eu-east,us-west,us-east",
    "HotRegionShare": 0.7,
    "DropOnFull": true,
    "ShutdownDrainTimeout": "00:00:30"
  },
  "Replication": {
    "Enabled": false,
    "OriginClusterId": "vfs-bench",
    "KeyPrefixes": ""
  },
  "Simulation": {
    "TickIntervalSeconds": 1,
    "DefaultRefuelDelaySeconds": 30
  },
  "Cities": {
    "Cities": [
      { "Id": "LON", "Name": "London" },
      { "Id": "PAR", "Name": "Paris" },
      { "Id": "BRU", "Name": "Brussels" },
      { "Id": "AMS", "Name": "Amsterdam" },
      { "Id": "BER", "Name": "Berlin" },
      { "Id": "PRG", "Name": "Prague" },
      { "Id": "VIE", "Name": "Vienna" },
      { "Id": "MUN", "Name": "Munich" },
      { "Id": "ZRH", "Name": "Zurich" },
      { "Id": "MAD", "Name": "Madrid" }
    ],
    "Edges": [
      { "From": "LON", "To": "PAR", "DistanceKm": 460 },
      { "From": "LON", "To": "BRU", "DistanceKm": 320 },
      { "From": "LON", "To": "AMS", "DistanceKm": 360 },
      { "From": "PAR", "To": "BRU", "DistanceKm": 310 },
      { "From": "PAR", "To": "MAD", "DistanceKm": 1100 },
      { "From": "PAR", "To": "ZRH", "DistanceKm": 490 },
      { "From": "BRU", "To": "AMS", "DistanceKm": 175 },
      { "From": "AMS", "To": "BER", "DistanceKm": 650 },
      { "From": "BER", "To": "PRG", "DistanceKm": 350 },
      { "From": "BER", "To": "MUN", "DistanceKm": 585 },
      { "From": "PRG", "To": "VIE", "DistanceKm": 330 },
      { "From": "VIE", "To": "MUN", "DistanceKm": 435 },
      { "From": "MUN", "To": "ZRH", "DistanceKm": 310 }
    ]
  },
  "AllowedHosts": "*"
}
