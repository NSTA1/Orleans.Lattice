# B-09 — Per-key replication filter cost.
# Re-runs B-04 with a non-trivial per-key prefix filter on the producer side. Only
# keys beginning with one of BENCH_REPLICATION_KEY_PREFIXES are shipped, so the
# observer evaluates the filter inline before recording the WAL append. Measures
# the steady-state cost of the filter on the hot write path.
BENCH_DESCRIPTION="Per-key replication filter cost"
BENCH_TELEMETRY_SINK=lattice
BENCH_KEY_SHAPE=CurrentStateByVehicleId
BENCH_REPLICATION_ENABLED=true
BENCH_REPLICATION_OVERLAY=true
BENCH_REPLICA_TELEMETRY_SINK=null
BENCH_REPLICA_REPLICATION_ENABLED=true
# Match the leading hex character of vehicle ids (the LatticeSink uses Guid.ToString("N")
# which produces lowercase hex). Keeps roughly half the writes in scope of replication
# so the filter does meaningful work without trivializing the comparison vs. B-04.
BENCH_REPLICATION_KEY_PREFIXES="0,1,2,3,4,5,6,7"
BENCH_FLEET_SIZE=2000
BENCH_WARMUP_SECONDS=30
BENCH_DURATION_SECONDS=300
