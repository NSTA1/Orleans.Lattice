# current-state-single-peer — Current-state tree, replication on, single peer.
# Same wiring as current-state-no-replication with Orleans.Lattice.Replication enabled
# and one downstream cluster. Tracks IMutationObserver overhead, WAL append rate,
# ship-loop throughput, and apply-side latency.
BENCH_DESCRIPTION="Current-state tree, replication on, single peer"
BENCH_TELEMETRY_SINK=lattice
BENCH_KEY_SHAPE=CurrentStateByVehicleId
BENCH_REPLICATION_ENABLED=true
BENCH_REPLICATION_OVERLAY=true
BENCH_REPLICA_TELEMETRY_SINK=null
BENCH_REPLICA_REPLICATION_ENABLED=true
BENCH_FLEET_SIZE=2000
BENCH_WARMUP_SECONDS=15
BENCH_DURATION_SECONDS=120