# B-11 — Streaming bulk-load ingest variant.
# Same key shape as B-10 but the sink batches into BulkLoadAsync instead of point
# writes. Validates that the bulk-load path scales with batch size.
BENCH_DESCRIPTION="Streaming bulk-load ingest"
BENCH_TELEMETRY_SINK=lattice
BENCH_KEY_SHAPE=EventLogTimestamped
BENCH_EVENT_LOG_TTL=01:00:00
BENCH_BULK_LOAD=true
# Larger batch — the bulk-load path amortises per-call cost.
BENCH_BATCH_SIZE=1024
BENCH_FLUSH_INTERVAL=00:00:00.100
BENCH_REPLICATION_ENABLED=false
BENCH_REPLICATION_OVERLAY=false
BENCH_FLEET_SIZE=2000
BENCH_WARMUP_SECONDS=30
BENCH_DURATION_SECONDS=300
