# atomic-write - Atomic-saga driver, single cluster, replication off.
# Drives a steady stream of SetManyAtomicAsync sagas via LatticeAtomicSagaDriver to
# exercise the WAL-only prepare path under sustained load. Closes the F-055 acceptance
# clause "saga-RPS scales linearly with batch concurrency, bounded by per-saga
# AtomicWriteGrain RPS rather than capped at single-grain throughput".
#
# Telemetry__Sink=lattice keeps the simulator's normal LatticeSink active alongside the
# atomic saga driver so the read-side scenario also has a realistic write floor for the
# GetAsync/KeysAsync read-path baseline checks. Set BENCH_TELEMETRY_SINK=null instead if
# you want to isolate the saga path from simulator-driven writes.
BENCH_DESCRIPTION="Atomic-saga driver, single cluster, replication off"
BENCH_TELEMETRY_SINK=lattice
BENCH_KEY_SHAPE=CurrentStateByVehicleId
BENCH_REPLICATION_ENABLED=false
BENCH_REPLICATION_OVERLAY=false
BENCH_FLEET_SIZE=2000
BENCH_WARMUP_SECONDS=15
BENCH_DURATION_SECONDS=30
# Atomic-saga driver wiring. Concurrency=16 spawns 16 persistent worker tasks each
# issuing back-to-back SetManyAtomicAsync calls; each worker uses a per-worker key
# prefix so concurrent sagas don't collide on the same keys (the AtomicWriteGrain
# registry would otherwise abort all but one). RatePerSecond=200 across 16 workers
# yields ~12.5 sagas/s/worker which leaves headroom for measurement; raise to stress
# the per-saga RPS ceiling. BatchSize=16 keys per saga matches the same fan-out the
# microbench items 1+2 measure so the silo-side numbers compare directly.
BENCH_ATOMIC_SAGA_DRIVER_ENABLED=true
BENCH_ATOMIC_SAGA_DRIVER_RATE=200
BENCH_ATOMIC_SAGA_DRIVER_CONCURRENCY=16
BENCH_ATOMIC_SAGA_DRIVER_BATCH_SIZE=16
BENCH_ATOMIC_SAGA_DRIVER_KEYSPACE=4000
BENCH_ATOMIC_SAGA_DRIVER_KEY_PREFIX=atomic-
BENCH_ATOMIC_SAGA_DRIVER_VALUE_BYTES=256
BENCH_ATOMIC_SAGA_DRIVER_WARMUP=00:00:15
