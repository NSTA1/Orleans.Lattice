# replication-backpressure — Replication backpressure and catch-up.
# Builds on current-state-single-peer. Pauses the receiving cluster for a controlled
# interval while the simulator continues writing; benchmark.ps1 issues
# `docker compose pause silo-replica` at BENCH_CHAOS_AFTER_SECONDS and `unpause` at
# BENCH_CHAOS_AFTER_SECONDS+BENCH_CHAOS_DURATION_SECONDS.
BENCH_DESCRIPTION="Replication backpressure and catch-up"
BENCH_TELEMETRY_SINK=lattice
BENCH_KEY_SHAPE=CurrentStateByVehicleId
BENCH_REPLICATION_ENABLED=true
BENCH_REPLICATION_OVERLAY=true
BENCH_REPLICA_TELEMETRY_SINK=null
BENCH_REPLICA_REPLICATION_ENABLED=true
BENCH_FLEET_SIZE=2000
BENCH_WARMUP_SECONDS=15
BENCH_DURATION_SECONDS=30
BENCH_CHAOS=pause
BENCH_CHAOS_TARGET=silo-replica
BENCH_CHAOS_AFTER_SECONDS=60
BENCH_CHAOS_DURATION_SECONDS=30
# Replication gRPC peer wiring — push to silo-replica:5001 (the receiver). Reverse
# direction unset, so the replica registers no outbound peer (no-op transport).
BENCH_ORIGIN_PEER_ENDPOINT=http://silo-replica:5001
