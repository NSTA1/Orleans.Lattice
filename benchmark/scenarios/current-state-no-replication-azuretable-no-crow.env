# current-state-no-replication-azuretable-no-crow - Current-state tree, replication off, durable WAL with phase-0 C-row elided.
# Mirror of current-state-no-replication-azuretable.env with AzureTableWalStorageOptions.EliminateCandidateRowOnHotPath = true.
# Candidate cohort for perf/wal-elide-phase0-candidate-row: AppendBatchAsync skips the per-batch
# candidate-row upsert on the shared manifest partition; reconciliation falls back to a
# batch-partition discovery scan above TAIL at activation time. Quantifies the steady-state
# throughput delta from removing the contended phase-0 round-trip from the hot path.
BENCH_DESCRIPTION="Current-state tree, replication off, Azure Table WAL (no phase-0 C-row)"
BENCH_TELEMETRY_SINK=lattice
BENCH_KEY_SHAPE=CurrentStateByVehicleId
BENCH_REPLICATION_ENABLED=false
BENCH_REPLICATION_OVERLAY=false
BENCH_FLEET_SIZE=2000
BENCH_WARMUP_SECONDS=15
BENCH_DURATION_SECONDS=30
BENCH_WAL_PROVIDER=azuretable
BENCH_WAL_TABLE_NAME=OrleansLatticeWal
BENCH_WAL_ELIMINATE_CANDIDATE_ROW=true
