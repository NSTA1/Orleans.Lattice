# current-state-no-replication-azuretable - Current-state tree, replication off, durable WAL.
# Mirror of current-state-no-replication.env with the WAL routed to Azure Tables (Azurite).
# Quantifies the per-commit cost of routing every WAL append through a single
# `TableClient.SubmitTransactionAsync` versus the in-memory baseline.
BENCH_DESCRIPTION="Current-state tree, replication off, Azure Table WAL"
BENCH_TELEMETRY_SINK=lattice
BENCH_KEY_SHAPE=CurrentStateByVehicleId
BENCH_REPLICATION_ENABLED=false
BENCH_REPLICATION_OVERLAY=false
BENCH_FLEET_SIZE=2000
BENCH_WARMUP_SECONDS=15
BENCH_DURATION_SECONDS=30
BENCH_WAL_PROVIDER=azuretable
BENCH_WAL_TABLE_NAME=OrleansLatticeWal
