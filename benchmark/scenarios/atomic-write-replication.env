# atomic-write-replication — Atomic-saga driver, two-cluster bidirectional replication.
# Both origin and replica clusters run the LatticeAtomicSagaDriver concurrently, each
# with a distinct top-level key prefix (atomic- vs atomic-replica-), so cross-cluster
# atomic-visibility is exercised symmetrically without LWW conflicts swamping the
# saga-throughput measurement. Closes the F-055 acceptance clause for cross-cluster
# universal atomic visibility under sustained replication load.
BENCH_DESCRIPTION="Atomic-saga driver, two-cluster bidirectional replication"
BENCH_TELEMETRY_SINK=lattice
BENCH_KEY_SHAPE=CurrentStateByVehicleId
BENCH_REPLICATION_ENABLED=true
BENCH_REPLICATION_OVERLAY=true
BENCH_REPLICA_TELEMETRY_SINK=lattice
BENCH_REPLICA_REPLICATION_ENABLED=true
BENCH_FLEET_SIZE=2000
BENCH_WARMUP_SECONDS=15
BENCH_DURATION_SECONDS=30
# Replication gRPC peer wiring — both directions. Origin pushes to silo-replica:5001
# AND replica pushes to silo:5001 so atomic-saga writes round-trip both ways.
BENCH_ORIGIN_PEER_ENDPOINT=http://silo-replica:5001
BENCH_REPLICA_PEER_ENDPOINT=http://silo:5001
# Origin-side atomic-saga driver. Same shape as atomic-write.env.
BENCH_ATOMIC_SAGA_DRIVER_ENABLED=true
BENCH_ATOMIC_SAGA_DRIVER_RATE=200
BENCH_ATOMIC_SAGA_DRIVER_CONCURRENCY=16
BENCH_ATOMIC_SAGA_DRIVER_BATCH_SIZE=16
BENCH_ATOMIC_SAGA_DRIVER_KEYSPACE=4000
BENCH_ATOMIC_SAGA_DRIVER_KEY_PREFIX=atomic-
BENCH_ATOMIC_SAGA_DRIVER_VALUE_BYTES=256
BENCH_ATOMIC_SAGA_DRIVER_WARMUP=00:00:15
# Replica-side atomic-saga driver. Distinct top-level prefix keeps cross-cluster
# keysets disjoint so the symmetric load measures saga throughput per cluster
# rather than LWW-conflict resolution.
BENCH_REPLICA_ATOMIC_SAGA_DRIVER_ENABLED=true
BENCH_REPLICA_ATOMIC_SAGA_DRIVER_RATE=200
BENCH_REPLICA_ATOMIC_SAGA_DRIVER_CONCURRENCY=16
BENCH_REPLICA_ATOMIC_SAGA_DRIVER_BATCH_SIZE=16
BENCH_REPLICA_ATOMIC_SAGA_DRIVER_KEYSPACE=4000
BENCH_REPLICA_ATOMIC_SAGA_DRIVER_KEY_PREFIX=atomic-replica-
BENCH_REPLICA_ATOMIC_SAGA_DRIVER_VALUE_BYTES=256
BENCH_REPLICA_ATOMIC_SAGA_DRIVER_WARMUP=00:00:15
