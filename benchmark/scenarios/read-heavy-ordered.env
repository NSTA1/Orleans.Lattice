# read-heavy-ordered — Read-dominant load, sequential key access.
# Same shape as read-heavy-random except the read-driver walks the discovered keyspace in
# sorted order with wrap-around. Exercises the leaf-cache prefetch path (sequential locality)
# vs. the random variant''s working-set churn — the gap between p99 read latency on the two
# scenarios is the cache-line-friendliness signal.
BENCH_DESCRIPTION="Read-heavy, sequential key access (95:5 read:write)"
BENCH_TELEMETRY_SINK=lattice
BENCH_KEY_SHAPE=CurrentStateByVehicleId
BENCH_REPLICATION_ENABLED=false
BENCH_REPLICATION_OVERLAY=false
BENCH_FLEET_SIZE=2000
BENCH_WARMUP_SECONDS=20
BENCH_DURATION_SECONDS=30
BENCH_READ_DRIVER_ENABLED=true
BENCH_READ_RATE_PER_SECOND=38000
BENCH_READ_PATTERN=Sequential
BENCH_READ_CONCURRENCY=128
BENCH_READ_WARMUP=00:00:15