# skewed-key-shard-splits - Skewed-key variant to force adaptive shard splits.
# Re-runs current-state-no-replication with keys prefixed by a deliberately
# oversubscribed bucket (HotRegionShare=0.7 → 70% of vehicles map to a single region)
# so the lattice must split the hot leaf into multiple shards in steady state.
BENCH_DESCRIPTION="Skewed-key variant - adaptive shard splits"
BENCH_TELEMETRY_SINK=lattice
BENCH_KEY_SHAPE=RegionPrefixedVehicleId
BENCH_REGIONS="hot,eu-west,eu-east,us-west,us-east"
BENCH_HOT_SHARE=0.7
BENCH_REPLICATION_ENABLED=false
BENCH_REPLICATION_OVERLAY=false
BENCH_FLEET_SIZE=2000
BENCH_WARMUP_SECONDS=15
BENCH_DURATION_SECONDS=30