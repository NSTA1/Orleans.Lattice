# B-02 — ILattice micro-benchmark.
# This scenario does NOT use the simulator pipeline or any Orleans silo. It is a
# harness-driven BenchmarkDotNet benchmark that exercises ILattice directly through
# hand-instantiated grains with NSubstitute-mocked IGrainFactory seams (point
# reads/writes, BulkLoadAsync, mixed read/write). benchmark.ps1 detects
# BENCH_KIND=microbench and runs benchmark/host/Bench.Microbench/ via
# `dotnet run -c Release` instead of bringing up docker-compose.
BENCH_DESCRIPTION="ILattice micro-benchmark (BenchmarkDotNet, harness-only — no silo)"
BENCH_KIND=microbench

# Fidelity knob:
#   quick — InProcessEmitToolchain + Job.ShortRun (~2 min total). Default.
#   full  — default forking toolchain + Job.Default (~30+ min, gold-standard rigour).
BENCH_MICROBENCH_FIDELITY=quick

# Workload selection (comma-separated method-name globs; empty = all four).
# Method names: PointWrite, PointRead, BulkLoad, Mixed_70R_30W.
BENCH_MICROBENCH_WORKLOADS=

# Workload tuning. The harness reads these in [GlobalSetup] before any [Benchmark] runs.
BENCH_MICROBENCH_KEY_COUNT=10000
BENCH_MICROBENCH_VALUE_BYTES=128
BENCH_MICROBENCH_BULK_BATCH=1000
