# B-02 — ILattice micro-benchmark.
# This scenario does NOT use the simulator pipeline. It is a separate harness-driven
# benchmark that exercises ILattice directly (point reads/writes, BulkLoadAsync,
# range scans, mixed read/write) bypassing VehicleGrain entirely. benchmark.ps1
# detects BENCH_KIND=microbench and runs benchmark/host/Bench.Microbench/ via
# `dotnet run -c Release` instead of bringing up docker-compose.
BENCH_DESCRIPTION="ILattice micro-benchmark (BenchmarkDotNet, in-proc Orleans cluster)"
BENCH_KIND=microbench

# Fidelity knob:
#   quick — InProcessEmitToolchain + Job.ShortRun (~2 min total). Default.
#   full  — default forking toolchain + Job.Default (~30+ min, gold-standard rigour).
BENCH_MICROBENCH_FIDELITY=quick

# Workload selection (comma-separated method-name globs; empty = all five).
# Method names: PointWrite, PointRead, BulkLoad, RangeScan, Mixed_70R_30W.
BENCH_MICROBENCH_WORKLOADS=

# Workload tuning. The harness reads these in [GlobalSetup] before any [Benchmark] runs.
BENCH_MICROBENCH_KEY_COUNT=10000
BENCH_MICROBENCH_VALUE_BYTES=128
BENCH_MICROBENCH_BULK_BATCH=1000
BENCH_MICROBENCH_SCAN_PAGE=256
BENCH_MICROBENCH_SCAN_KEYS=1000
