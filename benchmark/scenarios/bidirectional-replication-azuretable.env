# bidirectional-replication-azuretable - Two-cluster bidirectional replication, durable WAL.
# Mirror of bidirectional-replication.env with the WAL routed to Azure Tables on BOTH silos.
# Each silo writes its WAL to its own dedicated Azurite instance (azurite + azurite-replica),
# so table names do not need to be distinguished. Quantifies the durable-WAL append cost
# under symmetric LWW-conflict load.
BENCH_DESCRIPTION="Two-cluster bidirectional replication, Azure Table WAL"
BENCH_TELEMETRY_SINK=lattice
BENCH_KEY_SHAPE=CurrentStateByVehicleId
BENCH_REPLICATION_ENABLED=true
BENCH_REPLICATION_OVERLAY=true
BENCH_REPLICA_TELEMETRY_SINK=lattice
BENCH_REPLICA_REPLICATION_ENABLED=true
BENCH_FLEET_SIZE=2000
BENCH_WARMUP_SECONDS=15
BENCH_DURATION_SECONDS=30
# Replication gRPC peer wiring - both directions. See bidirectional-replication.env for
# the full rationale.
BENCH_ORIGIN_PEER_ENDPOINT=http://silo-replica:5001
BENCH_REPLICA_PEER_ENDPOINT=http://silo:5001
# In-silo write driver on the replica (see bidirectional-replication.env for rationale).
BENCH_REPLICA_WRITE_DRIVER_ENABLED=true
BENCH_REPLICA_WRITE_DRIVER_RATE=2000
BENCH_REPLICA_WRITE_DRIVER_CONCURRENCY=16
BENCH_REPLICA_WRITE_DRIVER_KEYSPACE=2000
BENCH_REPLICA_WRITE_DRIVER_KEY_PREFIX=replica-
BENCH_REPLICA_WRITE_DRIVER_VALUE_BYTES=256
BENCH_REPLICA_WRITE_DRIVER_WARMUP=00:00:15
# Durable WAL on both silos (each writes to its own Azurite instance).
BENCH_WAL_PROVIDER=azuretable
BENCH_WAL_TABLE_NAME=OrleansLatticeWal
