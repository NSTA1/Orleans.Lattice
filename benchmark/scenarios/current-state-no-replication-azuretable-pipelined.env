# current-state-no-replication-azuretable-pipelined - Current-state tree, replication off, durable WAL with pipelined phase-2.
# Mirror of current-state-no-replication-azuretable.env with AzureTableWalStorageOptions.PipelinePhaseTwoCommits = true.
# Quantifies the steady-state throughput delta from overlapping the current batch's phase-0+1
# with the previous batch's phase-2 manifest commit on the Azure Tables WAL provider (F-070).
BENCH_DESCRIPTION="Current-state tree, replication off, Azure Table WAL (pipelined phase-2)"
BENCH_TELEMETRY_SINK=lattice
BENCH_KEY_SHAPE=CurrentStateByVehicleId
BENCH_REPLICATION_ENABLED=false
BENCH_REPLICATION_OVERLAY=false
BENCH_FLEET_SIZE=2000
BENCH_WARMUP_SECONDS=15
BENCH_DURATION_SECONDS=30
BENCH_WAL_PROVIDER=azuretable
BENCH_WAL_TABLE_NAME=OrleansLatticeWal
BENCH_WAL_PIPELINE_PHASE_TWO=true
