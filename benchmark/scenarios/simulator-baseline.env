# simulator-baseline — Simulator baseline (no Lattice).
# Producer-only path with NullTelemetrySink. Establishes the per-vehicle CPU/memory cost
# of the simulator itself so every Lattice-on scenario is reported as a delta over this.
BENCH_DESCRIPTION="Simulator baseline (NullTelemetrySink, no Lattice)"
BENCH_TELEMETRY_SINK=null
BENCH_REPLICATION_ENABLED=false
BENCH_REPLICATION_OVERLAY=false
BENCH_FLEET_SIZE=2000
BENCH_WARMUP_SECONDS=15
BENCH_DURATION_SECONDS=120