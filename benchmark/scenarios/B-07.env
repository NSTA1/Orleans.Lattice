# B-07 — Receiver crash mid-stream.
# Builds on B-04. Hard-kills the receiver silo during steady-state replication and
# brings it back up after BENCH_CHAOS_DURATION_SECONDS. Verifies WAL durability and
# replay correctness under restart.
BENCH_DESCRIPTION="Receiver crash mid-stream"
BENCH_TELEMETRY_SINK=lattice
BENCH_KEY_SHAPE=CurrentStateByVehicleId
BENCH_REPLICATION_ENABLED=true
BENCH_REPLICATION_OVERLAY=true
BENCH_REPLICA_TELEMETRY_SINK=null
BENCH_REPLICA_REPLICATION_ENABLED=true
BENCH_FLEET_SIZE=2000
BENCH_WARMUP_SECONDS=30
BENCH_DURATION_SECONDS=420
BENCH_CHAOS=kill
BENCH_CHAOS_TARGET=silo-replica
BENCH_CHAOS_AFTER_SECONDS=120
BENCH_CHAOS_DURATION_SECONDS=60
