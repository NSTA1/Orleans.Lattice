# B-12 — Observer-off vs. observer-on delta.
# Pairs with B-04. This file is the off-side: replication is enabled-but-no-observer
# (Replication__Enabled=true with no peers configured) so the IMutationObserver chain
# is empty and the hot write path measures the WAL-append cost without observer dispatch.
# The on-side is B-04 (which fans out to a peer through the observer).
BENCH_DESCRIPTION="Observer-off control (paired with B-04 on-side)"
BENCH_TELEMETRY_SINK=lattice
BENCH_KEY_SHAPE=CurrentStateByVehicleId
BENCH_REPLICATION_ENABLED=false
BENCH_REPLICATION_OVERLAY=false
BENCH_FLEET_SIZE=2000
BENCH_WARMUP_SECONDS=15
BENCH_DURATION_SECONDS=120
