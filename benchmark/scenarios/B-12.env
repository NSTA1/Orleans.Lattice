# B-12 — Observer-off vs. observer-on delta.
# Pairs with B-04. This file is the off-side: replication is enabled-but-no-peer
# (Replication__Enabled=true with no overlay so the default NoOpReplicationTransport
# is registered) so the IMutationObserver chain dispatches and the WAL append fires
# but no batch is shipped. This isolates the WAL-append and observer-dispatch cost
# from the transport cost. The on-side is B-04 (which fans out to a real peer
# through the docker overlay).
BENCH_DESCRIPTION="Observer-off control (paired with B-04 on-side)"
BENCH_TELEMETRY_SINK=lattice
BENCH_KEY_SHAPE=CurrentStateByVehicleId
BENCH_REPLICATION_ENABLED=true
BENCH_REPLICATION_OVERLAY=false
BENCH_FLEET_SIZE=2000
BENCH_WARMUP_SECONDS=15
BENCH_DURATION_SECONDS=120
