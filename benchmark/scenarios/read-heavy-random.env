# read-heavy-random — Read-dominant load, random key access.
# Same write topology as current-state-no-replication (steady-state per-vehicle overwrites)
# plus a read-driver issuing GetAsync at 38000/s against random keys discovered via cursor
# pagination. Read:write ratio approximates 95:5 at the default fleet size, mirroring
# YCSB workload B. Measures cache effectiveness and Get fast-path tail latency.
BENCH_DESCRIPTION="Read-heavy, random key access (95:5 read:write)"
BENCH_TELEMETRY_SINK=lattice
BENCH_KEY_SHAPE=CurrentStateByVehicleId
BENCH_REPLICATION_ENABLED=false
BENCH_REPLICATION_OVERLAY=false
BENCH_FLEET_SIZE=2000
BENCH_WARMUP_SECONDS=20
BENCH_DURATION_SECONDS=30
BENCH_READ_DRIVER_ENABLED=true
BENCH_READ_RATE_PER_SECOND=38000
BENCH_READ_PATTERN=Random
BENCH_READ_CONCURRENCY=128
BENCH_READ_WARMUP=00:00:15