# event-log-with-ttl — Event-log tree with TTL (separate run).
# Each tick produces a new key (`vehicleId/{Timestamp:O}`) with a 1h TTL applied via
# the SetAsync(ttl) overload. TTL drives steady-state tombstone compaction.
BENCH_DESCRIPTION="Event-log tree with TTL"
BENCH_TELEMETRY_SINK=lattice
BENCH_KEY_SHAPE=EventLogTimestamped
BENCH_EVENT_LOG_TTL=01:00:00
BENCH_REPLICATION_ENABLED=false
BENCH_REPLICATION_OVERLAY=false
BENCH_FLEET_SIZE=2000
BENCH_WARMUP_SECONDS=15
BENCH_DURATION_SECONDS=30