# bidirectional-replication — Two-cluster bidirectional replication.
# Both clusters produce writes (silo + silo-replica run lattice sink) and replicate
# into each other. Verifies LWW conflict-resolution under symmetric load.
BENCH_DESCRIPTION="Two-cluster bidirectional replication"
BENCH_TELEMETRY_SINK=lattice
BENCH_KEY_SHAPE=CurrentStateByVehicleId
BENCH_REPLICATION_ENABLED=true
BENCH_REPLICATION_OVERLAY=true
BENCH_REPLICA_TELEMETRY_SINK=lattice
BENCH_REPLICA_REPLICATION_ENABLED=true
BENCH_FLEET_SIZE=2000
BENCH_WARMUP_SECONDS=15
BENCH_DURATION_SECONDS=30
# Replication gRPC peer wiring — both directions. Origin pushes to silo-replica:5001
# AND replica pushes to silo:5001 so writes round-trip both ways.
BENCH_ORIGIN_PEER_ENDPOINT=http://silo-replica:5001
BENCH_REPLICA_PEER_ENDPOINT=http://silo:5001
# In-silo write driver on the replica. The simulator API only points at the origin
# cluster, so without an in-silo SetAsync producer on the replica side the replica's
# outbound WAL stays empty and the reverse-direction ship/apply histograms never
# populate — the "bidirectional" scenario is unidirectional in practice. The
# LatticeWriteDriver background service generates a steady stream of writes into the
# same replicated tree the origin replicates into; the replica's replication observer
# captures every call into its WAL, the per-(tree, peer) shipper drains it and pushes
# to the origin. Rate is tuned ~5% of the origin's ~40k/s telemetry to keep the
# scenario LWW-conflict-shaped without overwhelming the receiver.
BENCH_REPLICA_WRITE_DRIVER_ENABLED=true
BENCH_REPLICA_WRITE_DRIVER_RATE=2000
BENCH_REPLICA_WRITE_DRIVER_CONCURRENCY=16
BENCH_REPLICA_WRITE_DRIVER_KEYSPACE=2000
BENCH_REPLICA_WRITE_DRIVER_KEY_PREFIX=replica-
BENCH_REPLICA_WRITE_DRIVER_VALUE_BYTES=256
BENCH_REPLICA_WRITE_DRIVER_WARMUP=00:00:15
