# read-write-mix-random - Balanced read/write, random key access.
# Steady-state per-vehicle writes from the simulator (~2000/s at FLEET_SIZE=2000) plus a
# read-driver issuing 2000 random GetAsync/s against the same keyspace. Approximates a
# YCSB workload-A 50:50 mix. Surfaces contention between the read fast-path and the
# write-commit path: a regression on either side moves the headline KPIs.
BENCH_DESCRIPTION="Read/write balanced, random key access (50:50)"
BENCH_TELEMETRY_SINK=lattice
BENCH_KEY_SHAPE=CurrentStateByVehicleId
BENCH_REPLICATION_ENABLED=false
BENCH_REPLICATION_OVERLAY=false
BENCH_FLEET_SIZE=2000
BENCH_WARMUP_SECONDS=20
BENCH_DURATION_SECONDS=30
BENCH_READ_DRIVER_ENABLED=true
BENCH_READ_RATE_PER_SECOND=2000
BENCH_READ_PATTERN=Random
BENCH_READ_CONCURRENCY=16
BENCH_READ_WARMUP=00:00:15