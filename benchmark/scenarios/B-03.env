# B-03 — Current-state tree, replication off.
# Per-vehicle current-state writes via LatticeSink, single cluster, no observers.
# Establishes the baseline cost of writing to Lattice from the simulator hot path.
BENCH_DESCRIPTION="Current-state tree, replication off"
BENCH_TELEMETRY_SINK=lattice
BENCH_KEY_SHAPE=CurrentStateByVehicleId
BENCH_REPLICATION_ENABLED=false
BENCH_REPLICATION_OVERLAY=false
BENCH_FLEET_SIZE=2000
BENCH_WARMUP_SECONDS=30
BENCH_DURATION_SECONDS=300
