# read-write-mix-ordered — Balanced read/write, sequential key access.
# Same shape as read-write-mix-random with the read-driver in Sequential mode. Exercises the
# read fast-path under a write-contention pattern that benefits from cursor/page locality.
BENCH_DESCRIPTION="Read/write balanced, sequential key access (50:50)"
BENCH_TELEMETRY_SINK=lattice
BENCH_KEY_SHAPE=CurrentStateByVehicleId
BENCH_REPLICATION_ENABLED=false
BENCH_REPLICATION_OVERLAY=false
BENCH_FLEET_SIZE=2000
BENCH_WARMUP_SECONDS=20
BENCH_DURATION_SECONDS=30
BENCH_READ_DRIVER_ENABLED=true
BENCH_READ_RATE_PER_SECOND=2000
BENCH_READ_PATTERN=Sequential
BENCH_READ_CONCURRENCY=16
BENCH_READ_WARMUP=00:00:15