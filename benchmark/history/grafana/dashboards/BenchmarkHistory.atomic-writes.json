    {
      "id": 7,
      "type": "stat",
      "title": "Saga failure rate (last value)",
      "description": "Fraction of terminal SetManyAtomicAsync sagas that did NOT commit (failed + compensated) over the latest non-empty sample. Sourced from the live cluster's Prometheus scrape forwarded to VictoriaMetrics. Threshold lines at 1% (yellow) and 5% (red).",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 6 },
      "fieldConfig": {
        "overrides": [],
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum(rate(orleans_lattice_atomic_write_completed_total{outcome=~\"failed|compensated\"}[5m])) / clamp_min(sum(rate(orleans_lattice_atomic_write_completed_total[5m])), 1e-12)",
          "legendFormat": "non-committed",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Saga failure rate (trend)",
      "description": "Saga failure rate trended over time. The threshold-style line markers at 1% / 5% match the headline tile.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 12, "y": 7, "w": 12, "h": 6 },
      "fieldConfig": {
        "overrides": [],
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "max": 1,
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "showPoints": "auto",
            "thresholdsStyle": { "mode": "line+area" }
          }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum(rate(orleans_lattice_atomic_write_completed_total{outcome=\"failed\"}[5m])) / clamp_min(sum(rate(orleans_lattice_atomic_write_completed_total[5m])), 1e-12)",
          "legendFormat": "failed",
          "refId": "FAIL"
        },
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum(rate(orleans_lattice_atomic_write_completed_total{outcome=\"compensated\"}[5m])) / clamp_min(sum(rate(orleans_lattice_atomic_write_completed_total[5m])), 1e-12)",
          "legendFormat": "compensated",
          "refId": "COMP"
        },
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum(rate(orleans_lattice_atomic_write_completed_total{outcome=~\"failed|compensated\"}[5m])) / clamp_min(sum(rate(orleans_lattice_atomic_write_completed_total[5m])), 1e-12)",
          "legendFormat": "non-committed",
          "refId": "TOTAL"
        }
      ]
    },
